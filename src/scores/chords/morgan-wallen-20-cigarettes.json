{"version":1,"id":"morgan-wallen-20-cigarettes","title":"20 Cigarettes","artist":"Morgan Wallen","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/morgan-wallen/20-cigarettes/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Josh Miller, Chase Mcgill, Blake Pendergrass and Chris LaCorte","chords":[{"symbol":"A#m","canonical":"A#m","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"A#2","canonical":"A#2","keyboardPitchClasses":[10,0,5],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"F#2","canonical":"F#2","keyboardPitchClasses":[6,8,1],"interpretation":null},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"G#7","canonical":"G#7","keyboardPitchClasses":[8,0,3,6],"interpretation":null},{"symbol":"F#7M","canonical":"F#maj7","keyboardPitchClasses":[6,10,1,5],"interpretation":"Keyboard interpretation: F#maj7"},{"symbol":"F7","canonical":"F7","keyboardPitchClasses":[5,9,0,3],"interpretation":null},{"symbol":"C#7M","canonical":"C#maj7","keyboardPitchClasses":[1,5,8,0],"interpretation":"Keyboard interpretation: C#maj7"},{"symbol":"A#m7","canonical":"A#m7","keyboardPitchClasses":[10,1,5,8],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"Twenty ciga-rettes and I lit me one","columns":38,"beats":8,"changes":[{"symbol":"A#m","column":8,"beat":0},{"symbol":"A#2","column":14,"beat":2},{"symbol":"F#","column":28,"beat":4},{"symbol":"F#2","column":35,"beat":6}]},{"id":"line-3","kind":"lyric","text":"On that redwood deck on Demonbreun","column