umns":45,"beats":8,"changes":[{"symbol":"A#m","column":15,"beat":0},{"symbol":"A#2","column":21,"beat":2},{"symbol":"F#","column":35,"beat":4},{"symbol":"F#2","column":42,"beat":6}]},{"id":"line-15","kind":"lyric","text":"With the windows cracked in my old half-ton","columns":46,"beats":6,"changes":[{"symbol":"C#","column":10,"beat":0},{"symbol":"G#","column":32,"beat":2},{"symbol":"G#7","column":43,"beat":4}]},{"id":"line-16","kind":"lyric","text":"Singin' take me home on them country roads","columns":44,"beats":4,"changes":[{"symbol":"A#m","column":9,"beat":0},{"symbol":"A#2","column":18,"beat":1},{"symbol":"F#","column":32,"beat":2},{"symbol":"F#2","column":41,"beat":3}]},{"id":"line-17","kind":"lyric","text":"So I turned off on one then next thing you know","columns":50,"beats":6,"changes":[{"symbol":"C#","column":12,"beat":0},{"symbol":"G#","column":36,"beat":2},{"symbol":"G#7","column":47,"beat":4}]},{"id":"line-18","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-19","kind":"lyric","text":"We had a beer bottle lookin' like an ashtray","columns":44,"beats":4,"changes":[{"symbol":"F#7M","column":15,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Under that full moon she was 'bout halfway","columns":42,"beats":4,"changes":[{"symbol":"F7","column":12,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Naked in my truck bed, so I helped her with the rest","columns":52,"beats":4,"changes":[{"symbol":"C#7M","column":14,"beat":0},{"symbol":"A#m7","column":47,"beat":2}]},{"id":"line-22","kind":"lyric","text":"She was sayin' my name, barely even knew it","columns":43,"beats":4,"changes":[{"symbol":"F#7M","column":16,"beat":0}]},{"id":"line-23","kind":"lyric","text":"We were both lyin', said we never do this","columns":41,"beats":4,"changes":[{"symbol":"F7","column":14,"beat":0}]},{"id":"line-24","kind":"lyric","text":"To the music of the wind through the woods","columns":44,"beats":5,"changes":[{"symbol":"A#m","column":8,"beat":0},{"