ric","text":"I would wait forever, exulted in the scene","columns":56,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"F#","column":8,"beat":1},{"symbol":"E","column":15,"beat":2},{"symbol":"B","column":22,"beat":3},{"symbol":"G#m","column":24,"beat":4},{"symbol":"F#","column":32,"beat":5},{"symbol":"E","column":42,"beat":6},{"symbol":"B","column":55,"beat":7}]},{"id":"line-5","kind":"lyric","text":"As long as I am with you, my heart continues to beat","columns":52,"beats":10,"changes":[{"symbol":"G#m","column":4,"beat":0},{"symbol":"F#","column":12,"beat":2},{"symbol":"E","column":20,"beat":4},{"symbol":"B","column":27,"beat":6},{"symbol":"C#m","column":29,"beat":8}]},{"id":"line-6","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-7","kind":"lyric","text":"With every step we take, Kyoto to The Bay","columns":41,"beats":4,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"D#m","column":27,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Strolling so casually","columns":21,"beats":4,"changes":[{"symbol":"C#m","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"We're different and the same, gave you another name","columns":51,"beats":4,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"D#m","column":31,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Switch up the batteries","columns":35,"beats":6,"changes":[{"symbol":"C#m","column":0,"beat":0},{"symbol":"B","column":27,"beat":2},{"symbol":"F#/A","column":31,"beat":4}]},{"id":"line-11","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-12","kind":"lyric","text":"If you gave me a chance I would take it","columns":39,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"F#","column":8,"beat":2},{"symbol":"E","column":19,"beat":4},{"symbol":"B","column":34,"beat":6}]},{"id":"line-13","kind":"lyric","text":"It's a shot in the dark but I'll make it","columns":40,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"F#","column":8,"beat":2},{"symbol":"E","column":19,"beat":4},{"symbol":"B","column":34,"beat":6}]},{"id":"line-14","kind":"lyric","text":"Know with all of your heart, you can't shame me","columns":47,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"F#/A#","column":11,"beat":2},{"symbol":"E","column":34,"beat":4},{"symbol":"B","column":43,"beat":6}]},{"id":"line-15","kind":"lyric","text":"When I am with you, there's no place I rather be","columns":48,"beats":8,"changes":[{"symbol":"C#m","column":0,"beat":0},{"symbol":"D#m","column":12,"beat":2},{"symbol":"E","column":33,"beat":4},{"symbol":"B","column":45,"beat":6}]},{"id":"line-16","kind":"lyric","text":"N-n-n-no, no, no, no place I rather be [3x]","columns":43,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"F#","column":8,"beat":2},{"symbol":"E","column":19,"beat":4},{"symbol":"B","column":34,"beat":6}]},{"id":"line-17","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"We staked out on a mission to find our inner peace","columns":50,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"Make it everlasting so nothing's incomplete","columns":43,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"It's easy being with you, sacred simplicity","columns":43,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"As long as we're together, there's no place I rather be","columns":55,"beats":4,"changes":[]},{"id":"line-22","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-23","kind":"lyric","text":"Hmmmmmmmmmm, Hoooooooooo","columns":35,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"F#","column":8,"beat":2},{"symbol":"E","column":19,"beat":4},{"symbol":"B","column":34,"beat":6}]},{"id":"line-24","kind":"lyric","text":"Be","columns":35,"beats":8,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbo