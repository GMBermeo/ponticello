{"version":1,"id":"benson-boone-in-the-stars","title":"In The Stars","artist":"Benson Boone","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/benson-boone/in-the-stars/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Jason Evigan,  Michael Pollack and Benson Boone","chords":[{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"D7","canonical":"D7","keyboardPitchClasses":[2,6,9,0],"interpretation":null},{"symbol":"D#m","canonical":"D#m","keyboardPitchClasses":[3,6,10],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primera Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":" Sunday mornings were your favorite","columns":35,"beats":3,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":9,"beat":1},{"symbol":"Gm","column":28,"beat":2}]},{"id":"line-3","kind":"lyric","text":"I used to meet you down on Woods creek road","columns":43,"beats":10,"changes":[{"symbol":"A#","column":10,"beat":0},{"symbol":"Dm","column":28,"beat":2},{"symbol":"Gm","column":38,"beat":4}]},{"id":"line-4","kind":"lyric","text":" You did your hair up like you were famous","columns":42,"beats":6,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":15,"beat":2},{"symbol":"Gm","column":37,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Even though it's only church where we were going","columns":48,"beats":3,"changes":[{"symbol":"Cm","column":5,"beat":0},{"symbol":"A#","column":22,"beat":1},{"symbol":"F","column":44,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Now Sunday mornings, I just sleep in","columns":36,"beats":6,"changes":[{"symbol":"A#","column":3,"beat":0},{"symbol":"Dm","column":12,"beat":2},{"symbol":"Gm","column":29,"beat":4}]},{"id":"line-7","kind":"lyric","text":"It's like I've buried my faith with you","columns":39,"beats":6,"changes":[{"symbol":"A#","column":15,"beat":0},{"symbol":"Dm","column":26,"beat":2},{"symbol":"Gm","column":37,"beat":4}]},{"id":"line-8","kind":"lyric","text":"I'm screaming at a God, I don't know if I believe in","columns":52,"beats":7,"changes":[{"symbol":"A#","column":4,"beat":0},{"symbol":"Dm","column":20,"beat":1},{"symbol":"Gm","column":33,"beat":2}]},{"id":"line-9","kind":"lyric","text":"'Cause I don't know what else I can do","columns":38,"beats":3,"changes":[{"symbol":"Cm","column":7,"beat":0},{"symbol":"A#","column":25,"beat":1},{"symbol":"F","column":37,"beat":2}]},{"id":"line-10","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-11","kind":"lyric","text":"Oh, I'm still holding on to everything that's dead and gone","columns":59,"beats":4,"changes":[{"symbol":"D#","column":14,"beat":0},{"symbol":"A#","column":47,"beat":2}]},{"id":"line-12","kind":"lyric","text":"I don't wanna say goodbye 'cause this one means forever","columns":55,"beats":8,"changes":[{"symbol":"F","column":14,"beat":0},{"symbol":"Gm","column":48,"beat":4}]},{"id":"line-13","kind":"lyric","text":"Now you're in the stars and six feet's never felt so far","columns":56,"beats":4,"changes":[{"symbol":"D#","column":11,"beat":0},{"symbol":"A#","column":46,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Here I am alone between the heavens and the embers","columns":50,"beats":4,"changes":[{"symbol":"F","column":10,"beat":0},{"symbol":"Gm","column":44,"beat":2}]},{"id":"line-15","kind":"lyric","text":"Oh, it hurts so hard for a million