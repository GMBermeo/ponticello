{"version":1,"id":"eminem-mockingbird","title":"Mockingbird","artist":"Eminem","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/eminem/mockingbird/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Eminem and Luis Edgardo Resto","chords":[{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Intro]","columns":7,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"      Yeah,       I know sometimes","columns":34,"beats":8,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"C","column":4,"beat":2},{"symbol":"D","column":12,"beat":4},{"symbol":"Em","column":15,"beat":6}]},{"id":"line-3","kind":"lyric","text":"Things may not   always make sense","columns":34,"beats":2,"changes":[{"symbol":"C","column":15,"beat":0}]},{"id":"line-4","kind":"lyric","text":"To you right now","columns":20,"beats":4,"changes":[{"symbol":"D","column":14,"beat":0},{"symbol":"Em","column":18,"beat":2}]},{"id":"line-5","kind":"lyric","text":"But hey, what'd Daddy always tell you?","columns":40,"beats":4,"changes":[{"symbol":"C","column":39,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Straighten up, little soldier","columns":29,"beats":4,"changes":[{"symbol":"D","column":11,"beat":0}]},{"id":"line-7","kind":"lyric","text":"   Stiffen up that upper lip!","columns":31,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"C","column":30,"beat":2}]},{"id":"line-8","kind":"lyric","text":"What you cryin' about?   You got me","columns":36,"beats":4,"changes":[{"symbol":"D","column":23,"beat":0},{"symbol":"Em","column":34,"beat":2}]},{"id":"line-9","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"Hailie, I know you miss your mom","columns":32,"beats":4,"changes":[{"symbol":"Em","column":12,"beat":0}]},{"id":"line-11","kind":"lyric","text":"And I know you miss your dad","columns":28,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-12","kind":"lyric","text":"When I'm gone, but I'm tryin'","columns":29,"beats":4,"changes":[{"symbol":"D","column":10,"beat":0}]},{"id":"line-13","kind":"lyric","text":"To give you the life that I never had","columns":37,"beats":4,"changes":[{"symbol":"Em","column":17,"beat":0}]},{"id":"line-14","kind":"lyric","text":"I can see you're sad, even when you smile","columns":41,"beats":4,"changes":[{"symbol":"C","column":38,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Even when you laugh","columns":19,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"I can see it in your eyes","columns":25,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Deep inside you wanna cry","columns":25,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0}]},{"id":"line-18","kind":"lyric","text":"'Cause you're scared, I ain't there","columns":35,"beats":4,"changes":[{"symbol":"C","column":32,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Daddy's with you in your prayers","columns":32,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"No more cryin', wipe them tears","columns":31,"beats":4,"changes":[{"symbol":"D","column":1,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Daddy's here, no more nightmares","columns":32,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0}]},{"id":"line-22","kind":"lyric","text":"We gon' pull together through it","columns":32,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"We gon' do it, Lainie-Uncle's crazy, ain't he?","columns":46,"beats":4,"changes":[{"symbol":"C","column":1,"beat":0},{"symbol":"D","column":32,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Yeah, but he loves you, girl","columns":28,"beats":4,"changes":[{"symbol":"Em","column":25,"beat":0}]},{"id":"line-25","kind":"lyric","text":"And you better know it","columns":22,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"We're all we got in this world","columns":30,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"When it spins, when it swirls","columns":29,"beats":4,"changes":[{"symbol":"C","column":2,"beat":0}]},{"id":"line-28","kind":"lyric","text":"When it whirls, when it twirls","columns":30,"beats":4,"changes":[{"symbol":"D","column":2,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Two little beautiful girls","columns":26,"beats":4,"changes":[{"symbol":"Em","column":2,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Lookin' puzzled, in a daze","columns":26,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"I know it's confusin' you","columns":25,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Daddy's always on the move","columns":26,"beats":4,"changes":[{"symbol":"D","column":1,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Momma's always on the news","columns":26,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0}]},{"id":"line-34","kind":"lyric","text":"I try to keep you sheltered from it","columns":35,"beats":4,"changes":[]},{"id":"line-35","kind":"lyric","text":"But somehow it seems","columns":20,"beats":4,"changes":[{"symbol":"C","column":1,"beat":0}]},{"id":"line-36","kind":"lyric","text":"The harder that I try to do that","columns":32,"beats":4,"changes":[{"symbol":"D","column":12,"beat":0}]},{"id":"line-37","kind":"lyric","text":"The more it backfires on me","columns":27,"beats":4,"changes":[{"symbol":"Em","column":9,"beat":0}]},{"id":"line-38","kind":"lyric","text":"All the things growin' up","columns":25,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"As Daddy that he had to see","columns":27,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Daddy don't want you to see","columns":27,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0}]},{"id":"line-41","kind":"lyric","text":"But you see just as much as he did","columns":34,"beats":2,"changes":[{"symbol":"Em","column":5,"beat":0}]},{"id":"line-42","kind":"lyric","text":"We did not plan it to be this way","columns":33,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"Your mother and me","columns":18,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-44","kind":"lyric","text":"But things have got so bad between us","columns":37,"beats":2,"changes":[{"symbol":"D","column":17,"beat":0}]},{"id":"line-45","kind":"lyric","text":"I don't see us ever bein'","columns":25,"beats":4,"changes":[{"symbol":"Em","column":9,"beat":0}]},{"id":"line-46","kind":"lyric","text":"Together ever again","columns":19,"beats":4,"changes":[]},{"id":"line-47","kind":"lyric","text":"Like we used to be when we was teenagers","columns":40,"beats":6,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-48","kind":"lyric","text":"But then, of course","columns":19,"beats":4,"changes":[{"symbol":"D","column":1,"beat":0}]},{"id":"line-49","kind":"lyric","text":"Everything always happens for a reason","columns":38,"beats":2,"changes":[{"symbol":"Em","column":3,"beat":0}]},{"id":"line-50","kind":"lyric","text":"I guess it was never meant to be","columns":32,"beats":4,"changes":[{"symbol":"C","column":22,"beat":0}]},{"id":"line-51","kind":"lyric","text":"But it's just something","columns":23,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"We have no control over","columns":23,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-53","kind":"lyric","text":"And that's what destiny is","columns":26,"beats":4,"changes":[{"symbol":"Em","column":6,"beat":0}]},{"id":"line-54","kind":"lyric","text":"But no more worries","columns":19,"beats":4,"changes":[]},{"id":"line-55","kind":"lyric","text":"Rest your head and go to sleep","columns":30,"beats":6,"changes":[{"symbol":"C","column":11,"beat":0}]},{"id":"line-56","kind":"lyric","text":"Maybe one day we'll wake up","columns":27,"beats":4,"changes":[{"symbol":"D","column":6,"beat":0}]},{"id":"line-57","kind":"lyric","text":"And this'll all just be a dream","columns":31,"beats":4,"changes":[{"symbol":"Em","column":12,"beat":0}]},{"id":"line-58","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-59","kind":"lyric","text":"Now hush, little baby, don't you cry","columns":36,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0},{"symbol":"C","column":24,"beat":2}]},{"id":"line-60","kind":"lyric","text":"Everything's gonna be alright","columns":29,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0},{"symbol":"Em","column":25,"beat":1}]},{"id":"line-61","kind":"lyric","text":"Stiffen that upper lip up,","columns":26,"beats":4,"changes":[]},{"id":"line-62","kind":"lyric","text":"Little lady, I told ya","columns":22,"beats":4,"changes":[{"symbol":"C","column":16,"beat":0}]},{"id":"line-63","kind":"lyric","text":"Daddy's here to hold ya through the night","columns":41,"beats":4,"changes":[{"symbol":"D","column":17,"beat":0},{"symbol":"Em","column":37,"beat":2}]},{"id":"line-64","kind":"lyric","text":"I know Mommy's not here right now","columns":33,"beats":4,"changes":[]},{"id":"line-65","kind":"lyric","text":"And we don't know why","columns":21,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-66","kind":"lyric","text":"We feel how we feel inside","columns":26,"beats":4,"changes":[{"symbol":"D","column":4,"beat":0},{"symbol":"Em","column":23,"beat":1}]},{"id":"line-67","kind":"lyric","text":"It may seem a little crazy, pretty baby","columns":39,"beats":2,"changes":[{"symbol":"C","column":36,"beat":0}]},{"id":"line-68","kind":"lyric","text":"But I promise, Momma's gon' be alright","columns":38,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0},{"symbol":"Em","column":34,"beat":2}]},{"id":"line-69","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-70","kind":"lyric","text":"It's funny, I remember back one year","columns":36,"beats":4,"changes":[{"symbol":"Em","column":12,"beat":0}]},{"id":"line-71","kind":"lyric","text":"When Daddy had no money","columns":23,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0}]},{"id":"line-72","kind":"lyric","text":"Mommy wrapped the Christmas presents up","columns":39,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0}]},{"id":"line-73","kind":"lyric","text":"And stuck 'em under the tree","columns":28,"beats":4,"changes":[{"symbol":"Em","column":6,"beat":0}]},{"id":"line-74","kind":"lyric","text":"And said some of 'em were from me","columns":33,"beats":4,"changes":[]},{"id":"line-75","kind":"lyric","text":"'Cause Daddy couldn't buy 'em","columns":29,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-76","kind":"lyric","text":"I'll never forget that Christmas,","columns":33,"beats":2,"changes":[{"symbol":"D","column":6,"beat":0}]},{"id":"line-77","kind":"lyric","text":"I sat up the whole night cryin'","columns":31,"beats":2,"changes":[{"symbol":"Em","column":6,"beat":0}]},{"id":"line-78","kind":"lyric","text":"'Cause Daddy felt like a bum see, Daddy had a job","columns":49,"beats":2,"changes":[{"symbol":"C","column":35,"beat":0}]},{"id":"line-79","kind":"lyric","text":"But his job was to keep the food","columns":32,"beats":4,"changes":[{"symbol":"D","column":9,"beat":0}]},{"id":"line-80","kind":"lyric","text":"On the table for you and Mom","columns":28,"beats":4,"changes":[{"symbol":"Em","column":14,"beat":0}]},{"id":"line-81","kind":"lyric","text":"And at the time, every house that we lived in","columns":45,"beats":2,"changes":[{"symbol":"C","column":35,"beat":0}]},{"id":"line-82","kind":"lyric","text":"Either kept gettin' broken into","columns":31,"beats":4,"changes":[{"symbol":"D","column":21,"beat":0}]},{"id":"line-83","kind":"lyric","text":"And robbed or shot up on the block","columns":34,"beats":2,"changes":[{"symbol":"Em","column":16,"beat":0}]},{"id":"line-84","kind":"lyric","text":"And your mom was savin' money for you in a jar","columns":46,"beats":2,"changes":[{"symbol":"C","column":31,"beat":0}]},{"id":"line-85","kind":"lyric","text":"Tryin' to start a piggy bank for you","columns":36,"beats":4,"changes":[{"symbol":"D","column":12,"beat":0}]},{"id":"line-86","kind":"lyric","text":"So you could go to college","columns":26,"beats":4,"changes":[{"symbol":"Em","column":4,"beat":0}]},{"id":"line-87","kind":"lyric","text":"Almost had a thousand dollars","columns":29,"beats":4,"changes":[]},{"id":"line-88","kind":"lyric","text":"'Til someone broke in and stole it","columns":34,"beats":4,"changes":[{"symbol":"C","column":2,"beat":0}]},{"id":"line-89","kind":"lyric","text":"And I know it hurt so bad","columns":25,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-90","kind":"lyric","text":"It broke your momma's heart","columns":27,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0}]},{"id":"line-91","kind":"lyric","text":"And it seemed like everything","columns":29,"beats":4,"changes":[]},{"id":"line-92","kind":"lyric","text":"Was just startin' to fall apart","columns":31,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0}]},{"id":"line-93","kind":"lyric","text":"Mom and Dad was arguin' a lot","columns":29,"beats":4,"changes":[{"symbol":"D","column":1,"beat":0},{"symbol":"Em","column":27,"beat":2}]},{"id":"line-94","kind":"lyric","text":"So Momma moved back","columns":19,"beats":4,"changes":[]},{"id":"line-95","kind":"lyric","text":"On to Chalmers in the flat","columns":26,"beats":4,"changes":[]},{"id":"line-96","kind":"lyric","text":"  One bedroom apartment","columns":23,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-97","kind":"lyric","text":"And Dad moved back","columns":18,"beats":2,"changes":[{"symbol":"D","column":5,"beat":0}]},{"id":"line-98","kind":"lyric","text":"To the other side of 8 Mile on Novara","columns":37,"beats":4,"changes":[{"symbol":"Em","column":21,"beat":0}]},{"id":"line-99","kind":"lyric","text":"And that's when Daddy went","columns":26,"beats":4,"changes":[]},{"id":"line-100","kind":"lyric","text":"To California with his CD","columns":25,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0}]},{"id":"line-101","kind":"lyric","text":"And met Dr. Dre and flew","columns":24,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0}]},{"id":"line-102","kind":"lyric","text":"You and Momma out to see me","columns":27,"beats":4,"changes":[{"symbol":"Em","column":9,"beat":0}]},{"id":"line-103","kind":"lyric","text":"But Daddy had to work","columns":21,"beats":4,"changes":[]},{"id":"line-104","kind":"lyric","text":"You and Momma had to leave me","columns":29,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0}]},{"id":"line-105","kind":"lyric","text":"Then you started seein' Daddy on the TV","columns":39,"beats":4,"changes":[{"symbol":"D","column":11,"beat":0},{"symbol":"Em","column":37,"beat":2}]},{"id":"line-106","kind":"lyric","text":"And Momma didn't like it","columns":24,"beats":4,"changes":[]},{"id":"line-107","kind":"lyric","text":"And you and Lainie were too young to understand it","columns":50,"beats":4,"changes":[{"symbol":"C","column":20,"beat":0}]},{"id":"line-108","kind":"lyric","text":"Papa was a rolling stone","columns":24,"beats":4,"changes":[{"symbol":"D","column":1,"beat":0}]},{"id":"line-109","kind":"lyric","text":"Momma developed a habit","columns":23,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0}]},{"id":"line-110","kind":"lyric","text":"And it all happened too fast","columns":28,"beats":4,"changes":[]},{"id":"line-111","kind":"lyric","text":"For either one of us to grab it","columns":31,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0}]},{"id":"line-112","kind":"lyric","text":"I'm just sorry you were there","columns":29,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-113","kind":"lyric","text":"And had to witness it first hand","columns":32,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0}]},{"id":"line-114","kind":"lyric","text":"'Cause all I ever wanted to do","columns":30,"beats":4,"changes":[{"symbol":"C","column":29,"beat":0}]},{"id":"line-115","kind":"lyric","text":"Was just make you proud","columns":23,"beats":4,"changes":[]},{"id":"line-116","kind":"lyric","text":"Now I'm sittin' in this empty house","columns":35,"beats":4,"changes":[{"symbol":"D","column":1,"beat":0},{"symbol":"Em","column":31,"beat":2}]},{"id":"line-117","kind":"lyric","text":"Just reminiscin', lookin' at","columns":28,"beats":4,"changes":[]},{"id":"line-118","kind":"lyric","text":"Your baby pictures, it just trips me out","columns":40,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0}]},{"id":"line-119","kind":"lyric","text":"To see how much you both have grown","columns":35,"beats":4,"changes":[{"symbol":"D","column":12,"beat":0}]},{"id":"line-120","kind":"lyric","text":"It's almost like you're sisters now","columns":35,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0}]},{"id":"line-121","kind":"lyric","text":"Wow, guess you pretty much are","columns":30,"beats":4,"changes":[{"symbol":"C","column":23,"beat":0}]},{"id":"line-122","kind":"lyric","text":"And Daddy's still here","columns":24,"beats":4,"changes":[{"symbol":"D","column":23,"beat":0}]},{"id":"line-123","kind":"lyric","text":"Lainie, I'm talkin' to you too","columns":30,"beats":4,"changes":[{"symbol":"Em","column":28,"beat":0}]},{"id":"line-124","kind":"lyric","text":"Daddy's still here","columns":18,"beats":4,"changes":[]},{"id":"line-125","kind":"lyric","text":"I like the sound of that, yeah","columns":30,"beats":4,"changes":[{"symbol":"C","column":27,"beat":0}]},{"id":"line-126","kind":"lyric","text":"It's got a ring to it, don't it?","columns":32,"beats":4,"changes":[{"symbol":"D","column":29,"beat":0}]},{"id":"line-127","kind":"lyric","text":"Sshh! Momma's only gone for the moment","columns":38,"beats":4,"changes":[{"symbol":"Em","column":14,"beat":0}]},{"id":"line-128","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-129","kind":"lyric","text":"Now hush, little baby, don't you cry","columns":36,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0},{"symbol":"C","column":24,"beat":2}]},{"id":"line-130","kind":"lyric","text":"Everything's gonna be alright","columns":29,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0},{"symbol":"Em","column":25,"beat":2}]},{"id":"line-131","kind":"lyric","text":"Stiffen that upper lip up,","columns":26,"beats":4,"changes":[]},{"id":"line-132","kind":"lyric","text":"Little lady, I told ya","columns":22,"beats":4,"changes":[{"symbol":"C","column":16,"beat":0}]},{"id":"line-133","kind":"lyric","text":"Daddy's here to hold ya through the night","columns":41,"beats":4,"changes":[{"symbol":"D","column":17,"beat":0},{"symbol":"Em","column":37,"beat":2}]},{"id":"line-134","kind":"lyric","text":"I know Mommy's not here right now","columns":33,"beats":4,"changes":[]},{"id":"line-135","kind":"lyric","text":"And we don't know why","columns":21,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-136","kind":"lyric","text":"We feel how we feel inside","columns":26,"beats":4,"changes":[{"symbol":"D","column":4,"beat":0},{"symbol":"Em","column":23,"beat":2}]},{"id":"line-137","kind":"lyric","text":"It may seem a little crazy, pretty baby","columns":39,"beats":4,"changes":[{"symbol":"C","column":36,"beat":0}]},{"id":"line-138","kind":"lyric","text":"But I promise, Momma's gon' be alright","columns":38,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0},{"symbol":"Em","column":34,"beat":2}]},{"id":"line-139","kind":"section","text":"[Final]","columns":7,"beats":0,"changes":[]},{"id":"line-140","kind":"lyric","text":"And if you ask me to","columns":20,"beats":4,"changes":[]},{"id":"line-141","kind":"lyric","text":"Daddy's gonna buy you a mockingbird","columns":35,"beats":4,"changes":[{"symbol":"C","column":25,"beat":0}]},{"id":"line-142","kind":"lyric","text":"I'ma give you the world","columns":23,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Em","column":19,"beat":2}]},{"id":"line-143","kind":"lyric","text":"I'ma buy a diamond ring for you","columns":31,"beats":4,"changes":[]},{"id":"line-144","kind":"lyric","text":"I'ma sing for you","columns":17,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0}]},{"id":"line-145","kind":"lyric","text":"I'll do anything for you to see you smile","columns":41,"beats":4,"changes":[{"symbol":"D","column":18,"beat":0},{"symbol":"Em","column":38,"beat":2}]},{"id":"line-146","kind":"lyric","text":"And if that mockingbird don't sing","columns":34,"beats":4,"changes":[]},{"id":"line-147","kind":"lyric","text":"And that ring don't shine","columns":25,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0}]},{"id":"line-148","kind":"lyric","text":"I'ma break that birdie's neck","columns":29,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0},{"symbol":"Em","column":26,"beat":2}]},{"id":"line-149","kind":"lyric","text":"I'll go back to the jeweler who sold it to ya","columns":45,"beats":4,"changes":[{"symbol":"C","column":40,"beat":0}]},{"id":"line-150","kind":"lyric","text":"And make him eat every carat, don't fuck with Dad!","columns":50,"beats":4,"changes":[{"symbol":"D","column":24,"beat":0},{"symbol":"Em","column":47,"beat":2}]}]}