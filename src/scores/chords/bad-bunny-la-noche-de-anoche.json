lumns":27,"beats":4,"changes":[{"symbol":"Em","column":17,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Con esa boquita suena rico to' lo que tú me dice'","columns":49,"beats":4,"changes":[{"symbol":"C","column":23,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Hicimo' pose' que yo má' nunca hice","columns":35,"beats":4,"changes":[{"symbol":"G","column":10,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Tú te mojaste' pa' que yo me bautice","columns":36,"beats":4,"changes":[{"symbol":"D/F#","column":9,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Y me ponga serio, serio","columns":23,"beats":4,"changes":[{"symbol":"Em","column":12,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Tú y yo junto' creando un imperio","columns":33,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Eso' ojito' tienen un misterio","columns":30,"beats":6,"changes":[{"symbol":"G","column":8,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Pero al final na' 'e lo nuestro fue en serio","columns":44,"beats":4,"changes":[{"symbol":"D/F#","column":10,"beat":0}]},{"id":"line-32","kind":"section","text":"[Pre-Coro: Bad Bunny]","columns":21,"beats":0,"changes":[]},{"id":"line-33","kind":"lyric","text":"Y ya me ha pasa'o que me han ilusiona'o","columns":39,"beats":2,"changes":[{"symbol":"Em","column":14,"beat":0}]},{"id":"line-34","kind":"lyric","text":"Y ya me ha pasa'o que me han abandona'o","columns":39,"beats":2,"changes":[{"symbol":"C","column":14,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Y ya me ha pasa'o que no está' a mi la'o","columns":40,"beats":6,"changes":[{"symbol":"G","column":14,"beat":0}]},{"id":"line-36","kind":"lyric","text":"Y ya me ha pasa'o","columns":18,"beats":2,"changes":[{"symbol":"D/F#","column":14,"beat":0}]},{"id":"line-37","kind":"section","text":"[Coro: ROSALÍA & Bad Bunny]","columns":27,"beats":0,"changes":[]},{"id":"line-38","kind":"lyric","text":"Porque la noche de anoche fue","columns":30,"b