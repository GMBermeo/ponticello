eats":4,"changes":[]},{"id":"line-45","kind":"lyric","text":"Hey man you disrespecting me?","columns":29,"beats":4,"changes":[]},{"id":"line-46","kind":"lyric","text":"Take him out","columns":12,"beats":4,"changes":[]},{"id":"line-47","kind":"lyric","text":"You gotta keep 'em separated","columns":28,"beats":4,"changes":[]},{"id":"line-48","kind":"lyric","text":"Hey they don't pay no mind","columns":26,"beats":4,"changes":[]},{"id":"line-49","kind":"lyric","text":"If you're under 18 you won't be doing any time","columns":46,"beats":4,"changes":[]},{"id":"line-50","kind":"lyric","text":"Hey come out and play","columns":21,"beats":4,"changes":[]},{"id":"line-51","kind":"lyric","text":"By the time you hear the siren","columns":30,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"It's already too late","columns":21,"beats":4,"changes":[]},{"id":"line-53","kind":"lyric","text":"One goes to the morgue and the other to jail","columns":44,"beats":4,"changes":[]},{"id":"line-54","kind":"lyric","text":"One guy's wasted and the other's a waste","columns":40,"beats":4,"changes":[]},{"id":"line-55","kind":"lyric","text":"It goes down the same as a thousand before","columns":42,"beats":4,"changes":[]},{"id":"line-56","kind":"lyric","text":"No one's getting smarter","columns":24,"beats":4,"changes":[]},{"id":"line-57","kind":"lyric","text":"No one's learning the score","columns":27,"beats":4,"changes":[]},{"id":"line-58","kind":"lyric","text":"Your never ending spree of death a violence and hate","columns":52,"beats":4,"changes":[]},{"id":"line-59","kind":"lyric","text":"Is gonna tie your own rope","columns":26,"beats":4,"changes":[]},{"id":"line-60","kind":"section","text":"Chorus","columns":6,"beats":0,"changes":[]}]}