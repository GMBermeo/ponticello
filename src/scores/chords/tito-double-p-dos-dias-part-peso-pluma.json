es":[{"symbol":"C#","column":41,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Todo lo que planeaba se nos fue a la chingada","columns":45,"beats":4,"changes":[{"symbol":"G#","column":37,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Mira en qué me convertí","columns":23,"beats":4,"changes":[{"symbol":"D#m","column":20,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Me encantan las pacas, me mama el dinero","columns":40,"beats":4,"changes":[{"symbol":"F#","column":32,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Baby, yo te lo advertí","columns":23,"beats":4,"changes":[{"symbol":"C#","column":21,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Que, estando solito, yo era un cagadero","columns":39,"beats":4,"changes":[{"symbol":"G#","column":32,"beat":0}]},{"id":"line-15","kind":"lyric","text":"No fui yo, sino por ti","columns":22,"beats":4,"changes":[{"symbol":"D#m","column":19,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Que me hice adicto a andar en esta loquera","columns":42,"beats":4,"changes":[{"symbol":"F#","column":35,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Guacha, lo que conseguí","columns":23,"beats":4,"changes":[{"symbol":"C#","column":17,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Un chingo de culos y ni uno me llena","columns":36,"beats":4,"changes":[{"symbol":"G#","column":29,"beat":0}]},{"id":"line-19","kind":"instrumental","text":"(                 )","columns":19,"beats":6,"changes":[{"symbol":"D#m","column":2,"beat":0},{"symbol":"F#","column":7,"beat":1},{"symbol":"C#","column":11,"beat":2},{"symbol":"G#","column":15,"beat":4}]},{"id":"line-20","kind":"lyric","text":"Ay, mamá","columns":8,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"Tito Double P, ah","columns":17,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"Así suena la puta Doble P, compa Tito","columns":37,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"Ay-ay-ay","columns":8,"beats":4,"changes":[]},{"id":