{"version":1,"id":"lorde-green-light","title":"Green Light","artist":"Lorde","key":"A","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/lorde/green-light/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Fun, Joel Little and Lorde","chords":[{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I do my makeup in somebody else's car","columns":37,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":18,"beat":2},{"symbol":"D","column":34,"beat":4}]},{"id":"line-2","kind":"lyric","text":"We order different drinks at the same bars","columns":42,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":19,"beat":2},{"symbol":"D","column":38,"beat":4}]},{"id":"line-3","kind":"lyric","text":"I know about what you did and I wanna scream the truth","columns":54,"beats":7,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":22,"beat":1},{"symbol":"D","column":49,"beat":2}]},{"id":"line-4","kind":"lyric","text":"She thinks you love the beach, you're such a damn liar","columns":54,"beats":5,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":24,"beat":1},{"symbol":"D","column":50,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Those great whites, they have big teeth","columns":39,"beats":6,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Hope they bite you","columns":18,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Thought you said that you would always be in love","columns":49,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"E","column":46,"beat":2}]},{"id":"line-8","kind":"lyric","text":"But you're not in love no more","columns":30,"beats":4,"changes":[{"symbol":"D","column":27,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Did it frighten you","columns":23,"beats":4,"changes":[{"symbol":"F#m","column":20,"beat":0}]},{"id":"line-10","kind":"lyric","text":"How we kissed when we danced on the light up floor?","columns":51,"beats":4,"changes":[{"symbol":"E","column":47,"beat":0}]},{"id":"line-11","kind":"lyric","text":"On the light up floor","columns":21,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-12","kind":"lyric","text":"But I hear sounds in my mind","columns":28,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":11,"beat":2},{"symbol":"A","column":24,"beat":5}]},{"id":"line-13","kind":"lyric","text":"Brand new sounds in my mind","columns":27,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":10,"beat":2},{"symbol":"A","column":23,"beat":4}]},{"id":"line-14","kind":"lyric","text":"But honey I'll be seein' you 'ever I go","columns":55,"beats":8,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"D","column":25,"beat":2},{"symbol":"A","column":37,"beat":4},{"symbol":"A","column":54,"beat":6}]},{"id":"line-15","kind":"lyric","text":"But honey I'll be seein' you down every road","columns":44,"beats":8,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"D","column":25,"beat":2},{"symbol":"A","column":40,"beat":5}]},{"id":"line-16","kind":"lyric","text":"I'm waiting for it, that green light, I want it","columns":47,"beats":12,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"A","column":20,"beat":4},{"symbol":"A","column":38,"beat":8}]},{"id":"line-17","kind":"lyric","text":"'Cause honey I'll come get my things, but I can't let go","columns":56,"beats":6,"changes":[{"symbol":"G","column":13,"beat":0},{"symbol":"D","column":30,"beat":2},{"symbol":"A","column":50,"beat":4}]},{"id":"line-18","kind":"lyric","text":"I'm waiting for it, that green light, I want it","columns":47,"beats":12,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"A","column":20,"beat":4},{"symbol":"A","column":38,"beat":8}]},{"id":"line-19","kind":"lyric","text":"Oh, I wish I could get my things and just let go","columns":48,"beats":8,"changes":[{"symbol":"G","column":11,"beat":0},{"symbol":"D","column":26,"beat":2},{"symbol":"A","column":46,"beat":5}]},{"id":"line-20","kind":"lyric","text":"I'm waiting for it, that green light, I want it","columns":47,"beats":3,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"A","column":20,"beat":1},{"symbol":"A","column":38,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Sometimes I wake up in a different bedroom","columns":42,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":20,"beat":2},{"symbol":"D","column":35,"beat":4}]},{"id":"line-22","kind":"lyric","text":"I whisper things, the city sings 'em back to you","columns":48,"beats":5,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":22,"beat":1},{"symbol":"D","column":42,"beat":4}]},{"id":"line-23","kind":"lyric","text":"All those rumors, they have big teeth","columns":37,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Hope they bite you","columns":18,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Thought you said that you would always be in love","columns":49,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"E","column":46,"beat":2}]},{"id":"line-26","kind":"lyric","text":"But you're not in love no more","columns":30,"beats":4,"changes":[{"symbol":"D","column":28,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Did it frighten you","columns