{"version":1,"id":"gene-autry-here-comes-santa-claus","title":"Here Comes Santa Claus","artist":"Gene Autry","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/gene-autry/here-comes-santa-claus/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Gene Autry and Oakley Haldeman","chords":[{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"G7","canonical":"G7","keyboardPitchClasses":[7,11,2,5],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Here comes Santa Claus, here comes Santa Claus,","columns":47,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Right down Santa Claus lane","columns":27,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Vixen and Blitzen and all his reindeer","columns":38,"beats":4,"changes":[]},{"id":"line-4","kind":"lyric","text":"Pullin' on the reins","columns":20,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Bells are ringin', children singin'","columns":35,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Em","column":19,"beat":2}]},{"id":"line-6","kind":"lyric","text":"All is merry and bright","columns":23,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0},{"symbol":"C","column":17,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Hang your stockings and say your prayers","columns":40,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"C","column":24,"beat":2}]},{"id":"line-8","kind":"lyric","text":"'Cause Santa Claus comes tonight!","columns":33,"beats":4,"changes":[{"symbol":"G7","column":7,"beat":0},{"symbol":"C","column":27,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Here comes Santa Claus, here comes Santa Claus,","columns":47,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Right down Santa Claus lane","columns":27,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0}]},{"id":"line-11","kind":"lyric","text":"He's got a bag that's filled with toys","columns":38,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"For boys and girls again","columns":24,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Hear those sleigh bells jingle jangle,","columns":38,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Em","column":24,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Oh what a beautiful sight","columns":25,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0},{"symbol":"C","column":20,"beat":2}]},{"id":"line-15","kind":"lyric","text":"So jump in bed and cover your head","columns":34,"beats":4,"changes":[{"symbol":"F","column":3,"beat":0},{"symbol":"C","column":25,"beat":2}]},{"id":"line-16","kind":"lyric","text":"'Cause Santa Claus comes tonight!","columns":33,"beats":4,"changes":[{"symbol":"G7","column":7,"beat":0},{"symbol":"C","column":27,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Here comes Santa Claus, here comes Santa Claus,","columns":47,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Right down Santa Claus lane","columns":27,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"He doesn't care if you're rich or poor","columns":38,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"He loves you just the same","columns":26,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"Santa Claus knows we're all Gods children","columns":41,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"That makes everything right","columns":27,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"So fill your hearts with Christmas cheer","columns":40,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"'Cause Santa Claus comes tonight!","columns":33,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"Here comes Santa Claus, here comes Santa Claus,","columns":47,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Right down Santa Claus lane","columns":27,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"He'll come around when the chimes ring out","columns":42,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"That it's Christmas morn again","columns":30,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"Peace on earth will come to all","columns":31,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"If we just follow the light","columns":27,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"So lets give thanks to the lord above","columns":37,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"That Santa Claus comes tonight!","columns":31,"beats":4,"changes":[]}]}