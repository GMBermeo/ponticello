{"version":1,"id":"zach-bryan-oklahoma-smokeshow","title":"Oklahoma Smokeshow","artist":"Zach Bryan","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/zach-bryan/oklahoma-smokeshow/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Zach Bryan","chords":[{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"C#5","canonical":"C#5","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":27,"beats":10,"changes":[{"symbol":"G#","column":8,"beat":0},{"symbol":"C#5","column":12,"beat":2},{"symbol":"Fm","column":17,"beat":4},{"symbol":"D#","column":21,"beat":6},{"symbol":"G#","column":25,"beat":8}]},{"id":"line-2","kind":"lyric","text":"Go on and put on that dress that all the bad boys like","columns":54,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-3","kind":"lyric","text":"I know your daddy ain't home so ride with me tonight","columns":52,"beats":4,"changes":[{"symbol":"C#5","column":1,"beat":0}]},{"id":"line-4","kind":"lyric","text":"You always wind up here in a puddle of tears","columns":44,"beats":6,"changes":[{"symbol":"Fm","column":1,"beat":0},{"symbol":"D#","column":20,"beat":2},{"symbol":"G#","column":41,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Them boys are out and they're angry and they're lookin' for blood","columns":65,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-6","kind":"lyric","text":"In the back of a blue old pick up truck","columns":39,"beats":4,"changes":[{"symbol":"C#5","column":1,"beat":0}]},{"id":"line-7","kind":"lyric","text":"You've got nowhere to go although you're all gussied up","columns":55,"beats":6,"changes":[{"symbol":"Fm","column":1,"beat":0},{"symbol":"D#","column":26,"beat":2},{"symbol":"G#","column":47,"beat":4}]},{"id":"line-8","kind":"lyric","text":"There's so much whiskey in his Coke it'll make her nose bend","columns":60,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-9","kind":"lyric","text":"But she swears that his love is a damn God send","columns":47,"beats":4,"changes":[{"symbol":"C#5","column":1,"beat":0}]},{"id":"line-10","kind":"lyric","text":"She's known God since she was a child","columns":37,"beats":6,"changes":[{"symbol":"Fm","column":1,"beat":0},{"symbol":"D#","column":17,"beat":2},{"symbol":"G#","column":34,"beat":4}]},{"id":"line-11","kind":"lyric","text":"She used to play in the yard and she would dream of one day","columns":59,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-12","kind":"lyric","text":"'Til the world came around and took her dreaming away","columns":53,"beats":4,"changes":[{"symbol":"C#5","column":1,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Told her how to dress and act and smile","columns":39,"beats":6,"changes":[{"symbol":"Fm","column":1,"beat":0},{"symbol":"D#","column":17,"beat":2},{"symbol":"G#","column":36,"beat":4}]},{"id":"line-14","kind":"lyric","text":"She's an Oklahoma Smokeshow","columns":27,"beats":4,"changes":[{"symbol":"C#","column":1,"beat":0}]},{"id":"line-15","kind":"lyric","text":"He's an asshole from back home","columns":30,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-16","kind":"lyric","text":"She'll never make it out alive","columns":30,"beats":4,"changes":[{"symbol":"D#","column":1,"beat":0},{"symbol":"Fm","column":27,"beat":2}]},{"id":"line-17","kind":"lyric","text":"That small town bar scene","columns":25,"beats":4,"changes":[{"symbol":"C#","column":1,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Where small vices kill your big dreams","columns":38,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-19","kind":"lyric","text":"He'd take you home but he's too drunk to drive","columns":46,"beats":4,"changes":[{"symbol":"D#","column":1,"beat":0},{"symbol":"Fm","column":43,"beat":2}]},{"id":"line-20","kind":"lyric","text":"I've been here, I've been up all night","columns":38,"beats":4,"changes":[{"symbol":"C#","column":1,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Thinkin' 'bout a life with you and I","columns":36,"beats":4,"changes":[{"symbol":"G#","column":3,"beat":0}]},{"id":"line-22","kind":"lyric","text":"One you'll never know","columns":21,"beats":4,"changes":[{"symbol":"D#","column":1,"beat":0}]},{"id":"line-23","kind":"lyric","text":"'Cause you're a small town smokeshow","columns":36,"beats":4,"changes":[{"symbol":"Fm","column":27,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Well, I've been here, I've been up all night","columns":44,"beats":4,"changes":[{"symbol":"C#","column":1,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Thinkin' 'bout a life with you and I","columns":36,"beats":4,"changes":[{"symbol":"G#","column":3,"beat":0}]},{"id":"line-26","kind":"lyric","text":"One you'll never know","columns":21,"beats":4,"changes":[{"symbol":"D#","column":1,"beat":0}]},{"id":"line-27","kind":"lyric","text":"'Cause you're a small town smokeshow","columns":36,"beats":4,"changes":[{"symbol":"Fm","column":28,"beat":0}]},{"id":"line-28","kind":"instrumental","text":"(                )","columns":18,"beats":4,"changes":[{"symbol":"C#","column":2,"beat":0},{"symbol":"G#","column":6,"beat":1},{"symbol":"D#","column":10,"beat":2},{"symbol":"Fm","column":14,"beat":3}]},{"id":"line-29","kind":"lyric","text":"Go on and put on that dress that all the bad boys like","columns":54,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0}]},{"id":"line-30","kind":"lyric","text":"I know your daddy ain't home so ride with me tonight","columns":52,"beats":4,