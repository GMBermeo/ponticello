ic","text":"Left the phone a little bitter but it's cool for now","columns":52,"beats":4,"changes":[{"symbol":"G","column":9,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Far from perfect for each other but we're working it out","columns":56,"beats":4,"changes":[{"symbol":"D","column":9,"beat":0},{"symbol":"A","column":42,"beat":2}]},{"id":"line-9","kind":"lyric","text":"I suppose (I suppose)","columns":21,"beats":4,"changes":[{"symbol":"G","column":6,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Now I'm waiting at the diner looking traumatized","columns":48,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"A","column":37,"beat":2}]},{"id":"line-11","kind":"lyric","text":"'Cause you walk up to the table with an order of fries","columns":54,"beats":4,"changes":[{"symbol":"G","column":11,"beat":0}]},{"id":"line-12","kind":"lyric","text":"And I know you","columns":14,"beats":4,"changes":[{"symbol":"D","column":6,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Yes, I know you","columns":15,"beats":4,"changes":[{"symbol":"A","column":7,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Used to love you (Used to love you)","columns":35,"beats":4,"changes":[{"symbol":"G","column":8,"beat":0}]},{"id":"line-15","kind":"lyric","text":"And I said","columns":10,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"\"I'm sorry I'm here for someone else","columns":36,"beats":6,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"A","column":15,"beat":2},{"symbol":"G","column":32,"beat":4}]},{"id":"line-17","kind":"lyric","text":"It's good to see your face","columns":26,"beats":4,"changes":[{"symbol":"D","column":22,"beat":0}]},{"id":"line-18","kind":"lyric","text":"And I really hope you're doing well","columns":35,"beats":4,"changes":[{"symbol":"A","column":13,"beat":0},{"symbol":"G","column":31,"beat":2}]},{"id":"line-19","kind":"lyric","text":"I hope you're doing well","columns":24,"beats":4,"changes":[{"symbol":"D","column":20,"beat":0