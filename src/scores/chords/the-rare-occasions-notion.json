{"version":1,"id":"the-rare-occasions-notion","title":"Notion","artist":"The Rare Occasions","key":"F#m","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/the-rare-occasions/notion/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Brian McLaughlin, Luke Imbusch and Jeremy Cohen","chords":[{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"C#m","canonical":"C#m","keyboardPitchClasses":[1,4,8],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"D°","canonical":"Ddim7","keyboardPitchClasses":[2,5,8,11],"interpretation":"Keyboard interpretation: Ddim7"},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Bm7","canonical":"Bm7","keyboardPitchClasses":[11,2,6,9],"interpretation":null},{"symbol":"F#m7","canonical":"F#m7","keyboardPitchClasses":[6,9,1,4],"interpretation":null},{"symbol":"F7M(5+)","canonical":"Fmaj7#5","keyboardPitchClasses":[5,9,1,4],"interpretation":"Keyboard interpretation: Fmaj7#5"},{"symbol":"D7M/A","canonical":"Dmaj7/A","keyboardPitchClasses":[9,1,2,6],"interpretation":"Keyboard interpretation: Dmaj7/A"},{"symbol":"F7M/C","canonical":"Fmaj7/C","keyboardPitchClasses":[0,4,5,9],"interpretation":"Keyboard interpretation: Fmaj7/C"},{"symbol":"A7M/E","canonical":"Amaj7/E","keyboardPitchClasses":[4,8,9,1],"interpretation":"Keyboard interpretation: Amaj7/E"},{"symbol":"A6/E","canonical":"A6/E","keyboardPitchClasses":[4,6,9,1],"interpretation":null},{"symbol":"C#m7","canonical":"C#m7","keyboardPitchClasses":[1,4,8,11],"interpretation":null},{"symbol":"D7M","canonical":"Dmaj7","keyboardPitchClasses":[2,6,9,1],"interpretation":"Keyboard interpretation: Dmaj7"},{"symbol":"F#m/A","canonical":"F#m/A","keyboardPitchClasses":[9,1,6],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":26,"beats":10,"changes":[{"symbol":"A","column":8,"beat":0},{"symbol":"C#m","column":11,"beat":2},{"symbol":"F#m","column":16,"beat":4},{"symbol":"D°","column":21,"beat":6},{"symbol":"F","column":25,"beat":8}]},{"id":"line-2","kind":"lyric","text":"By helping UG you make the world better... and earn IQ","columns":54,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"Sure it’s a calming notion, perpetual in motion","columns":47,"beats":4,"changes":[{"symbol":"Bm7","column":12,"beat":0},{"symbol":"F#m7","column":32,"beat":2}]},{"id":"line-4","kind":"lyric","text":"But I don’t need the comfort of any lies","columns":41,"beats":4,"changes":[{"symbol":"Bm7","column":12,"beat":0},{"symbol":"F#m7","column":37,"beat":2}]},{"id":"line-5","kind":"lyric","text":"For I have seen the ending and there is no ascending rise","columns":65,"beats":8,"changes":[{"symbol":"Bm7","column":11,"beat":0},{"symbol":"F#m7","column":41,"beat":2},{"symbol":"A","column":54,"beat":4},{"symbol":"F7M(5+)","column":58,"beat":6}]},{"id":"line-6","kind":"lyric","text":"Oh back when I was younger, was told by other youngsters","columns":56,"beats":4,"changes":[{"symbol":"Bm7","column":13,"beat":0},{"symbol":"F#m7","column":41,"beat":2}]},{"id":"line-7","kind":"lyric","text":"That my end will be torture beneath the earth","columns":45,"beats":4,"changes":[{"symbol":"Bm7","column":12,"beat":0},{"symbol":"F#m7","column":41,"beat":2}]},{"id":"line-8","kind":"lyric","text":"‘Cuz I don’t see what they see when death is staring at me","columns":58,"beats":4,"changes":[{"symbol":"Bm7","column":13,"beat":0},{"symbol":"F#m7","column":46,"beat":2}]},{"id":"line-9","kind":"lyric","text":"I see a window, a limit, to live it, or not at all","columns":54,"beats":4,"changes":[{"symbol":"Bm7","column":8,"beat":0},{"symbol":"F7M(5+)","column":47,"beat":2}]},{"id":"line-10","kind":"instrumental","text":"(                           )","columns":29,"beats":8,"changes":[{"symbol":"D7M/A","column":2,"beat":0},{"symbol":"F7M/C","column":9,"beat":2},{"symbol":"A7M/E","column":16,"beat":4},{"symbol":"A6/E","column":23,"beat":6}]},{"id":"line-11","kind":"instrumental","text":"(                       )","columns":25,"beats":8,"changes":[{"symbol":"Bm7","column":2,"beat":0},{"symbol":"C#m7","column":7,"beat":2},{"symbol":"D7M","column":13,"beat":4},{"symbol":"F7M/C","column":18,"beat":6}]},{"id":"line-12","kind":"lyric","text":"If you could pull the lever to carry on forever","columns":47,"beats":4,"changes":[{"symbol":"Bm7","column":13,"beat":0},{"symbol":"F#m7","column":38,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Would your life even matter anymore?","columns":36,"beats":4,"changes":[{"symbol":"Bm7","column":16,"beat":0},{"symbol":"F#m7","column":31,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Sure it’s a calming notion, perpetual in motion","columns":47,"beats":4,"changes":[{"symbol":"Bm7","column":12,"beat":0},{"symbol":"F#m7","column":35,"beat":2}]},{"id":"line-15","kind":"lyric","text":"But it’s not what you signed up for","columns":40,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0},{"symbol":"F7M(5+)","column":33,"beat":2}]},{"id":"line-16","kind":"instrumental","text":"(                         )","columns":27,"beats":8,"changes":[{"symbol":"A","column":2,"beat":0},{"symbol":"F7M(5+)","column":5,"beat":2},{"symbol":"F#m","column":14,"beat":4},{"symbol":"F7M(5+)","column":19,"beat":6}]},{"id":"line-17","kind":"instrumental","text":"(                         )","columns":27,"beats":8,"changes":[{"symbol":"A","column":2,"beat":0},{"symbol":"F7M(5+)","column":5,"beat":2},{"symbol":"F#m","column":14,"beat":4},{"symbol":"F7M(5+)","column":19,"beat":6}]},{"id":"line-18","kind":"lyric","text":"I’m sure there won’t always be sunshine","columns":44,"beats":8,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F7M(5+)","column":15,"beat":2},{"symbol":"F#m/A","column":29,"beat":4},{"symbol":"F7M(5+)","column":37,"beat":6}]},{"id":"line-19","kind":"lyric","text":"But there’s this momentary beam of light","columns":45,"beats":8,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F7M(5+)","column":15,"beat":2},{"symbol":"F#m/A","column":29,"beat":4},{"symbol":"F7M(5+)","column":38,"beat":6}]},{"id":"line-20","kind":"lyric","text":"You don’t have to wait those salty decades","columns":42,"beats":8,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F7M(5+)","column":29,"beat":4}]},{"id":"line-21","kind":"lyric","text":"To get through the gate it’s all in front of your face","columns":54,"beats":4,"changes":[{"symbol":"F#m/A","column":3,"beat":0},{"symbol":"F7M(5+)","column":33,"beat":2}]},{"id":"line-22","kind":"lyric","text":"I’m sure there won’t always be sunshine","columns":44,"beats":8,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F7M(5+)","column":15,"beat":2},{"symbol":"F#m/A","column":29,"beat":4},{"symbol":"F7M(5+)","column":37,"beat":6}]},{"id":"line-23","kind":"lyric","text":"I’m sure there won’t always be sunshine","columns":42,"beats":8,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F7M(5+)","column":14,"beat":2},{"symbol":"D7M","column":35,"beat":4},{"symbol":"Dm","column":40,"beat":6}]},{"id":"line-24","kind":"lyric","text":"But there’s this momentary beam of light","columns":40,"beats":8,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F7M(5+)","column":16,"beat":2},{"symbol":"D7M","column":28,"beat":4},{"symbol":"Dm","column":37,"beat":6}]},{"id":"line-25","kind":"lyric","text":"I could cross the ocean in a fit of devotion","columns":44,"beats":4,"changes":[{"symbol":"A","column":8,"beat":0},{"symbol":"Bm7","column":33,"beat":2}]},{"id":"line-26","kind":"lyric","text":"For every shining second this fragile body beckons","columns":50,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0},{"symbol":"Bm7","column":38,"beat":2}]},{"id":"line-27","kind":"lyric","text":"You think you’re owed it better believing ancient letters","columns":57,"beats":4,"changes":[{"symbol":"A","column":17,"beat":0},{"symbol":"Bm7","column":42,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Sure it’s a calming notion but it’s a lie","columns":41,"beats":4,"changes":[{"symbol":"A","column":12,"beat":0},{"symbol":"Bm7","column":31,"beat":2}]}]}