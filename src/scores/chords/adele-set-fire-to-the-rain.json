{"version":1,"id":"adele-set-fire-to-the-rain","title":"Set Fire To The Rain","artist":"Adele","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/adele/set-fire-to-the-rain/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Smith Fraser Lance Thorneycroft, Adele and Fraser Thorneycroft-Smith","chords":[{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Dm7","canonical":"Dm7","keyboardPitchClasses":[2,5,9,0],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"Am7","canonical":"Am7","keyboardPitchClasses":[9,0,4,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"Intro:","columns":16,"beats":8,"changes":[{"symbol":"Dm","column":7,"beat":0},{"symbol":"F","column":10,"beat":2},{"symbol":"C","column":12,"beat":4},{"symbol":"Gm","column":14,"beat":6}]},{"id":"line-2","kind":"lyric","text":"I let it fall, my heart","columns":23,"beats":4,"changes":[{"symbol":"Dm","column":10,"beat":0},{"symbol":"F","column":19,"beat":2}]},{"id":"line-3","kind":"lyric","text":"And as it fell, you rose to claim it","columns":36,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0},{"symbol":"Gm","column":30,"beat":2}]},{"id":"line-4","kind":"lyric","text":"It was dark and I was over","columns":26,"beats":4,"changes":[{"symbol":"Dm","column":8,"beat":0},{"symbol":"F","column":22,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Until you kissed my lips and you saved me","columns":41,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0}]},{"id":"line-6","kind":"lyric","text":"My hands they're strong","columns":23,"beats":4,"changes":[{"symbol":"Dm","column":4,"beat":0},{"symbol":"F","column":20,"beat":2}]},{"id":"line-7","kind":"lyric","text":"But my knees were far too weak","columns":30,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0},{"symbol":"Gm","column":27,"beat":2}]},{"id":"line-8","kind":"lyric","text":"To stand in your arms","columns":21,"beats":4,"changes":[{"symbol":"Dm","column":5,"beat":0},{"symbol":"F","column":17,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Without falling into your feet","columns":30,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0}]},{"id":"line-10","kind":"section","text":"Pré-Refrão:","columns":11,"beats":0,"changes":[]},{"id":"line-11","kind":"lyric","text":"But there´s a side, to you, that I never knew, never knew","columns":57,"beats":4,"changes":[{"symbol":"A#","column":15,"beat":0},{"symbol":"Gm","column":37,"beat":2}]},{"id":"line-12","kind":"lyric","text":"All the things you'd say, they where never true, never true","columns":59,"beats":4,"changes":[{"symbol":"Dm7","column":10,"beat":0}]},{"id":"line-13","kind":"lyric","text":"And the games you'd play, you would always, always win","columns":54,"beats":4,"changes":[{"symbol":"A#","column":9,"beat":0},{"symbol":"C","column":28,"beat":2}]},{"id":"line-14","kind":"section","text":"Refrão:","columns":7,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"But I set fire to the rain","columns":26,"beats":4,"changes":[{"symbol":"Dm7","column":11,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Watched it pour as I touched your face","columns":38,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Well, it burned while I cried","columns":29,"beats":4,"changes":[{"symbol":"Gm","column":10,"beat":0}]},{"id":"line-18","kind":"lyric","text":"'Cause I heard it screaming out your name, your name!","columns":53,"beats":4,"changes":[{"symbol":"Dm7","column":33,"beat":0},{"symbol":"C","column":50,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Verso 2 - dedilhado:","columns":20,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"When I lay, with you","columns":20,"beats":4,"changes":[{"symbol":"Dm","column":5,"beat":0},{"symbol":"F","column":15,"beat":2}]},{"id":"line-21","kind":"lyric","text":"I could stay there,  close my eyes","columns":34,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"Gm","column":23,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Feel you here forever","columns":21,"beats":4,"changes":[{"symbol":"Dm","column":10,"beat":0},{"symbol":"F","column":17,"beat":2}]},{"id":"line-23","kind":"lyric","text":"You and me together, nothing is better!","columns":39,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0}]},{"id":"line-24","kind":"section","text":"Pré-Refrão:","columns":11,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"Cause there´s a side to you that I never knew, never knew","columns":57,"beats":4,"changes":[{"symbol":"A#","column":17,"beat":0},{"symbol":"Gm","column":37,"beat":2}]},{"id":"line-26","kind":"lyric","text":"All the things you'd say, they where never true, never true","columns":59,"beats":4,"changes":[{"symbol":"Dm","column":10,"beat":0}]},{"id":"line-27","kind":"lyric","text":"And the games you'd play, you would always, always win","columns":54,"beats":4,"changes":[{"symbol":"A#","column":9,"beat":0},{"symbol":"C","column":37,"beat":2}]},{"id":"line-28","kind":"section","text":"Refrão:","columns":7,"beats":0,"changes":[]},{"id":"line-29","kind":"lyric","text":"But I set fire to the rain","columns":26,"beats":4,"changes":[{"symbol":"Dm7","column":11,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Watched it pour as I touched your face","columns":38,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Well, it burned while I cried","columns":29,"beats":4,"changes":[{"symbol":"Gm","column":10,"beat":0}]},{"id":"line-32","kind":"lyric","text":"'Cause I heard it screaming out your name, your name!","columns":53,"beats":4,"changes":[{"symbol":"Dm7","column":33,"beat":0},{"symbol":"C","column":50,"beat":2}]},{"id":"line-33","kind":"lyric","text":"I set fire to the rain","columns":22,"beats":4,"changes":[{"symbol":"Dm7","column":7,"beat":0}]},{"id":"line-34","kind":"lyric","text":"And I threw us into the flames","columns":30,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Well, it felt something died","columns":28,"beats":4,"changes":[{"symbol":"Gm","column":10,"beat":0}]},{"id":"line-36","kind":"lyric","text":"Cause I knew do that was the last time, the last time!","columns":54,"beats":4,"changes":[{"symbol":"Dm","column":30,"beat":0},{"symbol":"C","column":50,"beat":2}]},{"id":"line-37","kind":"section","text":"Ponte:","columns":6,"beats":0,"changes":[]},{"id":"line-38","kind":"lyric","text":"Sometimes I wake up by the door,","columns":32,"beats":4,"changes":[{"symbol":"A#","column":10,"beat":0},{"symbol":"Am","column":29,"beat":2}]},{"id":"line-39","kind":"lyric","text":"That heart you caught must be waiting for you,","columns":46,"beats":4,"changes":[{"symbol":"Am7","column":16,"beat":0},{"symbol":"Gm","column":39,"beat":2}]},{"id":"line-40","kind":"lyric","text":"Even now when we´re already over,","columns":33,"beats":4,"changes":[{"symbol":"A#","column":6,"beat":0},{"symbol":"Am","column":30,"beat":2}]},{"id":"line-41","kind":"lyric","text":"I can´t help myself from looking for you","columns":40,"beats":4,"changes":[{"symbol":"Am7","column":9,"beat":0},{"symbol":"Gm","column":34,"beat":2}]},{"id":"line-42","kind":"section","text":"Refrão:","columns":7,"beats":0,"changes":[]},{"id":"line-43","kind":"lyric","text":"I set fire to the rain","columns":22,"beats":4,"changes":[{"symbol":"Dm7","column":7,"beat":0}]},{"id":"line-44","kind":"lyric","te