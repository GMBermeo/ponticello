{"version":1,"id":"zach-bryan-burn-burn-burn","title":"Burn, Burn, Burn","artist":"Zach Bryan","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/zach-bryan/burn-burn-burn/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Zach Bryan","chords":[{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Everyone seems a damn genius lately","columns":35,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Tik-tok talking, late-night TV","columns":30,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"Still so much I have yet to know","columns":32,"beats":6,"changes":[{"symbol":"Cm","column":1,"beat":0},{"symbol":"A#","column":17,"beat":2},{"symbol":"D#","column":30,"beat":4}]},{"id":"line-4","kind":"lyric","text":"We get dressed up just to go downtown","columns":37,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"In some ego-filled late night crowd","columns":35,"beats":4,"changes":[]},{"id":"line-6","kind":"lyric","text":"It seems it's where I feel most alone","columns":38,"beats":3,"changes":[{"symbol":"Cm","column":4,"beat":0},{"symbol":"A#","column":24,"beat":1},{"symbol":"D#","column":36,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I'd like to get lost on some old back road","columns":42,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Find a shade tree and a honey hole","columns":34,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"And talk to my grandpa again","columns":28,"beats":6,"changes":[{"symbol":"Cm","column":5,"beat":0},{"symbol":"A#","column":18,"beat":2},{"symbol":"D#","column":26,"beat":4}]},{"id":"line-10","kind":"lyric","text":"And I see God in everything","columns":27,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0}]},{"id":"line-11","kind":"lyric","text":"The trees and pain and nights in the spring","columns":43,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"So why do I still long for a home?","columns":34,"beats":6,"changes":[{"symbol":"Cm","column":4,"beat":0},{"symbol":"A#","column":14,"beat":2},{"symbol":"D#","column":32,"beat":4}]},{"id":"line-13","kind":"lyric","text":"I'd like to lay in a field on a cozy blanket","columns":44,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-14","kind":"lyric","text":"And feel the fear of never wakin'","columns":33,"beats":4,"changes":[]},{"id":"line-15","kind":"lyric","text":"To know the true warmth of the sun","columns":35,"beats":6,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":20,"beat":2},{"symbol":"D#","column":33,"beat":4}]},{"id":"line-16","kind":"lyric","text":"I'd like to love my lady long and hard","columns":38,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"And lay down lines of laymen guitar","columns":35,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Never leave her loving arms again","columns":33,"beats":6,"changes":[{"symbol":"Cm","column":1,"beat":0},{"symbol":"A#","column":18,"beat":2},{"symbol":"D#","column":31,"beat":4}]},{"id":"line-19","kind":"lyric","text":"My exes hate me and my friends all miss me","columns":42,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"I wanna drown in a rot gut whiskey","columns":34,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"Leave this small town for awhile","columns":32,"beats":6,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":19,"beat":2},{"symbol":"D#","column":30,"beat":4}]},{"id":"line-22","kind":"lyric","text":"Heading to Paris on a late-night flight","columns":39,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Find a bar and get in a fight","columns":29,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"Write a few poems on a sunny balcony","columns":37,"beats":3,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":24,"beat":1},{"symbol":"D#","column":35,"beat":2}]},{"id":"line-25","kind":"lyric","text":"I wanna be a child climbing trees somewhere","columns":43,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Breathing in the fresh outside air","columns":34,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"And before I knew this life was unkind","columns":38,"beats":3,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":24,"beat":1},{"symbol":"D#","column":36,"beat":2}]},{"id":"line-28","kind":"lyric","text":"I want a well-trained dog on a couple of acres","columns":46,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-29","kind":"lyric","text":"A kind, kind lady and a place to take her","columns":41,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"Few good friends I can count on one of my hands","columns":47,"beats":3,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":26,"beat":1},{"symbol":"D#","column":45,"beat":2}]},{"id":"line-31","kind":"lyric","text":"I know I'm bound to die one day","columns":31,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"So when I reach those golden gates","columns":34,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"I pray to say I did the best I can","columns":35,"beats":6,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":17,"beat":2},{"symbol":"D#","column":33,"beat":4}]},{"id":"line-34","kind":"lyric","text":"Sit with my mother and the dearly departed","columns":42,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Send a prayer down to the broken-hearted","columns":40,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"Let 'em know it all turns out just fine","columns":39,"beats":6,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":19,"beat":2},{"symbol":"D#","column":37,"beat":4}]},{"id":"line-37","kind":"lyric","text":"To know me is to love me and to hate me is to wrong me","columns":54,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-38","kind":"lyric","text":"I prefer my nights so lonely","columns":28,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"Love blues guitar, muscle cars, and gin","columns":40,"beats":3,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":22,"beat":1},{"symbol":"D#","column":38,"beat":2}]},{"id":"line-40","kind":"lyric","text":"I'm a simple man, I don't need much","columns":35,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0}]},{"id":"line-41","kind":"lyric","text":"Just my simple songs and some human touch","columns":41,"beats":4,"changes":[]},{"id":"line-42","kind":"lyric","text":"I'm tired now, so I'm bringin' my ass home","columns":42,"beats":5,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"A#","column":25,"beat":1},{"symbol":"D#","column":40,"beat":4}]},{"id":"line-43","kind":"lyric","text":"So let me go down the line","columns":26,"beats":6,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"G#","column":11,"beat":2},{"symbol":"D#","column":24,"beat":4}]},{"id":"line-44","kind":"lyric","text":"Let me feel it all","columns":18,"beats":4,"changes":[{"symbol":"A#","column":16,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Joy, pain, and sky","columns":18,"beats":2,"changes":[{"symb