{"version":1,"id":"lil-peep-star-shopping","title":"Star Shopping","artist":"Lil Peep","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/lil-peep/star-shopping/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Yppah, Lil Peep and Cabe Dixon Ii Brown","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Intro]","columns":7,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"Wait right here, I'll be back in the morning","columns":47,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":17,"beat":2},{"symbol":"A","column":46,"beat":4}]},{"id":"line-3","kind":"lyric","text":"I know that I'm not that important to you but to me girl, you're","columns":64,"beats":4,"changes":[{"symbol":"Bm","column":39,"beat":0},{"symbol":"A","column":60,"beat":2}]},{"id":"line-4","kind":"lyric","text":"So much more than gorgeous","columns":26,"beats":4,"changes":[{"symbol":"G","column":25,"beat":0}]},{"id":"line-5","kind":"lyric","text":"So much more than perfect","columns":26,"beats":4,"changes":[{"symbol":"Bm","column":24,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Right now I know that I'm not really worth it","columns":45,"beats":2,"changes":[{"symbol":"A","column":36,"beat":0}]},{"id":"line-7","kind":"lyric","text":"If you give me time I can work on it","columns":38,"beats":2,"changes":[{"symbol":"Bm","column":36,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Give me some time while I work on it","columns":36,"beats":4,"changes":[{"symbol":"A","column":14,"beat":0},{"symbol":"G","column":32,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Losing your patience