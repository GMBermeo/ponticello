{"version":1,"id":"sienna-spiro-great-expectation","title":"Great Expectation","artist":"SIENNA SPIRO","key":"Dm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/sienna-spiro/great-expectation/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Michael Pollack, Omer Fedi and Sienna Spiro","chords":[{"symbol":"D#m","canonical":"D#m","keyboardPitchClasses":[3,6,10],"interpretation":null},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"B","canonical":"B","keyboardPitchClasses":[11,3,6],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"A#7","canonical":"A#7","keyboardPitchClasses":[10,2,5,8],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"In my head, you lay down next to me","columns":35,"beats":4,"changes":[{"symbol":"D#m","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Kiss my lips, hold me carefully","columns":31,"beats":4,"changes":[{"symbol":"C#","column":0,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Say goodbye and feel all the withdrawals","columns":40,"beats":2,"changes":[{"symbol":"B","column":0,"beat":0},{"symbol":"C#","column":27,"beat":1}]},{"id":"line-4","kind":"lyric","text":"But it's not the same, in reality","columns":33,"beats":6,"changes":[{"symbol":"D#m","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"I say your name, but you don't get back to me","columns":45,"beats":4,"changes":[{"symbol":"C#","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Till you got something you need me for","columns":38,"beats":4,"changes":[{"symbol":"B","column":0,"beat":0},{"symbol":"C#","column":31,"beat":2}]},{"id":"line-7","kind":"lyric","text":"So I sing just to know I'm alive","columns":32,"beats":1,"changes":[{"symbol":"B","column":5,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And I cried all the tears I could cry","columns":37,"beats":2,"changes":[{"symbol":"F#","column":6,"beat":0}]},{"id":"line-9","kind":"lyric","text":"If happiness is just an illusion","columns":32,"beats":4,"changes":[{"symbol":"A#7","column":3,"beat":0}]},{"id":"line-10","kind":"lyric","text":"You were the best I ever had","columns":28,"beats":4,"changes":[{"symbol":"D#m","column":13,"beat":0},{"symbol":"C#","column":26,"beat":2}]},{"id":"line-11","kind":"lyric","text":"If you can't be what I want","columns":27,"beats":4,"changes":[{"symbol":"B","column":3,"beat":0}]},{"id":"line-12","kind":"lyric","text":"And the things you say aren't true","columns":34,"beats":4,"changes":[{"symbol":"F#","column":8,"beat":0}]},{"id":"line-13","kind":"lyric","text":"All I need is the great expectation of you","columns":42,"beats":6,"changes":[{"symbol":"A#7","column":1,"beat":0},{"symbol":"D#m","column":25,"beat":2},{"symbol":"C#","column":38,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Expectation of you","columns":18,"beats":4,"changes":[{"symbol":"B","column":0,"beat":0}]},{"id":"line-15","kind":"lyric","text":"The tracks of my tears go back for years","columns":40,"beats":4,"changes":[{"symbol":"D#m","column":5,"beat":0}]},{"id":"line-16","kind":"lyric","text":"When I was young, I've always had the fears","columns":43,"beats":4,"changes":[{"symbol":"C#","column":5,"beat":0}]},{"id":"line-17","kind":"lyric","text":"One would leave","columns":15,"beats":4,"changes":[{"symbol":"B","column":0,"beat":0}]},{"id":"line-18","kind":"lyric","text":"So I held on so long (so long, so long)","columns":39,"beats":4,"changes":[{"symbol":"C#","column":16,"beat":0}]},{"id":"line-19","kind":"lyric","text":"But to each their own, you come and go a lot","columns":44,"beats":2,"changes":[{"symbol":"D#m","column":7,"beat":0}]},{"id":"line-20","kind":"lyric","text":"It's black and white, but I go back and change the plot","columns":55,"beats":4,"changes":[{"symbol":"C#","column":7,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Just to have ya in the way I want","columns":33,"beats":4,"changes":[{"symbol":"B","column":0,"beat":0},{"symbol":"C#","column":26,"beat":2}]},{"id":"line-22","kind":"lyric","text":"So I sing just to know I'm alive (I sing so long)","columns":49,"beats":4,"changes":[{"symbol":"B","column":4,"beat":0}]},{"id":"line-23","kind":"lyric","text":"And I cried all the tears I could cry (I cried for you)","columns":55,"beats":4,"changes":[{"symbol":"F#","column":7,"beat":0}]},{"id":"line-24","kind":"lyric","text":"If happiness is just an illusion","columns":32,"beats":4,"changes":[{"symbol":"A#7","column":4,"beat":0}]},{"id":"line-25","kind":"lyric","text":"You were the best I ever had","columns":28,"beats":4,"changes":[{"symbol":"D#m","column":13,"beat":0},{"symbol":"C#","column":26,"beat":2}]},{"id":"line-26","kind":"lyric","text":"If you can't be what I want (be what I want)","columns":44,"beats":4,"changes":[{"symbol":"B","column":4,"beat":0}]},{"id":"line-27","kind":"lyric","text":"And the things you say aren't true (not true, not true)","columns":55,"beats":4,"changes":[{"symbol":"F#","column":8,"beat":0}]},{"id":"line-28","kind":"lyric","text":"All I need is the great expectation of you, oh","columns":46,"beats":6,"changes":[{"symbol":"A#7","column":1,"beat":0},{"symbol":"D#m","column":25,"beat":2},{"symbol":"C#","column":41,"beat":4}]},{"id":"line-29","kind":"lyric","text":"Cry my tears and let 'em dry (mm, expectation of you)","columns":53,"beats":4,"changes":[{"symbol":"B","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Cry my tears and testify","columns":24,"beats":4,"changes":[{"symbol":"F#","column":1,"beat":0}]},{"id":"line-31","kind":"lyric","text":"You exist inside my mind","columns":24,"beats":4,"changes":[{"symbol":"A#7","column":1,"beat":0}]},{"id":"line-32","kind":"lyric","text":"You, so","columns":9,"beats":4,"changes":[{"symbol":"D#m","column":0,"beat":0},{"symbol":"C#","column":7,"beat":1}]},{"id":"line-33","kind":"lyric","text":"So I sing just to know I'm alive","columns":32,"beats":4,"changes":[{"symbol":"B","column":5,"beat":0}]},{"id":"line-34","kind":"lyric","text":"And I cried all the tears I could cry (I cried for you)","columns":55,"beats":4,"changes":[{"symbol":"F#","column":6,"beat":0}]},{"id":"line-35","kind":"lyric","text":"If happiness is just an illusion","columns":32,"beats":4,"changes":[{"symbol":"A#7","column":3,"beat":0}]},{"id":"line-36","kind":"lyric","text":"You were the best I ever had (best I had)","columns":41,"beats":4,"changes":[{"symbol":"D#m","column":13,"beat":0},{"symbol":"C#","column":26,"beat":2}]},{"id":"line-37","kind":"lyric","text":"If you can't be what I want (be what I want)","columns":44,"beats":2,"changes":[{"symbol":"B","column":3,"beat":0}]},{"id":"line-38","kind":"lyric","text":"And the things you say aren't true (not true, not true)","columns":55,"beats":4,"changes":[{"symbol":"F#","column":8,"beat":0}]},{"id":"line-39","kind":"lyric","text":"All I need is the great expectation of you","columns":43,"beats":6,"changes":[{"symbol":"A#7","column":0,"beat":0},{"symbol":"D#m","column":25,"beat":2},{"symbol":"C#","column":41,"beat":4}]},{"id":"line-40","kind":"lyric","text":"All I need is","columns":13,"beats":4,"changes":[{"symbol":"B","column":0,"beat":0}]},{"id":"line-41","kind":"lyric","text":"All I need is you","columns":18,"beats":4,"changes":[{"symbol":"A#7","column":0,"beat":0},{"symbol":"D#m","column":15,"beat":2}]}]}