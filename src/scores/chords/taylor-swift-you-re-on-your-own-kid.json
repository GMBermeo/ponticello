symbol":"A/C#","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":" I hear it in your voice, you're smokin' with your boys","columns":55,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-7","kind":"lyric","text":" I touch my phone as if it's your face","columns":38,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":13,"beat":2}]},{"id":"line-8","kind":"lyric","text":" I didn't choose this town, I dream of getting out","columns":50,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":" There's just one who could make me stay","columns":40,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":15,"beat":2},{"symbol":"Bm","column":38,"beat":4}]},{"id":"line-10","kind":"lyric","text":"All my days","columns":11,"beats":4,"changes":[{"symbol":"A/C#","column":0,"beat":0}]},{"id":"line-11","kind":"lyric","text":" From sprinkler splashes to fireplace ashes","columns":43,"beats":6,"changes":[{"symbol":"G2","column":0,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"D","column":38,"beat":4}]},{"id":"line-12","kind":"lyric","text":"I waited ages to see you there","columns":30,"beats":4,"changes":[{"symbol":"Bm7","column":9,"beat":0},{"symbol":"G2","column":25,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I search the party of better bodies","columns":35,"beats":4,"changes":[{"symbol":"A","column":13,"beat":0},{"symbol":"D","column":29,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Just to learn that you never cared","columns":34,"beats":4,"changes":[{"symbol":"Bm7/F#","column":8,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-15","kind":"lyric","text":"You're on your own, kid, you always have been","columns":45,"beats":4,"changes":[{"symbol":"A","column":15,"beat":0},{"symbol":"D","column":41,"beat":2}]},{"id":"line-16","kind":"lyric","text":" I see the great escape, so long, Daisy May","columns":43,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":" I picked the petals, he loves me not","columns":37,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":15,"beat":2}]},{"id":"line-18","kind":"lyric","text":" Something different bloomed, writing in my room","columns":48,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":" I play my songs in the parking lot","columns":35,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":12,"beat":2},{"symbol":"Bm","column":33,"beat":4}]},{"id":"line-20","kind":"lyric","text":"I'll run away","columns":13,"beats":4,"changes":[{"symbol":"A/C#","column":5,"beat":0}]},{"id":"line-21","kind":"lyric","text":" From sprinkler splashes to fireplace ashes","columns":43,"beats":6,"changes":[{"symbol":"G2","column":0,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"D","column":38,"beat":4}]},{"id":"line-22","kind":"lyric","text":"I called a taxi to take me there","columns":32,"beats":4,"changes":[{"symbol":"Bm7","column":11,"beat":0},{"symbol":"G2","column":27,"beat":2}]},{"id":"line-23","kind":"lyric","text":"I search the party of better bodies","columns":35,"beats":4,"changes":[{"symbol":"A","column":13,"beat":0},{"symbol":"D","column":29,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Just to learn that my dreams aren't rare","columns":40,"beats":4,"changes":[{"symbol":"Bm7/F#","column":8,"beat":0},{"symbol":"G2","column":37,"beat":2}]},{"id":"line-25","kind":"lyric","text":"You're on your own, kid, you always have been","columns":45,"beats":4,"changes":[{"symbol":"A","column":15,"beat":0}]},{"id":"line-26","kind":"instrumental","text":"(               )","columns":17,"beats":4,"changes":[{"symbol":"G2","column":2,"beat":0},{"symbol":"A","column":6,"beat":1},{"symbol":"D","column":9,"beat":2},{"symbol":"Bm7","column":12,"beat":3}]},{"id":"line-27","kind":"instrumental","text":"(                  )","columns":20,"beats":8,"changes":[{"symbol":"G2","column":2,"beat":0},{"symbol":"A","column":6,"beat":2},{"symbol":"D","column":9,"beat":4},{"symbol":"Bm7/F#","column":12,"beat":6}]},{"id":"line-28","kind":"instrumental","text":"(       )","columns":9,"beats":4,"changes":[{"symbol":"G2","column":2,"beat":0},{"symbol":"A","column":6,"beat":2}]},{"id":"line-29","kind":"lyric","text":" From sprinkler splashes to fireplace ashes","columns":43,"beats":6,"changes":[{"symbol":"G2","column":0,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"D","column":38,"beat":4}]},{"id":"line-30","kind":"lyric","text":"I gave my blood, sweat and tears for this","columns":41,"beats":4,"changes":[{"symbol":"Bm7","column":10,"beat":0},{"symbol":"G2","column":37,"beat":2}]},{"id":"line-31","kind":"lyric","text":"I hosted parties and starved my body","columns":36,"beats":4,"changes":[{"symbol":"A","column":9,"beat":0},{"symbol":"D","column":32,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Like I'd be saved by a perfect kiss","columns":35,"beats":4,"changes":[{"symbol":"Bm7/F#","column":12,"beat":0},{"symbol":"G2","column":32,"beat":2}]},{"id":"line-33","kind":"lyric","text":"The jokes weren't funny, I took the money","columns":41,"beats":4,"changes":[{"symbol":"A","column":18,"beat":0},{"symbol":"D","column":36,"beat":2}]},{"id":"line-34","kind":"lyric","text":"My friends from home don't know what to say","columns":43,"beats":4,"changes":[{"symbol":"Bm7","column":16,"beat":0},{"symbol":"G2","column":40,"beat":2}]},{"id":"line-35","kind":"lyric","text":"I looked around in a blood-soaked gown","columns":38,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0},{"symbol":"D","column":34,"beat":2}]},{"id":"line-36","kind":"lyric","text":"And I saw something they can't take away","columns":40,"beats":4,"changes":[{"symbol":"Bm7/F#","column":14,"beat":0},{"symbol":"G2","column":38,"beat":2}]},{"id":"line-37","kind":"lyric","text":"'Cause there were pages turned","columns":30,"beats":4,"change