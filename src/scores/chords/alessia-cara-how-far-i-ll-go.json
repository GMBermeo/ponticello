lyric","text":"See the line where the sky meets the sea?","columns":41,"beats":4,"changes":[{"symbol":"E","column":8,"beat":0}]},{"id":"line-16","kind":"lyric","text":"It calls me","columns":11,"beats":4,"changes":[{"symbol":"B","column":4,"beat":0}]},{"id":"line-17","kind":"lyric","text":"And no one knows","columns":16,"beats":4,"changes":[{"symbol":"C#m","column":13,"beat":0}]},{"id":"line-18","kind":"lyric","text":"How far it goes","columns":15,"beats":4,"changes":[{"symbol":"A9","column":11,"beat":0}]},{"id":"line-19","kind":"lyric","text":"If the wind on my sail on the sea","columns":33,"beats":4,"changes":[{"symbol":"E","column":7,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Stays behind me","columns":15,"beats":4,"changes":[{"symbol":"B","column":9,"beat":0}]},{"id":"line-21","kind":"lyric","text":"One day I'll know","columns":17,"beats":4,"changes":[{"symbol":"C#m","column":13,"beat":0}]},{"id":"line-22","kind":"lyric","text":"If I go there's just no telling","columns":31,"beats":4,"changes":[{"symbol":"Am9","column":5,"beat":0}]},{"id":"line-23","kind":"lyric","text":"How far I'll go","columns":15,"beats":4,"changes":[{"symbol":"E","column":13,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Go-oh-oh-oh-oh-oh-oh-oh-oh-oh","columns":29,"beats":4,"changes":[{"symbol":"E","column":1,"beat":0},{"symbol":"B","column":5,"beat":1},{"symbol":"C#m","column":9,"beat":2},{"symbol":"A","column":15,"beat":3}]},{"id":"line-25","kind":"lyric","text":"Go-oh-oh-oh-oh-oh-oh-oh-oh-oh","columns":29,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Go-oh-oh-oh-oh-oh-oh-oh-oh-oh","columns":29,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"Go-oh-oh-oh-oh-oh-oh-oh-oh-oh","columns":29,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"I know everybody on this island","columns":31,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"F#m7","column":25,"beat":2}]},{"id":"line-29","kind":"lyric","text":"Seems so happy on th