{"version":1,"id":"morgan-wallen-wasted-on-you","title":"Wasted On You","artist":"Morgan Wallen","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/morgan-wallen/wasted-on-you/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Morgan Wallen","chords":[{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"A#°","canonical":"A#dim7","keyboardPitchClasses":[10,1,4,7],"interpretation":"Keyboard interpretation: A#dim7"},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":24,"beats":20,"changes":[{"symbol":"A","column":8,"beat":0},{"symbol":"A#°","column":11,"beat":4},{"symbol":"Bm","column":16,"beat":8},{"symbol":"G","column":20,"beat":12},{"symbol":"D","column":23,"beat":16}]},{"id":"line-2","kind":"instrumental","text":"","columns":23,"beats":10,"changes":[{"symbol":"A","column":8,"beat":0},{"symbol":"A#°","column":11,"beat":2},{"symbol":"G","column":16,"beat":4},{"symbol":"D","column":19,"beat":6},{"symbol":"A","column":22,"beat":8}]},{"id":"line-3","kind":"lyric","text":"I don't always wake up in the mornin'","columns":37,"beats":4,"changes":[{"symbol":"Bm","column":4,"beat":0},{"symbol":"G","column":32,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Pour myself a strong one","columns":24,"beats":4,"changes":[{"symbol":"D","column":14,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Ah, but when I get lonely I do","columns":30,"beats":4,"changes":[{"symbol":"A","column":3,"beat":0},{"symbol":"Bm","column":24,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Your memory gets burnin'","columns":24,"beats":4,"changes":[{"symbol":"G","column":15,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Lean back on the bourbon","columns":24,"beats":4,"changes":[{"symbol":"D","column":19,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Sure as hell can't keep leanin' on you","columns":38,"beats":4,"changes":[{"symbol":"A","column":4,"beat":0},{"symbol":"Bm","column":32,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Looks like I'm learnin' the hard way again","columns":42,"beats":4,"changes":[{"symbol":"G","column":16,"beat":0},{"symbol":"D","column":41,"beat":2}]},{"id":"line-10","kind":"lyric","text":"It's all my fault","columns":17,"beats":4,"changes":[{"symbol":"A","column":12,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Yeah, I dropped the ball","columns":24,"beats":4,"changes":[{"symbol":"Bm","column":20,"beat":0}]},{"id":"line-12","kind":"lyric","text":"You're gone and I'm gone three sheets to the wind","columns":49,"beats":4,"changes":[{"symbol":"G","column":9,"beat":0},{"symbol":"D","column":45,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Thinking 'bout all I've wasted on you","columns":37,"beats":4,"changes":[{"symbol":"A","column":14,"beat":0},{"symbol":"Bm","column":34,"beat":2}]},{"id":"line-14","kind":"lyric","text":"All of this time and all of this money","columns":38,"beats":4,"changes":[{"symbol":"G","column":12,"beat":0},{"symbol":"D","column":33,"beat":2}]},{"id":"line-15","kind":"lyric","text":"All of these sorries I don't owe you honey","columns":42,"beats":4,"changes":[{"symbol":"A","column":13,"beat":0},{"symbol":"Bm","column":37,"beat":2}]},{"id":"line-16","kind":"lyric","text":"All of these miles on this Chevy, and prayers in a pew","columns":54,"beats":4,"changes":[{"symbol":"G","column":14,"beat":0},{"symbol":"D","column":40,"beat":2}]},{"id":"line-17","kind":"lyric","text":"All them days I spent wasted on you","columns":42,"beats":6,"changes":[{"symbol":"A","column":5,"beat":0},{"symbol":"Bm","column":32,"beat":2},{"symbol":"G","column":41,"beat":4}]},{"id":"line-