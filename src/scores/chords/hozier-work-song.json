{"version":1,"id":"hozier-work-song","title":"Work Song","artist":"Hozier","key":"Bb","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/hozier/work-song/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Hozier","chords":[{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Boys workin on empty","columns":28,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":26,"beat":2}]},{"id":"line-2","kind":"lyric","text":"Is that the kinda way to face the burning heat?","columns":52,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":50,"beat":2}]},{"id":"line-3","kind":"lyric","text":"I just think about my baby","columns":31,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":29,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I'm so full of love I could barely eat","columns":38,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"There's nothing sweeter than my baby","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":38,"beat":2}]},{"id":"line-6","kind":"lyric","text":"I never want once from the cherry tree","columns":42,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":40,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Cause my baby's sweet as can be","columns":35,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":33,"beat":2}]},{"id":"line-8","kind":"lyric","text":"She give me toothaches just from kissin me","columns":42,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"    When, my, time comes around","columns":31,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":13,"beat":2}]},{"id":"line-10","kind":"lyric","text":"    Lay me gently in the cold dark earth","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":35,"beat":2}]},{"id":"line-11","kind":"lyric","text":"    No grave can hold my body down","columns":34,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":17,"beat":2}]},{"id":"line-12","kind":"lyric","text":"    I'll crawl home to her","columns":26,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-13","kind":"lyric","text":"That's when my baby found me","columns":31,"beats":8,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":29,"beat":4}]},{"id":"line-14","kind":"lyric","text":"I was three days on a drunken sin","columns":37,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":35,"beat":2}]},{"id":"line-15","kind":"lyric","text":"I woke with her walls around me","columns":35,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":33,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Nothin in her room but an empty crib","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":38,"beat":2}]},{"id":"line-17","kind":"lyric","text":"And I was burnin up a fever","columns":32,"beats":8,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":30,"beat":4}]},{"id":"line-18","kind":"lyric","text":"I didn't care much how long I lived","columns":39,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":37,"beat":2}]},{"id":"line-19","kind":"lyric","text":"But I swear I thought I dreamed her","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":38,"beat":2}]},{"id":"line-20","kind":"lyric","text":"She never asked me once about the wrong I did","columns":45,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"    When, my, time comes around","columns":31,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":14,"beat":2}]},{"id":"line-22","kind":"lyric","text":"    Lay me gently in the cold dark earth","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":35,"beat":2}]},{"id":"line-23","kind":"lyric","text":"    No grave can hold my body down","columns":34,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":17,"beat":2}]},{"id":"line-24","kind":"lyric","text":"    I'll crawl home to her","columns":26,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-25","kind":"lyric","text":"My baby never fret none","columns":28,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":26,"beat":2}]},{"id":"line-26","kind":"lyric","text":"About what my hands and my body done","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":38,"beat":2}]},{"id":"line-27","kind":"lyric","text":"If the Lord don't forgive me","columns":32,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":30,"beat":2}]},{"id":"line-28","kind":"lyric","text":"I'd still have my baby and my babe would have me","columns":48,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-29","kind":"lyric","text":"When I was kissing on my baby","columns":33,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":31,"beat":2}]},{"id":"line-30","kind":"lyric","text":"And she put her love down soft and sweet","columns":44,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":42,"beat":2}]},{"id":"line-31","kind":"lyric","text":"In the lowland plot I was free","columns":34,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":32,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Heaven and hell were words to me","columns":32,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-33","kind":"lyric","text":"    When, my, time comes around","columns":31,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":14,"beat":2}]},{"id":"line-34","kind":"lyric","text":"    Lay me gently in the cold dark earth","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":35,"beat":2}]},{"id":"line-35","kind":"lyric","text":"    No grave can hold my body down","columns":34,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":17,"beat":2}]},{"id":"line-36","kind":"lyric","text":"    I'll crawl home to her","columns":26,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]}]}