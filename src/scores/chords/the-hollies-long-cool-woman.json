,"kind":"lyric","text":"        Sitting in a nest of bad men","columns":36,"beats":4,"changes":[{"symbol":"E","column":10,"beat":0}]},{"id":"line-11","kind":"lyric","text":"        Whiskey bottles piling high","columns":35,"beats":6,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"A","column":25,"beat":2},{"symbol":"E","column":32,"beat":4}]},{"id":"line-12","kind":"lyric","text":"        Bootlegging boozer on the West Side","columns":43,"beats":4,"changes":[{"symbol":"E","column":9,"beat":0}]},{"id":"line-13","kind":"lyric","text":"        Full of people who are doing wrong","columns":42,"beats":6,"changes":[{"symbol":"G","column":18,"beat":0},{"symbol":"A","column":32,"beat":2},{"symbol":"E","column":39,"beat":4}]},{"id":"line-14","kind":"lyric","text":"        Just about to call up the D.A. man","columns":42,"beats":4,"changes":[{"symbol":"E","column":9,"beat":0}]},{"id":"line-15","kind":"lyric","text":"        When I heard this woman sing a song","columns":43,"beats":6,"changes":[{"symbol":"G","column":16,"beat":0},{"symbol":"A","column":33,"beat":2},{"symbol":"E","column":40,"beat":4}]},{"id":"line-16","kind":"lyric","text":"        A pair of 45s made me open my eyes","columns":42,"beats":4,"changes":[{"symbol":"A","column":11,"beat":0}]},{"id":"line-17","kind":"lyric","text":"        My temperature started to rise","columns":38,"beats":4,"changes":[{"symbol":"B","column":12,"beat":0}]},{"id":"line-18","kind":"lyric","text":"        She was a long cool woman in a black dress","columns":50,"beats":4,"changes":[{"symbol":"A","column":19,"beat":0}]},{"id":"line-19","kind":"lyric","text":"        Just-a 5'9, beautiful, tall","columns":35,"beats":4,"changes":[{"symbol":"G","column":15,"beat":0},{"symbol":"E","column":32,"beat":2}]},{"id":"line-20","kind":"lyric","text":"        With just one look I was a bad mess","columns":43,"beats":4,"changes":[{"symbol":"A","column":14,"beat":0}]},{"id":"line-21","kind":"lyric","text":"        'Cause that long cool woman had it all","columns":46,"beats":4,"changes":[{"symbol":"G","column":21,"beat":0},{"symbol":"E","column":44,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Break between verses {4X}:","columns":26,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"    1)","columns":6,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"         v   v   v   v     v   v   v   v","columns":40,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"    2,3,4)","columns":10,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"         v   v   v   v     v   v   v   v","columns":40,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"    {Guitar 2 plays mostly muted quarter-notes on low E","columns":55,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"{repeat main riff, 4X, as before}","columns":33,"beats":4,"changes":[]},{"id":"line-29","kind":"section","text":"Verse 2:","columns":8,"beats":0,"changes":[]},{"id":"line-30","kind":"lyric","text":"        I saw her head up the table","columns":35,"beats":4,"changes":[{"symbol":"E","column":8,"beat":0}]},{"id":"line-31","kind":"lyric","text":"        Well, a tall walking big black cat","columns":42,"beats":6,"changes":[{"symbol":"G","column":17,"beat":0},{"symbol":"A","column":30,"beat":2},{"symbol":"E","column":40,"beat":4}]},{"id":"line-32","kind":"lyric","text":"        When Charlie said I hope that you're able boy","columns":53,"beats":4,"changes":[{"symbol":"E","column":15,"beat":0}]},{"id":"line-33","kind":"lyric","text":"        Well, I'm telling you she knows where it's at","columns":53,"beats":6,"changes":[{"symbol":"G","column":19,"beat":0},{"symbol":"A","column":35,"beat":2},{"symbol":"E","column":51,"beat":4}]},{"id":"line-34","kind":"lyric","text":"        Then suddenly we heard the sirens","columns":41,"beats":4,"changes":[{"symbol":"E","column":15,"beat":0}]},{"id":"line-35","kind":"lyric","text":"        And everybody started to run","columns":36,"beats":6,"changes":[{"symbol":"G","column":13,"beat":0},{"symbol":"A","column":24,"beat":2},{"symbol":"E","column":33,"beat":4}]},{"id":"line-36","kind":"lyric","text":"        A-jumping out of doors and tables","columns":41,"beats":4,"changes":[{"symbol":"E","column":12,"beat":0}]},{"id":"line-37","kind":"lyric","text":"        When I heard somebody shooting a gun","columns":44,"beats":6,"changes":[{"symbol":"G","column":17,"beat":0},{"symbol":"A","column":31,"beat":2},{"symbol":"E","column":42,"beat":4}]},{"id":"line-38","kind":"lyric","text":"        Well, the D.A. was pumping my left hand","columns":47,"beats":4,"changes":[{"symbol":"E","column":19,"beat":0}]},{"id":"line-39","kind":"lyric","text":"        And a-she was a-holding my right","columns":40,"beats":6,"changes":[{"symbol":"G","column":15,"beat":0},{"symbol":"A","column":26,"beat":2},{"symbol":"E","column":37,"beat":4}]},{"id":"line-40","kind":"lyric","text":"        Well I told her don't get scared","columns":40,"beats":4,"changes":[{"symbol":"E","column":16,"beat":0}]},{"id":"line-41","kind":"lyric","text":"        'Cause you're gonna be spared","columns":37,"beats":4,"changes":[{"symbol":"G","column":24,"beat":0}]},{"id":"line-42","kind":"lyric","text":"        I've gotta be forgiving if I wanna spend my living","columns":58,"beats":4,"changes":[{"symbol":"A","column":14,"beat":0}]},{"id":"line-43","kind":"lyric","text":"        With a long cool woman in a black dress","columns":47,"beats":2,"changes":[{"symbol":"A","column":16,"beat":0}]},{"id":"line-44","kind":"lyric","text":"        Just a 5'9 beautiful tall","columns":33,"beats":4,"changes":[{"symbol":"G","column":15,"beat":0},{"symbol":"E","column":30,"beat":2}]},{"id":"line-45","kind":"lyric","text":"        Yeah, with just one look I was a bad mess","columns":49,"beats":4,"changes":[{"symbol":"A","column":20,"beat":0}]},{"id":"line-46","kind":"lyric","text":"        'Cause that long cool woman had it all","columns":46,"beats":4,"changes":[{"symbol":"G","column":21,"beat":0},{"symbol":"E","column":44,"beat":2}]},{"id":"line-47","kind":"lyric","text":"Coda (over main riff):","columns":22,"beats":4,"changes":[]},{"id":"line-48","kind":"lyric","text":"        Had it all...           {repeat to fade}","columns":48,"beats":4,"changes":[{"symbol":"E","column":16,"beat":0}]}]}