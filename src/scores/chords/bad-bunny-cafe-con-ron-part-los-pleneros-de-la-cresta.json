":39,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Es amanecerme y beberme un galón","columns":32,"beats":8,"changes":[{"symbol":"Cm","column":10,"beat":0},{"symbol":"Gm","column":16,"beat":2},{"symbol":"F","column":22,"beat":4},{"symbol":"Gm","column":28,"beat":6}]},{"id":"line-15","kind":"lyric","text":"(Por la mañana, café, por la tarde, ron)","columns":42,"beats":6,"changes":[{"symbol":"Gm","column":18,"beat":0},{"symbol":"Cm","column":36,"beat":2},{"symbol":"Gm","column":40,"beat":4}]},{"id":"line-16","kind":"lyric","text":"(Ya estamo' en la ca—)","columns":22,"beats":4,"changes":[{"symbol":"Cm","column":9,"beat":0},{"symbol":"Gm","column":19,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Brother, yo no sé ni cómo llegué a casa anoche","columns":46,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Clase de loquera, y hoy me están tirando de nuevo pa' bajar pa'llá","columns":66,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"Pero yo creo que hoy, sí, que, acho, pichaera, que no me esperen, por—","columns":70,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"El humo empañó el camino y no pude recordar","columns":43,"beats":4,"changes":[{"symbol":"Dm","column":22,"beat":0},{"symbol":"Gm","column":39,"beat":2}]},{"id":"line-21","kind":"lyric","text":"El camino pa' mi casa, hoy me vuelves a invitar","columns":47,"beats":4,"changes":[{"symbol":"A","column":18,"beat":0},{"symbol":"Dm","column":40,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Yo me iba a quedar tranquilo, pero, si quiere' vacilar","columns":54,"beats":4,"changes":[{"symbol":"Dm","column":23,"beat":0},{"symbol":"Gm","column":41,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Sube tú pa' la montaña, porque hoy yo me quedo acá","columns":50,"beats":4,"changes":[{"symbol":"A","column":19,"beat":0},{"symbol":"Dm","column":46,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Ven subiendo, ven subiendo, que no le vamo' a bajar","columns":51,"beats":6,"changes":[{"symbol":"Dm","column":11,"beat":0},{"symbol":"Dm","column":24,"beat":2},{"symbol":"Gm","column":29,"beat":4}]},{"id":"line-25","kind":"lyric","text":"Sube tú pa' la montaña, hoy yo me quedo acá","columns":43,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0},{"symbol":"Dm","column":35,"beat":2}]},{"id":"line-26","kind":"lyric","text":"Ven subiendo, ven subiendo, que no le vamo' a bajar","columns":51,"beats":8,"changes":[{"symbol":"Dm","column":11,"beat":0},{"symbol":"Dm","column":25,"beat":2},{"symbol":"Gm","column":29,"beat":4},{"symbol":"Dm","column":45,"beat":6}]},{"id":"line-27","kind":"lyric","text":"Sube tú pa' la montaña, hoy yo me quedo acá (dile, dile, dile algo)","columns":67,"beats":4,"changes":[{"symbol":"A","column":19,"beat":0},{"symbol":"Dm","column":40,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Allá abajo (allá abajo), allá abajo (allá abajo) no se me ha perdido na' (na')","columns":78,"beats":4,"changes":[{"symbol":"Dm","column":9,"beat":0},{"symbol":"Dm","column":33,"beat":1},{"symbol":"Gm","column":49,"beat":2}]},{"id":"line-29","kind":"lyric","text":"Están arriba en el monte los código' de verdad (suban pa'cá pa' que vean)","columns":73,"beats":4,"changes":[{"symbol":"A","column":19,"beat":0},{"symbol":"Dm","column":44,"beat":2}]},{"id":"line-30","kind":"lyric","text":"Ven subiendo (¿qué?), ven subiendo (ey, ey), que no le vamo' a","columns":62,"beats":4,"changes":[{"symbol":"Dm","column":7,"beat":0},{"symbol":"Dm","column":30,"beat":1},{"symbol":"Gm","column":33,"beat":3}]},{"id":"line-31","kind":"lyric","text":"Bajar","columns":5,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Sube tú pa' la montaña, hoy yo me quedo acá (¿qué se hace hoy?, ¿qué se hace hoy?)","columns":82,"beats":4,"changes":[{"symbol":"A","column":18,"beat":0},{"symbol":"Dm","column":40,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Hoy se bebe, hoy se bebe y nadie nos va a parar","columns":47,"beats":6,"changes":[{"symbol":"Dm","column":9,"beat":0},{"symbol":"Dm","column":21,"beat":2},{"symbol":"Gm","column":28,"beat":4}]},{"id":"line-34","kind":"lyric","text":"El samurai está en brillo y el combo va a chinchorrear (ponle, ponle, ponle, ponle, ponle)","columns":90,"beats":4,"changes":[{"symbol":"A","column":22,"beat":0},{"symbol":"Dm","column":46,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Ven subiendo (vamo'), ven subiendo (dale pa'cá), que no le vamo' a","columns":66,"beats":4,"changes":[{"symbol":"Dm","column":11,"beat":0},{"symbol":"Gm","column":24,"beat":2}]},{"id":"line-36","kind":"lyric","text":"Bajar (no le vamo' a bajar)","columns":27,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-37","kind":"lyric","text":"Sube tú pa' la montaña, hoy yo me quedo acá","columns":43,"beats":4,"changes":[{"symbol":"A","column":17,"beat":0},{"symbol":"Dm","column":39,"beat":2}]},{"id":"line-38","kind":"lyric","text":"Ey, ten cuida'o, ten cuida'o (uy) cuando te toque bajar","columns":55,"beats":4,"changes":[{"symbol":"Dm","column":6,"beat":0},{"symbol":"Gm","column":38,"beat":2}]},{"id":"line-39","kind":"lyric","text":"Que no te vaya' por risco y te tengamos que buscar","columns":50,"beats":4,"changes":[{"symbol":"A","column":22,"beat":0},{"symbol":"Dm","column":45,"beat":2}]},{"id":"line-40","kind":"lyric","text":"(Yo te voy a decir algo pa' que sepa')","columns":38,"beats":4,"changes":[]},{"id":"line-41","kind":"lyric","text":"En el monte, hoy se rompe","columns":25,"beats":6,"changes":[{"symbol":"Dm","column":1,"beat":0},{"symbol":"Gm","column":19,"beat":2},{"symbol":"Dm","column":23,"beat":4}]},{"id":"line-42","kind":"lyric","text":"Desde que sale el Sol hasta que se esconde","columns":42,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"(En el monte, hoy se rompe)","columns":27,"beats":4,"changes":[]},{"id":"line-44","kind":"lyric","text":"Chillando goma, botando humo, dale, ponle","columns":41,"beats":4,"changes":[{"symb