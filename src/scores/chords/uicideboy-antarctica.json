xt":"My birth was an error","columns":21,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-21","kind":"section","text":"[Verse 2: Ruby da Cherry]","columns":25,"beats":0,"changes":[]},{"id":"line-22","kind":"lyric","text":"I am the Lord of loneliness","columns":27,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"I'll hold my breath","columns":19,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Just spoke with death","columns":21,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"He said he hopes for the best","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Told him I'm ropin' my neck","columns":27,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Then I woke up chokin' from the hole in my chest","columns":48,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Somehow I manage to function and hope","columns":37,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Everyday got a lump in my throat","columns":32,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"That's them pills swallowed whole","columns":33,"beats":6,"changes":[{"symbol":"D","column":13,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Smoke a blunt and then fuck all these hoes","columns":42,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"End up humpin' they throat","columns":26,"beats":4,"changes":[{"symbol":"F#m","column":8,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Get the fuck away from me","columns":25,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-34","kind":"lyric","text":"I hate all of you, faithfully","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id"