{"version":1,"id":"olivia-rodrigo-brutal","title":"Brutal","artist":"Olivia Rodrigo","key":"C#m","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/olivia-rodrigo/brutal/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Daniel Leonard Nigro and Olivia Isabel Rodrigo","chords":[{"symbol":"B5","canonical":"B5","keyboardPitchClasses":[11,6],"interpretation":null},{"symbol":"A#5","canonical":"A#5","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"A5","canonical":"A5","keyboardPitchClasses":[9,4],"interpretation":null},{"symbol":"G#5","canonical":"G#5","keyboardPitchClasses":[8,3],"interpretation":null},{"symbol":"G5","canonical":"G5","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"F#5","canonical":"F#5","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"E5","canonical":"E5","keyboardPitchClasses":[4,11],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"B7","canonical":"B7","keyboardPitchClasses":[11,3,6,9],"interpretation":null},{"symbol":"E/G#","canonical":"E/G#","keyboardPitchClasses":[8,11,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"(I want it to be, like, messy)","columns":30,"beats":4,"changes":[]},{"id":"line-2","kind":"lyric","text":"I'm so insecure I  think","columns":24,"beats":6,"changes":[{"symbol":"B5","column":0,"beat":0},{"symbol":"A#5","column":15,"beat":2},{"symbol":"A5","column":20,"beat":4}]},{"id":"line-3","kind":"lyric","text":"That I'll die before I  drink","columns":29,"beats":6,"changes":[{"symbol":"B5","column":1,"beat":0},{"symbol":"A#5","column":20,"beat":2},{"symbol":"A5","column":25,"beat":4}]},{"id":"line-4","kind":"lyric","text":"And I'm so caught up in the news","columns":32,"beats":6,"changes":[{"symbol":"B5","column":4,"beat":0},{"symbol":"A#5","column":21,"beat":2},{"symbol":"A5","column":29,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Of who likes me and who hates you","columns":33,"beats":3,"changes":[{"symbol":"B5","column":3,"beat":0},{"symbol":"A#5","column":25,"beat":1},{"symbol":"A5","column":30,"beat":2}]},{"id":"line-6","kind":"lyric","text":"And I'm so tired that I might","columns":29,"beats":4,"changes":[{"symbol":"A5","column":4,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Quit my job, start a new life","columns":29,"beats":4,"changes":[{"symbol":"A5","column":1,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And they'd all be so disappointed","columns":33,"beats":2,"changes":[{"symbol":"G#5","column":5,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Cuz who am I, if not exploited?","columns":31,"beats":4,"changes":[{"symbol":"G5","column":5,"beat":0},{"symbol":"F#5","column":17,"beat":2}]},{"id":"line-10","kind":"lyric","text":"And I'm so sick of seventeen","columns":28,"beats":6,"changes":[{"symbol":"B5","column":4,"beat":0},{"symbol":"A#5","column":20,"beat":2},{"symbol":"A5","column":25,"beat":4}]},{"id":"line-11","kind":"lyric","text":"Where's my fuckin' teenage dream?","columns":33,"beats":6,"changes":[{"symbol":"B5","column":1,"beat":0},{"symbol":"A#5","column":20,"beat":2},{"symbol":"A5","column":28,"beat":4}]},{"id":"line-12","kind":"lyric","text":"If someone tells me one more time","columns":33,"beats":6,"changes":[{"symbol":"B5","column":4,"beat":0},{"symbol":"A#5","column":20,"beat":2},{"symbol":"A5","column":30,"beat":4}]},{"id":"line-13","kind":"lyric","text":"\"Enjoy your youth\", I'm gonna cry","columns":33,"beats":6,"changes":[{"symbol":"B5","column":2,"beat":0},{"symbol":"A#5","column":25,"beat":2},{"symbol":"A5","column":30,"beat":4}]},{"id":"line-14","kind":"lyric","text":"And I don't stick up for myself","columns":31,"beats":4,"changes":[{"symbol":"A5","column":4,"beat":0}]},{"id":"line-15","kind":"lyric","text":"I'm anxious and nothing can help","columns":32,"beats":4,"changes":[{"symbol":"A5","column":5,"beat":0}]},{"id":"line-16","kind":"lyric","text":"And I wish I'd done this before","columns":31,"beats":4,"changes":[{"symbol":"G#5","column":3,"beat":0}]},{"id":"line-17","kind":"lyric","text":"And I wish people likеd me more","columns":31,"beats":4,"changes":[{"symbol":"G5","column":4,"beat":0},{"symbol":"F#5","column":19,"beat":2}]},{"id":"line-18","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-19","kind":"lyric","text":"All I did was try my best","columns":25,"beats":4,"changes":[{"symbol":"E5","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"This thе kinda thanks I get?","columns":28,"beats":4,"changes":[{"symbol":"E5","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Unrelentlessly upset  (huh, huh, huh)","columns":37,"beats":4,"changes":[{"symbol":"B5","column":0,"beat":0},{"symbol":"A#5","column":32,"beat":2}]},{"id":"line-22","kind":"lyric","text":"(Huh, huh, huh)","columns":15,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"They say \"These are the golden years\"","columns":37,"beats":4,"changes":[{"symbol":"A5","column":5,"beat":0}]},{"id":"line-24","kind":"lyric","text":"But I wish I could disappear","columns":28,"beats":4,"changes":[{"symbol":"E5","column":6,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Ego crush is so severe","columns":22,"beats":4,"changes":[{"symbol":"B5","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"God, it's brutal out here","columns":25,"beats":4,"changes":[{"symbol":"B5","column":0,"beat":0}]},{"id":"line-27","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-28","kind":"lyric","text":"I feel like no one wants me","columns":27,"beats":6,"changes":[{"symbol":"B5","column":0,"beat":0},{"symbol":"A#5","column":20,"beat":1},{"symbol":"A5","column":25,"beat":2}]},{"id":"line-29","kind":"lyric","text":"And I hate th