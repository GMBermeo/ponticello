{"version":1,"id":"taylor-swift-chloe-or-sam-or-sophia-or-marcus","title":"Chloe Or Sam Or Sophia Or Marcus","artist":"Taylor Swift","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/taylor-swift/chloe-or-sam-or-sophia-or-marcus/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Aaron Dessner and Taylor Swift","chords":[{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Your hologram stumbled into my apartment","columns":40,"beats":6,"changes":[{"symbol":"F","column":6,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Hands in the hair of somebody in darkness","columns":41,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Named Chloe or Sam or Sophia or Marcus","columns":38,"beats":4,"changes":[{"symbol":"F","column":6,"beat":0}]},{"id":"line-4","kind":"lyric","text":"And I just watched it happen","columns":30,"beats":4,"changes":[{"symbol":"G","column":6,"beat":0},{"symbol":"F","column":29,"beat":2}]},{"id":"line-5","kind":"lyric","text":"As the decade would play us for fools","columns":39,"beats":4,"changes":[{"symbol":"C","column":38,"beat":0}]},{"id":"line-6","kind":"lyric","text":"And you saw my bones out with somebody new","columns":42,"beats":4,"changes":[]},{"id":"line-7","kind":"lyric","text":"Who seemed like he would've bullied you in school","columns":49,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And you just watched it happen","columns":30,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"  If you wanna break my cold, cold heart","columns":40,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Just say: I loved you the way that you were","columns":43,"beats":4,"changes":[{"symbol":"C","column":13,"beat":0},{"symbol":"F","column":40,"beat":2}]},{"id":"line-11","kind":"lyric","text":"  If you wanna tear my world apart","columns":34,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":24,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Just say you've always wondered","columns":31,"beats":4,"changes":[{"symbol":"C","column":17,"beat":0},{"symbol":"F","column":26,"beat":2}]},{"id":"line-13","kind":"lyric","text":"You said some things that I can't unabsorb","columns":42,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-14","kind":"lyric","text":"You turned me into an idea of sorts","columns":35,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-15","kind":"lyric","text":"You needed me, but you needed drugs more","columns":40,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-16","kind":"lyric","text":"And I couldn't watch it happen","columns":30,"beats":4,"changes":[{"symbol":"G","column":6,"beat":0}]},{"id":"line-17","kind":"lyric","text":"I changed into goddesses, villains and fools","columns":44,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Changed plans and lovers, and outfits and rules","columns":47,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"All to outrun my desertion of you","columns":33,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"And you just watched it","columns":23,"beats":4,"changes":[{"symbol":"G","column":3,"beat":0}]},{"id":"line-21","kind":"lyric","text":"  If you wanna break my cold, cold heart","columns":40,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Just say: I loved you the way that you were","columns":43,"beats":4,"changes":[{"symbol":"C","column":13,"beat":0},{"symbol":"F","column":40,"beat":2}]},{"id":"line-23","kind":"lyric","text":"  If you wanna tear my world apart","columns":34,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Just say you've always wondered","columns":31,"beats":4,"changes":[{"symbol":"C","column":16,"beat":0},{"symbol":"F","column":25,"beat":2}]},{"id":"line-25","kind":"lyric","text":"If the glint in my eye traced the depths of your sigh","columns":53,"beats":4,"changes":[{"symbol":"Dm","column":8,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Down that passage in time back to the moment","columns":44,"beats":4,"changes":[{"symbol":"G","column":8,"beat":0}]},{"id":"line-27","kind":"lyric","text":"I crashed into you, like so many wrecks do","columns":42,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Too impaired by my youth to know what to do","columns":43,"beats":4,"changes":[{"symbol":"F","column":8,"beat":0},{"symbol":"F","column":40,"beat":2}]},{"id":"line-29","kind":"lyric","text":"So if I sell my apartment","columns":25,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"And you have some kids with an internet starlet","columns":47,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Will that make your memory fade from this scarlet maroon","columns":56,"beats":4,"changes":[{"symbol":"F","column":5,"beat":0},{"symbol":"G","column":52,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Like it never happened?","columns":23,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"Could it be enough to just float in your orbit?","columns":47,"beats":4,"changes":[{"symbol":"F","column":5,"beat":0}]},{"id":"line-34","kind":"lyric","text":"Can we watch our phantoms like watching wild horses?","columns":52,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Cooler in theory, but not if you force it to be","columns":47,"beats":4,"changes":[{"symbol":"F","column":5,"beat":0},{"symbol":"G","column":46,"beat":2}]},{"id":"line-36","kind":"lyric","text":"It just didn't happen","columns":21,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"   So if you wanna break my cold, cold heart","columns":44,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-38","kind":"lyric","text":"Say you loved me","columns":27,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0},{"symbol":"F","column":26,"beat":2}]},{"id":"line-39","kind":"lyric","text":"   And if you wanna tear my world apart","columns":39,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-40","kind":"lyric","text":"Say you'll always wonder","columns":24,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"F","column":21,"beat":2}]},{"id":"line-41","kind":"lyric","text":"(Ah-ah-ah-ah-ah-ah)","columns":19,"beats":6,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"G","column":9,"beat":2},{"symbol":"C","column":17,"beat":4}]},{"id":"line-42","kind":"lyric","text":"'Cause I wonder","columns":15,"beats":4,"changes":[{"symbol":"F","column":10,"beat":0}]},{"id":"line-43","kind":"lyric","text":"(Ah-ah-ah)","columns":10,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Will I always (Ah-ah-ah)","columns":24,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Will I always wonder?","columns":21,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"F","column":15,"beat":2}]}]}