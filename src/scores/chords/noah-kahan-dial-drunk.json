{"version":1,"id":"noah-kahan-dial-drunk","title":"Dial Drunk","artist":"Noah Kahan","key":"A","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/noah-kahan/dial-drunk/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Noah Kahan and Noah Isaac Levine","chords":[{"symbol":"C#/G#","canonical":"C#/G#","keyboardPitchClasses":[8,1,5],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"I'm rememberin' I promised to forget you now","columns":44,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":18,"beat":2},{"symbol":"Fm","column":33,"beat":4}]},{"id":"line-3","kind":"lyric","text":"But it's rainin' and I'm callin' drunk","columns":38,"beats":2,"changes":[{"symbol":"Fm","column":9,"beat":0}]},{"id":"line-4","kind":"lyric","text":"And my medicine is drowning your perspective out","columns":48,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":21,"beat":2},{"symbol":"Fm","column":36,"beat":4}]},{"id":"line-5","kind":"lyric","text":"So I ain't taking any fault","columns":27,"beats":4,"changes":[{"symbol":"Fm","column":11,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Am I honest still? Am I half the man I used to be?","columns":50,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":14,"beat":2},{"symbol":"Fm","column":42,"beat":4}]},{"id":"line-7","kind":"lyric","text":"I doubt it, forget about it, whatever","columns":37,"beats":4,"changes":[{"symbol":"Fm","column":12,"beat":0}]},{"id":"line-8","kind":"lyric","text":"It's all the same anyways","columns":30,"beats":8,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":7,"beat":2},{"symbol":"Fm","column":21,"beat":4},{"symbol":"D#","column":28,"beat":6}]},{"id":"line-9","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"I ain't proud of all the punches that I've thrown","columns":49,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":27,"beat":2}]},{"id":"line-11","kind":"lyric","text":"In the name of someone I no longer know","columns":39,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":24,"beat":2}]},{"id":"line-12","kind":"lyric","text":"For the shame of being young, drunk, and alone","columns":46,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":29,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Traffic lights and a transmitter radio","columns":38,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":27,"beat":2}]},{"id":"line-14","kind":"lyric","text":"I don't like that, when they threw me in the car","columns":48,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":31,"beat":2}]},{"id":"line-15","kind":"lyric","text":"I gave your name as my emergency phone call","columns":43,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":24,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Honey, it rang and rang, even the cops thought you were wrong for hanging up","columns":81,"beats":8,"changes":[{"symbol":"C#/G#","column":10,"beat":0},{"symbol":"G#","column":41,"beat":2},{"symbol":"D#","column":79,"beat":5}]},{"id":"line-17","kind":"lyric","text":"I dial drunk, I'll die a drunk, I'd die for you","columns":47,"beats":4,"changes":[{"symbol":"Fm","column":7,"beat":0},{"symbol":"C#/G#","column":37,"beat":2}]},{"id":"line-18","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-19","kind":"lyric","text":"I'm untethering from the parts of me you'd recognize","columns":52,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":18,"beat":2},{"symbol":"Fm","column":46,"beat":4}]},{"id":"line-20","kind":"lyric","text":"From charming to alarming in seconds","columns":36,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"I'll be bedridden, I'll let the pain metastasize","columns":48,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":20,"beat":2},{"symbol":"Fm","column":45,"beat":4}]},{"id":"line-22","kind":"lyric","text":"But, that's morning, I'll forget it","columns":35,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"And the dial tone is all I have","columns":37,"beats":8,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":15,"beat":2},{"symbol":"Fm","column":30,"beat":4},{"symbol":"D#","column":35,"beat":6}]},{"id":"line-24","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"I ain't proud of all the punches that I've thrown","columns":49,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":27,"beat":2}]},{"id":"line-26","kind":"lyric","text":"In the name of someone I no longer know","columns":39,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":24,"beat":2}]},{"id":"line-27","kind":"lyric","text":"For the shame of being young, drunk, and alone","columns":46,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":29,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Traffic lights and a transmitter radio","columns":38,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":27,"beat":2}]},{"id":"line-29","kind":"lyric","text":"I don't like that, when they threw me in the car","columns":48,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":31,"beat":2}]},{"id":"line-30","kind":"lyric","text":"I gave your name as my emergency phone call","columns":43,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":24,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Honey, it rang and rang, even the cops thought you were wrong for hanging up","columns":81,"beats":6,"changes":[{"symbol":"C#/G#","column":10,"beat":0},{"symbol":"G#","column":41,"beat":2},{"symbol":"D#","column":79,"beat":4}]},{"id":"line-32","kind":"lyric","text":"I dial drunk, I'll die a drunk, I'd die for you","columns":47,"beats":4,"changes":[{"symbol":"Fm","column":7,"beat":0},{"symbol":"C#/G#","column":37,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Well, I'd die for you","columns":31,"beats":6,"changes":[{"symbol":"G#","column":10,"beat":0},{"symbol":"D#","column":23,"beat":2},{"symbol":"Fm","column":29,"beat":4}]},{"id":"line-34","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-35","kind":"lyric","text":"I beg you, sir, just let me call","columns":32,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0}]},{"id":"line-36","kind":"lyric","text":"I'll give you my blood alcohol","columns":30,"beats":4,"changes":[{"symbol":"G#","column":0,"beat":0}]},{"id":"line-37","kind":"lyric","text":"I'll rot with all the burnouts in the cell","columns":42,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":39,"beat":2}]},{"id":"line-38","kind":"lyric","text":"I'll change my faith, I'll praise the flag","columns":42,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Just wait, I swear she'll call me back","columns":38,"beats":4,"changes":[{"symbol":"G#","column":0,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Oh, son, are you a danger to yourself?","columns":38,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":34,"beat":2}]},{"id":"line-41","kind":"lyric","text":"Well, fuck that sir, just let me call","columns":37,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0}]},{"id":"line-42","kind":"lyric","text":"I'll give you my blood alcohol","columns":30,"beats":4,"changes":[{"symbol":"G#","column":0,"beat":0}]},{"id":"line-43","kind":"lyric","text":"I'll rot with all the burnouts in the cell","columns":42,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":39,"beat":2}]},{"id":"line-44","kind":"lyric","text":"I'll change my faith, I'll kiss the badge","columns":41,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Just wait, I swear she'll call me back","columns":38,"beats":4,"changes":[{"symbol":"G#","column":0,"beat":0}]},{"id":"line-46","kind":"lyric","text":"Son, why do you do this to yourself?","columns":36,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":32,"beat":2}]},{"id":"line-47","kind":"lyric","text":"And I said","columns":10,"beats":4,"changes":[]},{"id":"line-48","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-49","kind":"lyric","text":"I ain't proud of all the punches that I've thrown","columns":49,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":27,"beat":2}]},{"id":"line-50","kind":"lyric","text":"In the name of someone I no longer know","columns":39,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":24,"beat":2}]},{"id":"line-51","kind":"lyric","text":"For the shame of being young, drunk, and alone","columns":46,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":29,"beat":2}]},{"id":"line-52","kind":"lyric","text":"Traffic lights and a transmitter radio","columns":38,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":27,"beat":2}]},{"id":"line-53","kind":"lyric","text":"I don't like that, when they threw me in the car","columns":48,"beats":4,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"G#","column":31,"beat":2}]},{"id":"line-54","kind":"lyric","text":"I gave your name as my emergency phone call","columns":43,"beats":4,"changes":[{"symbol":"D#","column":0,"beat":0},{"symbol":"Fm","column":24,"beat":2}]},{"id":"line-55","kind":"lyric","text":"Honey, it rang and rang, even the cops thought you were wrong for hanging up","columns":79,"beats":8,"changes":[{"symbol":"C#/G#","column":10,"beat":0},{"symbol":"G#","column":40,"beat":2},{"symbol":"D#","column":76,"beat":5}]},{"id":"line-56","kind":"lyric","text":"I dial drunk, I'll die a drunk, I'd die for you","columns":47,"beats":2,"changes":[{"symbol":"Fm","column":7,"beat":0}]}]}