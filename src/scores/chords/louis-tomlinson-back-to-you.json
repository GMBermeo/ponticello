{"version":1,"id":"louis-tomlinson-back-to-you","title":"Back To You","artist":"Louis Tomlinson","key":"D","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/louis-tomlinson/back-to-you/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Louis Tomlinson, Richard Boardman, Digital Farm Animals, Pablo Bowman and Sarah Blanchard","chords":[{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":21,"beats":8,"changes":[{"symbol":"Fm","column":8,"beat":0},{"symbol":"A#","column":12,"beat":2},{"symbol":"D#","column":16,"beat":4},{"symbol":"C","column":20,"beat":6}]},{"id":"line-2","kind":"lyric","text":"I know you say you know me, know me well","columns":40,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"A#","column":28,"beat":2}]},{"id":"line-3","kind":"lyric","text":"But these days I don't even know myself, no","columns":43,"beats":4,"changes":[{"symbol":"D#","column":10,"beat":0},{"symbol":"C","column":35,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I always thought I'd be with someone else","columns":41,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"A#","column":29,"beat":2}]},{"id":"line-5","kind":"lyric","text":"I thought I would own the way I felt, yeah","columns":42,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0},{"symbol":"C","column":32,"beat":2}]},{"id":"line-6","kind":"lyric","text":"I call you but you never even answer","columns":36,"beats":4,"changes":[{"symbol":"Fm","column":2,"beat":0},{"symbol":"A#","column":30,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I tell myself I'm done with wicked games","columns":40,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0},{"symbol":"C","column":35,"beat":2}]},{"id":"line-8","kind":"lyric","text":"But then I get so numb with all the laughter","columns":44,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0},{"symbol":"A#","column":36,"beat":2}]},{"id":"line-9","kind":"lyric","text":"That I forget about the pain","columns":30,"beats":4,"changes":[{"symbol":"D#","column":5,"beat":0},{"symbol":"C","column":29,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Whoah, you stress me out, you kill me","columns":40,"beats":6,"changes":[{"symbol":"Fm","column":7,"beat":0},{"symbol":"A#","column":21,"beat":2},{"symbol":"D#","column":38,"beat":4}]},{"id":"line-11","kind":"lyric","text":"You drag me down, you fuck me up","columns":36,"beats":8,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"Fm","column":34,"beat":4}]},{"id":"line-12","kind":"lyric","text":"We're on the ground, we're screaming","columns":39,"beats":4,"changes":[{"symbol":"A#","column":13,"beat":0},{"symbol":"D#","column":37,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I don't know how to make it stop","columns":36,"beats":4,"changes":[{"symbol":"C","column":13,"beat":0},{"symbol":"Fm","column":34,"beat":2}]},{"id":"line-14","kind":"lyric","text":"I love it, I hate it, and I can't take it","columns":44,"beats":8,"changes":[{"symbol":"A#","column":10,"beat":0},{"symbol":"D#","column":20,"beat":2},{"symbol":"C","column":33,"beat":4},{"symbol":"Fm","column":42,"beat":6}]},{"id":"line-15","kind":"lyric","text":"But I keep on coming back to you","columns":34,"beats":4,"changes":[{"symbol":"A#","column":6,"beat":0},{"symbol":"D#","column":32,"beat":2}]},{"id":"line-16","kind":"lyric","text":"I know my friends they give me bad advice","columns":41,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"A#","column":31,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Like move on, get you out my mind","columns":35,"beats":4,"changes":[{"symbol":"D#","column":10,"beat":0},{"symbol":"C","column":34,"beat":2}]},{"id":"line-18","kind":"lyric","text":"But don't you think I haven't even tried?","columns":41,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0},{"symbol":"A#","column":30,"beat":2}]},{"id":"line-19","kind":"lyric","text":"You got me cornered and my hands are tied","columns":43,"beats":4,"changes":[{"symbol":"D#","column":11,"beat":0},{"symbol":"C","column":42,"beat":2}]},{"id":"line-20","kind":"lyric","text":"You got me so addicted to the drama","columns":35,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"A#","column":30,"beat":2}]},{"id":"line-21","kind":"lyric","text":"I tell myself I'm done with wicked games","columns":40,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0},{"symbol":"C","column":35,"beat":2}]},{"id":"line-22","kind":"lyric","text":"But then I get so numb with all the laughter","columns":44,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0},{"symbol":"A#","column":36,"beat":2}]},{"id":"line-23","kind":"lyric","text":"That I forget about the pain","columns":30,"beats":4,"changes":[{"symbol":"D#","column":5,"beat":0},{"symbol":"C","column":29,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Whoah, you stress me out, you kill me","columns":40,"beats":6,"changes":[{"symbol":"Fm","column":7,"beat":0},{"symbol":"A#","column":21,"beat":2},{"symbol":"D#","column":38,"beat":4}]},{"id":"line-25","kind":"lyric","text":"You drag me down, you fuck me up","columns":35,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"Fm","column":33,"beat":2}]},{"id":"line-26","kind":"lyric","text":"We're on the ground, we're screaming","columns":41,"beats":4,"changes":[{"symbol":"A#","column":13,"beat":0},{"symbol":"D#","column":39,"beat":2}]},{"id":"line-27","kind":"lyric","text":"I don't know how to make it stop","columns":35,"beats":4,"changes":[{"symbol":"C","column":13,"beat":0},{"symbol":"Fm","column":33,"beat":2}]},{"id":"line-28","kind":"lyric","text":"I love it, I hate it, and I can't take it","columns":44,"beats":4,"changes":[{"symbol":"A#","column":9,"beat":0},{"symbol":"D#","column":20,"beat":1},{"symbol":"C","column":33,"beat":2},{"symbol":"Fm","column":42,"beat":3}]},{"id":"line-29","kind":"lyric","text":"But I keep on coming back to you (back to you)","columns":46,"beats":3,"changes":[{"symbol":"A#","column":6,"beat":0},{"symbol":"D#","column":32,"beat":1},{"symbol":"C","column":39,"beat":2}]},{"id":"line-30","kind":"lyric","text":"Oh, no, no, I just keep on coming back to you (back to you)","columns":59,"beats":4,"changes":[{"symbol":"Fm","column":10,"beat":0},{"symbol":"A#","column":19,"beat":1},{"symbol":"D#","column":45,"beat":2},{"symbol":"C","column":52,"beat":3}]},{"id":"line-31","kind":"lyric","text":"Oh, no, no, I just keep on coming back to you","columns":47,"beats":6,"changes":[{"symbol":"Fm","column":10,"beat":0},{"symbol":"A#","column":19,"beat":2},{"symbol":"D#","column":45,"beat":4}]},{"id":"line-32","kind":"lyric","text":"  And I guess you'll never know","columns":34,"beats":3,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"A#","column":8,"beat":1},{"symbol":"D#","column":32,"beat":2}]},{"id":"line-33","kind":"lyric","text":"All the bullshit that you put me through","columns":43,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"Fm","column":41,"beat":2}]},{"id":"line-34","kind":"lyric","text":"And I guess you'll never know, no","columns":36,"beats":3,"changes":[{"symbol":"A#","column":6,"beat":0},{"symbol":"D#","column":29,"beat":1},{"symbol":"C","column":35,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Yeah, so you can cut me up and kiss me harder","columns":45,"beats":4,"changes":[{"symbol":"Fm","column":9,"beat":0},{"symbol":"A#","column":36,"beat":2}]},{"id":"line-36","kind":"lyric","text":"You can be the pill to ease the pain","columns":36,"beats":4,"changes":[{"symbol":"D#","c