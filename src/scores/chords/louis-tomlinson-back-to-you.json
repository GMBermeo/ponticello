ic","text":"Oh, no, no, I just keep on coming back to you","columns":47,"beats":6,"changes":[{"symbol":"Fm","column":10,"beat":0},{"symbol":"A#","column":19,"beat":2},{"symbol":"D#","column":45,"beat":4}]},{"id":"line-47","kind":"lyric","text":"Back to you","columns":14,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0},{"symbol":"Fm","column":12,"beat":2}]},{"id":"line-48","kind":"lyric","text":"I just keep on coming back to you","columns":35,"beats":4,"changes":[{"symbol":"A#","column":7,"beat":0},{"symbol":"D#","column":33,"beat":2}]}]}