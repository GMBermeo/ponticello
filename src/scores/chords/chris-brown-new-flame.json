{"version":1,"id":"chris-brown-new-flame","title":"New Flame","artist":"Chris Brown","key":"Db","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/chris-brown/new-flame/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Usher (Us), Ric Ross, Chris Brown, Keith Tomas, Maurice N Simmonds, Eric A Bellinger, M Hunter, Count Justice, John Paul Diaz and Major Money","chords":[{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"Bbm","canonical":"Bbm","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"There can be one only you","columns":25,"beats":4,"changes":[{"symbol":"C#","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"And baby, God could never make two","columns":36,"beats":4,"changes":[{"symbol":"Bbm","column":7,"beat":0},{"symbol":"G#","column":34,"beat":2}]},{"id":"line-3","kind":"lyric","text":"And I know you came here with your crew","columns":39,"beats":2,"changes":[{"symbol":"C#","column":15,"beat":0}]},{"id":"line-4","kind":"lyric","text":"But I promise you that it feels like it's just us two","columns":55,"beats":4,"changes":[{"symbol":"Bbm","column":7,"beat":0},{"symbol":"G#","column":53,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Oh, I don't know what you had planned to do tonight","columns":51,"beats":4,"changes":[{"symbol":"C#","column":20,"beat":0}]},{"id":"line-6","kind":"lyric","text":"But I just wanna be the one to do you right","columns":45,"beats":4,"changes":[{"symbol":"Bbm","column":17,"beat":0},{"symbol":"G#","column":43,"beat":2}]},{"id":"line-7","kind":"lyric","text":"We're standing here looking at each other","columns":41,"beats":2,"changes":[{"symbol":"C#","column":6,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Baby, eye to eye","columns":16,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"And I'm hoping","columns":14,"beats":4,"changes":[{"symbol":"Bbm","column":9,"beat":0}]},{"id":"line-10","kind":"lyric","text":"That you're thinking about leaving with me tonight","columns":50,"beats":4,"changes":[{"symbol":"G#","column":47,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Who said","columns":8,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"You can't find love in a club?","columns":30,"beats":4,"changes":[{"symbol":"C#","column":16,"beat":0}]},{"id":"line-13","kind":"lyric","text":"'Cause I wanna tell them they wrong","columns":35,"beats":4,"changes":[]},{"id":"line-14","kind":"lyric","text":"Come on, just baby, try a new thing","columns":35,"beats":4,"changes":[{"symbol":"Bbm","column":26,"beat":0}]},{"id":"line-15","kind":"lyric","text":"And let's spark a new flame","columns":27,"beats":4,"changes":[{"symbol":"G#","column":19,"beat":0}]},{"id":"line-16","kind":"lyric","text":"You gon' be my baby","columns":19,"beats":4,"changes":[{"symbol":"C#","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Love me, love you crazy","columns":23,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Tell me if you're with it","columns":25,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"Baby, come and get it","columns":21,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Baby try a new thing","columns":20,"beats":4,"changes":[{"symbol":"Bbm","column":6,"beat":0}]},{"id":"line-21","kind":"lyric","text":"And let's spark a new flame","columns":27,"beats":4,"changes":[{"symbol":"G#","column":17,"beat":0}]},{"id":"line-22","kind":"lyric","text":"  (Segue a música inteira com as mesmas notas)","columns":46,"beats":4,"changes":[]}]}