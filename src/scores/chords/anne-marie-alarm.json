{"version":1,"id":"anne-marie-alarm","title":"Alarm","artist":"Anne-Marie","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/anne-marie/alarm/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Maccutcheon Steven, Aliway (Gb 1), Bon Harris, Gibon, Simon Charles Granger, Douglas Mccarthy, Piper Chris, Ina and Anne-Marie Nicholson","chords":[{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"You lay here with me, you're shutting down","columns":42,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"C","column":22,"beat":2}]},{"id":"line-2","kind":"lyric","text":"I smell her on ya, I'm focused now","columns":34,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"F","column":19,"beat":2}]},{"id":"line-3","kind":"lyric","text":"I know what's going on in your head, yeah","columns":41,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"C","column":20,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I know what's happened here in our bed, yeah","columns":44,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"F","column":24,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Your phone is buzzing, so pick it up","columns":36,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"C","column":22,"beat":2}]},{"id":"line-6","kind":"lyric","text":"I know she calling, so what the fuck","columns":36,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"F","column":19,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I should've known a cheat stays a cheater","columns":41,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"C","column":21,"beat":2}]},{"id":"line-8","kind":"lyric","text":"So here we are","columns":14,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"And there goes the alarm ringing in my head","columns":43,"beats":4,"changes":[{"symbol":"Am","column":20,"beat":0},{"symbol":"C","column":39,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Like somebody said, \"Don't you trust him, no\"","columns":45,"beats":4,"changes":[{"symbol":"G","column":15,"beat":0},{"symbol":"F","column":41,"beat":2}]},{"id":"line-11","kind":"lyric","text":"Texting from his ex, what did you expect?","columns":41,"beats":4,"changes":[{"symbol":"Am","column":17,"beat":0},{"symbol":"C","column":37,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Now you're lying here knowing where he goes","columns":43,"beats":4,"changes":[{"symbol":"G","column":18,"beat":0},{"symbol":"F","column":40,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Now he gotta gotcha","columns":19,"beats":4,"changes":[{"symbol":"Am","column":14,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Karma is a bitch, yeah","columns":22,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Same way that they come that's the way they go","columns":46,"beats":4,"changes":[{"symbol":"G","column":20,"beat":0},{"symbol":"F","column":44,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Now he gotta gotcha","columns":19,"beats":4,"changes":[{"symbol":"Am","column":14,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Rewinding the picture","columns":21,"beats":4,"changes":[{"symbol":"C","column":15,"beat":0}]},{"id":"line-18","kind":"lyric","text":"There goes the alarm and the siren's go","columns":39,"beats":4,"changes":[{"symbol":"G","column":17,"beat":0}]},{"id":"line-19",