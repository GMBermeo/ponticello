{"version":1,"id":"drake-diplomatic-immunity","title":"Diplomatic Immunity","artist":"Drake","key":"Dm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/drake/diplomatic-immunity/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Drake, Boi-1da and Nick Brongers","chords":[{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"Asus2","canonical":"Asus2","keyboardPitchClasses":[9,11,4],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"","columns":13,"beats":8,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":3,"beat":2},{"symbol":"Asus2","column":6,"beat":4},{"symbol":"G","column":12,"beat":6}]},{"id":"line-2","kind":"instrumental","text":"","columns":13,"beats":8,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":3,"beat":2},{"symbol":"Asus2","column":6,"beat":4},{"symbol":"G","column":12,"beat":6}]},{"id":"line-3","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-4","kind":"lyric","text":"Diplomatic immunity, fuck 'em","columns":29,"beats":6,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":4,"beat":2},{"symbol":"Asus2","column":21,"beat":4}]},{"id":"line-5","kind":"lyric","text":"All that peace and that unity","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"All that weak shit'll ruin me, fuck 'em, yeah","columns":47,"beats":7,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":32,"beat":1},{"symbol":"Asus2","column":42,"beat":2}]},{"id":"line-7","kind":"lyric","text":"N.C.                                          Dm","columns":48,"beats":4,"changes":[]},{"id":"line-8","kind":"lyric","text":"'Cause niggas started talkin' to me like I'm slowin' down","columns":57,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"Opinions over statistics, of course","columns":43,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"Asus2","column":38,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Gassed off journalistic","columns":23,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Come at me and all you'll get is the ballistic report","columns":53,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":39,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Booked a private room at Wylie's, waiter twistin' the cork","columns":58,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":44,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I got multi-colored rings like the Olympics, of course","columns":54,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":38,"beat":2}]},{"id":"line-14","kind":"lyric","text":"At award shows, cuttin' through the tension, of course","columns":54,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":38,"beat":2}]},{"id":"line-15","kind":"lyric","text":"Girls huggin' me then askin' me, \"What scent that is, boy?\"","columns":59,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":40,"beat":2}]},{"id":"line-16","kind":"lyric","text":"I be walkin' around the Six like I invented it, boy","columns":51,"beats":4,"changes":[{"symbol":"Asus2","column":6,"beat":0},{"symbol":"G","column":37,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Yeah, who am I? The do or die","columns":29,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":20,"beat":2}]},{"id":"line-18","kind":"lyric","text":"The one with the fewest lies and the truest ties","columns":48,"beats":4,"changes":[{"symbol":"Asus2","column":19,"beat":0}]},{"id":"line-19","kind":"lyric","text":"They try to compare us","columns":22,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"But like a job straight outta high school there's no you and I","columns":62,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":30,"beat":2}]},{"id":"line-21","kind":"lyric","text":"I taught you everything you know, now you got student pride","columns":59,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-22","kind":"lyric","text":"All factual, I call the house \"the embassy\"","columns":43,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":16,"beat":2}]},{"id":"line-23","kind":"lyric","text":"The studio \"the chapel\", I hate to travel","columns":41,"beats":4,"changes":[{"symbol":"Asus2","column":8,"beat":0},{"symbol":"G","column":28,"beat":2}]},{"id":"line-24","kind":"lyric","text":"I just pulled up on Solana show, the girl's a natural","columns":53,"beats":4,"changes":[{"symbol":"Dm","column":8,"beat":0},{"symbol":"Am","column":38,"beat":2}]},{"id":"line-25","kind":"lyric","text":"I knew her way back when Hollywood was international","columns":52,"beats":4,"changes":[{"symbol":"Asus2","column":4,"beat":0},{"symbol":"G","column":42,"beat":2}]},{"id":"line-26","kind":"lyric","text":"Yeah, the furthest I've been, that's word to my ends","columns":52,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":37,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Word to the flags that belong in the hood of my Benz","columns":52,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":38,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Very presidential, I broke all the codes for zonin' in my residential","columns":69,"beats":5,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":27,"beat":1},{"symbol":"Asus2","column":60,"beat":4}]},{"id":"line-29","kind":"lyric","text":"I broke spirits that I never meant to","columns":37,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"My body isn't much of a sacred temple, with vodka and wine","columns":58,"beats":6,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":9,"beat":2},{"symbol":"Asus2","column":40,"beat":4}]},{"id":"line-31","kind":"lyric","text":"And sleep at the opposite times","columns":31,"beats":2,"changes":[{"symbol":"G","column":7,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Promise shit is gettin' outta line like when you make a stencil","columns":63,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":30,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Or gettin' outta line like when you break a pencil","columns":50,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":22,"beat":2}]},{"id":"line-34","kind":"lyric","text":"Violatin' the Treaty of Versailles","columns":34,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":18,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Champagne is the alias, but no cease and desist in I","columns":52,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":33,"beat":2}]},{"id":"line-36","kind":"lyric","text":"I refuse to comply with regulations","columns":35,"beats":4,"changes":[{"symbol":"Dm","column":4,"beat":0},{"symbol":"Am","column":26,"beat":2}]},{"id":"line-37","kind":"lyric","text":"I listen to heavy metal for meditation, no silence","columns":50,"beats":4,"changes":[{"symbol":"Asus2","column":13,"beat":0},{"symbol":"G","column":40,"beat":2}]},{"id":"line-38","kind":"lyric","text":"Like Sanders on the Detroit Lions","columns":33,"beats":4,"changes":[{"symbol":"Dm","column":5,"beat":0},{"symbol":"Am","column":30,"beat":2}]},{"id":"line-39","kind":"lyric","text":"Get a run around and I'll bury you where they won't find ya","columns":59,"beats":4,"changes":[{"symbol":"Asus2","column":26,"beat":0},{"symbol":"G","column":53,"beat":2}]},{"id":"line-40","kind":"lyric","text":"Motor City Casino, I'm at the cage with my old license","columns":54,"beats":4,"changes":[{"symbol":"Dm","column":13,"beat":0},{"symbol":"Am","column":43,"beat":2}]},{"id":"line-41","kind":"lyric","text":"They tell me \"don't worry, I got your money\" like Osirus","columns":56,"beats":4,"changes":[{"symbol":"Asus2","column":21,"beat":0},{"symbol":"G","column":52,"beat":2}]},{"id":"line-42","kind":"lyric","text":"(I'm the Osiris of this shit)","columns":29,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"Dirty 30, workin' on me","columns":23,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":13,"beat":2}]},{"id":"line-44","kind":"lyric","text":"Tired of women that may tag me in pictures airin' my dirty laundry","columns":66,"beats":4,"changes":[{"symbol":"Asus2","column":11,"beat":0},{"symbol":"G","column":55,"beat":2}]},{"id":"line-45","kind":"lyric","text":"Caterin' is from Giorgio Baldi, Robyn's favorite","columns":48,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Am","column":19,"beat":2}]},{"id":"line-46","kind":"lyric","text":"Shit is nice, but I prefer Madeo","columns":32,"beats":4,"changes":[{"symbol":"Asus2","column":0,"beat":0},{"symbol":"G","column":24,"beat":2}]},{"id":"line-47","kind":"lyric","text":"Calamari rings and tomato","columns":25,"beats":4,"changes":[{"symbol":"Dm","column":2,"beat":0}]},{"id":"line-48","kind":"lyric","text":"I got the sauce and now shorties keep claimin' preggo","columns":56,"beats":5,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"Asus2","column":26,"beat":1},{"symbol":"G","column":55,"beat":4}]},{"id":"line-49","kind":"lyric","text":"Wakin' up at 6 PM like, \"Where does the day go?\"","columns":48,"beats":2,"changes":[{"symbol"