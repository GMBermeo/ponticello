{"version":1,"id":"the-1975-about-you","title":"About You","artist":"The 1975","key":"D","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/the-1975/about-you/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: The 1975 and George Daniel","chords":[{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I know a place","columns":14,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"A","column":9,"beat":2}]},{"id":"line-2","kind":"lyric","text":"It's somewhere I go when I need to remember your face","columns":56,"beats":3,"changes":[{"symbol":"Bm","column":5,"beat":0},{"symbol":"G","column":48,"beat":1},{"symbol":"A","column":55,"beat":2}]},{"id":"line-3","kind":"lyric","text":"We get married in our heads","columns":27,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0},{"symbol":"A","column":21,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Something to do while we try to recall how we met","columns":52,"beats":6,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"G","column":45,"beat":2},{"symbol":"A","column":51,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Do you think I have forgotten?","columns":30,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Do you think I have forgotten?","columns":30,"beats":6,"changes":[{"symbol":"A","column":7,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Do you think I have forgotten","columns":29,"beats":4,"changes":[{"symbol":"Bm","column":7,"beat":0}]},{"id":"line-8","kind":"lyric","text":"About you?","columns":12,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"A","column":11,"beat":2}]},{"id":"line-9","kind":"lyric","text":"You and I were alive","columns":20,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"A","column":16,"beat":2}]},{"id":"line-10","kind":"lyric","text":"With nothing to do I could lay and just look in your eyes","columns":60,"beats":8,"changes":[{"symbol":"Bm","column":5,"beat":0},{"symbol":"G","column":52,"beat":2},{"symbol":"A","column":59,"beat":5}]},{"id":"line-11","kind":"lyric","text":"Wait and pretend","columns":16,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"A","column":11,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Hold on and hope that we'll find our way back in the end","columns":60,"beats":6,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"G","column":49,"beat":2},{"symbol":"A","column":59,"beat":4}]},{"id":"line-13","kind":"lyric","text":"Do you think I have forgotten?","columns":30,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Do you think I have forgotten?","columns":30,"beats":4,"changes":[{"symbol":"A","column":7,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Do you think I have forgotten","columns":29,"beats":4,"changes":[{"symbol":"Bm","column":7,"beat":0}]},{"id":"line-16","kind":"lyric","text":"About you?","columns":12,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"A","column":11,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Do you think I have forgotten?","columns":30,"beats":4,"changes":[{"symbol":"D","column":7,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Do you think I have forgotten?","columns":30,"beats":6,"changes":[{"symbol":"A","column":7,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Do you think I have forgotten","columns":29,"beats":4,"changes":[{"symbol":"Bm","column":7,"beat":0}]},{"id":"line-20","kind":"lyric","text":"About you?","columns":12,"beats":4,"changes"