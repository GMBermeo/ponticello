{"version":1,"id":"lauren-spencer-smith-fingers-crossed","title":"Fingers Crossed","artist":"Lauren Spencer-Smith","key":"D","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/lauren-spencer-smith/fingers-crossed/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Erixson, London Fransisca and Lauren Spencer-Smith","chords":[{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Introduced me to your family","columns":28,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Watched my favourite shows on your TV","columns":37,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Made me breakfast in the morning","columns":32,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0}]},{"id":"line-4","kind":"lyric","text":"When you got home from work","columns":27,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Making plans to travel 'round the world","columns":39,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Said we'd always put each other first","columns":37,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Old love songs we used to play to","columns":33,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Funny now I hate you","columns":20,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Now, I remember when you'd call me late at night","columns":48,"beats":4,"changes":[{"symbol":"F","column":5,"beat":0},{"symbol":"Dm","column":43,"beat":2}]},{"id":"line-10","kind":"lyric","text":"And I gave you my hours and advice","columns":34,"beats":6,"changes":[{"symbol":"Gm","column":30,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Just tryna fix you and all your daddy issues","columns":44,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"But now, I don't even miss you anymore","columns":38,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0}]},{"id":"line-13","kind":"lyric","text":"So I, I want all the tears back that I cried","columns":44,"beats":4,"changes":[{"symbol":"F","column":3,"beat":0},{"symbol":"Dm","column":39,"beat":2}]},{"id":"line-14","kind":"lyric","text":"All the hours spent giving advice on how to write your songs","columns":60,"beats":4,"changes":[{"symbol":"Gm","column":29,"beat":0}]},{"id":"line-15","kind":"lyric","text":"All you did was prove me wrong","columns":30,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"When you said you loved me","columns":26,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Well you must've had your fingers crossed","columns":41,"beats":4,"changes":[{"symbol":"F","column":37,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Should've paid attention to my friends","columns":38,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Telling me how bad it's gonna end","columns":33,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Always giving their opinions","columns":28,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Now I wish I would have listened","columns":32,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-22",