{"version":1,"id":"taylor-swift-would-ve-could-ve-should-ve","title":"Would've, Could've, Should've","artist":"Taylor Swift","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/taylor-swift/would-ve-could-ve-should-ve/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Aaron Dessner and Taylor Swift","chords":[{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"D/F#","canonical":"D/F#","keyboardPitchClasses":[6,9,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"If you would've blinked then I would've","columns":39,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Em","column":15,"beat":2}]},{"id":"line-3","kind":"lyric","text":"Looked away at the first glance","columns":31,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":8,"beat":2}]},{"id":"line-4","kind":"lyric","text":"If you tasted poison","columns":20,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Em","column":13,"beat":2}]},{"id":"line-5","kind":"lyric","text":"You could've","columns":12,"beats":4,"changes":[]},{"id":"line-6","kind":"lyric","text":"Spit me out at the first chance","columns":31,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":8,"beat":2}]},{"id":"line-7","kind":"lyric","text":"And if I was some paint","columns":23,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Em","column":17,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Did it splatter","columns":