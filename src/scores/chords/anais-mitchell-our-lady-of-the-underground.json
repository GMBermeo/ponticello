{"version":1,"id":"anais-mitchell-our-lady-of-the-underground","title":"Our Lady Of The Underground","artist":"Anais Mitchell","key":"Am","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/anais-mitchell/our-lady-of-the-underground/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/6Gjhue17BgY9qNELrLXTpj","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Anaïs Mitchell","chords":[{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"E7","canonical":"E7","keyboardPitchClasses":[4,8,11,2],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"","columns":15,"beats":8,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E","column":6,"beat":2},{"symbol":"Am","column":8,"beat":4},{"symbol":"E","column":14,"beat":6}]},{"id":"line-2","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"(PERSEPHONE)","columns":12,"beats":4,"changes":[]},{"id":"line-4","kind":"lyric","text":"I don't know about you, boys","columns":28,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":26,"beat":2}]},{"id":"line-5","kind":"lyric","text":"But if you're like me, then hanging around","columns":42,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":39,"beat":2}]},{"id":"line-6","kind":"lyric","text":"This old manhole is bringing you down","columns":37,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":33,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Six-feet-under getting under your skin","columns":39,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":37,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Cabin fever is setting in","columns":27,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":25,"beat":2}]},{"id":"line-9","kind":"lyric","text":"You're stir crazy! You're stuck in a rut!","columns":41,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":38,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Or you could use a little pick-me-up","columns":36,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":34,"beat":2}]},{"id":"line-11","kind":"lyric","text":"I can give you what it is you crave","columns":35,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":31,"beat":2}]},{"id":"line-12","kind":"lyric","text":"A little something from the good old days","columns":41,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":37,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I got the wind right here in a jar","columns":34,"beats":8,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":32,"beat":4}]},{"id":"line-14","kind":"lyric","text":"I got the rain on tap at the bar","columns":32,"beats":8,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":30,"beat":4}]},{"id":"line-15","kind":"lyric","text":"I got sunshine up on the shelf","columns":30,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":26,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Allow me to introduce myself","columns":28,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Brother, what's my name?","columns":24,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-18","kind":"lyric","text":"My name is...","columns":13,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"(CROWD)","columns":7,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Our Lady of the Underground!","columns":28,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"(PERSEPHONE)","columns":12,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"Brother, what's my name?","columns":24,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"(CROWD)","columns":7,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"Our Lady of Ways! Our Lady of Means!","columns":36,"beats":4,"changes":[{"symbol":"Bb","column":13,"beat":0}]},{"id":"line-25","kind":"lyric","text":"(PERSEPHONE)","columns":12,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Brother, what's my name?","columns":24,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-27","kind":"lyric","text":"My name is...","columns":13,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"(CROWD)","columns":7,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"Our Lady of the Upside Down","columns":27,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"(PERSEPHONE)","columns":12,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"Brother what's my name?","columns":23,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"I'll tell you my name...","columns":27,"beats":4,"changes":[{"symbol":"Bb","column":25,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Persephone!","columns":11,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-34","kind":"section","text":"[Break]","columns":7,"beats":0,"changes":[]},{"id":"line-35","kind":"instrumental","text":"","columns":17,"beats":8,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":5,"beat":2},{"symbol":"Am","column":10,"beat":4},{"symbol":"E7","column":15,"beat":6}]},{"id":"line-36","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-37","kind":"lyric","text":"Come here, brother, let me guess","columns":32,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":28,"beat":2}]},{"id":"line-38","kind":"lyric","text":"It's the little things you miss","columns":31,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":29,"beat":2}]},{"id":"line-39","kind":"lyric","text":"Spring flowers, autumn leaves","columns":29,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":24,"beat":2}]},{"id":"line-40","kind":"lyric","text":"Ask me, brother, and you shall receive","columns":38,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":34,"beat":2}]},{"id":"line-41","kind":"lyric","text":"Or maybe these just ain't enough","columns":32,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":28,"beat":2}]},{"id":"line-42","kind":"lyric","text":"Maybe you're looking for some stronger stuff","columns":44,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":40,"beat":2}]},{"id":"line-43","kind":"lyric","text":"I got a sight for the sorest eye","columns":33,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":31,"beat":2}]},{"id":"line-44","kind":"lyric","text":"When's the last time you saw the sky?","columns":37,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-45","kind":"section","text":"[Bridge]","columns":8,"beats":0,"changes":[]},{"id":"line-46","kind":"lyric","text":"Wipe away your tears, brother","columns":29,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-47","kind":"lyric","text":"Brother, I know how you feel","columns":28,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-48","kind":"lyric","text":"I can see you're blinded by the sadness of it all","columns":49,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"Bb","column":35,"beat":2}]},{"id":"line-49","kind":"lyric","text":"But look a little closer, everything will be revealed","columns":53,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"Bb","column":27,"beat":2}]},{"id":"line-50","kind":"lyric","text":"Look a little closer, there's a crack in the wall","columns":49,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"Bb","column":21,"beat":2}]},{"id":"line-51","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-52","kind":"lyric","text":"You want stars? I got a skyful","columns":30,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":24,"beat":2}]},{"id":"line-53","kind":"lyric","text":"Put a quarter in the slot, you'll get an eyeful","columns":47,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":42,"beat":2}]},{"id":"line-54","kind":"lyric","text":"You want the moon? I got her too","columns":34,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":32,"beat":2}]},{"id":"line-55","kind":"lyric","text":"She's right here waiting in my pay-per-view","columns":43,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-56","kind":"lyric","text":"Oh, how long's it been?","columns":23,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":19,"beat":2}]},{"id":"line-57","kind":"lyric","text":"A little moonshine ain't no sin","columns":32,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":30,"beat":2}]},{"id":"line-58","kind":"lyric","text":"One at a time, boys, straight line","columns":34,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"E7","column":31,"beat":2}]},{"id":"line-59","kind":"lyric","text":"What the boss don't know, the boss won't mind","columns":45,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]}]}