{"version":1,"id":"sam-hunt-body-like-a-back-road","title":"Body Like a Back Road","artist":"Sam Hunt","key":"F","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/sam-hunt/body-like-a-back-road/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Josh Osborne, Shane L. McAnally, Sam Lawry Hunt and Zachery Miller Crowell","chords":[{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"Bb9","canonical":"Bbadd9","keyboardPitchClasses":[10,0,2],"interpretation":"Keyboard interpretation: Bbadd9"},{"symbol":"B9b","canonical":null,"keyboardPitchClasses":[11,1,3,10],"interpretation":"No verified cello diagram for this symbol. Source chord retained."},{"symbol":"B9m","canonical":"Bm9","keyboardPitchClasses":[],"interpretation":"Keyboard interpretation: Bm9"}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":22,"beats":8,"changes":[{"symbol":"F","column":9,"beat":0},{"symbol":"C","column":12,"beat":2},{"symbol":"Dm","column":15,"beat":4},{"symbol":"Bb9","column":19,"beat":6}]},{"id":"line-2","kind":"lyric","text":"Got a girl from the south side, got braids in her hair","columns":54,"beats":4,"changes":[{"symbol":"C","column":31,"beat":0},{"symbol":"Dm","column":49,"beat":2}]},{"id":"line-3","kind":"lyric","text":"First time I seen her walk by, man I 'bout fell off my chair","columns":60,"beats":8,"changes":[{"symbol":"Bb9","column":0,"beat":0},{"symbol":"F","column":23,"beat":2},{"symbol":"Bb9","column":31,"beat":4},{"symbol":"F","column":48,"beat":6}]},{"id":"line-4","kind":"lyric","text":"Had to get her number, it took me like six weeks","columns":48,"beats":6,"changes":[{"symbol":"F","column":15,"beat":0},{"symbol":"C","column":22,"be