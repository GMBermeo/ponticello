anges":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":31,"beat":2}]},{"id":"line-17","kind":"lyric","text":"And a million feet that fell in line","columns":36,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Gm","column":24,"beat":2}]},{"id":"line-18","kind":"lyric","text":"and stepped in time with Hades' step","columns":36,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":25,"beat":2}]},{"id":"line-19","kind":"lyric","text":"and a million minds that were just one mind","columns":43,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":30,"beat":2}]},{"id":"line-20","kind":"lyric","text":"Like stones in a row, stone by stone, row by row, the river rose up singing","columns":75,"beats":12,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":17,"beat":2},{"symbol":"Dm","column":22,"beat":4},{"symbol":"C","column":31,"beat":6},{"symbol":"Dm","column":38,"beat":8},{"symbol":"C","column":45,"beat":10}]},{"id":"line-21","kind":"lyric","text":"la la la la la la la","columns":20,"beats":8,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":9,"beat":2},{"symbol":"Bb","column":18,"beat":5}]},{"id":"line-22","kind":"lyric","text":"la la la la la la la, oh, singing","columns":33,"beats":6,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":9,"beat":2},{"symbol":"B","column":18,"beat":4}]},{"id":"line-23","kind":"lyric","text":"la la la la la la la","columns":20,"beats":6,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":9,"beat":2},{"symbol":"Bb","column":18,"beat":4}]},{"id":"line-24","kind":"lyric","text":"la la la la la la la","columns":20,"beats":8,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"C","column":9,"beat":2},{"symbol":"Am","column":18,"beat":5}]}]}