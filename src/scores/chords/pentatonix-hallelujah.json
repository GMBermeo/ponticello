{"version":1,"id":"pentatonix-hallelujah","title":"Hallelujah","artist":"Pentatonix","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/pentatonix/hallelujah/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Leonard Cohen","chords":[{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"D7","canonical":"D7","keyboardPitchClasses":[2,6,9,0],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I've heard there was a secret chord","columns":35,"beats":4,"changes":[{"symbol":"Bb","column":6,"beat":0},{"symbol":"Gm","column":25,"beat":2}]},{"id":"line-2","kind":"lyric","text":"That David played and it pleased the Lord","columns":41,"beats":4,"changes":[{"symbol":"Bb","column":6,"beat":0},{"symbol":"Gm","column":27,"beat":2}]},{"id":"line-3","kind":"lyric","text":"But you don't really care for music, do ya?","columns":43,"beats":4,"changes":[{"symbol":"Eb","column":5,"beat":0},{"symbol":"F","column":22,"beat":1},{"symbol":"Bb","column":37,"beat":2},{"symbol":"F","column":42,"beat":3}]},{"id":"line-4","kind":"lyric","text":"Well, it goes like this","columns":23,"beats":4,"changes":[{"symbol":"Bb","column":1,"beat":0}]},{"id":"line-5","kind":"lyric","text":"The fourth, the fifth, the minor fall, the major lift","columns":53,"beats":8,"changes":[{"symbol":"Eb","column":6,"beat":0},{"symbol":"F","column":18,"beat":2},{"symbol":"Gm","column":28,"beat":4},{"symbol":"Eb","column":44,"beat":6}]},{"id":"line-6","kind":"lyric","text":"The baffled king composing Hallelujah","columns":37,"beats":6,"changes":[{"symbol":"F","column":1,"beat":0},{"symbol":"D7","column":20,"beat":2},{"symbol":"Gm","column":30,"beat":4}]},{"id":"line-7","kind":"lyric","text":"Hallelujah, Hallelujah","columns":22,"beats":4,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"Gm","column":14,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Hallelujah, Halleluuuuuuujah","columns":28,"beats":8,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"Bb","column":14,"beat":2},{"symbol":"F","column":20,"beat":4},{"symbol":"Bb","column":24,"beat":6}]},{"id":"line-9","kind":"instrumental","text":"(        )","columns":10,"beats":4,"changes":[{"symbol":"Bb","column":2,"beat":0},{"symbol":"Gm","column":6,"beat":2}]},{"id":"line-10","kind":"instrumental","text":"(        )","columns":10,"beats":4,"changes":[{"symbol":"Bb","column":2,"beat":0},{"symbol":"Gm","column":6,"beat":2}]},{"id":"line-11","kind":"lyric","text":"Well, your faith was strong but you needed proof","columns":48,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Gm","column":36,"beat":2}]},{"id":"line-12","kind":"lyric","text":"You saw her bathing on the roof","columns":31,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Gm","column":27,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Her beauty and the moonlight overthrew ya","columns":42,"beats":8,"changes":[{"symbol":"Eb","column":0,"beat":0},{"symbol":"F","column":19,"beat":2},{"symbol":"Bb","column":31,"beat":4},{"symbol":"F","column":41,"beat":6}]},{"id":"line-14","kind":"lyric","text":"She tied you to the kitchen chair","columns":33,"beats":6,"changes":[{"symbol":"Bb","column":1,"beat":0},{"symbol":"Eb","column":20,"beat":2},{"symbol":"F","column":29,"beat":4}]},{"id":"line-15","kind":"lyric","text":"She broke your throne and she cut your hair","columns":43,"beats":4,"changes":[{"symbol":"Gm","column":1,"beat":0},{"symbol":"Eb","column":27,"beat":2}]},{"id":"line-16","kind":"lyric","text":"And from your lips, she drew the Hallelujah","columns":43,"beats":6,"changes":[{"symbol":"F","column":1,"beat":0},{"symbol":"D7","column":21,"beat":2},{"symbol":"Gm","column":34,"beat":4}]},{"id":"line-17","kind":"lyric","text":"Hallelujah, Hallelujah","columns":22,"beats":4,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"Gm","column":16,"beat":2}]},{"id":"line-18","kind":"lyric","text":"Hallelujah, Halleluuuuuuuujah","columns":29,"beats":8,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"Bb","column":13,"beat":2},{"symbol":"F","column":20,"beat":4},{"symbol":"Bb","column":26,"beat":6}]},{"id":"line-19","kind":"instrumental","text":"(        )","columns":10,"beats":4,"changes":[{"symbol":"Bb","column":2,"beat":0},{"symbol":"Gm","column":6,"beat":2}]},{"id":"line-20","kind":"instrumental","text":"(        )","columns":10,"beats":4,"changes":[{"symbol":"Bb","column":2,"beat":0},{"symbol":"Gm","column":6,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Well, baby, I've been here before","columns":33,"beats":4,"changes":[{"symbol":"Bb","column":1,"beat":0},{"symbol":"Gm","column":22,"beat":2}]},{"id":"line-22","kind":"lyric","text":"I've seen this room and I've walked this floor","columns":46,"beats":4,"changes":[{"symbol":"Bb","column":1,"beat":0},{"symbol":"Gm","column":32,"beat":2}]},{"id":"line-23","kind":"lyric","text":"I used to live alone before I knew ya","columns":39,"beats":8,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"F","column":18,"beat":2},{"symbol":"Bb","column":33,"beat":4},{"symbol":"F","column":38,"beat":6}]},{"id":"line-24","kind":"lyric","text":"And I've seen your flag on the marble arch","columns":42,"beats":6,"changes":[{"symbol":"Bb","column":1,"beat":0},{"symbol":"Eb","column":17,"beat":2},{"symbol":"F","column":35,"beat":4}]},{"id":"line-25","kind":"lyric","text":"And love is not a victory march","columns":31,"beats":4,"changes":[{"symbol":"Gm","column":1,"beat":0},{"symbol":"Eb","column":19,"beat":2}]},{"id":"line-26","kind":"lyric","text":"It's a cold and it's a broken Hallelujah","columns":40,"beats":6,"changes":[{"symbol":"F","column":1,"beat":0},{"symbol":"D7","column":19,"beat":2},{"symbol":"Gm","column":34,"beat":4}]},{"id":"line-27","kind":"lyric","text":"Hallelujah, Hallelujah","columns":22,"beats":4,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"Gm","column":13,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Hallelujah, Halleluuuuuuuuujah","columns":30,"beats":8,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"Bb","column":13,"beat":2},{"symbol":"F","column":21,"beat":4},{"symbol":"Bb","column":28,"beat":6}]},{"id":"line-29","kind":"lyric","text":"Well, maybe there's a God above","columns":31,"beats":4,"changes":[{"symbol":"Bb","column":1,"beat":0},{"symbol":"Gm","column":24,"beat":2}]},{"id":"line-30","kind":"lyric","text":"But all I've ever learned from love","columns":35,"beats":4,"changes":[{"symbol":"Bb","column":1,"beat":0},{"symbol":"Gm","column":21,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Was how to shoot somebody who outdrew ya","columns":41,"beats":8,"changes":[{"symbol":"Eb","column":1,"beat":0},{"symbol":"F","column":21,"beat":2},{"symbol":"Bb","column":35,"beat":4},{"symbol":"F","column":40,"beat":6}]},{"id":"line-32","kind":"lyric","text":"And it's not a cry that you hear at night","columns":41,"beats":6,"changes":[{"symbol":"Bb","column":2,"beat":0},{"symbol":"Eb","column":19,"beat":2},{"symbol":"F","column":32,"beat":4}]},{"id":"line-33","kind":"lyric","text":"It's not somebody who's seen the light","columns":38,"beats":4,"changes":[{"symbol":"Gm","column":5,"beat":0},{"symbol":"Eb","column":25,"beat":2}]},{"id":"line-34","kind":"lyric","text":"It's a cold and it's a broken Hallelujah","columns":40,"beats":6,"changes":[{"symbol":"F","column":1,"beat":0},{"symbol":"D7","column":17,"beat":2},{"symbol":"Gm","column":33,"beat":4}]},{"id":"line-35","kind":"lyric","text":"Hallelujah, Hallelujah","columns":22,"beats":4,"changes":[{"symbol":"Eb","column":4,"beat":0},{"symbol":"Gm","column":17,"beat":2}]},{"