olumn":23,"beat":2}]},{"id":"line-9","kind":"lyric","text":"You saw me look at you","columns":22,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-10","kind":"instrumental","text":"(       )","columns":9,"beats":4,"changes":[{"symbol":"F","column":2,"beat":0},{"symbol":"Dm","column":5,"beat":2}]},{"id":"line-11","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-12","kind":"lyric","text":"I burn for you","columns":14,"beats":4,"changes":[{"symbol":"A#","column":2,"beat":0}]},{"id":"line-13","kind":"lyric","text":"  And you don’t even know my name","columns":36,"beats":6,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"A#","column":21,"beat":2},{"symbol":"Dm","column":34,"beat":4}]},{"id":"line-14","kind":"lyric","text":"If you asked me to","columns":18,"beats":4,"changes":[{"symbol":"A#","column":3,"beat":0}]},{"id":"line-15","kind":"lyric","text":"  I'd give up everything","columns":27,"beats":6,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"A#","column":15,"beat":2},{"symbol":"Dm","column":25,"beat":4}]},{"id":"line-16","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-17","kind":"lyric","text":"To be close to you","columns":18,"beats":4,"changes":[{"symbol":"A#","column":6,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Pull the trigger on the gun","columns":27,"beats":8,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Dm","column":24,"beat":4}]},{"id":"line-19","kind":"lyric","text":"I gave you when we met","columns":22,"beats":4,"changes":[{"symbol":"Am","column":19,"beat":0}]},{"id":"line-20","kind":"lyric","text":"I wanna be close to you","columns":23,"beats":4,"changes":[{"symbol":"A#","column":11,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Break my heart and start a fire","columns":31,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Dm","column":25,"beat":2}]},{"id":"line-22","kind":"lyric","text":"You got me overni