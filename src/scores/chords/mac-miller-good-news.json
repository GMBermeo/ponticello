{"version":1,"id":"mac-miller-good-news","title":"Good News","artist":"Mac Miller","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/mac-miller/good-news/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Jon Brion and Mac Miller","chords":[{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"G#7","canonical":"G#7","keyboardPitchClasses":[8,0,3,6],"interpretation":null},{"symbol":"C#m7","canonical":"C#m7","keyboardPitchClasses":[1,4,8,11],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":34,"beats":12,"changes":[{"symbol":"E","column":8,"beat":0},{"symbol":"G#7","column":11,"beat":2},{"symbol":"C#m7","column":16,"beat":4},{"symbol":"A","column":22,"beat":6},{"symbol":"C#m7","column":25,"beat":8},{"symbol":"G#7","column":31,"beat":10}]},{"id":"line-2","kind":"instrumental","text":"","columns":34,"beats":12,"changes":[{"symbol":"E","column":8,"beat":0},{"symbol":"G#7","column":11,"beat":2},{"symbol":"C#m7","column":16,"beat":4},{"symbol":"A","column":22,"beat":6},{"symbol":"C#m7","column":25,"beat":8},{"symbol":"G#7","column":31,"beat":10}]},{"id":"line-3","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-4","kind":"lyric","text":"I spent the whole day in my head","columns":32,"beats":6,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"G#7","column":18,"beat":2},{"symbol":"C#m7","column":27,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Do a little spring cleanin'","columns":27,"beats":4,"changes":[{"symbol":"A","column":19,"beat":0}]},{"id":"line-6","kind":"lyric","text":"I'm always too busy dreamin', yeah","columns":34,"beats":4,"changes":[{"symbol":"C#m7","column":1,"beat":0},{"symbol":"G#7","column":16,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Well, maybe I should wake up instead","columns":36,"beats":6,"changes":[{"symbol":"E","column":7,"beat":0},{"symbol":"G#7","column":21,"beat":2},{"symbol":"C#m7","column":29,"beat":4}]},{"id":"line-8","kind":"lyric","text":"A lot of things I regret, but I just say, \"I forget\"","columns":52,"beats":6,"changes":[{"symbol":"A","column":19,"beat":0},{"symbol":"C#m7","column":35,"beat":2},{"symbol":"G#7","column":43,"beat":4}]},{"id":"line-9","kind":"lyric","text":"Why can't it just be easy?","columns":31,"beats":4,"changes":[{"symbol":"E","column":20,"beat":0},{"symbol":"G#7","column":28,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Why does everybody need me to stay?","columns":35,"beats":4,"changes":[{"symbol":"C#m7","column":17,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Oh, I hate the feeling","columns":22,"beats":4,"changes":[{"symbol":"A","column":15,"beat":0}]},{"id":"line-12","kind":"lyric","text":"When you're high but you're underneath the ceiling","columns":50,"beats":4,"changes":[{"symbol":"C#m7","column":14,"beat":0},{"symbol":"G#7","column":29,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Got the cards in my hand, I hate dealing, yeah","columns":47,"beats":6,"changes":[{"symbol":"E","column":33,"beat":0},{"symbol":"G#7","column":36,"beat":2},{"symbol":"C#m7","column":43,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Get everything I need then I'm gone, but it ain't stealing","columns":58,"beats":8,"changes":[{"symbol":"A","column":2,"beat":0},{"symbol":"C#m7","column":17,"beat":2},{"symbol":"G#7","column":29,"beat":5}]},{"id":"line-15","kind":"lyric","text":"Can I get a break?","columns":18,"beats":4,"changes":[{"symbol":"E","column":11,"beat":0}]},{"id":"line-16","kind":"lyric","text":"I wish that I could just get out my goddamn way","columns":47,"beats":4,"changes":[{"symbol":"G#7","column":0,"beat":0},{"symbol":"C#m7","column":20,"beat":2}]},{"id":"line-17","kind":"lyric","text":"What is there to say?","columns":21,"beats":4,"changes":[{"symbol":"A","column":16,"beat":0}]},{"id":"line-18","kind":"lyric","text":"There ain't a better time than today","columns":36,"beats":4,"changes":[{"symbol":"C#m7","column":14,"beat":0},{"symbol":"G#7","column":31,"beat":2}]},{"id":"line-19","kind":"lyric","text":"But maybe I'll lay down for a little, yeah","columns":42,"beats":6,"changes":[{"symbol":"E","column":4,"beat":0},{"symbol":"G#7","column":19,"beat":2},{"symbol":"C#m7","column":31,"beat":4}]},{"id":"line-20","kind":"lyric","text":"Instead of always trying to   figure everything out","columns":51,"beats":3,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"C#m7","column":24,"beat":1},{"symbol":"G#7","column":32,"beat":2}]},{"id":"line-21","kind":"lyric","text":"And all I do is say sorry","columns":25,"beats":6,"changes":[{"symbol":"E","column":2,"beat":0},{"symbol":"G#7","column":10,"beat":2},{"symbol":"C#m7","column":21,"beat":4}]},{"id":"line-22","kind":"lyric","text":"Half the time I don't even know what I'm saying it about","columns":56,"beats":6,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"C#m7","column":19,"beat":2},{"symbol":"G#7","column":31,"beat":4}]},{"id":"line-23","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-24","kind":"lyric","text":"Good news, good news, good news","columns":31,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"G#7","column":11,"beat":2}]},{"id":"line-25","kind":"lyric","text":"That's all they wanna hear","columns":26,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"No, they don't like you when I'm down","columns":37,"beats":6,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"C#m7","column":17,"beat":2},{"symbol":"G#7","column":30,"beat":4}]},{"id":"line-27","kind":"lyric","text":"But when I'm flying, oh","columns":23,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"G#7","column":6,"beat":2}]},{"id":"line-28","kind":"lyric","text":"It make 'em so uncomfortable","columns":28,"beats":4,"changes":[{"symbol":"C#m7","column":3,"beat":0}]},{"id":"line-29","kind":"lyric","text":"So different, what's the difference?","columns":36,"beats":6,"changes":[{"symbol":"A","column":1,"beat":0},{"symbol":"C#m7","column":14,"beat":2},{"symbol":"G#7","column":24,"beat":4}]},{"id":"line-30","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-31","kind":"lyric","text":"Well, it ain't that bad","columns":23,"beats":4,"changes":[{"symbol":"E","column":20,"beat":0}]},{"id":"line-32","kind":"lyric","text":"It could always be worse","columns":24,"beats":4,"changes":[{"symbol":"G#7","column":1,"beat":0},{"symbol":"C#m7","column":15,"beat":2}]},{"id":"line-33","kind":"lyric","text":"I'm running out of gas, hardly anything left","columns":44,"beats":4,"changes":[{"symbol":"A","column":19,"beat":0}]},{"id":"line-34","kind":"lyric","text":"Hope I make it home from work","columns":29,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0},{"symbol":"G#7","column":18,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Well, so tired of being so tired","columns":32,"beats":6,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"G#7","column":10,"beat":2},{"symbol":"C#m7","column":23,"beat":4}]},{"id":"line-36","kind":"lyric","text":"Why I gotta build something beautiful just to go set it on fire?","columns":64,"beats":3,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"C#m7","column":28,"beat":1},{"symbol":"G#7","column":55,"beat":2}]},{"id":"line-37","kind":"lyric","text":"   I'm no liar, but","columns":20,"beats":6,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"G#7","column":8,"beat":2},{"symbol":"C#m7","column":16,"beat":4}]},{"id":"line-38","kind":"lyric","text":"Sometimes the truth don't sound like the truth","columns":46,"beats":2,"changes":[{"symbol":"A","column":39,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Maybe 