{"version":1,"id":"xavi-mx-la-victima","title":"La Víctima","artist":"Xavi (MX)","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/xavi-mx/la-victima/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Xavi","chords":[{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A#m","canonical":"A#m","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Ya pensé","columns":8,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Dos veces antes de que tú me la juegues con que ya yo no sé","columns":59,"beats":6,"changes":[{"symbol":"A#m","column":0,"beat":0},{"symbol":"Bm","column":10,"beat":2},{"symbol":"Em","column":48,"beat":4}]},{"id":"line-3","kind":"lyric","text":"No te hagas la víctima, tú sabes claramente lo que hiciste","columns":58,"beats":4,"changes":[{"symbol":"A","column":51,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Cometimos errores","columns":17,"beats":4,"changes":[]},{"id":"line-5","kind":"lyric","text":"Pero, esta vez, no vuelvo, porque te pasas de lanza","columns":51,"beats":4,"changes":[{"symbol":"D","column":19,"beat":0},{"symbol":"F#","column":46,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Y nunca fue bastante para que tú te calmaras en la puteada y ver","columns":64,"beats":8,"changes":[{"symbol":"Bm","column":2,"beat":0},{"symbol":"A#m","column":12,"beat":2},{"symbol":"Bm","column":21,"beat":4},{"symbol":"Em","column":56,"beat":6}]},{"id":"line-7","kind":"lyric","text":"El hombre que te amaba, no lo valoraste y te pelaste por feria","columns":62,"beats":4,"changes":[{"symbol":"A","column":50,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Ahora quieres buscarme","columns":22,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"Pero yo ya no puedo, porque ando por todas partes","columns":49,"beats":4,"changes":[{"symbol":"D","column":14,"beat":0},{"symbol":"F#","column":43,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Y AMG en mi caravana con toda la plebada fui pa' la privada aquella","columns":67,"beats":4,"changes":[{"symbol":"Bm","column":2,"beat":0},{"symbol":"A#m","column":6,"beat":1},{"symbol":"Bm","column":16,"beat":2},{"symbol":"Em","column":55,"beat":3}]},{"id":"line-11","kind":"lyric","text":"Quise empedarme para no pensarte y resultaste estar ahí","columns":55,"beats":4,"changes":[{"symbol":"A","column":48,"beat":0}]},{"id":"line-12","kind":"lyric","text":"En medio de otros brazos","columns":24,"beats":4,"changes":[]},{"id":"line-13","kind":"lyric","text":"Y yo pensé que me querias","columns":25,"beats":4,"changes":[{"symbol":"D","column":21,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Y otra vez con tus mentiras","columns":27,"beats":4,"changes":[{"symbol":"F#","column":22,"beat":0}]},{"id":"line-15","kind":"lyric","text":"(La víctima)","columns":12,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"Ya pensé","columns":8,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Dos veces antes de que tú me la juegues con que ya yo no sé","columns":59,"beats":6,"changes":[{"symbol":"A#m","column":0,"beat":0},{"symbol":"Bm","column":10,"beat":2},{"symbol":"Em","column":48,"beat":4}]},{"id":"line-18","kind":"lyric","text":"No te hagas la víctima, tú sabes claramente lo que hiciste","columns":58,"beats":4,"changes":[{"symbol":"A","column":51,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Cometimos errores","columns":17,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Pero, esta vez, no vuelvo, porque te pasas de lanza","columns":51,"beats":4,"changes":[{"symbol":"D","column":19,"beat":0},{"symbol":"F#","column":46,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Y de una vez, agarra tus cosas, pélate a la verga","columns":49,"beats":6,"changes":[{"symbol":"Bm","column":2,"beat":0},{"symbol":"A#m","column":14,"beat":2},{"symbol":"Bm","column":25,"beat":4}]},{"id":"line-22","kind":"lyric","text":"No quiero volverte a ver","columns":24,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Y vive esa vida que tanto querías","columns":33,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"Malagradecida eres","columns":18,"beats":4,"changes":[{"symbol":"A","column":9,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Me quebraste el corazón, porque pensé que me querías","columns":52,"beats":4,"changes":[{"symbol":"D","column":48,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Y otra vez con tus mentiras","columns":27,"beats":4,"changes":[{"symbol":"F#","column":23,"beat":0}]}]}