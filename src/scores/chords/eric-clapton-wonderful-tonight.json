]},{"id":"line-8","kind":"lyric","text":"    She's wondering what clothes to wear","columns":40,"beats":4,"changes":[{"symbol":"C/E","column":0,"beat":0},{"symbol":"D5","column":27,"beat":2}]},{"id":"line-9","kind":"lyric","text":"  She puts on her make-up","columns":26,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":21,"beat":2}]},{"id":"line-10","kind":"lyric","text":"    And brushes her long blond hair","columns":35,"beats":4,"changes":[{"symbol":"C/E","column":0,"beat":0},{"symbol":"D5","column":21,"beat":2}]},{"id":"line-11","kind":"lyric","text":"   And then she asks me","columns":23,"beats":4,"changes":[{"symbol":"C9","column":0,"beat":0},{"symbol":"D5","column":19,"beat":2}]},{"id":"line-12","kind":"lyric","text":"  \"Do I look all right?\"","columns":24,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":9,"beat":2},{"symbol":"Em","column":18,"beat":4}]},{"id":"line-13","kind":"lyric","text":"And I say yes","columns":16,"beats":4,"changes":[{"symbol":"C9","column":14,"beat":0}]},{"id":"line-14","kind":"lyric","text":"You look wonderful tonight","columns":41,"beats":10,"changes":[{"symbol":"D5","column":10,"beat":0},{"symbol":"G","column":22,"beat":2},{"symbol":"D4/F#","column":27,"beat":4},{"symbol":"C/E","column":34,"beat":6},{"symbol":"D5","column":39,"beat":8}]},{"id":"line-15","kind":"lyric","text":"(Guitarra Base 1)","columns":17,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"(Guitarra Base 2)","columns":17,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"(Guitarra Solo)","columns":15,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Segunda Parte:","columns":14,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"  We go to a party","columns":22,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":17,"beat":4}]},{"id":"line-20","kind":"lyric","text":"    And everyone turns to see","columns":29,"beats":4,"changes":[{"symbol":"C/E","column":0,"beat":0},{"symbol":"D5","column":18,"beat":2}]},{"id":"line-21","kind":"lyric","text":"  This beautiful lady","columns":23,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":18,"beat":2}]},{"id":"line-22","kind":"lyric","text":"    That's walking around with me","columns":33,"beats":4,"changes":[{"symbol":"C/E","column":0,"beat":0},{"symbol":"D5","column":21,"beat":2}]},{"id":"line-23","kind":"lyric","text":"   And then she asks me","columns":23,"beats":4,"changes":[{"symbol":"C9","column":0,"beat":0},{"symbol":"D5","column":19,"beat":2}]},{"id":"line-24","kind":"lyric","text":"  \"Do you feel all right?\"","columns":26,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":11,"beat":2},{"symbol":"Em","column":20,"beat":4}]},{"id":"line-25","kind":"lyric","text":"And I say yes","columns":16,"beats":4,"changes":[{"symbol":"C9","column":14,"beat":0}]},{"id":"line-26","kind":"lyric","text":"I feel wonderful tonight","columns":24,"beats":4,"changes":[{"symbol":"D5","column":8,"beat":0},{"symbol":"G","column":20,"beat":2}]},{"id":"line-27","kind":"lyric","text":"(Guitarra Base 1)","columns":17,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"(Guitarra Base 2)","columns":17,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"(Guitarra Solo)","columns":15,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"Terceira Parte:","columns":15,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"I feel wonderful, because I see","columns":31,"beats":4,"changes":[{"symbol":"C9","column":8,"beat":0},{"symbol":"D5","column":21,"beat":2}]},{"id":"line-32","kind":"lyric","text":"The love light in your eyes","columns":27,"beats":6,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"D4/F#","column":15,"beat":2},{"symbol":"Em","column":23,"beat":4}]},{"id":"line-33","kind":"lyric","text":"And the wonder of it all","columns":24,"beats":4,"changes":[{"symbol":"C9","column":9,"beat":0},{"symbol":"D5","column":21,"beat":2}]},{"id":"line-34","kind":"lyric","text":"Is that you just don't realize","columns":30,"beats":4,"changes":[{"symbol":"C9","column":13,"beat":0},{"symbol":"D5","column":27,"beat":2}]},{"id":"line-35","kind":"lyric","text":"How much I love you","columns":53,"beats":16,"changes":[{"symbol":"G","column":12,"beat":0},{"symbol":"D4/F#","column":20,"beat":2},{"symbol":"C/E","column":27,"beat":4},{"symbol":"D5","column":32,"beat":6},{"symbol":"G","column":36,"beat":8},{"symbol":"D4/F#","column":39,"beat":10},{"symbol":"C/E","column":46,"beat":12},{"symbol":"D5","column":51,"beat":14}]},{"id":"line-36","kind":"lyric","text":"(Guitarra Base 1)","columns":17,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"(Guitarra Base 2)","columns":17,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"(Guitarra Solo)","columns":15,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"Quarta Parte:","columns":13,"beats":4,"changes":[]},{"id":"line-40","kind":"lyric","text":"  It's time to go home now","columns":26,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":19,"beat":2}]},{"id":"line-41","kind":"lyric","text":"    I've got an aching head","columns":27,"beats":4,"changes":[{"symbol":"C/E","column":0,"beat":0},{"symbol":"D5","column":24,"beat":2}]},{"id":"line-42","kind":"lyric","text":"  So I give her the car keys","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":24,"beat":2}]},{"id":"line-43","kind":"lyric","text":"    She help me to bed","columns":25,"beats":4,"changes":[{"symbol":"C/E","column":0,"beat":0},{"symbol":"D5","column":23,"beat":2}]},{"id":"line-44","kind":"lyric","text":"   And then I tell her","columns":22,"beats":4,"changes":[{"symbol":"C9","column":0,"beat":0},{"symbol":"D5","column":18,"beat":2}]},{"id":"line-45","kind":"lyric","text":"  As I turn out the light","columns":25,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D4/F#","column":8,"beat":2},{"symbol":"Em","column":21,"beat":4}]},{"id":"line-46","kind":"lyric","text":"I say, my darling","columns":17,"beats":4,"changes":[{"symbol":"C9","column":11,"beat":0}]},{"id":"line-47","kind":"lyric","text":"You were wonderful tonight","columns":40,"beats":5,"changes":[{"symbol":"D5","column":10,"beat":0},{"symbol":"G","column":22,"beat":1},{"symbol":"D4/F#","column":27,"beat":2},{"symbol":"Em","column":34,"beat":3},{"symbol":"D5","column":38,"beat":4}]},{"id":"line-48","kind":"lyric","text":"Oh, my darling","columns":14,"beats":4,"changes":[{"symbol":"C9","column":8,"beat":0}]},{"id":"line-49","kind":"lyric","text":"You were wonderful tonight","columns":26,"beats":4,"changes":[{"symbol":"D5","column":10,"beat":0}]},{"id":"line-50","kind":"lyric","text":"(Guitarra Base 1)","columns":17,"beats":4,"changes":[]},{"id":"line-51","kind":"lyric","text":"(Guitarra Base 2)","columns":17,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"(Guitarra Solo)","columns":15,"beats":4,"changes":[]},{"id":"line-53","kind":"instrumental","text":"Final:","columns":24,"beats":8,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"D4/F#","column":10,"beat":2},{"symbol":"C/E","column":17,"beat":4},{"symbol":"D5","column":22,"beat":6}]},{"id":"line-54","kind":"instrumental","text":"","columns":24,"beats":8,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"D4/F#","column":10,"beat":2},{"symbol":"C/E","column":17,"beat":4},{"symbol":"D5","column":22,"beat":6}]},{"id":"line-55","kind":"instrumental","text":"","columns":8,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0}]},{"id":"line-56","kind":"lyric","text":"(Guitarra Base 1)","columns":17,"beats":4,"changes":[]},{"id":"line-57","kind":"lyric","text":"(Guitarra Base 2)","columns":17,"beats":4,"changes":[]},{"id":"line-58","kind":"lyric","text":"(Guitarra Solo)","columns":15,"beats":4,"changes":[]}]}