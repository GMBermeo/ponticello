:[0,4,7,10],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"Bb7","canonical":"Bb7","keyboardPitchClasses":[10,2,5,8],"interpretation":null},{"symbol":"Ab/Eb","canonical":"Ab/Eb","keyboardPitchClasses":[3,8,0],"interpretation":null},{"symbol":"Db/Eb","canonical":"Db/Eb","keyboardPitchClasses":[],"interpretation":null},{"symbol":"E7","canonical":"E7","keyboardPitchClasses":[4,8,11,2],"interpretation":null},{"symbol":"A7(5-)","canonical":"A7b5","keyboardPitchClasses":[9,1,3,7],"interpretation":"Keyboard interpretation: A7b5"},{"symbol":"Ab7","canonical":"Ab7","keyboardPitchClasses":[8,0,3,6],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":21,"beats":8,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"Em","column":11,"beat":2},{"symbol":"Am7","column":15,"beat":4},{"symbol":"D","column":20,"beat":6}]},{"id":"line-2","kind":"instrumental","text":"","columns":21,"beats":8,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"Em","column":11,"beat":2},{"symbol":"Am7","column":15,"beat":4},{"symbol":"D","column":20,"beat":6}]},{"id":"line-3","kind":"lyric","text":"That's life (that's life), that's what all the people say","columns":57,"beats":4,"changes":[{"symbol":"G","column":3,"beat":0},{"symbol":"B7","column":35,"beat":2}]},{"id":"line-4","kind":"lyric","text":"  You're ridin' high in April,  shot down in May","columns":48,"beats":4,"changes":[{"symbol":"Em7","column":0,"beat":0},{"symbol":"A7","column":30,"beat":2}]},{"id":"line-5","kind":"lyric","text":"But I know I'm gonna change that tune","columns":42,"beats":8,"changes":[{"symbol":"G/D","column":2,"beat":0},{"symbol":"B7","column":21,"beat":2},{"symbol":"Em","column":34,"beat":4},{"symbol":"Em7","column":39,"beat":6}]},{"id":"line-6","kind":"lyric","text":"When I'm back on top, back on top in June","columns":46,"beats":6,"changes":[{"symbol":"A7","column":5,"beat":0},{"symbol":"D7","column":38,"beat":2},{"symbol":"D5+","column":43,"beat":4}]},{"id":"line-7","kind":"lyric","text":"I said that's life (that's life), and as funny as it may seem","columns":61,"beats":4,"changes":[{"symbol":"G","column":15,"beat":0},{"symbol":"B7","column":41,"beat":2}]},{"id":"line-8","kind":"lyric","text":"  Some people get their kicks   stompin' on a dream","columns":51,"beats":4,"changes":[{"symbol":"Em7","column":0,"beat":0},{"symbol":"A7","column":30,"beat":2}]},{"id":"line-9","kind":"lyric","text":"But I don't let it,   let it get me down","columns":45,"beats":4,"changes":[{"symbol":"G/D","column":0,"beat":0},{"symbol":"B7","column":19,"beat":1},{"symbol":"Em","column":37,"beat":2},{"symbol":"Em7","column":42,"beat":3}]},{"id":"line-10","kind":"lyric","text":"'Cause this fine old world,   it keeps spinnin' around","columns":62,"beats":14,"changes":[{"symbol":"A7","column":12,"beat":0},{"symbol":"C/D","column":27,"beat":2},{"symbol":"G","column":51,"beat":4},{"symbol":"C/G","column":56,"beat":6},{"symbol":"G","column":61,"beat":8}]},{"id":"line-11","kind":"lyric","text":"I've been a puppet, a pauper, a pirate, a poet, a pawn and a king","columns":65,"beats":4,"changes":[{"symbol":"G7","column":12,"beat":0}]},{"id":"line-12","kind":"lyric","text":"I've been up and down and over and out, and I know one thing","columns":60,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"C6","column":27,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Each time I find myself flat on my face","columns":39,"beats":4,"changes":[{"symbol":"A7","column":6,"beat":0}]},{"id":"line-14","kind":"lyric","text":"I pick myself up and get back in the race","columns":41,"beats":4,"changes":[{"symbol":"D7","column":3,"beat":0},{"symbol":"D5+","column":25,"beat":2}]},{"id":"line-15","kind":"lyric","text":"That's life (that's life), i tell you   i can't deny it","columns":55,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"B7","column":38,"beat":2}]},{"id":"line-16","kind":"lyric","text":" I thought of quitting, baby, but my heart just ain't gonna buy it","columns":66,"beats":4,"changes":[{"symbol":"Em7","column":0,"beat":0},{"symbol":"A7","column":29,"beat":2}]},{"id":"line-17","kind":"lyric","text":"And if I didn't think it was worth one single try","columns":54,"beats":8,"changes":[{"symbol":"G/D","column":3,"beat":0},{"symbol":"B7","column":29,"beat":2},{"symbol":"Em","column":46,"beat":4},{"symbol":"Em7","column":51,"beat":6}]},{"id":"line-18","kind":"lyric","text":"I'd jump right on a big bird,   and then I'd fly","columns":57,"beats":10,"changes":[{"symbol":"A7","column":5,"beat":0},{"symbol":"C/D","column":29,"beat":2},{"symbol":"G","column":46,"beat":4},{"symbol":"C/G","column":51,"beat":6},{"symbol":"G","column":56,"beat":8}]},{"id":"line-19","kind":"lyric","text":"I've been a puppet, a pauper, a pirate, a poet, a pawn and a king","columns":65,"beats":4,"changes":[{"symbol":"G7","column":12,"beat":0}]},{"id":"line-20","kind":"lyric","text":"I've been up and down and over and out, and I know one thing","columns":60,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"C6","column":27,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Each time I find myself layin' flat on my face","columns":46,"beats":4,"changes":[{"symbol":"A7","column":6,"beat":0}]},{"id":"line-22","kind":"lyric","text":"I just pick myself up and get back in the race","columns":46,"beats":4,"changes":[{"symbol":"D7","column":8,"beat":0},{"symbol":"Eb7","column":30,"beat":2}]},{"id":"line-23","kind":"lyric","text":"That's life (that's life), that's life   and i can't deny it","columns":60,"beats":4,"changes":[{"symbol":"Ab","column":8,"beat":0},{"symbol":"C7","column":39,"beat":2}]},{"id":"line-24","kind":"lyric","text":"  Many times I thought of cuttin' out, but my heart won't buy it","columns":64,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"Bb7","column":34,"beat":2}]},{"id":"line-25","kind":"lyric","text":"But if there's nothin' shakin' come this here July","columns":54,"beats":8,"changes":[{"symbol":"Ab/Eb","column":4,"beat":0},{"symbol":"C7","column":23,"beat":2},{"symbol":"Fm","column":46,"beat":4},{"symbol":"Bb7","column":51,"beat":6}]},{"id":"line-26","kind":"lyric","text":"I'm gonna roll myself up in a big ball and die","columns":64,"beats":6,"changes":[{"symbol":"Bb7","column":10,"beat":0},{"symbol":"Db/Eb","column":30,"beat":1},{"symbol":"Ab","column":44,"beat":2},{"symbol":"B7","column":49,"beat":3},{"symbol":"E7","column":54,"beat":4},{"symbol":"Db/Eb","column":59,"beat":5}]},{"id":"line-27","kind":"lyric","text":"My,    my!","columns":12,"beats":4,"changes":[{"symbol":"A7(5-)","column":0,"beat":0},{"symbol":"Ab7","column":9,"beat":3}]}]}