{"version":1,"id":"gracie-abrams-hit-the-wall","title":"Hit The Wall","artist":"Gracie Abrams","key":"Eb","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/gracie-abrams/hit-the-wall/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Aaron Dessner and Abrams","chords":[{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"Cm7","canonical":"Cm7","keyboardPitchClasses":[0,3,7,10],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":10,"beats":6,"changes":[{"symbol":"D#","column":8,"beat":0}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"  I'm a crack in the pavement","columns":29,"beats":4,"changes":[{"symbol":"G#","column":0,"beat":0},{"symbol":"D#","column":23,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I'm a slip knot","columns":17,"beats":4,"changes":[{"symbol":"Cm7","column":14,"beat":0}]},{"id":"line-5","kind":"lyric","text":"I'm afraid that my fortress is a glass box","columns":44,"beats":4,"changes":[{"symbol":"A#","column":20,"beat":0},{"symbol":"G#","column":42,"beat":2}]},{"id":"line-6","kind":"lyric","text":"I should know what I'm playing, but I forgot","columns":46,"beats":4,"changes":[{"symbol":"D#","column":26,"beat":0},{"symbol":"Cm7","column":43,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Felt good for a day, but that stopped","columns":37,"beats":4,"changes":[{"symbol":"A#","column":17,"beat":0},{"symbol":"G#","column":