{"version":1,"id":"ricky-montgomery-line-without-a-hook","title":"Line Without a Hook","artist":"Ricky Montgomery","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/ricky-montgomery/line-without-a-hook-/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ricky Montgomery","chords":[{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"A#m","canonical":"A#m","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I don't really give a damn","columns":26,"beats":4,"changes":[{"symbol":"C#","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"About the way you touch me","columns":26,"beats":4,"changes":[{"symbol":"G#","column":19,"beat":0}]},{"id":"line-3","kind":"lyric","text":"When we're alone","columns":16,"beats":4,"changes":[{"symbol":"Fm","column":12,"beat":0}]},{"id":"line-4","kind":"lyric","text":"You can hold my hand","columns":20,"beats":4,"changes":[{"symbol":"C#","column":9,"beat":0}]},{"id":"line-5","kind":"lyric","text":"If no one's home","columns":16,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Do you like it when I'm away?","columns":29,"beats":4,"changes":[{"symbol":"G#","column":10,"beat":0},{"symbol":"Fm","column":27,"beat":2}]},{"id":"line-7","kind":"lyric","text":"If I went and hurt my body, baby","columns":32,"beats":4,"changes":[{"symbol":"C#","column":16,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Would you love me the same?","columns":27,"beats":4,"changes":[{"symbol":"D#","column":6,"beat":0}]},{"id":"line-9","kind":"lyric","text":"I can feel all my bones coming back","columns":35,"beats":4,"changes":[{"symbol":"G#","column":12,"beat":0}]},{"id":"line-10","kind":"lyric","text":"And I'm craving motion","columns":22,"beats":4,"changes":[{"symbol":"Fm","column":9,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Mama never really learned how to live by herself","columns":48,"beats":4,"changes":[{"symbol":"C#","column":5,"beat":0},{"symbol":"D#","column":35,"beat":2}]},{"id":"line-12","kind":"lyric","text":"It's a curse","columns":12,"beats":4,"changes":[{"symbol":"G#","column":7,"beat":0}]},{"id":"line-13","kind":"lyric","text":"And it's growing","columns":16,"beats":4,"changes":[{"symbol":"Fm","column":10,"beat":0}]},{"id":"line-14","kind":"lyric","text":"You're a pond and I'm an ocean","columns":30,"beats":4,"changes":[{"symbol":"C#","column":7,"beat":0},{"symbol":"D#","column":27,"beat":2}]},{"id":"line-15","kind":"lyric","text":"Oh, all my emotions","columns":20,"beats":4,"changes":[{"symbol":"G#","column":5,"beat":0},{"symbol":"Fm","column":18,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Feel like explosions when you are around","columns":40,"beats":6,"changes":[{"symbol":"C#","column":1,"beat":0},{"symbol":"D#","column":23,"beat":2},{"symbol":"G#","column":38,"beat":4}]},{"id":"line-17","kind":"lyric","text":"And I've found a way to kill the sound, oh","columns":42,"beats":6,"changes":[{"symbol":"Fm","column":5,"beat":0},{"symbol":"C#","column":18,"beat":2},{"symbol":"D#","column":36,"beat":4}]},{"id":"line-18","kind":"lyric","text":"Oh, baby, I am a wreck when I'm without you","columns":43,"beats":6,"changes":[{"symbol":"G#","column":0,"beat":0},{"symbol":"Fm","column":19,"beat":2},{"symbol":"C#","column":36,"beat":4}]},{"id":"line-19","kind":"lyric","text":"I need you here to stay","columns":24,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0},{"symbol":"G#","column":22,"beat":2}]},{"id":"line-20","kind":"lyric","text":"I broke all my bones that day I found you","columns":41,"beats":4,"changes":[{"symbol":"Fm","column":13,"beat":0},{"symbol":"C#","column":34,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Crying at the lake","columns":18,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0},{"symbol":"G#","column":16,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Was it something I said to make you feel like you're a burden?","columns":62,"beats":4,"changes":[{"symbol":"Fm","column":8,"beat":0},{"symbol":"C#","column":37,"beat":1},{"symbol":"D#","column":58,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Oh, and if I could take it all back","columns":35,"beats":4,"changes":[{"symbol":"G#","column":6,"beat":0},{"symbol":"Fm","column":33,"beat":2}]},{"id":"line-24","kind":"lyric","text":"I swear that I would pull you from the tide","columns":54,"beats":10,"changes":[{"symbol":"C#","column":12,"beat":0},{"symbol":"D#","column":29,"beat":1},{"symbol":"G#","column":44,"beat":4},{"symbol":"Fm","column":48,"beat":6},{"symbol":"C#","column":52,"beat":8}]},{"id":"line-25","kind":"lyric","text":"Oh, whoa, whoa, whoa","columns":20,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0}]},{"id":"line-26","kind":"lyric","text":"I said no, I said no","columns":20,"beats":4,"changes":[{"symbol":"G#","column":2,"beat":0},{"symbol":"Fm","column":13,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Listen close, it's a no","columns":23,"beats":4,"changes":[{"symbol":"C#","column":1,"beat":0},{"symbol":"D#","column":16,"beat":2}]},{"id":"line-28","kind":"lyric","text":"The wind is a-pounding on my back","columns":33,"beats":4,"changes":[{"symbol":"G#","column":5,"beat":0},{"symbol":"Fm","column":26,"beat":2}]},{"id":"line-29","kind":"lyric","text":"And I found hope in a heart attack","columns":34,"beats":4,"changes":[{"symbol":"C#","column":5,"beat":0},{"symbol":"D#","column":25,"beat":2}]},{"id":"line-30","kind":"lyric","text":"Oh, at last