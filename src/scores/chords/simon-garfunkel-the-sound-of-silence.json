{"version":1,"id":"simon-garfunkel-the-sound-of-silence","title":"The Sound Of Silence","artist":"Simon & Garfunkel","key":"Am","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/simon-e-garfunkel/the-sound-of-silence/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Paul Kane","chords":[{"symbol":"D#9","canonical":"D#add9","keyboardPitchClasses":[3,5,7],"interpretation":"Keyboard interpretation: D#add9"},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"D#m","canonical":"D#m","keyboardPitchClasses":[3,6,10],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"B","canonical":"B","keyboardPitchClasses":[11,3,6],"interpretation":null},{"symbol":"F#/C#","canonical":"F#/C#","keyboardPitchClasses":[1,6,10],"interpretation":null},{"symbol":"D#9/A#","canonical":"D#9/A#","keyboardPitchClasses":[],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":11,"beats":4,"changes":[{"symbol":"D#9","column":8,"beat":0}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"   Hello, darkness, my old friend","columns":33,"beats":4,"changes":[{"symbol":"D#9","column":0,"beat":0},{"symbol":"C#","column":24,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I've come to talk with you again","columns":32,"beats":4,"changes":[{"symbol":"D#m","column":29,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Because a vision softly creeping","columns":40,"beats":8,"changes":[{"symbol":"F#","column":11,"beat":0},{"symbol":"B","column":23,"beat":2},{"symbol":"F#","column":30,"beat":4},{"symbol":"F#/C#","column":35,"beat":6}]},{"id":"line-6","kind":"lyric","text":"Left its seeds while","columns":20,"beats":4,"changes":[]},{"id":"line-7","kind":"lyric","text":"I was sleeping","columns":21,"beats":6,"changes":[{"symbol":"B","column":3,"beat":0},{"symbol":"F#","column":11,"beat":2},{"symbol":"F#/C#","column":16,"beat":4}]},{"id":"line-8","kind":"lyric","text":"And the vision that was planted in my","columns":37,"beats":4,"changes":[{"symbol":"B","column":9,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Brain","columns":5,"beats":4,"changes":[{"symbol":"F#","column":2,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Still remains","columns":17,"beats":4,"changes":[{"symbol":"D#m","column":14,"beat":0}]},{"id":"line-11","kind":"lyric","text":"  Within the sound of silence","columns":36,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0},{"symbol":"C#","column":15,"beat":1},{"symbol":"D#9","column":25,"beat":2},{"symbol":"D#m","column":33,"beat":3}]},{"id":"line-12","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-13","kind":"lyric","text":"In restless dreams I walked alone","columns":33,"beats":4,"changes":[{"symbol":"C#","column":30,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Narrow streets of cobblestone","columns":29,"beats":4,"changes":[{"symbol":"D#m","column":26,"beat":0}]},{"id":"line-15","kind":"lyric","text":"'Neath the halo of a street lamp","columns":32,"beats":6,"changes":[{"symbol":"F#","column":12,"beat":0},{"symbol":"B","column":20,"beat":2},{"symbol":"F#","column":30,"beat":4}]},{"id":"line-16","kind":"lyric","text":"I turned my collar to the cold and damp","columns":39,"beats":4,"changes":[{"symbol":"B","column":27,"beat":0},{"symbol":"F#","column":36,"beat":2}]},{"id":"line-17","kind":"lyric","text":"When my eyes were stabbed by the flash","columns":38,"beats":4,"changes":[{"symbol":"B","column":8,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Of a neon light","columns":15,"beats":4,"changes":[{"symbol":"F#","column":11,"beat":0}]},{"id":"line-19","kind":"lyric","text":"That split the night","columns":24,"beats":4,"changes":[{"symbol":"D#m","column":21,"beat":0}]},{"id":"line-20","kind":"lyric","text":"  And touched the sound of silence","columns":34,"beats":3,"changes":[{"symbol":"F#","column":0,"beat":0},{"symbol":"C#","column":20,"beat":1},{"symbol":"D#m","column":30,"beat":2}]},{"id":"line-21","kind":"section","text":"[Terceira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-22","kind":"lyric","text":"And in the naked light I saw","columns":28,"beats":4,"changes":[{"symbol":"C#","column":26,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Ten thousand people, maybe more","columns":31,"beats":4,"changes":[{"symbol":"D#m","column":28,"beat":0}]},{"id":"line-24","kind":"lyric","text":"People talking without speaking","columns":31,"beats":6,"changes":[{"symbol":"F#","column":8,"beat":0},{"symbol":"B","column":20,"beat":2},{"symbol":"F#","column":29,"beat":4}]},{"id":"line-25","kind":"lyric","text":"People hearing without listening","columns":32,"beats":4,"changes":[{"symbol":"B","column":19,"beat":0},{"symbol":"F#","column":29,"beat":2}]},{"id":"line-26","kind":"lyric","text":"People writing songs that voices never","columns":38,"beats":4,"changes":[{"symbol":"B","column":16,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Share","columns":5,"beats":4,"changes":[{"symbol":"F#","column":2,"beat":0}]},{"id":"line-28","kind":"lyric","text":"And no one dare","columns":19,"beats":4,"changes":[{"symbol":"D#m","column":16,"beat":0}]},{"id":"line-29","kind":"lyric","text":"  Disturb the sound of silence","columns":30,"beats":6,"changes":[{"symbol":"F#","column":0,"beat":0},{"symbol":"C#","column":16,"beat":2},{"symbol":"D#m","column":26,"beat":4}]},{"id":"line-30","kind":"section","text":"[Quarta Parte]","columns":14,"beats":0,"changes":[]},{"id":"line-31","kind":"lyric","text":"Fools, said I, you do not know","columns":30,"beats":4,"changes":[{"symbol":"C#","column":28,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Silence like a cancer grows","columns":27,"beats":4,"changes":[{"symbol":"D#m","column":24,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Hear my words that I might teach you","columns":37,"beats":3,"changes":[{"symbol":"F#","column":9,"beat":0},{"symbol":"B","column":23,"beat":1},{"symbol":"F#","column":35,"beat":2}]},{"id":"line-34","kind":"lyric","text":"Take my arms that I might reach you","columns":35,"beats":4,"changes":[{"symbol":"B","column":21,"beat":0},{"symbol":"F#","column":33,"beat":2}]},{"id":"line-35","kind":"lyric","text":"But my words like silent raindrops fell","columns":39,"beats":4,"changes":[{"symbol":"B","column":8,"beat":0},{"symbol":"F#","column":36,"beat":2}]},{"id":"line-36","kind":"lyric","text":"   And echoed in the wells of silence","columns":37,"beats":3,"changes":[{"symbol":"D#m","column":0,"beat":0},{"symbol":"C#","column":23,"beat":1},{"symbol":"D#m","column":33,"beat":2}]},{"id":"line-37","kind":"section","text":"[Quinta Parte]","columns":14,"beats":0,"changes":[]},{"id":"line-38","kind":"lyric","text":"And the people bowed and prayed","columns":31,"beats":4,"changes":[{"symbol":"C#","column":27,"beat":0}]},{"id":"line-39","kind":"lyric","text":"To the neon god they made","columns":25,"beats":4,"changes":[{"symbol":"D#m","column":22,"beat":0}]},{"id":"line-40","kind":"lyric","text":"And the sign flashed out its warning","columns":36,"beats":3,"changes":[{"symbol":"F#","column":9,"beat":0},{"symbol":"B","column":26,"beat":1},{"symbol":"F#","column":34,"beat":2}]},{"id":"line-41","kind":"lyric","text":"In the words that it was forming","columns":32,"beats":4,"changes":[{"symbol":"B","column":22,"beat":0},{"symbol":"F#","column":29,"beat":2}]},{"id":"line-42","kind":"lyric","text":"And the sign said","columns":17,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"The words of the prophets are written","columns":37,"beats":4,"changes":[{"symbol":"B","column":5,"beat":0}]},{"id":"line-44","kind":"lyric","text":"On the subway walls","columns":19,"beats":4,"changes":[{"symbol":"F#","column":15,"beat":0}]},{"id":"line-45","kind":"lyric","text":"And tenement halls","columns":22,"beats":4,"changes":[{"symbol":"D#m","column":19,"beat":0}]},{"id":"line-46","kind":"lyric","text":"And whispered in the sound of silence","columns":37,"beats":3,"changes":[{"symbol":"F#","column":6,"beat":0},{"symbol":"C#","column":23,"beat":1},{"symbol":"D#9","column":33,"beat":2}]},{"id":"line-47","kind":"instrumental","text":"[Final]","columns":14,"beats":4,"changes":[{"symbol":"D#9/A#","column":8,"beat":0}]}]}