{"version":1,"id":"elyotto-sugarcrash","title":"Sugarcrash","artist":"ElyOtto","key":"Dm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/elyotto/sugarcrash/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Aaron Joseph, Kim Petras, Curtis Waters, Alex Keith Chapman and Elliott Platt","chords":[{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I'm on a sugar crash, I ain't got no fuckin' cash","columns":49,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":22,"beat":2}]},{"id":"line-2","kind":"lyric","text":"Maybe I should take a bath, cut my fuckin' brain in half","columns":56,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":28,"beat":2}]},{"id":"line-3","kind":"lyric","text":"I'm not lonely, just a bit tired of this fucking shit","columns":53,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":27,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Nothing that I write can make me feel good","columns":42,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":33,"beat":2}]},{"id":"line-5","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-6","kind":"lyric","text":"Victim of the great machine, in love with everything I see","columns":58,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":29,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Neon lights surrounding me, I indulge in luxury","columns":47,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":28,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Everything I do is wrong, 'cept for when I hit the bong","columns":55,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":28,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Hit the bong, hit the b-b-b-b-b, feel good","columns":42,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":33,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Feeling shitty in my bed, didn't take my fuckin' meds","columns":53,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":26,"beat":2}]},{"id":"line-11","kind":"lyric","text":"Hyperpop up in my ears, everything just disappears","columns":50,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":24,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Don't wanna be someone else, just don't wanna hate myself","columns":57,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":30,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I just don't wanna hate myself, instead I wanna feel good","columns":57,"beats":8,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":32,"beat":4}]},{"id":"line-14","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"I'm on a sugar crash, I ain't got no fuckin' cash","columns":49,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":22,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Maybe I should take a bath, cut my fuckin' brain in half","columns":56,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":28,"beat":2}]},{"id":"line-17","kind":"lyric","text":"I'm not lonely, just a bit tired of this fucking shit","columns":53,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"F","column":27,"beat":2}]},{"id":"line-18","kind":"lyric","text":"Nothing that I write can make me feel good","columns":42,"beats":8,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Dm","column":33,"beat":4}]},{"id":"line-19","kind":"section","text":"[Bridge]","columns":8,"beats":0,"changes":[]},{"id":"line-20","kind":"lyric","text":"Where to now?","columns":13,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Got the rest of my life just laid out","columns":37,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"C","column":19,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Got the rest of my life to fuck around","columns":38,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Bb","column":19,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Got the rest of my life to make sound","columns":41,"beats":6,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"C","column":19,"beat":2},{"symbol":"Dm","column":39,"beat":4}]},{"id":"line-24","kind":"section","text":"[Outro]","columns":7,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"Where to now?","columns":13,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Got the rest of my life just laid out","columns":37,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"C","column":19,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Got the rest of my life to fuck around","columns":38,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"Bb","column":19,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Got the rest of my life to make sound","columns":37,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"C","column":19,"beat":2}]},{"id":"line-29","kind":"lyric","text":"Feel good","columns":9,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]}]}