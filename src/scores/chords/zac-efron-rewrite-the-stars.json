{"version":1,"id":"zac-efron-rewrite-the-stars","title":"Rewrite The Stars","artist":"Zac Efron","key":"Bb","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/zac-efron/rewrite-the-stars/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: The Greastest Showman","chords":[{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"You know I want you","columns":19,"beats":4,"changes":[]},{"id":"line-2","kind":"lyric","text":"It's not a secret I try to hide","columns":31,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"I know you want me","columns":18,"beats":4,"changes":[]},{"id":"line-4","kind":"lyric","text":"So don't keep saying our hands are tied","columns":39,"beats":4,"changes":[{"symbol":"Bb","column":15,"beat":0},{"symbol":"Eb","column":23,"beat":2}]},{"id":"line-5","kind":"lyric","text":"You claim it's not in the cards","columns":31,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Gm","column":17,"beat":2}]},{"id":"line-6","kind":"lyric","text":"But fate is pulling you miles away","columns":34,"beats":2,"changes":[{"symbol":"Eb","column":17,"beat":0}]},{"id":"line-7","kind":"lyric","text":"And out of reach from me","columns":24,"beats":4,"changes":[{"symbol":"F","column":13,"beat":0}]},{"id":"line-8","kind":"lyric","text":"But you're here in my heart","columns":27,"beats":4,"changes":[{"symbol":"Gm","column":14,"beat":0}]},{"id":"line-9","kind":"lyric","text":"So who can stop me if I decide","columns":30,"beats":6,"changes":[{"symbol":"Eb","column":13,"beat":0}]},{"id":"line-10","kind":"lyric","text":"That you're my destiny?","columns":23,"beats":4,"changes":[]},{"id":"line-11","kind":"lyric","text":"What if we rewrite the stars?","columns":29,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0},{"symbol":"Eb","column":17,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Say you were made to be mine","columns":28,"beats":4,"changes":[{"symbol":"Bb","column":10,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Nothing could keep us apart","columns":27,"beats":6,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Gm","column":9,"beat":2},{"symbol":"Eb","column":17,"beat":4}]},{"id":"line-14","kind":"lyric","text":"You'd be the one I was meant to find","columns":36,"beats":4,"changes":[{"symbol":"Bb","column":7,"beat":0},{"symbol":"F","column":22,"beat":2}]},{"id":"line-15","kind":"lyric","text":"It's up to you, and it's up to me","columns":33,"beats":4,"changes":[{"symbol":"Gm","column":9,"beat":0},{"symbol":"Eb","column":25,"beat":2}]},{"id":"line-16","kind":"lyric","text":"No one can say what we get to be","columns":32,"beats":8,"changes":[{"symbol":"Bb","column":6,"beat":0},{"symbol":"F","column":18,"beat":4}]},{"id":"line-17","kind":"lyric","text":"So why don't we rewrite the stars?","columns":34,"beats":4,"changes":[{"symbol":"Gm","column":9,"beat":0},{"symbol":"Eb","column":20,"beat":2}]},{"id":"line-18","kind":"lyric","text":"Maybe the world could be ours","columns":29,"beats":4,"changes":[{"symbol":"Bb","column":5,"beat":0},{"symbol":"F","column":16,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Tonight","columns":13,"beats":8,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Cm","column":6,"beat":2},{"symbol":"Gm","column":9,"beat":4},{"symbol":"F","column":12,"beat":6}]},{"id":"line-20","kind":"lyric","text":"You think it's easy","columns":19,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"You think I don't want to run to you","columns":36,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"But there are mountains","columns":23,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"And there are doors that we can't walk through","columns":46,"beats":4,"changes":[{"symbol":"Eb","column":24,"beat":0}]},{"id":"line-24","kind":"lyric","text":"I know you're wondering why","columns":27,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Gm","column":15,"beat":2}]},{"id":"line-25","kind":"lyric","text":"Because we're able to be","columns":24,"beats":4,"changes":[{"symbol":"Eb","column":13,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Just you and me","columns":15,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"Within these walls","columns":18,"beats":4,"changes":[{"symbol":"F","column":9,"beat":0}]},{"id":"line-28","kind":"lyric","text":"But when we go outside","columns":22,"beats":4,"changes":[{"symbol":"Gm","column":9,"beat":0}]},{"id":"line-29","kind":"lyric","text":"You're going to wake up and see that it was hopeless after all","columns":62,"beats":4,"changes":[{"symbol":"Eb","column":17,"beat":0}]},{"id":"line-30","kind":"lyric","text":"No one can rewrite the stars","columns":28,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0},{"symbol":"Eb","column":17,"beat":2}]},{"id":"line-31","kind":"lyric","text":"How can you say you'll be mine?","columns":31,"beats":4,"changes":[{"symbol":"Bb","column":6,"beat":0},{"symbol":"F","column":17,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Everything keeps us apart","columns":25,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0},{"symbol":"Eb","column":14,"beat":2}]},{"id":"line-33","kind":"lyric","text":"And I'm not the one you were meant to find","columns":42,"beats":4,"changes":[{"symbol":