beat":0}]},{"id":"line-5","kind":"lyric","text":"If it was ever hard to move","columns":27,"beats":4,"changes":[{"symbol":"Bbm7","column":10,"beat":0}]},{"id":"line-6","kind":"lyric","text":"She'd turn the rain to a rainbow","columns":32,"beats":4,"changes":[{"symbol":"Eb7","column":2,"beat":0}]},{"id":"line-7","kind":"lyric","text":"When I was livin' in the blue","columns":29,"beats":4,"changes":[{"symbol":"Ab","column":12,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Why then, if she's so perfect","columns":29,"beats":4,"changes":[{"symbol":"Fm","column":2,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Do I still wish that it was you?","columns":32,"beats":4,"changes":[{"symbol":"Bbm7","column":12,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Perfect don't mean that it's workin'","columns":36,"beats":4,"changes":[{"symbol":"Eb7","column":1,"beat":0}]},{"id":"line-11","kind":"lyric","text":"So what can I do?","columns":17,"beats":4,"changes":[{"symbol":"Ab","column":15,"beat":0}]},{"id":"line-12","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-13","kind":"lyric","text":"When you're out of sight in my mind","columns":35,"beats":4,"changes":[{"symbol":"Bbm","column":12,"beat":0},{"symbol":"Eb7","column":25,"beat":2}]},{"id":"line-14","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"'Cause sometimes I look in her eyes","columns":35,"beats":4,"changes":[{"symbol":"Bbm7","column":12,"beat":0},{"symbol":"Eb7","column":31,"beat":2}]},{"id":"line-16","kind":"lyric","text":"And that's where I find a glimpse of us","columns":39,"beats":6,"changes":[{"symbol":"Ab","column":20,"beat":0},{"symbol":"Gm5+","column":28,"beat":2},{"symbol":"Fm","column":37,"beat":4}]},{"id":"line-17","kind":"lyric","text":"And I try to fall for her touch","columns":31,"beats":4,"changes":[{"symbol":"Bbm7","column":8,"beat":0},{"symbol":"Eb7","column":27,"beat":2}]},{"id":"line-18","kind"