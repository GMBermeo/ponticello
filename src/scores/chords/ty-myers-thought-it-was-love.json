":" His life all figured out","columns":32,"beats":6,"changes":[{"symbol":"G#m","column":6,"beat":0},{"symbol":"A","column":15,"beat":1},{"symbol":"A","column":26,"beat":4},{"symbol":"G#m","column":29,"beat":5}]},{"id":"line-18","kind":"lyric","text":"As for me, I stay locked up in this old","columns":39,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"B","column":25,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Bedroom","columns":7,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Writing songs for you and thinking","columns":34,"beats":4,"changes":[{"symbol":"E","column":10,"beat":0}]},{"id":"line-21","kind":"lyric","text":"About us","columns":8,"beats":4,"changes":[{"symbol":"G#m","column":0,"beat":0},{"symbol":"A","column":6,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Girl, I thought it was love","columns":27,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"B","column":24,"beat":4}]},{"id":"line-23","kind":"instrumental","text":"[Interlude]","columns":32,"beats":12,"changes":[{"symbol":"F#m","column":12,"beat":0},{"symbol":"B","column":17,"beat":2},{"symbol":"E","column":20,"beat":4},{"symbol":"C#m","column":23,"beat":6},{"symbol":"D","column":28,"beat":8},{"symbol":"B","column":31,"beat":10}]},{"id":"line-24","kind":"section","text":"[Terceira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"I went to bed with a headache tonight","columns":37,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"B","column":25,"beat":2}]},{"id":"line-26","kind":"lyric","text":"'Cause I've got a mortgage due and no one","columns":41,"beats":4,"changes":[{"symbol":"E","column":19,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Laying by my side","columns":17,"beats":4,"changes":[{"symbol":"A","column":8,"beat":0}]},{"id":"line-28","kind":"lyric","text":"I never knew a king-size bed would get so cold","columns":46,"beats":4,"changes":[{"symbol":"F#m","column":0,"be