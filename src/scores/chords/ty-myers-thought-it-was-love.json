{"version":1,"id":"ty-myers-thought-it-was-love","title":"Thought it Was Love","artist":"Ty Myers","key":"E","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/ty-myers/thought-it-was-love/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ty Myers","chords":[{"symbol":"E7M","canonical":"Emaj7","keyboardPitchClasses":[4,8,11,3],"interpretation":"Keyboard interpretation: Emaj7"},{"symbol":"C#m","canonical":"C#m","keyboardPitchClasses":[1,4,8],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"B","canonical":"B","keyboardPitchClasses":[11,3,6],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"G#m","canonical":"G#m","keyboardPitchClasses":[8,11,3],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":26,"beats":8,"changes":[{"symbol":"E7M","column":8,"beat":0},{"symbol":"C#m","column":13,"beat":2},{"symbol":"E7M","column":18,"beat":4},{"symbol":"C#m","column":23,"beat":6}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"I woke up with a headache today","columns":31,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"B","column":18,"beat":2}]},{"id":"line-4","kind":"lyric","text":"'Cause I've got a mortgage due and an empty bed to make","columns":55,"beats":4,"changes":[{"symbol":"E","column":18,"beat":0},{"symbol":"A","column":43,"beat":2}]},{"id":"line-5","kind":"lyric","text":"And, girl, it's funny to me how much I hate your me