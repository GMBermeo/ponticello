{"version":1,"id":"morgan-wallen-i-got-better","title":"I Got Better","artist":"Morgan Wallen","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/morgan-wallen/i-got-better/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Richard Chase Mcgill, Sno, Charlie Handsome, Michael Wilson Hardy, Blake Mccoy and Morgan C Wallen","chords":[{"symbol":"Am7","canonical":"Am7","keyboardPitchClasses":[9,0,4,7],"interpretation":null},{"symbol":"C7M","canonical":"Cmaj7","keyboardPitchClasses":[0,4,7,11],"interpretation":"Keyboard interpretation: Cmaj7"},{"symbol":"F7M","canonical":"Fmaj7","keyboardPitchClasses":[5,9,0,4],"interpretation":"Keyboard interpretation: Fmaj7"},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":16,"beats":4,"changes":[{"symbol":"Am7","column":8,"beat":0},{"symbol":"C7M","column":13,"beat":2}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"Everything's still pretty much the same 'round here","columns":51,"beats":4,"changes":[{"symbol":"Am7","column":5,"beat":0}]},{"id":"line-4","kind":"lyric","text":"My neighbors still shootin' all of next year's deer","columns":51,"beats":4,"changes":[{"symbol":"C7M","column":3,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Boys still lose 'less they're playin' at home","columns":45,"beats":4,"changes":[{"symbol":"F7M","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"But I've got better since you got gone","columns":38,"beats":4,"changes":[{"symbol":"C7M","column":4,"beat":0}]},{"id":"line-7","kind":"lyric","text":"I'm still a few too many on a Friday night","columns":42,"beats":4,"changes":[{"symbol":"Am7","column":12,"beat":0}]},{"id":"line-8","kind":"lyric","text":"I still try to step in when