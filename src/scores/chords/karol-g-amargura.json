{"version":1,"id":"karol-g-amargura","title":"Amargura","artist":"KAROL G","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/karol-g/amargura/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ovy On The Drums, Karol G, Keityn and Catalino Curet Alonso","chords":[{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Hey","columns":3,"beats":4,"changes":[]},{"id":"line-2","kind":"lyric","text":"Ayer, te vi","columns":12,"beats":4,"changes":[{"symbol":"F#m","column":9,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Aparentemente, estabas contento, estabas feliz","columns":46,"beats":4,"changes":[{"symbol":"Bm","column":9,"beat":0},{"symbol":"E","column":44,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Besándola a ella, así como me besaba' a mí","columns":42,"beats":4,"changes":[{"symbol":"A","column":13,"beat":0},{"symbol":"F#m","column":37,"beat":2}]},{"id":"line-5","kind":"lyric","text":"En parte, me alegra que uno de los dos no esté llorando","columns":55,"beats":4,"changes":[{"symbol":"Bm","column":14,"beat":0},{"symbol":"E","column":51,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Ojalá me piense de vez en cuando","columns":32,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Y aunque yo hago como si na'","columns":28,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"Bm","column":25,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Baby, qué amargura me da","columns":24,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"