{"version":1,"id":"taylor-swift-the-smallest-man-who-ever-lived","title":"The Smallest Man Who Ever Lived","artist":"Taylor Swift","key":"Bb","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/taylor-swift/the-smallest-man-who-ever-lived/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Aaron Dessner and Taylor Swift","chords":[{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"Was any of it true","columns":18,"beats":6,"changes":[{"symbol":"Bb","column":4,"beat":0},{"symbol":"Eb","column":8,"beat":2},{"symbol":"F","column":14,"beat":4}]},{"id":"line-3","kind":"lyric","text":"Gazing at me, starry-eyed","columns":25,"beats":6,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Eb","column":7,"beat":2},{"symbol":"F","column":14,"beat":4}]},{"id":"line-4","kind":"lyric","text":"In your Jehovah's witness suit","columns":30,"beats":6,"changes":[{"symbol":"Bb","column":10,"beat":0},{"symbol":"Eb","column":18,"beat":2},{"symbol":"F","column":26,"beat":4}]},{"id":"line-5","kind":"lyric","text":"Who the fuck was that guy?","columns":26,"beats":6,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Eb","column":8,"beat":2},{"symbol":"F","column":17,"beat":4}]},{"id":"line-6","kind":"lyric","text":"You tried to buy some pills","columns":27,"beats":6,"changes":[{"symbol":"Gm","column":4,"beat":0},{"symbol":"Eb","column":13,"beat":2},{"symbol":"F","column":22,"beat":4}]},{"id":"line-7","kind":"lyric","text":"From a friend of friends of mine","columns":32,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":7,"beat":2},{"symbol":"F","column":17,"beat":4}]},{"id":"line-8","kind":"lyric","text":"They just ghosted you","columns":21,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":10,"beat":2},{"symbol":"F","column":18,"beat":4}]},{"id":"line-9","kind":"lyric","text":"Now you know what it feels like","columns":31,"beats":6,"changes":[{"symbol":"Gm","column":4,"beat":0},{"symbol":"Eb","column":13,"beat":2},{"symbol":"F","column":21,"beat":4}]},{"id":"line-10","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-11","kind":"lyric","text":"   And I don't even want you back, I just want to know","columns":54,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":15,"beat":2},{"symbol":"F","column":29,"beat":5}]},{"id":"line-12","kind":"lyric","text":"   If rusting my sparkling summer was the goal","columns":46,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":14,"beat":2},{"symbol":"F","column":27,"beat":5}]},{"id":"line-13","kind":"lyric","text":"   And I don't miss what we had, but could someone give","columns":55,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":15,"beat":2},{"symbol":"F","column":28,"beat":4}]},{"id":"line-14","kind":"lyric","text":"   A message to the smallest man who ever lived?","columns":48,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":13,"beat":2},{"symbol":"F","column":29,"beat":4}]},{"id":"line-15","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-16","kind":"lyric","text":"You hung me on your wall","columns":24,"beats":6,"changes":[{"symbol":"Bb","column":4,"beat":0},{"symbol":"Eb","column":12,"beat":2},{"symbol":"F","column":20,"beat":4}]},{"id":"line-17","kind":"lyric","text":"Stabbed me with your pushpins","columns":29,"beats":6,"changes":[{"symbol":"Bb","column":0,"beat":0},{"symbol":"Eb","column":11,"beat":2},{"symbol":"F","column":21,"beat":4}]},{"id":"line-18","kind":"lyric","text":"In public showed me off","columns":23,"beats":6,"changes":[{"symbol":"Bb","column":3,"beat":0},{"symbol":"Eb","column":10,"beat":2},{"symbol":"F","column":20,"beat":4}]},{"id":"line-19","kind":"lyric","text":"Then sank in stoned oblivion","columns":28,"beats":6,"changes":[{"symbol":"Bb","column":5,"beat":0},{"symbol":"Eb","column":13,"beat":2},{"symbol":"F","column":21,"beat":4}]},{"id":"line-20","kind":"lyric","text":"Cause once your queen had come","columns":30,"beats":6,"changes":[{"symbol":"Gm","column":6,"beat":0},{"symbol":"Eb","column":16,"beat":2},{"symbol":"F","column":26,"beat":4}]},{"id":"line-21","kind":"lyric","text":"You treat her like an also-ran","columns":30,"beats":8,"changes":[{"symbol":"Gm","column":4,"beat":0},{"symbol":"Eb","column":14,"beat":2},{"symbol":"F","column":22,"beat":5}]},{"id":"line-22","kind":"lyric","text":"You didn't measure up","columns":21,"beats":8,"changes":[{"symbol":"Gm","column":4,"beat":0},{"symbol":"Eb","column":11,"beat":2},{"symbol":"F","column":19,"beat":5}]},{"id":"line-23","kind":"lyric","text":"In any measure of a man","columns":23,"beats":6,"changes":[{"symbol":"Gm","column":3,"beat":0},{"symbol":"Eb","column":7,"beat":2},{"symbol":"F","column":15,"beat":4}]},{"id":"line-24","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":" And I don't even want you back, I just want to know","columns":52,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":14,"beat":2},{"symbol":"F","column":27,"beat":4}]},{"id":"line-26","kind":"lyric","text":" If rusting my sparkling summer was the goal","columns":44,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":12,"beat":2},{"symbol":"F","column":25,"beat":4}]},{"id":"line-27","kind":"lyric","text":" And I don't miss what we had, but could someone give","columns":53,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":13,"beat":2},{"symbol":"F","column":26,"beat":4}]},{"id":"line-28","kind":"lyric","text":" A message to the smallest man who ever lived?","columns":46,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Eb","column":11,"beat":2},{"symbol":"F","column":27,"beat":4}]},{"id":"line-29","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-30","kind":"lyric","text":"Were you sent by someone who wanted me dead?","columns":44,"beats":4,"changes":[{"symbol":"Bb","column":21,"beat":0},{"symbol":"Gm","column":39,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Did you sleep with a gun underneath our bed?","columns":44,"beats":4,"changes":[{"symbol":"F","column":21,"beat":0},{"symbol":"Eb","column":40,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Were you writing a book?","columns":24,"beats":4,"changes":[{"symbol":"Bb","column":19,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Were you a sleeper cell spy?","columns":28,"beats":4,"changes":[{"symbol":"Gm","column":24,"beat":0}]},{"id":"line-34","kind":"lyric","text":"In 50 years, will all this be declassified?","columns":43,"beats":4,"changes":[{"symbol":"F","column":18,"beat":0},{"symbol":"Eb","column":38,"beat":2}]},{"id":"line-35","kind":"lyric","text":"You'll confess why you did it","columns":29,"beats":4,"changes":[{"symbol":"Bb","column":23,"beat":0}]},{"id":"line-36","kind":"lyric","text":"And I'll say good riddance","columns":26,"beats":4,"changes":[{"symbol":"Gm","column":18,"beat":0}]},{"id":"line-37","kind":"lyric","text":"'Cause it wasn't sexy once it wasn't forbidden","columns":46,"beats":4,"changes":[{"symbol":"F","column":17,"beat":0},{"symbol":"Eb","column":40,"beat":2}]},{"id":"line-38","kind":"lyric","text":"I would've died for your sins","columns":29,"beats":4,"changes":[{"symbol":"Bb","column":25,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Instead, I just died inside","columns":27,"beats":4,"changes":[{"symbol":"Gm","column":23,"beat":0}]},{"id":"line-40","kind":"lyric","text":"And you deserve prison, but you won't get time","columns":46,"beats":4,"changes":[{"symbol":"F","column":16,"beat":0},{"symbol":"Eb","column":42,"beat":2}]},{"id":"line-41","kind":"lyric","text":"You'll slide into inboxes and slip through the bars","columns":51,"beats":4,"changes":[{"symbol":"Bb","column":18,"beat":0},{"symbol":"Gm","column":47,"beat":2}]},{"id":"line-42","kind":"lyric","text":"You crashed my party and your rental car","columns":40,"beats":4,"changes":[{"symbol":"F","column":15,"beat":0},{"symbol":"Eb","column":37,"beat":2}]},{"id":"line-43","kind":"lyric","text":"You said normal girls were boring","columns":33,"beats":4,"changes":[{"symbol":"Bb","column":27,"beat":0}]},{"id":"line-44","kind":"lyric","text":"But you were gone by the morning","columns":32,"beats":4,"changes":[{"symbol":"Gm","column":25,"beat":0}]},{"id":"line-45","kind":"lyric","text":"You kicked out the stage lights but you're still performing","columns":59,"beats":4,"changes":[{"symbol":"F","column":19,"beat":0},{"symbol":"Eb","column":52,"beat":2}]},{"id":"line-46","kind":"lyric","text":"And in plain sight, you hid","columns":27,"beats":4,"changes":[{"symbol":"Bb","column":24,"beat":0}]},{"id":"line-47","kind":"lyric","text":"But you are what you did","columns":24,"beats":4,"changes":[{"symbol":"Gm","column":21,"beat":0}]},{"id":"line-48","kind":"lyric","text":"And I'll forget you, but I will never forgive","columns":45,"beats":4,"changes":[{"symbol":"F","column":12,"beat":0},{"symbol":"Eb","column":41,"beat":2}]},{"id":"line-49","kind":"lyric","text":"The smallest man who ever lived","columns":31,"beats":4,"changes":[{"symbol":"Bb","column":25,"beat":0}]}]}