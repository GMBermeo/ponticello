{"version":1,"id":"billie-eilish-nda","title":"Nda","artist":"Billie Eilish","key":"Gm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/billie-eilish/nda/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Finneas and Billie Eilish","chords":[{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Did you think I'd show up in a limousine?","columns":41,"beats":2,"changes":[{"symbol":"Gm","column":9,"beat":0}]},{"id":"line-2","kind":"lyric","text":"No had to save my money for security","columns":36,"beats":4,"changes":[{"symbol":"Gm","column":10,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Got a stalker walkin' up and down the street","columns":44,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Says he's Satan and he'd like to meet","columns":37,"beats":4,"changes":[{"symbol":"Gm","column":10,"beat":0}]},{"id":"line-5","kind":"lyric","text":"I bought a secret house when I was seventeen","columns":44,"beats":4,"changes":[{"symbol":"Cm","column":12,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Haven't had a party since I got the keys","columns":40,"beats":4,"changes":[{"symbol":"Cm","column":3,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Had a pretty boy over, but he couldn't stay","columns":43,"beats":2,"changes":[{"symbol":"Gm","column":7,"beat":0}]},{"id":"line-8","kind":"lyric","text":"On his way out, made him sign an NDA","columns":36,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0}]},{"id":"line-9","kind":"instrumental","text":"(    )","columns":6,"beats":4,"changes":[{"symbol":"Gm","column":2,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Yeah, I made him sign an NDA","columns":28,"beats":4,"changes":[]},{"id":"line-11","kind":"lyric","text":"(Once was good enough)","columns":22,"beats":4,"changes":[{"symbol":"Cm","column":1,"beat":0}]},{"id":"line-12","kind":"lyric","text":"'Cause I don't want him having shit to say","columns":42,"beats":4,"changes":[{"symbol":"Cm","column":15,"beat":0}]},{"id":"line-13","kind":"lyric","text":"   You couldn't save me, but you can't let me go","columns":53,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Bb","column":33,"beat":2},{"symbol":"Eb","column":47,"beat":4},{"symbol":"Cm","column":51,"beat":6}]},{"id":"line-14","kind":"lyric","text":"   I can crave you, but you don't need to know","columns":52,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Bb","column":28,"beat":2},{"symbol":"Eb","column":47,"beat":4},{"symbol":"D","column":51,"beat":6}]},{"id":"line-15","kind":"instrumental","text":"(    )","columns":6,"beats":4,"changes":[{"symbol":"Gm","column":2,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Thirty under thirty for another year","columns":36,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"I can barely go outside, I think I hate it here","columns":47,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Maybe I should think about a new career","columns":39,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Somewhere in Kauai where I can disappear","columns":40,"beats":4,"changes":[{"symbol":"Gm","column":2,"beat":0}]},{"id":"line-20","kind":"lyric","text":"I've been having fun getting older now","columns":38,"beats":4,"changes":[{"symbol":"Cm","column":11,"beat":0}]},{"id":"line-21","kind":"lyric"