{"version":1,"id":"gracie-abrams-i-love-you-i-m-sorry","title":"I Love You, I'm Sorry","artist":"Gracie Abrams","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/gracie-abrams/i-love-you-i-m-sorry/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Aaron Dessner, Gracie Abrams and Audrey Hobert","chords":[{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Cm7","canonical":"Cm7","keyboardPitchClasses":[0,3,7,10],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"  Two Augusts ago","columns":17,"beats":8,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":16,"beat":4}]},{"id":"line-3","kind":"lyric","text":"I told the truth, oh","columns":20,"beats":4,"changes":[{"symbol":"Cm7","column":11,"beat":0}]},{"id":"line-4","kind":"lyric","text":"But you didn't like it, you went home","columns":37,"beats":4,"changes":[{"symbol":"D#","column":15,"beat":0}]},{"id":"line-5","kind":"lyric","text":"  You're in your Benz, I'm by the gate","columns":42,"beats":8,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":18,"beat":2},{"symbol":"Cm7","column":35,"beat":4},{"symbol":"D#","column":40,"beat":6}]},{"id":"line-6","kind":"lyric","text":"  Now you go alone","columns":18,"beats":4,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":15,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Charm all the people you train for","columns":34,"beats":4,"changes":[{"symbol":"Cm7","column":14,"beat":0}]},{"id":"line-8","kind":"lyric","text":"You mean well but aim low","columns":25,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0}]},{"id":"line-9","kind":"lyric","text":"  And I'll make it known like I'm getting paid","columns":47,"beats":4,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":20,"beat":1},{"symbol":"Cm7","column":39,"beat":2},{"symbol":"D#","column":45,"beat":3}]},{"id":"line-10","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-11","kind":"lyric","text":"That's just the way life goes","columns":29,"beats":4,"changes":[{"symbol":"A#","column":16,"beat":0},{"symbol":"F","column":26,"beat":2}]},{"id":"line-12","kind":"lyric","text":"I like to slam doors closed","columns":27,"beats":4,"changes":[{"symbol":"Cm7","column":10,"beat":0},{"symbol":"D#","column":21,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Trust me, I know it's always about me","columns":37,"beats":6,"changes":[{"symbol":"A#","column":12,"beat":0},{"symbol":"F","column":23,"beat":2},{"symbol":"Cm7","column":34,"beat":4}]},{"id":"line-14","kind":"lyric","text":"I love you, I'm sorry","columns":21,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0}]},{"id":"line-15","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-16","kind":"lyric","text":"  Two summers from now","columns":22,"beats":4,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":20,"beat":2}]},{"id":"line-17","kind":"lyric","text":"We'll have been talking","columns":23,"beats":4,"changes":[{"symbol":"Cm7","column":16,"beat":0}]},{"id":"line-18","kind":"lyric","text":"But not all that often, we're cool now","columns":38,"beats":4,"changes":[{"symbol":"D#","column":17,"beat":0}]},{"id":"line-19","kind":"lyric","text":"  I'll be on a boat","columns":19,"beats":4,"changes":[{"symbol":"A#","column":0,"beat":0},{"symbol":"F","column":16,"beat":2}]},{"id":"line-20","kind":"lyric","text":"You're on a plane going somewhere, same","columns":40,"beats":3,"changes":[{"symbol":"Cm7","column":8,"beat":0},{"symbol":"D#","column":20,"beat":1},{"symbol":"A#","column":38,"beat":2}]},{"id":"line-21","kind":"lyric","text":"And I'll have a drink","columns":21,"beats":4,"changes":[{"symbol":"F","column":16,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Wistfully lean out my window","columns":28,"beats":4,"changes":[{"symbol":"Cm7","column":10,"beat":0}]},{"id":"line-23","kind":"lyric","text":"And watch the sun set on the lake","columns":33,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0},{"symbol":"A#","column":30,"beat":2}]},{"id":"line-24","kind":"lyric","text":"I might not feel real, but it's okay, mmm","columns":41,"beats":6,"changes":[{"symbol":"F","column":17,"beat":0},{"symbol":"Cm7","column":29,"beat":2},{"symbol":"D#","column":35,"beat":4}]},{"id":"line-25","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-26","kind":"lyric","text":"'Cause that's just the way life goes","columns":36,"beats":4,"changes":[{"symbol":"A#","column":23,"beat":0},{"symbol":"F","column":33,"beat":2}]},{"id":"line-27","kind":"lyric","text":"I push my luck, it shows","columns":24,"beats":4,"changes":[{"symbol":"Cm7","column":10,"beat":0},{"symbol":"D#","column":19,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Thankful you don't send someone to kill me","columns":42,"beats":6,"changes":[{"symbol":"A#","column":13,"beat":0},{"symbol":"F","column":25,"beat":2},{"symbol":"Cm7","column":39,"beat":4}]},{"id":"line-29","kind":"lyric","text":"I love you, I'm sorry","columns":21,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0}]},{"id":"line-30","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-31","kind":"lyric","text":"You were the best but you were the worst","columns":40,"beats":4,"changes":[{"symbol":"A#","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"As sick as it sounds, I loved you first","columns":39,"beats":4,"changes":[{"symbol":"F","column":3,"beat":0}]},{"id":"line-33","kind":"lyric","text":"I was a dick, it is what it is","columns":30,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-34","kind":"lyric","text":"A habit to kick the age-old curse","columns":33,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0}]},{"id":"line-35","kind":"lyric","text":"I tend to laugh whenever I'm sad","columns":32,"beats":4,"changes":[{"symbol":"A#","column":0,"beat":0}]},{"id":"line-36","kind":"lyric","text":"I stare at the crash, it actually works","columns":39,"beats":4,"changes":[{"symbol":"F","column":2,"beat":0}]},{"id":"line-37","kind":"lyric","text":"Making amends, this shit never ends","columns":35,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-38","kind":"lyric","text":"I'm wrong again, wrong again","columns":28,"beats":4,"changes":[{"symbol":"D#","column":4,"beat":0}]},{"id":"line-39","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-40","kind":"lyric","text":"The way life goes","columns":17,"beats":4,"changes":[{"symbol":"A#","column":4,"beat":0},{"symbol":"F","column":14,"beat":2}]},{"id":"line-41","kind":"lyric","text":"Joyriding down our road","columns":23,"beats":4,"changes":[{"symbol":"Cm7","column":10,"beat":0},{"symbol":"D#","column":19,"beat":2}]},{"id":"line-42","kind":"lyric","text":"Lay on the horn to prove that it haunts me","columns":42,"beats":6,"changes":[{"symbol":"A#","column":11,"beat":0},{"symbol":"F","column":20,"beat":2},{"symbol":"Cm7","column":39,"beat":4}]},{"id":"line-43","kind":"lyric","text":"(I'm wrong again, wrong again)","columns":30,"beats":4,"changes":[]},{"id":"line-44","kind":"lyric","text":"I love you, I'm sorry","columns":21,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0}]},{"id":"line-45","kind":"lyric","text":"The way life goes","columns":17,"beats":4,"changes":[{"symbol":"A#","column":4,"beat":0},{"symbol":"F","column":14,"beat":2}]},{"id":"line-46","kind":"lyric","text":"(You were the best but you were the worst)","columns":42,"beats":4,"changes":[]},{"id":"line-47","kind":"lyric","text":"(As sick as it sounds, I loved you first)","columns":41,"beats":4,"changes":[]},{"id":"line-48","kind":"lyric","text":"I wanna speak in code","columns":21,"beats":4,"changes":[{"symbol":"Cm7","column":8,"beat":0},{"symbol":"D#","column":17,"beat":2}]},{"id":"line-49","kind":"lyric","text":"(I was a dick, it is what it is)","columns":32,"beats":4,"changes":[]},{"id":"line-50","kind":"lyric","text":"(A habit to kick, the age-old curse)","columns":36,"beats":4,"changes":[]},{"id":"line-51","kind":"lyric","text":"Hope that I don't, won't make it about me","columns":41,"beats":6,"changes":[{"symbol":"A#","column":12,"beat":0},{"symbol":"F","column":26,"beat":2},{"symbol":"Cm7","column":37,"beat":4}]},{"id":"line-52","kind":"lyric","text":"(I tend to laugh whenever I'm sad)","columns":34,"beats":4,"changes":[]},{"id":"line-53","kind":"lyric","text":"(I stare at the crash, it actually works)","columns":41,"beats":4,"changes":[]},{"id":"line-54","kind":"lyric","text":"I love you, I'm sorry","columns":21,"beats":4,"changes":[{"symbol":"D#","column":2,"beat":0}]}]}