{"version":1,"id":"hamilton-an-american-musical-satisfied","title":"Satisfied","artist":"Hamilton: An American Musical","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/hamilton/satisfied/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/3dP0pLbg9OfVwssDjp9aT0","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Lin-Manuel Miranda","chords":[{"symbol":"Cm7","canonical":"Cm7","keyboardPitchClasses":[0,3,7,10],"interpretation":null},{"symbol":"Eb/Bb","canonical":"Eb/Bb","keyboardPitchClasses":[10,3,7],"interpretation":null},{"symbol":"Cm7/F","canonical":"Cm7/F","keyboardPitchClasses":[],"interpretation":null},{"symbol":"Ab9","canonical":"Abadd9","keyboardPitchClasses":[8,10,0],"interpretation":"Keyboard interpretation: Abadd9"},{"symbol":"G7","canonical":"G7","keyboardPitchClasses":[7,11,2,5],"interpretation":null},{"symbol":"Ab7","canonical":"Ab7","keyboardPitchClasses":[8,0,3,6],"interpretation":null},{"symbol":"Cm7/Bb","canonical":"Cm7/Bb","keyboardPitchClasses":[10,0,3,7],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"Eb7","canonical":"Eb7","keyboardPitchClasses":[3,7,10,1],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Alright, alright. That's what I'm talkin' about!","columns":48,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0},{"symbol":"Eb/Bb","column":34,"beat":2}]},{"id":"line-2","kind":"lyric","text":"Now everyone give it up for the maid of honor","columns":45,"beats":4,"changes":[{"symbol":"Cm7/F","column":11,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Angelica Schuyler!","columns":20,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0},{"symbol":"G7","column":18,"beat":2}]},{"id":"line-4","kind":"lyric","text":"A toast to the groom (to the groom, to the groom, to the groom)","columns":63,"beats":4,"changes":[{"symbol":"Cm7","column":15,"beat":0}]},{"id":"line-5","kind":"lyric","text":"To the bride (To the bride, to the bride, to the bride)","columns":55,"beats":4,"changes":[{"symbol":"Eb/Bb","column":7,"beat":0}]},{"id":"line-6","kind":"lyric","text":"From your sister (Angelica, Angelica, Angelica)","columns":47,"beats":4,"changes":[{"symbol":"Cm7/F","column":10,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Who is always by your side (By your side)","columns":41,"beats":4,"changes":[{"symbol":"Ab9","column":8,"beat":0},{"symbol":"G7","column":37,"beat":2}]},{"id":"line-8","kind":"lyric","text":"To your union (To the union! To the revolution!)","columns":48,"beats":4,"changes":[{"symbol":"Cm7","column":8,"beat":0}]},{"id":"line-9","kind":"lyric","text":"And the hope that you provide (provide, provide)","columns":48,"beats":4,"changes":[{"symbol":"Eb/Bb","column":8,"beat":0}]},{"id":"line-10","kind":"lyric","text":"May you always (always)","columns":23,"beats":4,"changes":[{"symbol":"Cm7/F","column":8,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Be satisfied (rewind)","columns":21,"beats":4,"changes":[{"symbol":"Ab9","column":4,"beat":0},{"symbol":"G7","column":15,"beat":2}]},{"id":"line-12","kind":"lyric","text":"I remember that night I just might","columns":34,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-13","kind":"lyric","text":"regret that night for the rest of my days","columns":41,"beats":4,"changes":[]},{"id":"line-14","kind":"lyric","text":"I remember those soldier boys tripping over themselves","columns":54,"beats":4,"changes":[{"symbol":"Eb/Bb","column":0,"beat":0}]},{"id":"line-15","kind":"lyric","text":"to win our praise","columns":17,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"I remember that dreamlike candlelight","columns":37,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"like a dream that you can't quite place","columns":39,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"But Alexander I'll never forget the first time I saw your face","columns":62,"beats":8,"changes":[{"symbol":"Ab9","column":0,"beat":0},{"symbol":"G7","column":21,"beat":2},{"symbol":"Cm7","column":58,"beat":5}]},{"id":"line-19","kind":"lyric","text":"I have never been the same","columns":26,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Intelligent eyes in a hunger-pang frame","columns":39,"beats":4,"changes":[{"symbol":"Eb/Bb","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"And when you said \"hi\" I forgot my dang name","columns":44,"beats":4,"changes":[{"symbol":"Cm7/F","column":4,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Set my heart aflame, every part aflame","columns":38,"beats":4,"changes":[{"symbol":"Ab9","column":7,"beat":0},{"symbol":"G7","column":32,"beat":2}]},{"id":"line-23","kind":"lyric","text":"This is not a game","columns":18,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"You strike me as a woman who has never been satisfied","columns":53,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-25","kind":"lyric","text":"I'm sure I don't know what you mean, you forget yourself","columns":56,"beats":4,"changes":[{"symbol":"Eb/Bb","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"You're like me. I'm never satisfied","columns":35,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Is that right?","columns":14,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"I have never been satisfied","columns":27,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0}]},{"id":"line-29","kind":"lyric","text":"My name is Angelica Schuyler","columns":28,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Alexander Hamilton","columns":18,"beats":4,"changes":[{"symbol":"Eb/Bb","column":0,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Where's your family from?","columns":25,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"Unimportant, there's a million things I haven't done","columns":52,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Just you wait, just you wait","columns":28,"beats":4,"changes":[{"symbol":"Ab7","column":0,"beat":0},{"symbol":"G7","column":15,"beat":2}]},{"id":"line-34","kind":"lyric","text":"So so so, so this is what it feels like to match wits","columns":53,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-35","kind":"lyric","text":"with someone at your level. What the hell is the catch?","columns":55,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"It's the feeling of freedom, of seeing the light","columns":48,"beats":4,"changes":[{"symbol":"Eb/Bb","column":9,"beat":0}]},{"id":"line-37","kind":"lyric","text":"It's Ben Franklin with a key and a kite","columns":39,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"You see it right?","columns":17,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"The conversation lasted two minutes, maybe three minutes","columns":56,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Everything we said in total agreement","columns":37,"beats":4,"changes":[]},{"id":"line-41","kind":"lyric","text":"It's a dream and it's a bit of a dance","columns":38,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0}]},{"id":"line-42","kind":"lyric","text":"A bit of a posture, it's a bit of a stance","columns":42,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0}]},{"id":"line-43","kind":"lyric","text":"He's a bit of a flirt but I'mma give it a chance","columns":48,"beats":2,"changes":[{"symbol":"Cm7","column":7,"beat":0}]},{"id":"line-44","kind":"lyric","text":"I asked about his family, did you see his answer?","columns":49,"beats":4,"changes":[]},{"id":"line-45","kind":"lyric","text":"His hands started fidgeting, he looked askance?","columns":47,"beats":4,"changes":[{"symbol":"Eb/Bb","column":4,"beat":0}]},{"id":"line-46","kind":"lyric","text":"He's penniless; he's flying by the seat of his pants","columns":52,"beats":4,"changes":[]},{"id":"line-47","kind":"lyric","text":"Handsome, boy does he know it","columns":29,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-48","kind":"lyric","text":"Peach fuzz, and he can't even grow it","columns":37,"beats":4,"changes":[]},{"id":"line-49","kind":"lyric","text":"I wanna take him far away from this place","columns":41,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0}]},{"id":"line-50","kind":"lyric","text":"Then I turn and see my sister's face and she is...","columns":50,"beats":4,"changes":[{"symbol":"G7","column":7,"beat":0}]},{"id":"line-51","kind":"lyric","text":"Helpless","columns":8,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-52","kind":"lyric","text":"And I know she is","columns":17,"beats":4,"changes":[]},{"id":"line-53","kind":"lyric","text":"Helpless","columns":8,"beats":4,"changes":[{"symbol":"Cm7/Bb","column":0,"beat":0}]},{"id":"line-54","kind":"lyric","text":"And her eyes are just","columns":21,"beats":4,"changes":[]},{"id":"line-55","kind":"lyric","text":"Helpless","columns":8,"beats":6,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-56","kind":"lyric","text":"And I realize three fundamental truths at the exact same time","columns":61,"beats":4,"changes":[{"symbol":"Ab9","column":20,"beat":0},{"symbol":"G7","column":57,"beat":2}]},{"id":"line-57","kind":"lyric","text":"Where are you taking me?","columns":24,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-58","kind":"lyric","text":"I'm about to change your life.","columns":30,"beats":4,"changes":[]},{"id":"line-59","kind":"lyric","text":"Then by all means, lead the way.","columns":32,"beats":4,"changes":[]},{"id":"line-60","kind":"lyric","text":"Number one!","columns":11,"beats":4,"changes":[{"symbol":"Cm7","column":7,"beat":0}]},{"id":"line-61","kind":"lyric","text":"I'm a girl in a world in which my only job is to marry rich","columns":59,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-62","kind":"lyric","text":"My father has no sons so I'm the one","columns":36,"beats":4,"changes":[{"symbol":"Eb/Bb","column":0,"beat":0}]},{"id":"line-63","kind":"lyric","text":"who has to social climb for one","columns":31,"beats":4,"changes":[]},{"id":"line-64","kind":"lyric","text":"So I'm the oldest and the wittiest and the gossip in","columns":52,"beats":4,"changes":[{"symbol":"Cm7/F","column":12,"beat":0}]},{"id":"line-65","kind":"lyric","text":"New York City is insidious","columns":26,"beats":4,"changes":[]},{"id":"line-66","kind":"lyric","text":"And Alexander is penniless","columns":26,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0}]},{"id":"line-67","kind":"lyric","text":"That doesn't mean I want him any less","columns":37,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0}]},{"id":"line-68","kind":"lyric","text":"Elizabeth Schuyler. It's a pleasure to meet you.","columns":48,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-69","kind":"lyric","text":"Schuyler?","columns":9,"beats":4,"changes":[]},{"id":"line-70","kind":"lyric","text":"My sister","columns":9,"beats":4,"changes":[]},{"id":"line-71","kind":"lyric","text":"Number two!","columns":11,"beats":4,"changes":[{"symbol":"Cm7","column":7,"beat":0}]},{"id":"line-72","kind":"lyric","text":"He's after me cuz I'm a Schuyler sister","columns":39,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-73","kind":"lyric","text":"That elevates his status","columns":24,"beats":4,"changes":[]},{"id":"line-74","kind":"lyric","text":"I'd have to be naive to set that aside","columns":38,"beats":4,"changes":[{"symbol":"Eb/Bb","column":4,"beat":0}]},{"id":"line-75","kind":"lyric","text":"Maybe that is why","columns":17,"beats":4,"changes":[]},{"id":"line-76","kind":"lyric","text":"I introduce him to Eliza","columns":24,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-77","kind":"lyric","text":"Now that's his bride","columns":20,"beats":4,"changes":[]},{"id":"line-78","kind":"lyric","text":"Nice going, Angelica, he was right","columns":34,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0}]},{"id":"line-79","kind":"lyric","text":"You will never be satisfied","columns":27,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0}]},{"id":"line-80","kind":"lyric","text":"Thank you for all your service","columns":30,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-81","kind":"lyric","text":"If it takes fighting a war for us to meet, it will have been worth it","columns":69,"beats":4,"changes":[]},{"id":"line-82","kind":"lyric","text":"I'll leave you to it.","columns":21,"beats":4,"changes":[]},{"id":"line-83","kind":"lyric","text":"Number three!","columns":13,"beats":4,"changes":[{"symbol":"Cm7","column":7,"beat":0}]},{"id":"line-84","kind":"lyric","text":"I know my sister like I know my own mind","columns":40,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-85","kind":"lyric","text":"You will never find anyone as trusting or as kind","columns":49,"beats":6,"changes":[{"symbol":"Eb/Bb","column":10,"beat":0}]},{"id":"line-86","kind":"lyric","text":"If I tell her that I love him she'd be silently resigned","columns":56,"beats":4,"changes":[{"symbol":"Cm7/F","column":5,"beat":0}]},{"id":"line-87","kind":"lyric","text":"He'd be mine","columns":12,"beats":4,"changes":[{"symbol":"Ab9","column":8,"beat":0}]},{"id":"line-88","kind":"lyric","text":"She would say \"I'm fine\"","columns":24,"beats":4,"changes":[{"symbol":"G7","column":19,"beat":0}]},{"id":"line-89","kind":"lyric","text":"She'd be lying","columns":14,"beats":4,"changes":[]},{"id":"line-90","kind":"lyric","text":"But when I fantasize at night it's Alexander's eyes","columns":51,"beats":4,"changes":[{"symbol":"Cm7","column":0,"beat":0}]},{"id":"line-91","kind":"lyric","text":"as I romanticize what might have been if I hadn't","columns":49,"beats":4,"changes":[{"symbol":"Eb/Bb","column":0,"beat":0}]},{"id":"line-92","kind":"lyric","text":"sized him up so quickly","columns":23,"beats":4,"changes":[{"symbol":"Cm7/F","column":0,"beat":0}]},{"id":"line-93","kind":"lyric","text":"At least my dear Eliza's his wife","columns":33,"beats":4,"changes":[{"symbol":"Eb","column":29,"beat":0}]},{"id":"line-94","kind":"lyric","text":"At least I keep his eyes in my life","columns":38,"beats":2,"changes":[{"symbol":"G7","column":36,"beat":0}]},{"id":"line-95","kind":"lyric","text":"To the groom! (to the groom, to the groom, to the groom)","columns":56,"beats":4,"changes":[{"symbol":"Cm7","column":8,"beat":0}]},{"id":"line-96","kind":"lyric","text":"To the bride! (To the bride, to the bride, to the bride)","columns":56,"beats":4,"changes":[{"symbol":"Eb/Bb","column":7,"beat":0}]},{"id":"line-97","kind":"lyric","text":"From your sister (Angelica, Angelica, Angelica)","columns":47,"beats":4,"changes":[{"symbol":"Cm7/F","column":10,"beat":0}]},{"id":"line-98","kind":"lyric","text":"Who is always by your side (By your side)","columns":41,"beats":4,"changes":[{"symbol":"Ab9","column":8,"beat":0},{"symbol":"G7","column":37,"beat":2}]},{"id":"line-99","kind":"lyric","text":"To your union (To the union! To the revolution!)","columns":48,"beats":4,"changes":[{"symbol":"Cm7","column":8,"beat":0}]},{"id":"line-100","kind":"lyric","text":"And the hope that you provide (provide, provide)","columns":48,"beats":4,"changes":[{"symbol":"Eb7","column":8,"beat":0}]},{"id":"line-101","kind":"lyric","text":"May you always (always)","columns":23,"beats":4,"changes":[{"symbol":"Cm7/F","column":8,"beat":0}]},{"id":"line-102","kind":"lyric","text":"Be satisfied (satisfied, satisfied, satisfied)","columns":46,"beats":4,"changes":[{"symbol":"Ab9","column":4,"beat":0},{"symbol":"G7","column":29,"beat":2}]},{"id":"line-103","kind":"lyric","text":"And I know","columns":10,"beats":4,"changes":[{"symbol":"Cm7","column":6,"beat":0}]},{"id":"line-104","kind":"lyric","text":"she'll be happy as his bride","columns":28,"beats":4,"changes":[{"symbol":"Eb/Bb","column":11,"beat":0}]},{"id":"line-105","kind":"lyric","text":"And I know","columns":11,"beats":4,"changes":[{"symbol":"Cm7/F","column":6,"beat":0}]},{"id":"line-106","kind":"lyric","text":"He will never be satisfied","columns":26,"beats":4,"changes":[{"symbol":"Ab9","column":0,"beat":0}]},{"id":"line-107","kind":"lyric","text":"I will never be satisfied","columns":36,"beats":4,"changes":[{"symbol":"G7","column":0,"beat":0},{"symbol":"Cm7","column":33,"beat":2}]}]}