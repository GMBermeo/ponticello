{"version":1,"id":"powfu-death-bed","title":"Death Bed","artist":"Powfu","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/powfu/death-bed/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Beatrice Laus, Isaiah Faber and Oscar Lang","chords":[{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"C7M","canonical":"Cmaj7","keyboardPitchClasses":[0,4,7,11],"interpretation":"Keyboard interpretation: Cmaj7"},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"Don't stay awake for too long","columns":29,"beats":4,"changes":[{"symbol":"C","column":1,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Don't go to bed","columns":15,"beats":4,"changes":[{"symbol":"C7M","column":1,"beat":0}]},{"id":"line-4","kind":"lyric","text":"I'll make a cup of coffee for your head","columns":39,"beats":2,"changes":[{"symbol":"F","column":14,"beat":0}]},{"id":"line-5","kind":"lyric","text":"It'll get you up and goin' out of bed","columns":37,"beats":2,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-6","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-7","kind":"lyric","text":"Yeah, I don't wanna fall asleep","columns":31,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0}]},{"id":"line-8","kind":"lyric","text":"I don't wanna pass away","columns":23,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"I been thinkin' of our future 'cause","columns":36,"beats":4,"changes":[{"symbol":"C7M","column":5,"beat":0}]},{"id":"line-10","kind":"lyric","text":"I'll never see those days","columns":25,"beats":4,"changes":[]},{"id":"line-11","kind":"lyric","text":"I don't know why this has happened","columns":34,"beats":4,"changes":[{"symbol":"F","column":7,"beat":0}]},{"id":"line-12","kind":"lyric","text":"But I probably deserve it","columns":25,"beats":4,"changes":[]},{"id":"line-13","kind":"lyric","text":"I tried to do my best","columns":21,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0}]},{"id":"line-14","kind":"lyric","text":"But you know that I'm not perfect","columns":33,"beats":4,"changes":[]},{"id":"line-15","kind":"lyric","text":"I been prayin' for forgiveness","columns":30,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0}]},{"id":"line-16","kind":"lyric","text":"You've been prayin' for my health","columns":33,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"When I leave this Earth","columns":23,"beats":4,"changes":[{"symbol":"C7M","column":1,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Hopin' you'll find someone else","columns":31,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"'Cause yeah, we still young","columns":27,"beats":4,"changes":[{"symbol":"F","column":5,"beat":0}]},{"id":"line-20","kind":"lyric","text":"There's so much we haven't done","columns":31,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"Gettin' married, start a family","columns":31,"beats":4,"changes":[{"symbol":"Fm","column":6,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Watch your husband with his son","columns":31,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"I wish it could be me, but","columns":26,"beats":4,"changes":[{"symbol":"C","column":2,"beat":0}]},{"id":"line-24","kind":"lyric","text":"I won't make it out this bed","columns":28,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"I hope I go to heaven so","columns":24,"beats":4,"changes":[{"symbol":"C7M","column":2,"beat":0}]},{"id":"line-26","kind":"lyric","text":"I see you once again","columns":20,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric",