{"version":1,"id":"bailey-zimmerman-where-it-ends","title":"Where It Ends","artist":"Bailey Zimmerman","key":"F#m","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/bailey-zimmerman/where-it-ends/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Joe London, Grant Averill and Bailey Zimmerman","chords":[{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":22,"beats":8,"changes":[{"symbol":"F#m","column":8,"beat":0},{"symbol":"A","column":13,"beat":2},{"symbol":"E","column":16,"beat":4},{"symbol":"F#m","column":19,"beat":6}]},{"id":"line-2","kind":"section","text":"[Verse 1]","columns":9,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"This is where it ends","columns":21,"beats":4,"changes":[{"symbol":"F#m","column":18,"beat":0}]},{"id":"line-4","kind":"lyric","text":"I've been down a few broken roads that I'm trying to mend","columns":57,"beats":4,"changes":[{"symbol":"A","column":11,"beat":0},{"symbol":"E","column":54,"beat":2}]},{"id":"line-5","kind":"lyric","text":"But this is where it ends","columns":25,"beats":4,"changes":[{"symbol":"F#m","column":22,"beat":0}]},{"id":"line-6","kind":"lyric","text":"And I'm breaking down","columns":21,"beats":4,"changes":[{"symbol":"F#m","column":18,"beat":0}]},{"id":"line-7","kind":"lyric","text":"You were lying when you said that you were trying to work things","columns":66,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"E","column":65,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Out","columns":3,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"But now I'm broken down","columns":23,"beats":4,"changes":[{"symbol":"F#m","column":20,"beat":0}]},{"id":"line-10","kind":"section","text":"[Verse 2]","columns":9,"beats":0,"changes":[]},{"id":"line-11","kind":"lyric","text":"I went to battle for you always","columns":31,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Fought for you on your worst days","columns":33,"beats":4,"changes":[{"symbol":"A","column":1,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Then you told me that you don't love me no more","columns":47,"beats":4,"changes":[{"symbol":"E","column":1,"beat":0},{"symbol":"F#m","column":44,"beat":2}]},{"id":"line-14","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"You're the last thing that I thought I'd lose","columns":45,"beats":4,"changes":[{"symbol":"D","column":12,"beat":0},{"symbol":"A","column":30,"beat":2}]},{"id":"line-16","kind":"lyric","text":"All I ever wanted was to be loved by you","columns":40,"beats":4,"changes":[{"symbol":"E","column":7,"beat":0},{"symbol":"F#m","column":29,"beat":2}]},{"id":"line-17","kind":"lyric","text":"I let you back in and I gave you a second chance","columns":48,"beats":6,"changes":[{"symbol":"D","column":3,"beat":0},{"symbol":"A","column":25,"beat":2},{"symbol":"E","column":43,"beat":4}]},{"id":"line-18","kind":"lyric","text":"And like a jet plane on a clear blue sky","columns":40,"beats":4,"changes":[{"symbol":"D","column":12,"beat":0},{"symbol":"A","column":27,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Sun came shining down on all your lies","columns":38,"beats":4,"changes":[{"symbol":"E","column":5,"beat":0},{"symbol":"F#m","column":25,"beat":2}]},{"id":"line-20","kind":"lyric","text":"I got too much pride to let that happen again","columns":45,"beats":3,"changes":[{"symbol":"D","column":7,"beat":0},{"symbol":"A","column":25,"beat":1},{"symbol":"E","column