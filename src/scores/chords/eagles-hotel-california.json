{"version":1,"id":"eagles-hotel-california","title":"Hotel California","artist":"Eagles","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/the-eagles/hotel-california/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Don Felder, Don Henley and Glenn Frey","chords":[{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"F#7","canonical":"F#7","keyboardPitchClasses":[6,10,1,4],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"E7","canonical":"E7","keyboardPitchClasses":[4,8,11,2],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Intro]","columns":7,"beats":0,"changes":[]},{"id":"line-2","kind":"section","text":"[Intro - Tab 1]","columns":15,"beats":0,"changes":[]},{"id":"line-3","kind":"section","text":"[Intro - Tab 2]","columns":15,"beats":0,"changes":[]},{"id":"line-4","kind":"section","text":"[Primeira Parte - Dedilhado]","columns":28,"beats":0,"changes":[]},{"id":"line-5","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-6","kind":"lyric","text":"   On a dark desert highway","columns":27,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-7","kind":"lyric","text":"    Cool wind in my hair","columns":24,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"  Warm smell of colitas","columns":23,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"   Rising up through the air","columns":28,"beats":4,"changes":[{"symbol":"E7","column":0,"beat":0}]},{"id":"line-10","kind":"lyric","text":"  Up ahead in the distance","columns":26,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-11","kind":"lyric","text":"  I saw a shimmering light","columns":26,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-12","kind":"lyric","text":"   My head grew heavy and my sight grew dim","columns":43,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-13","kind":"lyric","text":"    I had to stop for the night","columns":31,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-14","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"   There she stood in the doorway","columns":33,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-16","kind":"lyric","text":"    I heard the mission bell","columns":28,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"  And I was thinking to myself","columns":30,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-18","kind":"lyric","text":"   This could be Heaven or this could be Hell","columns":45,"beats":4,"changes":[{"symbol":"E7","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"  Then she lit up a candle","columns":26,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"  And she showed me the way","columns":27,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"   There were voices down the corridor","columns":38,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"    I thought I heard them say","columns":30,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-23","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-24","kind":"lyric","text":"Welcome to the Hotel California","columns":31,"beats":4,"changes":[{"symbol":"G","column":1,"beat":0},{"symbol":"D","column":26,"beat":2}]},{"id":"line-25","kind":"lyric","text":"Such a lovely place","columns":19,"beats":4,"changes":[{"symbol":"F#7","column":8,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Such a lovely face","columns":18,"beats":4,"changes":[{"symbol":"Bm","column":1,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Plenty of room at the Hotel California","columns":38,"beats":4,"changes":[{"symbol":"G","column":2,"beat":0},{"symbol":"D","column":33,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Any time of year","columns":16,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0}]},{"id":"line-29","kind":"lyric","text":"You can find us here","columns":20,"beats":4,"changes":[{"symbol":"F#7","column":9,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Segunda parte - repete dedilhado","columns":32,"beats":4,"changes":[]},{"id":"line-31","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-32","kind":"lyric","text":"   Her mind is Tiffany-twisted","columns":30,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-33","kind":"lyric","text":"    She got the Mercedes-Benz","columns":29,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-34","kind":"lyric","text":"  She got a lot of pretty, pretty boys","columns":38,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-35","kind":"lyric","text":"  That she calls friends","columns":24,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-36","kind":"lyric","text":"  How they dance in the courtyard","columns":33,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-37","kind":"lyric","text":"Sweet summer sweat","columns":18,"beats":4,"changes":[{"symbol":"D","column":2,"beat":0}]},{"id":"line-38","kind":"lyric","text":"   Some dance to remember","columns":25,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-39","kind":"lyric","text":"    Some dance to forget","columns":24,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-40","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-41","kind":"lyric","text":"   So I called up the Captain","columns":29,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-42","kind":"lyric","text":"    Please bring me my wine, he said","columns":36,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-43","kind":"lyric","text":"  We haven't had that spirit here since","columns":39,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-44","kind":"lyric","text":"  Nineteen sixty-nine","columns":21,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-45","kind":"lyric","text":"  And still those voices","columns":24,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-46","kind":"lyric","text":"are calling from far away","columns":25,"beats":4,"changes":[{"symbol":"D","column":18,"beat":0}]},{"id":"line-47","kind":"lyric","text":"   Wake you up in the middle of the night","columns":41,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-48","kind":"lyric","text":"    Just to hear them say","columns":25,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-49","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-50","kind":"lyric","text":"Welcome to the Hotel California","columns":31,"beats":4,"changes":[{"symbol":"G","column":1,"beat":0},{"symbol":"D","column":26,"beat":2}]},{"id":"line-51","kind":"lyric","text":"Such a lovely place","columns":19,"beats":4,"changes":[{"symbol":"F#7","column":8,"beat":0}]},{"id":"line-52","kind":"lyric","text":"Such a lovely face","columns":18,"beats":4,"changes":[{"symbol":"Bm","column":1,"beat":0}]},{"id":"line-53","kind":"lyric","text":"We're livin' it up at the Hotel California","columns":42,"beats":4,"changes":[{"symbol":"G","column":1,"beat":0},{"symbol":"D","column":37,"beat":2}]},{"id":"line-54","kind":"lyric","text":"What a nice surprise","columns":20,"beats":4,"changes":[{"symbol":"Em","column":8,"beat":0}]},{"id":"line-55","kind":"lyric","text":"Bring your alibis","columns":17,"beats":2,"changes":[{"symbol":"F#7","column":11,"beat":0}]},{"id":"line-56","kind":"section","text":"[Terceira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-57","kind":"section","text":"[Primeira estrofe - Pausa]","columns":26,"beats":0,"changes":[]},{"id":"line-58","kind":"lyric","text":"   Mirrors on the ceiling","columns":25,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-59","kind":"lyric","text":"    The pink champagne on ice, and she said","columns":43,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-60","kind":"lyric","text":"  We are all just prisoners here","columns":32,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-61","kind":"lyric","text":"  Of our own device","columns":19,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-62","kind":"lyric","text":"  And in the master's chambers","columns":30,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-63","kind":"lyric","text":"  They gathered for the feast","columns":29,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-64","kind":"lyric","text":"   The stab it with their steely knives","columns":39,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-65","kind":"lyric","text":"But they just can't kill the beast","columns":34,"beats":4,"changes":[{"symbol":"F#7","column":10,"beat":0}]},{"id":"line-66","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-67","kind":"lyric","text":"   Last thing I remember, I was","columns":31,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-68","kind":"lyric","text":"    Running for the door","columns":24,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-69","kind":"lyric","text":"  I had to find the passage back","columns":32,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-70","kind":"lyric","text":"To the place I was before","columns":25,"beats":4,"changes":[{"symbol":"E","column":9,"beat":0}]},{"id":"line-71","kind":"lyric","text":"  Relax, said the night man","columns":27,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-72","kind":"lyric","text":"We are programmed to receive","columns":28,"beats":4,"changes":[{"symbol":"D","column":3,"beat":0}]},{"id":"line-73","kind":"lyric","text":"   You can check out any time you like","columns":38,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-74","kind":"lyric","text":"But you can never leave","columns":23,"beats":4,"changes":[{"symbol":"F#7","column":9,"beat":0}]},{"id":"line-75","kind":"instrumental","text":"[Solo]","columns":21,"beats":8,"changes":[{"symbol":"Bm","column":7,"beat":0},{"symbol":"F#7","column":11,"beat":2},{"symbol":"A","column":16,"beat":4},{"symbol":"E7","column":19,"beat":6}]},{"id":"line-76","kind":"instrumental","text":"","columns":20,"beats":8,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"D","column":10,"beat":2},{"symbol":"Em","column":13,"beat":4},{"symbol":"F#7","column":17,"beat":6}]},{"id":"line-77","kind":"section","text":"[Solo Final]","columns":12,"beats":0,"changes":[]}]}