{"version":1,"id":"billie-eilish-ilomilo","title":"Ilomilo","artist":"Billie Eilish","key":"Cm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/billie-eilish/ilomilo/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Finneas and Billie Eilish","chords":[{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Told you not to worry","columns":21,"beats":4,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-2","kind":"lyric","text":"But maybe that's a lie","columns":22,"beats":4,"changes":[{"symbol":"Cm","column":17,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Honey, what's your hurry?","columns":25,"beats":4,"changes":[{"symbol":"Fm","column":19,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Won't you stay inside?","columns":22,"beats":4,"changes":[{"symbol":"Cm","column":15,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Remember not to get too close to stars","columns":38,"beats":2,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-6","kind":"lyric","text":"They're never gonna give you love like ours","columns":43,"beats":4,"changes":[{"symbol":"Cm","column":20,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Where did you go?","columns":17,"beats":4,"changes":[{"symbol":"Cm","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"I should know, but it's cold","columns":28,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"And I don't wanna be lonely","columns":27,"beats":4,"changes":[{"symbol":"Gm","column":18,"beat":0}]},{"id":"line-10","kind":"lyric","text":"So show me the way home","columns":23,"beats":4,"changes":[{"symbol":"Fm","column":18,"beat":0}]},{"id":"line-11","kind":"lyric","text":"I can't lose another life","columns":25,"beats":4,"changes":[{"symbol":"Cm","column":17,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Hurry, I'm worried","columns":18,"beats":8,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"Gm","column":10,"beat":4}]},{"id":"line-13","kind":"lyric","text":"The world's a little blurry","columns":27,"beats":4,"changes":[{"symbol":"Fm","column":20,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Or maybe it's my eyes","columns":21,"beats":4,"changes":[{"symbol":"Cm","column":16,"beat":0}]},{"id":"line-15","kind":"lyric","text":"The friends I've had to bury","columns":28,"beats":4,"changes":[{"symbol":"Fm","column":21,"beat":0}]},{"id":"line-16","kind":"lyric","text":"They keep me up at night","columns":24,"beats":4,"changes":[{"symbol":"Cm","column":18,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Said I couldn't love someone","columns":28,"beats":4,"changes":[{"symbol":"Fm","column":20,"beat":0}]},{"id":"line-18","kind":"lyric","text":"'Cause I might break","columns":20,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"If you're gonna die, not by mistake","columns":35,"beats":4,"changes":[{"symbol":"Cm","column":1,"beat":0}]},{"id":"line-20","kind":"lyric","text":"So, where did you go?","columns":21,"beats":4,"changes":[{"symbol":"Cm","column":14,"beat":0}]},{"id":"line-21","kind":"lyric","text":"I should know, but it's cold","columns":28,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"And I don't wanna be lonely","columns":27,"beats":4,"changes":[{"symbol":"Gm","column":18,"beat":0}]},{"id":"line-23","kind":"lyric","text":"So tell me you'll come home","columns":27,"beats":4,"changes":[{"symbol":"Fm","column":22,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Even if it's just a lie","columns":23,"beats":4,"changes":[{"symbol":"Cm","column":18,"beat":0}]},{"id":"line-25","kind":"lyric","text":"I tried not to upset you","columns":24,"beats":4,"changes":[{"symbol":"Cm","column":15,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Let you rescue me the day I met you","columns":35,"beats":4,"changes":[{"symbol":"Gm","column":28,"beat":0}]},{"id":"line-27","kind":"lyric","text":"I just wanted to protect you","columns":28,"beats":4,"changes":[{"symbol":"Fm","column":19,"beat":0}]},{"id":"line-28","kind":"lyric","text":"But now I'll never get to","columns":25,"beats":4,"changes":[{"symbol":"Cm","column":19,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Hurry, I'm worried","columns":28,"beats":8,"changes":[{"symbol":"Cm","column":0,"beat":0},{"symbol":"Gm","column":9,"beat":2},{"symbol":"Fm","column":19,"beat":4},{"symbol":"Cm","column":26,"beat":6}]},{"id":"line-30","kind":"lyric","text":"Where did you go?","columns":17,"beats":4,"changes":[{"symbol":"Cm","column":14,"beat":0}]},{"id":"line-31","kind":"lyric","text":"I should know, but it's cold","columns":28,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"And I don't wanna be lonely","columns":27,"beats":4,"changes":[{"symbol":"Gm","column":21,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Was hoping you'd come home","columns":26,"beats":4,"changes":[{"symbol":"Fm","column":22,"beat":0}]},{"id":"line-34","kind":"lyric","text":"I don't care if it's a lie","columns":26,"beats":4,"changes":[{"symbol":"Cm","column":22,"beat":0}]}]}