{"version":1,"id":"luke-combs-where-the-wild-things-are","title":"Where The Wild Things Are","artist":"Luke Combs","key":"D","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/luke-combs/where-the-wild-things-are/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Randy Montana and Dave Turnbull","chords":[{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"My big brother rode an Indian Scout","columns":35,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":23,"beat":2}]},{"id":"line-2","kind":"lyric","text":"It was black like his jacket","columns":28,"beats":4,"changes":[{"symbol":"D","column":22,"beat":0}]},{"id":"line-3","kind":"lyric","text":"American Spirit hangin' outta his mouth","columns":39,"beats":4,"changes":[{"symbol":"G","column":24,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Just like our daddy","columns":19,"beats":4,"changes":[{"symbol":"D","column":14,"beat":0}]},{"id":"line-5","kind":"lyric","text":"He kicked-started that bike one night and broke Mama's heart","columns":60,"beats":6,"changes":[{"symbol":"Bm","column":10,"beat":0},{"symbol":"G","column":32,"beat":2},{"symbol":"D","column":56,"beat":4}]},{"id":"line-6","kind":"lyric","text":"He pointed that headlight west","columns":30,"beats":4,"changes":[{"symbol":"G","column":16,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Out where the wild things are","columns":29,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"D","column":26,"beat":2}]},{"id":"line-8","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-9","kind":"lyric","text":"He'd call me up every couple of weeks","columns":37,"beats":4,"changes":[{"symbol":"G","column":23,"beat":0}]},{"id":"line-10","kind":"lyric","text":"From South California","columns":21,"beats":4,"changes":[{"symbol":"D","column":15,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Talk about the desert and the Joshua Tree","columns":41,"beats":4,"changes":[{"symbol":"G","column":30,"beat":0}]},{"id":"line-12","kind":"lyric","text":"And his pretty girl stories","columns":27,"beats":4,"changes":[{"symbol":"D","column":20,"beat":0}]},{"id":"line-13","kind":"lyric","text":"How he bought an Airstream trailer and a J-45 guitar","columns":52,"beats":6,"changes":[{"symbol":"Bm","column":17,"beat":0},{"symbol":"G","column":41,"beat":2},{"symbol":"D","column":49,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Said, \"Little brother, you'd love it out here","columns":45,"beats":4,"changes":[{"symbol":"G","column":29,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Out where the wild things are\"","columns":30,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"D","column":26,"beat":2}]},{"id":"line-16","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-17","kind":"lyric","text":"Oh, it's hearts on fire and crazy dreams","columns":40,"beats":8,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"G","column":3,"beat":2},{"symbol":"D","column":19,"beat":4},{"symbol":"A","column":34,"beat":6}]},{"id":"line-18","kind":"lyric","text":"Oh, the nights ignite like gasoline","columns":35,"beats":8,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"G","column":3,"beat":2},{"symbol":"D","column":17,"beat":4},{"symbol":"A","column":31,"beat":6}]},{"id":"line-19","kind":"lyric","text":"And light up those streets that never sleep when the sky goes dark","columns":66,"beats":6,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"D","column":32,"beat":2},{"symbol":"Em","column":53,"beat":4}]},{"id":"line-20","kind":"lyric","text":"Out where the wild things are","columns":29,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"D","column":26,"beat":2}]},{"id":"line-21","kind":"section","text":"[Terceira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-22","kind":"lyric","text":"I called my brother from the back of that plane","columns":47,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":29,"beat":2}]},{"id":"line-23","kind":"lyric","text":"The second I made it","columns":20,"beats":4,"changes":[{"symbol":"D","column":13,"beat":0}]},{"id":"line-24","kind":"lyric","text":"We started drinkin' on the strip in LA","columns":38,"beats":4,"changes":[{"symbol":"G","column":27,"beat":0}]},{"id":"line-25","kind":"lyric","text":"And then it got crazy","columns":21,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Ended up at a house in the hills with some Hollywood stars","columns":58,"beats":3,"changes":[{"symbol":"Bm","column":6,"beat":0},{"symbol":"G","column":27,"beat":1},{"symbol":"D","column":48,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Kissin' on a blonde in a backyard pool","columns":38,"beats":4,"changes":[{"symbol":"G","column":25,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Out where the wild things are","columns":29,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"Bm","column":26,"beat":2}]},{"id":"line-29","kind":"instrumental","text":"[Solo]","columns":14,"beats":6,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"D","column":10,"beat":2},{"symbol":"A","column":13,"beat":4}]},{"id":"line-30","kind":"instrumental","text":"","columns":15,"beats":6,"changes":[{"symbol":"Bm","column":7,"beat":0},{"symbol":"G","column":11,"beat":2},{"symbol":"A","column":14,"beat":4}]},{"id":"line-31","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-32","kind":"lyric","text":"Couple iron horse rebels","columns":24,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Wild as the devil","columns":17,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-34","kind":"lyric","text":"I knew I had to move back east","columns":30,"beats":6,"changes":[{"symbol":"A","column":7,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Said goodbye to my brother","columns":26,"beats":4,"changes":[{"symbol":"G","column":13,"beat":0}]},{"id":"line-36","kind":"lyric","text":"At the end of that summer","columns":25,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-37","kind":"lyric","text":"But I knew he'd never leave","columns":27,"beats":4,"changes":[{"symbol":"A","column":6,"beat":0}]},{"id":"line-38","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-39","kind":"lyric","text":"Oh, it's hearts on fire and crazy dreams","columns":40,"beats":8,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"G","column":4,"beat":2},{"symbol":"D","column":19,"beat":4},{"symbol":"A","column":34,"beat":6}]},{"id":"line-40","kind":"lyric","text":"Oh, the nights ignite like gasoline","columns":35,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"G","column":4,"beat":1},{"symbol":"D","column":18,"beat":2},{"symbol":"A","column":32,"beat":3}]},{"id":"line-41","kind":"lyric","text":"And oh, them Indian Scouts, man, they're built for speed","columns":56,"beats":4,"changes":[{"symbol":"Bm","column":4,"beat":0},{"symbol":"G","column":8,"beat":1},{"symbol":"D","column":20,"beat":2},{"symbol":"A","column":51,"beat":3}]},{"id":"line-42","kind":"lyric","text":"And oh, they said he hit that guardrail at half past three","columns":58,"beats":4,"changes":[{"symbol":"Bm","column":4,"beat":0},{"symbol":"G","column":8,"beat":1},{"symbol":"D","column":30,"beat":2},{"symbol":"A","column":53,"beat":3}]},{"id":"line-43","kind":"lyric","text":"Lit up those streets that never sleep when the sky goes dark","columns":60,"beats":3,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"D","column":26,"beat":1},{"symbol":"Em","column":47,"beat":2}]},{"id":"line-44","kind":"lyric","text":"We buried him out in the wind 'neath the West Coast stars","columns":58,"beats":8,"changes":[{"symbol":"G","column":3,"beat":0},{"symbol":"D","column":14,"beat":2},{"symbol":"Em","column":41,"beat":4},{"symbol":"A","column":57,"beat":6}]},{"id":"line-45","kind":"lyric","text":"Out where the wild things are","columns":29,"beats":4,"changes":[{"symbol":"D","column":26,"beat":0}]},{"id":"line-46","kind":"instrumental","text":"[Final]","columns":12,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"G","column":11,"beat":2}]},{"id":"line-47","kind":"lyric","text":"Out where the wild things are","columns":29,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"D","column":26,"beat":2}]}]}