{"version":1,"id":"lorde-what-was-that","title":"What Was That","artist":"Lorde","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/lorde/what-was-that/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Lorde and Jim E Stack","chords":[{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":9,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-2","kind":"lyric","text":"A place in the city","columns":19,"beats":4,"changes":[{"symbol":"F","column":4,"beat":0},{"symbol":"Am","column":16,"beat":2}]},{"id":"line-3","kind":"lyric","text":"A chair and a bed","columns":17,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-4","kind":"lyric","text":"I cover up all the mirrors, I can't see myself yet","columns":50,"beats":8,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Am","column":16,"beat":2},{"symbol":"C","column":32,"beat":4},{"symbol":"D","column":48,"beat":6}]},{"id":"line-5","kind":"lyric","text":"I wear smoke like a wedding veil","columns":32,"beats":8,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"Am","column":21,"beat":4}]},{"id":"line-6","kind":"lyric","text":"Make a meal I won't eat","columns":23,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":20,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Step out into the street, alone in a sea","colu