:[{"symbol":"Eb7M","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Couple of feelings that were laid to rest","columns":41,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"Didn't know that the party was over","columns":35,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-10","kind":"lyric","text":"And it's true that I need you, get closer","columns":41,"beats":4,"changes":[]},{"id":"line-11","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-12","kind":"lyric","text":"Burning photos, had to learn to let go","columns":38,"beats":4,"changes":[{"symbol":"Abm7","column":0,"beat":0}]},{"id":"line-13","kind":"lyric","text":"I used to be","columns":12,"beats":8,"changes":[{"symbol":"Eb7M","column":0,"beat":0},{"symbol":"Cm","column":10,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Somebody in another skin (Another skin)","columns":39,"beats":4,"changes":[{"symbol":"Fm7","column":0,"beat":0},{"symbol":"Abm7","column":20,"beat":2}]},{"id":"line-15","kind":"lyric","text":"I heard that you're happy without me","columns":36,"beats":4,"changes":[{"symbol":"Eb7M","column":0,"beat":0}]},{"id":"line-16","kind":"lyric","text":"And I hope it's true (I hope, I hope it's true)","columns":47,"beats":4,"changes":[{"symbol":"Fm","column":11,"beat":0},{"symbol":"Abm7","column":22,"beat":2}]},{"id":"line-17","kind":"lyric","text":"It kills me a little, that's okay","columns":33,"beats":4,"changes":[{"symbol":"Eb7M","column":0,"beat":0}]},{"id":"line-18","kind":"lyric","text":"'Cause I'd die for you","columns":23,"beats":4,"changes":[{"symbol":"Fm","column":21,"beat":0}]},{"id":"line-19","kind":"lyric","text":"You know I'd still die for you","columns":30,"beats":4,"changes":[{"symbol":"Abm7","column":0,"beat":0}]},{"id":"line-20","kind":"instrumental","text":"(                )","columns":18,"beats":6,"changes":[{"symbol":"Eb7M","column":2,"beat":0},{"symbol":"Fm","column":8,"beat":2},{"symbol":"Abm7","column