{"version":1,"id":"olivia-dean-let-alone-the-one-you-love","title":"Let Alone The One You Love","artist":"Olivia Dean","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/olivia-dean/let-alone-the-one-you-love/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Bastian Langebaek, Max Wolfgang, Olivia Dean and Deschanel Gordon","chords":[{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"G/B","canonical":"G/B","keyboardPitchClasses":[11,2,7],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":21,"beats":8,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"G/B","column":11,"beat":2},{"symbol":"Am","column":16,"beat":4},{"symbol":"D","column":20,"beat":6}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"  Thought I was done with this feeling","columns":38,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":31,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I really thought you could be him","columns":33,"beats":4,"changes":[{"symbol":"D","column":27,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Thought I was safe, hmm","columns":23,"beats":4,"changes":[{"symbol":"C","column":16,"beat":0}]},{"id":"line-6","kind":"lyric","text":"  You were the warmth that I needed","columns":35,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":28,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Like a breeze in the evening","columns":28,"beats":4,"changes":[{"symbol":"D","column":21,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And then you changed","columns":23,"beats":4,"changes":[{"symbol":"C","column":16,"beat":0},{"symbol":"G/B","column":20,"beat":2}]},{"id":"line-9","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"You're all the same, yeah","columns":25,"beats":4,"changes":[{"symbol":"Am","column":8,"beat":0},{"symbol":"D","column":21,"beat":2}]},{"id":"line-11","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-12","kind":"lyric","text":"  It's too much to mend","columns":25,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":23,"beat":4}]},{"id":"line-13","kind":"lyric","text":"You're the hug that had to end","columns":30,"beats":4,"changes":[{"symbol":"D","column":28,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Though I've tried to hold on","columns":28,"beats":8,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"G/B","column":16,"beat":2},{"symbol":"Am","column":20,"beat":4},{"symbol":"D","column":27,"beat":6}]},{"id":"line-15","kind":"lyric","text":"  And if you knew me at all","columns":28,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":26,"beat":4}]},{"id":"line-16","kind":"lyric","text":"You wouldn't try to keep me small","columns":33,"beats":4,"changes":[{"symbol":"D","column":31,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Who would do that to a friend","columns":29,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Let alone the one you love?","columns":27,"beats":4,"changes":[{"symbol":"Am","column":5,"beat":0}]},{"id":"line-19","kind":"instrumental","text":"[Interlude]","columns":22,"beats":6,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"G/B","column":15,"beat":2},{"symbol":"Am","column":20,"beat":4}]},{"id":"line-20","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-21","kind":"lyric","text":"  And any choice you had worth making","columns":37,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":31,"beat":2}]},{"id":"line-22","kind":"lyric","text":"I'd push you to take it","columns":23,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0}]},{"id":"line-23","kind":"lyric","text":"No questions asked, no doubt in mind","columns":38,"beats":8,"changes":[{"symbol":"C","column":14,"beat":0},{"symbol":"G/B","column":18,"beat":2},{"symbol":"Am","column":32,"beat":4},{"symbol":"D","column":37,"beat":6}]},{"id":"line-24","kind":"lyric","text":"But when they're mine, yeah","columns":27,"beats":4,"changes":[{"symbol":"G","column":19,"beat":0}]},{"id":"line-25","kind":"lyric","text":"You react like I'm crossing a line","columns":34,"beats":4,"changes":[{"symbol":"Em","column":30,"beat":0}]},{"id":"line-26","kind":"lyric","text":"I'm too much to handle, and \"Just dial it","columns":41,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Back a bit\"","columns":11,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"Well, well, I'm not having it, babe","columns":35,"beats":8,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"G/B","column":6,"beat":2},{"symbol":"Am","column":20,"beat":4},{"symbol":"D","column":31,"beat":6}]},{"id":"line-29","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-30","kind":"lyric","text":"  It's too much to mend","columns":25,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":23,"beat":2}]},{"id":"line-31","kind":"lyric","text":"You're the hug that had to end","columns":30,"beats":4,"changes":[{"symbol":"D","column":28,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Though I've tried to hold on","columns":28,"beats":8,"changes":[{"symbol":"C","column":10,