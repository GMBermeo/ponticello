ext":"    I'm in the business of misery","columns":33,"beats":4,"changes":[{"symbol":"F#5","column":0,"beat":0},{"symbol":"E5","column":28,"beat":1}]},{"id":"line-8","kind":"lyric","text":"Let's take it from the top","columns":27,"beats":4,"changes":[{"symbol":"F#5","column":24,"beat":0}]},{"id":"line-9","kind":"lyric","text":"She's got a body like an hourglass","columns":34,"beats":4,"changes":[{"symbol":"D5","column":26,"beat":0}]},{"id":"line-10","kind":"lyric","text":"It's tickin' like a clock","columns":25,"beats":4,"changes":[{"symbol":"F#5","column":22,"beat":0}]},{"id":"line-11","kind":"lyric","text":"It's a matter of time","columns":21,"beats":4,"changes":[{"symbol":"E5","column":18,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Before we all run out","columns":21,"beats":4,"changes":[{"symbol":"F#5","column":18,"beat":0}]},{"id":"line-13","kind":"lyric","text":"When I thought he was mine,","columns":27,"beats":4,"changes":[{"symbol":"A5","column":23,"beat":0}]},{"id":"line-14","kind":"lyric","text":"She caught him by the mouth","columns":27,"beats":4,"changes":[{"symbol":"G#5","column":16,"beat":0}]},{"id":"line-15","kind":"lyric","text":"(Riff 1)","columns":8,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"    P.M .  .  .  .  .  .","columns":24,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"    I waited eight long months","columns":30,"beats":4,"changes":[{"symbol":"F#5","column":0,"beat":0},{"symbol":"E5","column":25,"beat":2}]},{"id":"line-18","kind":"lyric","text":"She finally set him free","columns":25,"beats":4,"changes":[{"symbol":"F#5","column":22,"beat":0}]},{"id":"line-19","kind":"lyric","text":"I told him I couldn't lie","columns":25,"beats":4,"changes":[{"symbol":"D5","column":23,"beat":0}]},{"id":"line-20","kind":"lyric","text":"He was the only one for me","columns":28,"beats":4,"changes":[{"symbol":"F#5","column":25,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Two weeks and we'd caught on fire","columns":33,"beats":4,"changes":[{"symbol":"E5","column":20,"beat":0}]},{"id":"line-22","kind":"lyric","text":"She's got it out for me","columns":23,"beats":4,"changes":[{"symbol":"F#5","column":13,"beat":0}]},{"id":"line-23","kind":"lyric","text":"But I wear the biggest smile","columns":28,"beats":4,"changes":[{"symbol":"A5","column":16,"beat":0},{"symbol":"G#5","column":25,"beat":2}]},{"id":"line-24","kind":"instrumental","text":"(         )","columns":11,"beats":4,"changes":[{"symbol":"F#5","column":2,"beat":0},{"symbol":"E5","column":7,"beat":2}]},{"id":"line-25","kind":"lyric","text":"(Variação da base no final da Primeira Parte)","columns":45,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"    P.M . . . . . . . . . .","columns":27,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"Primeiro Refrão:","columns":16,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"   Whoa, well, I never meant to brag","columns":36,"beats":6,"changes":[{"symbol":"D5","column":0,"beat":0},{"symbol":"A5","column":15,"beat":2},{"symbol":"E5","column":34,"beat":4}]},{"id":"line-29","kind":"lyric","text":"But I got him where I want him now","columns":34,"beats":3,"changes":[{"symbol":"F#m","column":7,"beat":0},{"symbol":"F#5(9)","column":23,"beat":1},{"symbol":"D5","column":32,"beat":2}]},{"id":"line-30","kind":"lyric","text":"Whoa, it was never my intention to brag","columns":39,"beats":4,"changes":[{"symbol":"A5","column":14,"beat":0},{"symbol":"E5","column":37,"beat":2}]},{"id":"line-31","kind":"lyric","text":"To steal it all away from you now","columns":33,"beats":6,"changes":[{"symbol":"F#m","column":5,"beat":0},{"symbol":"F#5(9)","column":18,"beat":2},{"symbol":"D5","column":31,"beat":4}]},{"id":"line-32","kind":"lyric","text":"But, God, does it feel    so good","columns":33,"beats":4,"changes":[{"symbol":"A5","column":23,"beat":0},{"symbol":"E5","column":30,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Cause I got him where I want    him now