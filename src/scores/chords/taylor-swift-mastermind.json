":0,"beat":0},{"symbol":"E4","column":28,"beat":4}]},{"id":"line-7","kind":"lyric","text":"Of a chain reaction of countermoves","columns":35,"beats":4,"changes":[{"symbol":"E","column":30,"beat":0}]},{"id":"line-8","kind":"lyric","text":"To assess the equation of you","columns":29,"beats":4,"changes":[{"symbol":"E4","column":26,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Checkmate, I couldn't lose","columns":26,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"What if I told you none of it was accidental?","columns":45,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0},{"symbol":"A2","column":29,"beat":2}]},{"id":"line-11","kind":"lyric","text":"And the first night that you saw me","columns":35,"beats":4,"changes":[{"symbol":"B4","column":11,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Nothing was gonna stop me","columns":25,"beats":4,"changes":[{"symbol":"E","column":4,"beat":0},{"symbol":"B/D#","column":20,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I laid the groundwork and then, just like clockwork","columns":51,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0},{"symbol":"A2","column":26,"beat":2}]},{"id":"line-14","kind":"lyric","text":"The dominoes cascaded in a line","columns":31,"beats":4,"changes":[{"symbol":"B4","column":7,"beat":0}]},{"id":"line-15","kind":"lyric","text":"What if I told you I'm the mastermind?","columns":38,"beats":4,"changes":[{"symbol":"E","column":32,"beat":0}]},{"id":"line-16","kind":"lyric","text":"And now you're mine","columns":19,"beats":4,"changes":[{"symbol":"A2","column":5,"beat":0}]},{"id":"line-17","kind":"lyric","text":"It was all by design","columns":20,"beats":4,"changes":[{"symbol":"C#m7","column":11,"beat":0}]},{"id":"line-18","kind":"lyric","text":"'Cause I'm a mastermind","columns":23,"beats":4,"changes":[{"symbol":"B4","column":3,"beat":0},{"symbol":"A2","column":11,"beat":2}]},{"id":"line-19","kind":"lyric","text":"You see, all the wisest women had to do it this way","columns":51,"beats":8,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"E4","column":24,"beat":4}]},{"id":"line-20","kind":"lyric","text":"'Cause we were born to be the pawn in every lover's game","columns":56,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"E4","column":29,"beat":2}]},{"id":"line-21","kind":"lyric","text":"If you fail to plan, you plan to fail","columns":37,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0},{"symbol":"E4","column":30,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Strategy sets the scene for the tale","columns":36,"beats":4,"changes":[{"symbol":"E","column":33,"beat":0}]},{"id":"line-23","kind":"lyric","text":"I'm the wind in our free-flowing sails","columns":38,"beats":4,"changes":[{"symbol":"E4","column":36,"beat":0}]},{"id":"line-24","kind":"lyric","text":"And the liquor in our cocktails","columns":31,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"What if I told you none of it was accidental?","columns":45,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0},{"symbol":"A2","column":29,"beat":2}]},{"id":"line-26","kind":"lyric","text":"And the first night that you saw me","columns":35,"beats":4,"changes":[{"symbol":"B4","column":11,"beat":0}]},{"id":"line-27","kind":"lyric","text":"I knew I wanted your body?","columns":26,"beats":4,"changes":[{"symbol":"E","column":4,"beat":0},{"symbol":"B/D#","column":20,"beat":2}]},{"id":"line-28","kind":"lyric","text":"I laid the groundwork and then, just like clockwork","columns":51,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0},{"symbol":"A2","column":26,"beat":2}]},{"id":"line-29","kind":"lyric","text":"The dominoes cascaded in a line","columns":31,"beats":4,"changes":[{"symbol":"B4","column":7,"beat":0}]},{"id":"line-30","kind":"lyric","text":"What if I told you I'm the mastermind?","columns":38,"beats":4,"changes":[{"symbol":"E","column":32,"beat":0}]},{"id":"line-31","kind":"lyric","text":"And now you're mine","columns":19,"beats":4,"changes":[{"symbol":"A2","column":5,"beat":0}]},{"id":"line-32","kind":"lyric","text":"It was all my design","columns":20,"beats":4,"changes":[{"symbol":"C#m7","column":11,"beat":0}]},{"id":"line-33","kind":"lyric","text":"'Cause I'm a mastermind","columns":23,"beats":4,"changes":[{"symbol":"B4","column":3,"beat":0},{"symbol":"A2","column":11,"beat":2}]},{"id":"line-34","kind":"lyric","text":"No one wanted to play with me as a little kid","columns":45,"beats":4,"changes":[{"symbol":"E","column":0,"beat":0}]},{"id":"line-35","kind":"lyric","text":"So I've been scheming like a criminal ever since","columns":48,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"To make them love me and make it seem effortless","columns":48,"beats":4,"changes":[{"symbol":"A4","column":0,"beat":0}]},{"id":"line-37","kind":"lyric","text":"This is the first time I feel the need to confess","columns":49,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"And I swear, I'm only cryptic and Machiavellian","columns":47,"beats":4,"changes":[{"symbol":"G#m","column":5,"beat":0},{"symbol":"A2","column":11,"beat":2}]},{"id":"line-39","kind":"lyric","text":"'Cause I care","columns":17,"beats":4,"changes":[{"symbol":"C#m7","column":13,"beat":0}]},{"id":"line-40","kind":"lyric","text":"So I told you none of it was accidental","columns":39,"beats":4,"changes":[{"symbol":"A2","column":23,"beat":0}]},{"id":"line-41","kind":"lyric","text":"And the first night that you saw me","columns":35,"beats":2,"changes":[{"symbol":"B4","column":9,"beat":0}]},{"id":"line-42","kind":"lyric","text":"Nothing was gonna stop me","columns":25,"beats":4,"changes":[{"symbol":"E","column":4,"beat":0},{"symbol":"B/D#","column":19,"beat":2}]},{"id":"line-43","kind":"lyric","text":"I laid the groundwork and then, saw a wild smirk","columns":48,"beats":4,"changes":[{"symbol":"C#m7","column":0,"beat":0},{"symbol":"A2","column":28,"beat":2}]},{"id":"line-44","kind":"lyric","text":"On your face, you knew the entire time","columns":38,"beats":2,"changes":[{"symbol":"B4","column":9,"beat":0}]},{"id":"line-45","kind":"lyric","text":"You knew that I'm a mastermind","columns":30,"beats":4,"changes":[{"symbol":"E","column":26,"beat":0}]},{"id":"line-46","kind":"lyric","text":"And now you're mine","columns":19,"beats":4,"changes":[{"symbol":"A2","column":5,"beat":0}]},{"id":"line-47","kind":"lyric","text":"Yeah, all you did was smile","columns":27,"beats":4,"changes":[{"symbol":"C#m7","column":15,"beat":0}]},{"id":"line-48","kind":"lyric","text":"'Cause I'm a mastermind","columns":23,"beats":4,"changes":[{"symbol":"B4","column":3,"beat":0},{"symbol":"A2","column":13,"beat":2}]},{"id":"line-49","kind":"instrumental","text":"[Final]","columns":9,"beats":4,"changes":[{"symbol":"E","column":8,"beat":0}]}]}