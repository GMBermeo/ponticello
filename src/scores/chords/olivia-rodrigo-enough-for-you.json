{"version":1,"id":"olivia-rodrigo-enough-for-you","title":"Enough For You","artist":"Olivia Rodrigo","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/olivia-rodrigo/enough-for-you/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Olivia Isabel Rodrigo","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"  I wore makeup when we dated","columns":29,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":10,"beat":2},{"symbol":"C","column":26,"beat":4}]},{"id":"line-3","kind":"lyric","text":"'Cause I thought you'd like me more","columns":35,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-4","kind":"lyric","text":"If I looked like the other prom queens","columns":38,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0},{"symbol":"C","column":28,"beat":2}]},{"id":"line-5","kind":"lyric","text":"I know that you loved before","columns":28,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Tried so hard to be everything that you liked","columns":45,"beats":8,"changes":[{"symbol":"Em","column":10,"beat":0},{"symbol":"C","column":26,"beat":2},{"symbol":"C","column":44,"beat":5}]},{"id":"line-7","kind":"lyric","text":"Just for you to say you're not","columns":30,"beats":4,"changes":[{"symbol":"G","column":6,"beat":0},{"symbol":"Em","column":16,"beat":2}]},{"id":"line-8","kind":"lyric","text":"The compliment type","columns":19,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"C","column":18,"beat":2}]},{"id":"line-9","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"  And I knew how you took your coffee","columns":37,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":13,"beat":2},{"symbol":"C","column":32,"beat":4}]},{"id":"line-11","kind":"lyric","text":"And your favorite songs by heart","columns":32,"beats":4,"changes":[{"symbol":"C","column":14,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-12","kind":"lyric","text":"I read all of your self-help books","columns":34,"beats":4,"changes":[{"symbol":"Em","column":7,"beat":0},{"symbol":"C","column":25,"beat":2}]},{"id":"line-13","kind":"lyric","text":"So you'd think that I was smart","columns":31,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"G","column":28,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Stupid, emotional, obsessive little me","columns":38,"beats":6,"changes":[{"symbol":"Em","column":10,"beat":0},{"symbol":"C","column":22,"beat":2},{"symbol":"C","column":36,"beat":4}]},{"id":"line-15","kind":"lyric","text":"  I knew from the start","columns":23,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":19,"beat":4}]},{"id":"line-16","kind":"lyric","text":"This is exactly how you'd leave","columns":31,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0}]},{"id":"line-17","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"You found someone more exciting","columns":31,"beats":4,"changes":[{"symbol":"G","column":14,"beat":0},{"symbol":"Em","column":25,"beat":2}]},{"id":"line-19","kind":"lyric","text":"The next second you were gone","columns":29,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-20","kind":"lyric","text":"  And you left me there crying","columns":30,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":25,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Wondering what I did wrong","columns":26,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"G","column":23,"beat":2}]},{"id":"line-22","kind":"lyric","text":"And you always say I'm never satisfied","columns":38,"beats":4,"changes":[{"symbol":"G","column":16,"beat":0},{"symbol":"Em","column":32,"beat":2}]},{"id":"line-23","kind":"lyric","text":"But I don't think that's true","columns":29,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-24","kind":"lyric","text":"'Cause all I ever wanted was","columns":28,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em","column":16,"beat":2}]},{"id":"line-25","kind":"lyric","text":"To be enough for you","columns":20,"beats":4,"changes":[{"symbol":"C","column":3,"beat":0},{"symbol":"G","column":18,"beat":2}]},{"id":"line-26","kind":"lyric","text":"Yeah, all I ever wanted was","columns":27,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"Em","column":19,"beat":2}]},{"id":"line-27","kind":"lyric","text":"To be enough for you","columns":20,"beats":4,"changes":[{"symbol":"C","column":3,"beat":0},{"symbol":"G","column":18,"beat":2}]},{"id":"line-28","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-29","kind":"lyric","text":"  And maybe I'm just not as interesting","columns":39,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":12,"beat":2},{"symbol":"C","column":30,"beat":4}]},{"id":"line-30","kind":"lyric","text":"As the girls you had before","columns":27,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0},{"symbol":"G","column":24,"beat":2}]},{"id":"line-31","kind":"lyric","text":"But God you couldn't have cared less about","columns":42,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0},{"symbol":"C","column":33,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Someone who loved you more","columns":26,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"G","column":24,"beat":2}]},{"id":"line-33","kind":"lyric","text":"I'd say you broke my heart","columns":26,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0}]},{"id":"line-34","kind":"lyric","text":"But you broke much more than that","columns":33,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"C","column":28,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Now, I don't want your sympathy","columns":31,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em","column":25,"beat":2}]},{"id":"line-36","kind":"lyric","text":"I just want myself back","columns":23,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-37","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-38","kind":"lyric","text":"Before you found someone more exciting","columns":38,"beats":4,"changes":[{"symbol":"G","column":19,"beat":0},{"symbol":"Em","column":32,"beat":2}]},{"id":"line-39","kind":"lyric","text":"The next second you were gone","columns":29,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-40","kind":"lyric","text":" And you left me there crying","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Em","column":24,"beat":2}]},{"id":"line-41","kind":"lyric","text":"Wondering what I did wrong","columns":26,"beats":4,"changes":[{"symbol":"C","column":2,"beat":0},{"symbol":"G","column":22,"beat":2}]},{"id":"line-42","kind":"lyric","text":"And you always say I'm never satisfied","columns":38,"beats":4,"changes":[{"symbol":"G","column":16,"beat":0},{"symbol":"Em","column":32,"beat":2}]},{"id":"line-43","kind":"lyric","text":"But I don't think that's true","columns":29,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-44","kind":"lyric","text":"'Cause all I ever wanted was to be enough","columns":41,"beats":6,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em","column":16,"beat":2},{"symbol":"C","column":29,"beat":4}]},{"id":"line-45","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-46","kind":"lyric","text":"And don't you think I loved you too much","columns":40,"beats":4,"changes":[{"symbol":"G","column":11,"beat":0},{"symbol":"Em","column":28,"beat":2}]},{"id":"line-47","kind":"lyric","text":"To be used and discarded","columns":24,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"G","column":18,"beat":2}]},{"id":"line-48","kind":"lyric","text":"Don't you think I loved you too much","columns":36,"beats":4,"changes":[{"symbol":"G","column":11,"beat":0},{"symbol":"Em","column":28,"beat":2}]},{"id":"line-49","kind":"lyric","text":"To think I deserve nothing","columns":26,"beats":4,"changes":[{"symbol":"C","column":9,"beat":0},{"symbol":"G","column":21,"beat":2}]},{"id":"line-50","kind":"lyric","text":"But don't tell me you're sorry, boy","columns":35,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em","column":26,"beat":2}]},{"id":"line-51","kind":"lyric","text":"Feel sorry for yourself","columns":23,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"G","column":18,"beat":2}]},{"id":"line-52","kind":"lyric","text":"'Cause someday, I'll be everything","columns":34,"beats":4,"changes":[{"symbol":"G","column":6,"beat":0},{"symbol":"Em","column":22,"beat":2}]},{"id":"line-53","kind":"lyric","text":"To somebody else","columns":16,"beats":2,"changes":[{"symbol":"C","column":6,"beat":0}]},{"id":"line-54","kind":"section","text":"[Terceira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-55","kind":"lyric","text":"And they'll think that I am so exciting","columns":39,"beats":4,"changes":[{"symbol":"G","column":23,"beat":0},{"symbol":"Em","column":32,"beat":2}]},{"id":"line-56","kind":"lyric","text":" And you'll be the one who's crying","columns":35,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":12,"beat":2},{"symbol":"Em","column":30,"beat":4}]},{"id":"line-57","kind":"lyric","text":" Yeah, you always say I'm never satisfied","columns":41,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":19,"beat":2},{"symbol":"Em","column":34,"beat":4}]},{"id":"line-58","kind":"lyric","text":"But I don't think that's true","columns":29,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-59","kind":"lyric","text":"You say I'm never satisfied","columns":27,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em","column":20,"beat":2}]},{"id":"line-60","kind":"lyric","text":"But that's not me, it's you","columns":27,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-61","kind":"lyric","text":"'Cause all I ever wanted was to be enough","columns":41,"beats":6,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em","column":17,"beat":2},{"symbol":"C","column":29,"beat":4}]},{"id":"line-62","kind":"lyric","text":"But I don't think anything","columns":26,"beats":4,"changes":[{"symbol":"G","column":4,"beat":0},{"symbol":"Em","column":20,"beat":2}]},{"id":"line-63","kind":"lyric","text":"Could ever be enough","columns":20,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0}]},{"id":"line-64","kind":"lyric","text":"For you","columns":7,"beats":1.5,"changes":[{"symbol":"G","column":4,"beat":0}]},{"id":"line-65","kind":"instrumental","text":"(     )","columns":7,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0},{"symbol":"C","column":5,"beat":2}]},{"id":"line-66","kind":"lyric","text":"Enough for you","columns":14,"beats":4,"changes":[{"symbol":"G","column":12,"beat":0}]},{"id":"line-67","kind":"instrumental","text":"(     )","columns":7,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0},{"symbol":"C","column":5,"beat":2}]},{"id":"line-68","kind":"lyric","text":"No, nothing's enough for you","columns":28,"beats":4,"changes":[{"symbol":"G","column":26,"beat":0}]}]}