{"version":1,"id":"morgan-wallen-i-m-the-problem","title":"I'm The Problem","artist":"Morgan Wallen","key":"Em","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/morgan-wallen/i-m-the-problem/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Sno, Charlie Handsome, Morgan C Wallen, Jamie Mclaughlin and Grady Block","chords":[{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"D#/G","canonical":"D#/G","keyboardPitchClasses":[7,10,3],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"C#7M","canonical":"C#maj7","keyboardPitchClasses":[1,5,8,0],"interpretation":"Keyboard interpretation: C#maj7"},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"A#m","canonical":"A#m","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":26,"beats":8,"changes":[{"symbol":"Fm","column":8,"beat":0},{"symbol":"D#/G","column":12,"beat":2},{"symbol":"G#","column":18,"beat":4},{"symbol":"C#7M","column":22,"beat":6}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"You say I'll never change","columns":25,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0}]},{"id":"line-4","kind":"lyric","text":"A-just to go around town with some gasoline","columns":43,"beats":2,"changes":[{"symbol":"G#","column":35,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Just tryin' to bum a flame","columns":26,"beats":4,"changes":[{"symbol":"C#","column":5,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Gonna burn the whole place down","columns":31,"beats":4,"changes":[{"symbol":"C#","column":0,"beat":0}]},{"id":"line-7","kind":"lyric","text":"And how do you explain","columns":22,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Ever fallin' in love with a guy like me in the first place","columns":58,"beats":4,"changes":[{"symbol":"G#","column":28,"beat":0},{"symbol":"C#7M","column":48,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Then turn around, say that I'm the worst thing?","columns":47,"beats":4,"changes":[{"symbol":"C#7M","column":0,"beat":0}]},{"id":"line-10","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-11","kind":"lyric","text":"I guess I'm the problem","columns":23,"beats":4,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-12","kind":"lyric","text":"And you're Ms. \"Never Do No Wrong\"","columns":34,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-13","kind":"lyric","text":"If I'm so awful","columns":15,"beats":4,"changes":[{"symbol":"C#7M","column":10,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Then why'd you stick around this long?","columns":38,"beats":4,"changes":[{"symbol":"C#7M","column":0,"beat":0}]},{"id":"line-15","kind":"lyric","text":"And if it's the whiskey","columns":23,"beats":4,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Then why you keep on pullin' it off the shelf?","columns":46,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"You hate that when you look at me, you halfway see yourself","columns":59,"beats":4,"changes":[{"symbol":"C#7M","column":4,"beat":0}]},{"id":"line-18","kind":"lyric","text":"And it got me thinkin'","columns":22,"beats":4,"changes":[{"symbol":"A#m","column":14,"beat":0}]},{"id":"line-19","kind":"lyric","text":"If I'm the problem, well, you might be the reason","columns":64,"beats":14,"changes":[{"symbol":"C#7M","column":11,"beat":0},{"symbol":"D#","column":27,"beat":2},{"symbol":"Fm","column":45,"beat":4},{"symbol":"D#","column":52,"beat":6},{"symbol":"G#","column":56,"beat":7},{"symbol":"C#7M","column":60,"beat":9}]},{"id":"line-20","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-21","kind":"lyric","text":"We try to go our sеparate ways","columns":30,"beats":4,"changes":[{"symbol":"Fm","column":10,"beat":0}]},{"id":"line-22","kind":"lyric","text":"And we're back and forth likе a swingin' door","columns":45,"beats":4,"changes":[{"symbol":"G#","column":32,"beat":0}]},{"id":"line-23","kind":"lyric","text":"And tomorrow's like yesterday","columns":29,"beats":4,"changes":[{"symbol":"C#7M","column":4,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Some days better than the night before","columns":38,"beats":4,"changes":[{"symbol":"C#7M","column":0,"beat":0}]},{"id":"line-25","kind":"lyric","text":"And you're back to me again","columns":27,"beats":4,"changes":[{"symbol":"A#m","column":10,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Then you go and tell your friends","columns":33,"beats":4,"changes":[{"symbol":"C#7M","column":9,"beat":0},{"symbol":"D#","column":27,"beat":2}]},{"id":"line-27","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-28","kind":"lyric","text":"That I'm the problem","columns":20,"beats":4,"changes":[{"symbol":"Fm","column":13,"beat":0}]},{"id":"line-29","kind":"lyric","text":"And you're Ms. \"Never Do No Wrong\"","columns":34,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"If I'm so awful","columns":15,"beats":6,"changes":[{"symbol":"C#7M","column":10,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Then why'd you stick around this long?","columns":38,"beats":6,"changes":[{"symbol":"C#7M","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"And if it's the whiskey","columns":23,"beats":4,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Then why you keep on pullin' it off the shelf?","columns":46,"beats":6,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-34","kind":"lyric","text":"You hate that when you look at me, you halfway see yourself","columns":59,"beats":4,"changes":[{"symbol":"C#7M","column":4,"beat":0}]},{"id":"line-35","kind":"lyric","text":"And it got me thinkin'","columns":22,"beats":4,"changes":[{"symbol":"A#m","column":14,"beat":0}]},{"id":"line-36","kind":"lyric","text":"If I'm the problem, well, you might be the reason","columns":64,"beats":10,"changes":[{"symbol":"C#7M","column":11,"beat":0},{"symbol":"D#","column":27,"beat":1},{"symbol":"Fm","column":45,"beat":2},{"symbol":"D#","column":52,"beat":3},{"symbol":"G#","column":56,"beat":4},{"symbol":"C#7M","column":60,"beat":5}]},{"id":"line-37","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-38","kind":"lyric","text":"If I'm such a waste of breath, such a waste of time","columns":52,"beats":4,"changes":[{"symbol":"A#m","column":0,"beat":0},{"symbol":"C#7M","column":48,"beat":2}]},{"id":"line-39","kind":"lyric","text":"Then why you on your way to waste another Friday night?","columns":60,"beats":6,"changes":[{"symbol":"A#m","column":5,"beat":0},{"symbol":"C#7M","column":50,"beat":2},{"symbol":"D#","column":58,"beat":4}]},{"id":"line-40","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-41","kind":"lyric","text":"If I'm the problem","columns":18,"beats":2,"changes":[{"symbol":"Fm","column":11,"beat":0}]},{"id":"line-42","kind":"lyric","text":"And you're Ms. \"Never Do No Wrong\"","columns":34,"beats":4,"changes":[{"symbol":"Fm","column":0,"beat":0}]},{"id":"line-43","kind":"lyric","text":"If I'm so awful","columns":15,"beats":6,"changes":[{"symbol":"C#7M","column":10,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Then why'd you stick around this long?","columns":38,"beats":4,"changes":[{"symbol":"C#7M","column":0,"beat":0}]},{"id":"line-45","kind":"lyric","text":"And if it