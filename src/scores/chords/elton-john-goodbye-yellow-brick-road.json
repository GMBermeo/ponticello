column":25,"beat":1},{"symbol":"Bb","column":43,"beat":2},{"symbol":"C#","column":68,"beat":3}]},{"id":"line-21","kind":"lyric","text":"Oh I've finally decided my future lies","columns":42,"beats":10,"changes":[{"symbol":"Eb","column":3,"beat":0},{"symbol":"F","column":8,"beat":2},{"symbol":"C/E","column":18,"beat":4},{"symbol":"Dm","column":27,"beat":6},{"symbol":"F/C","column":39,"beat":8}]},{"id":"line-22","kind":"lyric","text":"Beyond the yellow brick ro...ad,  a.....h, a.....h","columns":54,"beats":13,"changes":[{"symbol":"Bb","column":3,"beat":0},{"symbol":"C","column":12,"beat":1},{"symbol":"Bbm","column":24,"beat":2},{"symbol":"Eb","column":29,"beat":3},{"symbol":"Ab","column":34,"beat":4},{"symbol":"C#","column":40,"beat":5},{"symbol":"Bbm","column":44,"beat":6},{"symbol":"C","column":50,"beat":7},{"symbol":"F","column":53,"beat":8}]}]}