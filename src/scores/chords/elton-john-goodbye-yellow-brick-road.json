{"version":1,"id":"elton-john-goodbye-yellow-brick-road","title":"Goodbye yellow brick road","artist":"Elton John","key":"F","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/elton-john/goodbye-yellow-brick-road/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ann Orson and Bernie Taupin","chords":[{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"C/E","canonical":"C/E","keyboardPitchClasses":[4,7,0],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"Dm/C","canonical":"Dm/C","keyboardPitchClasses":[],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"C4","canonical":"Csus4","keyboardPitchClasses":[0,5,7],"interpretation":"Keyboard interpretation: Csus4"},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"Gm/Bb","canonical":"Gm/Bb","keyboardPitchClasses":[10,2,7],"interpretation":null},{"symbol":"F/A","canonical":"F/A","keyboardPitchClasses":[9,0,5],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"Bbm","canonical":"Bbm","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"Ab","canonical":"Ab","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"A7","canonical":"A7","keyboardPitchClasses":[9,1,4,7],"interpretation":null},{"symbol":"D7","canonical":"D7","keyboardPitchClasses":[2,6,9,0],"interpretation":null},{"symbol":"F/C","canonical":"F/C","keyboardPitchClasses":[0,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":24,"beats":8,"changes":[{"symbol":"F","column":8,"beat":0},{"symbol":"C/E","column":11,"beat":2},{"symbol":"Dm","column":16,"beat":4},{"symbol":"Dm/C","column":20,"beat":6}]},{"id":"line-2","kind":"instrumental","text":"","columns":20,"beats":8,"changes":[{"symbol":"Bb","column":8,"beat":0},{"symbol":"C4","column":12,"beat":2},{"symbol":"C","column":16,"beat":4},{"symbol":"F","column":19,"beat":6}]},{"id":"line-3","kind":"lyric","text":"When are you gonna come down, when are you going to land","columns":56,"beats":10,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Gm/Bb","column":19,"beat":1},{"symbol":"C","column":26,"beat":2},{"symbol":"F","column":33,"beat":4},{"symbol":"F/A","column":43,"beat":6},{"symbol":"Bb","column":53,"beat":8}]},{"id":"line-4","kind":"lyric","text":"I should have stayed on the farm ,should have  listened to my old man","columns":69,"beats":6,"changes":[{"symbol":"Eb","column":4,"beat":0},{"symbol":"C","column":30,"beat":2},{"symbol":"F","column":49,"beat":4}]},{"id":"line-5","kind":"lyric","text":"You know you can't hold me forever, I didn't sign up with you","columns":61,"beats":12,"changes":[{"symbol":"Gm","column":6,"beat":0},{"symbol":"Gm/Bb","column":20,"beat":2},{"symbol":"C","column":30,"beat":4},{"symbol":"F","column":39,"beat":6},{"symbol":"F/A","column":45,"beat":8},{"symbol":"Bb","column":58,"beat":10}]},{"id":"line-6","kind":"lyric","text":"I'm not a present for your friends to open","columns":42,"beats":4,"changes":[{"symbol":"Eb","column":5,"beat":0},{"symbol":"C","column":30,"beat":2}]},{"id":"line-7","kind":"lyric","text":"This boy's too young to be singing the blu..es, a.....h,  a.....h","columns":69,"beats":14,"changes":[{"symbol":"F","column":6,"beat":0},{"symbol":"Bbm","column":40,"beat":2},{"symbol":"Eb","column":45,"beat":4},{"symbol":"Ab","column":51,"beat":6},{"symbol":"C#","column":55,"beat":8},{"symbol":"Bbm","column":59,"beat":10},{"symbol":"C","column":68,"beat":12}]},{"id":"line-8","kind":"lyric","text":"So goodbye yellow brick road where the dogs of society howl","columns":59,"beats":4,"changes":[{"symbol":"F","column":4,"beat":0},{"symbol":"A7","column":25,"beat":1},{"symbol":"Bb","column":39,"beat":2},{"symbol":"F","column":56,"beat":3}]},{"id":"line-9","kind":"lyric","text":"You can't plant me in your penthouse, I'm going back to my plough","columns":69,"beats":5,"changes":[{"symbol":"D7","column":5,"beat":0},{"symbol":"Gm","column":28,"beat":1},{"symbol":"C","column":44,"beat":2},{"symbol":"F","column":62,"beat":3},{"symbol":"C/E","column":66,"beat":4}]},{"id":"line-10","kind":"lyric","text":"Back to the howling old owl in the woods, hunting the horny black toad","columns":70,"beats":4,"changes":[{"symbol":"Dm","column":1,"beat":0},{"symbol":"A7","column":25,"beat":1},{"symbol":"Bb","column":43,"beat":2},{"symbol":"C#","column":68,"beat":3}]},{"id":"line-11","kind":"lyric","text":"Oh I've finally decided my future lies","columns":42,"beats":10,"changes":[{"symbol":"Eb","column":3,"beat":0},{"symbol":"F","column":8,"beat":2},{"symbol":"C/E","column":18,"beat":4},{"symbol":"Dm","column":27,"beat":6},{"symbol":"F/C","column":39,"beat":8}]},{"id":"line-12","kind":"lyric","text":"Beyond the yellow brick ro...ad,  a.....h, a.....h","columns":54,"beats":13,"changes":[{"symbol":"Bb","column":3,"beat":0},{"symbol":"C","column":12,"beat":1},{"symbol":"Bbm","column":24,"beat":2},{"symbol":"Eb","column":29,"beat":3},{"symbol":"Ab","column":34,"beat":4},{"symbol":"C#","column":40,"beat":5},{"symbol":"Bbm","column":44,"beat":6},{"symbol":"C","column":50,"beat":7},{"symbol":"F","column":53,"beat":8}]},{"id":"line-13","kind":"lyric","text":"What do you think you'l do then? I bet that`ll shoot down your plane","columns":68,"beats":16,"changes":[{"symbol":"Gm","column":3,"beat":0},{"symbol":"Gm/Bb","column":15,"beat":2},{"symbol":"C","column":31,"beat":4},{"symbol":"F","column":38,"beat":6},{"symbol":"F/A","column":50,"beat":8},{"symbol":"Bb","column":62,"beat":10}]},{"id":"l