":"line-16","kind":"lyric","text":"To be loved, to be loved and nothing more","columns":41,"beats":4,"changes":[{"symbol":"Bbm","column":0,"beat":0},{"symbol":"Eb","column":30,"beat":2}]},{"id":"line-17","kind":"lyric","text":"And you kept your word, do you want a medal?","columns":44,"beats":4,"changes":[{"symbol":"Ab","column":0,"beat":0},{"symbol":"Fm","column":25,"beat":2}]},{"id":"line-18","kind":"lyric","text":"The way that someone leaves this world","columns":38,"beats":6,"changes":[{"symbol":"Ab","column":0,"beat":0},{"symbol":"Cm","column":25,"beat":2},{"symbol":"Fm","column":33,"beat":4}]},{"id":"line-19","kind":"lyric","text":"Is all just levels to me now, oh, to me now","columns":43,"beats":4,"changes":[{"symbol":"Bbm","column":19,"beat":0},{"symbol":"Eb","column":39,"beat":2}]},{"id":"line-20","kind":"lyric","text":"I'll take my pride, stand here for you","columns":38,"beats":4,"changes":[{"symbol":"Db","column":18,"beat":0},{"symbol":"Cm","column":34,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Know I'm not blind, just seeing it through","columns":42,"beats":4,"changes":[{"symbol":"Fm","column":13,"beat":0},{"symbol":"Eb","column":35,"beat":2}]},{"id":"line-22","kind":"lyric","text":"You'd take my life just for the thrill","columns":38,"beats":4,"changes":[{"symbol":"Db","column":15,"beat":0},{"symbol":"Cm","column":34,"beat":2}]},{"id":"line-23","kind":"lyric","text":"I'll take tonight and die on this hill","columns":38,"beats":4,"changes":[{"symbol":"Fm","column":12,"beat":0},{"symbol":"Bb7","column":35,"beat":2}]},{"id":"line-24","kind":"lyric","text":"I always will","columns":13,"beats":4,"changes":[{"symbol":"Dbm","column":3,"beat":0},{"symbol":"Fm","column":9,"beat":2}]},{"id":"line-25","kind":"lyric","text":"I'll be here the whole night","columns":28,"beats":4,"changes":[{"symbol":"C/E","column":18,"beat":0}]},{"id":"line-26","kind":"lyric","text":"I'll be here 'cause I can","columns":25,"beats":4,"changes":[{"symbol":"Eb","column":23,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Yeah, I know you don't care","columns":27,"beats":4,"changes":[{"symbol":"Bb/D","column":18,"beat":0}]},{"id":"line-28","kind":"lyric","text":"I know nothing could matter","columns":27,"beats":4,"changes":[{"symbol":"Bbm","column":9,"beat":0}]},{"id":"line-29","kind":"lyric","text":"God, I wish something mattered to you","columns":37,"beats":4,"changes":[{"symbol":"Cm","column":14,"beat":0},{"symbol":"Eb","column":34,"beat":2}]},{"id":"line-30","kind":"lyric","text":"I'll take my pride, stand here for you","columns":38,"beats":4,"changes":[{"symbol":"Db","column":15,"beat":0},{"symbol":"Cm","column":35,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Know I'm not blind, just seeing it through","columns":42,"beats":4,"changes":[{"symbol":"Fm","column":15,"beat":0},{"symbol":"Eb","column":37,"beat":2}]},{"id":"line-32","kind":"lyric","text":"You'd take my life just for the thrill","columns":38,"beats":4,"changes":[{"symbol":"Db","column":15,"beat":0},{"symbol":"Cm","column":34,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Well, I'll take tonight and die on this hill","columns":44,"beats":4,"changes":[{"symbol":"Fm","column":18,"beat":0},{"symbol":"Bb7","column":41,"beat":2}]},{"id":"line-34","kind":"lyric","text":"I always, always, I always will","columns":31,"beats":4,"changes":[{"symbol":"Dbm","column":0,"beat":0},{"symbol":"Ab","column":27,"beat":2}]}]}