{"version":1,"id":"sabrina-carpenter-goodbye","title":"Goodbye","artist":"Sabrina Carpenter","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/sabrina-carpenter/goodbye/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Jack Antonoff, Sabrina Carpenter and Amy Allen","chords":[{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"C#m","canonical":"C#m","keyboardPitchClasses":[1,4,8],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Broke my heart on Saturday","columns":26,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Guess overnight your feelings changed","columns":37,"beats":4,"changes":[{"symbol":"D","column":6,"beat":0}]},{"id":"line-3","kind":"lyric","text":"And I have cried so much, I almost fainted (aha, aha)","columns":53,"beats":4,"changes":[{"symbol":"C#m","column":4,"beat":0},{"symbol":"E","column":36,"beat":2}]},{"id":"line-4","kind":"lyric","text":"To show you just how much it hurts","columns":34,"beats":4,"changes":[{"symbol":"F#m","column":3,"beat":0}]},{"id":"line-5","kind":"lyric","text":"I wish I had a gun or words","columns":27,"beats":4,"changes":[{"symbol":"D","column":2,"beat":0}]},{"id":"line-6","kind":"lyric","text":"If somethin' got lost in communication (aha, aha)","columns":49,"beats":3,"changes":[{"symbol":"C#m","column":3,"beat":0},{"symbol":"E","column":23,"beat":1},{"symbol":"F#m","column":33,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Well, sayonara, adiós","columns":21,"beats":4,"changes":[{"symbol":"E","column":5,"beat":0}]},{"id":"line-8","kin