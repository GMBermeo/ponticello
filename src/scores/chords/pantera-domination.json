ns":12,"beats":4,"changes":[]},{"id":"line-26","kind":"section","text":"INTRO:","columns":6,"beats":0,"changes":[]},{"id":"line-27","kind":"lyric","text":"riff 1(a) *2","columns":12,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"riff 1(b) *2","columns":12,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"riff 1(c) *2","columns":12,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"riff 1(b) *2","columns":12,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"riff 2(a) *1","columns":12,"beats":4,"changes":[]},{"id":"line-32","kind":"section","text":"VERSE 1:","columns":8,"beats":0,"changes":[]},{"id":"line-33","kind":"lyric","text":"riff 3(a) *1.5","columns":14,"beats":4,"changes":[]},{"id":"line-34","kind":"lyric","text":"riff 4 *1","columns":9,"beats":4,"changes":[]},{"id":"line-35","kind":"lyric","text":"riff 3(a) *3.5","columns":14,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"Agony is the price that you pay in the end","columns":42,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"Domination consumes you then calls you a friend.","columns":48,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"riff 4 * 1","columns":10,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"It's a twisted fall.","columns":20,"beats":4,"changes":[]},{"id":"line-40","kind":"lyric","text":"riff 3(a) *1.5","columns":14,"beats":4,"changes":[]},{"id":"line-41","kind":"lyric","text":"Binds are like steel and manipulates the will to be.","columns":52,"beats":4,"changes":[]},{"id":"line-42","kind":"lyric","text":"riff 3(b) *1","columns":12,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"An eternity.","columns":12,"beats":4,"changes":[]},{"id":"line-44","kind":"lyric","text":"riff 3(a) *1.5","columns":14,"beats":4,"changes":[]},{"id":"line-45","kind":"lyric","text":"How soon we forget when there's nothing else left to destroy","columns":60,"beats":4,"changes":[]},{"id":"line-46","kind":"lyric","text":"It's a useless ploy.","columns":20,"beats":4,"changes":[]},{"id":"line-47","kind":"lyric","text":"riff 4 *1","columns":9,"beats":4,"changes":[]},{"id":"line-48","kind":"lyric","text":"PRE - CHORUS:","columns":13,"beats":4,"changes":[]},{"id":"line-49","kind":"lyric","text":"riff 5(a) *1","columns":12,"beats":4,"changes":[]},{"id":"line-50","kind":"lyric","text":"Your eyes will see the dawn of the day","columns":38,"beats":4,"changes":[]},{"id":"line-51","kind":"lyric","text":"And the writing on the wall.","columns":28,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"riff 4 *1","columns":9,"beats":4,"changes":[]},{"id":"line-53","kind":"lyric","text":"riff 5(b) *1","columns":12,"beats":4,"changes":[]},{"id":"line-54","kind":"lyric","text":"Those words that stare into your soul","columns":37,"beats":4,"changes":[]},{"id":"line-55","kind":"lyric","text":"and to yourself you will befall.","columns":32,"beats":4,"changes":[]},{"id":"line-56","kind":"lyric","text":"riff 2(b) *1","columns":12,"beats":4,"changes":[]},{"id":"line-57","kind":"section","text":"CHORUS:","columns":7,"beats":0,"changes":[]},{"id":"line-58","kind":"lyric","text":"riff 1(a) *2","columns":12,"beats":4,"changes":[]},{"id":"line-59","kind":"lyric","text":"It's domination. Pushed into","columns":28,"beats":4,"changes":[]},{"id":"line-60","kind":"lyric","text":"riff 1(c) *2","columns":12,"beats":4,"changes":[]},{"id":"line-61","kind":"lyric","text":"Living hell. Domination.","columns":24,"beats":4,"changes":[]},{"id":"line-62","kind":"lyric","text":"riff 2 (c) *1","columns":13,"beats":4,"changes":[]},{"id":"line-63","kind":"lyric","text":"Lyrics for verse 2:","columns":19,"beats":4,"changes":[]},{"id":"line-64","kind":"lyric","text":"A now blacked heart is reaching out in divinity.","columns":48,"beats":4,"changes":[]},{"id":"line-65","kind":"lyric","text":"Body suspended by chains over razors and nails, it's a penalty.","columns":63,"beats":4,"changes":[]},{"id":"line-66","kind":"lyric","text":"Each razor a vice and each nail marks demise of your life.","columns":58,"beats":4,"changes":[]},{"id":"line-67","kind":"lyric","text":"Grim construction grows.","columns":24,"beats":4,"changes":[]},{"id":"line-68","kind":"lyric","text":"Life plays its tricks seals you in brick by brick till your end","columns":63,"beats":4,"changes":[]},{"id":"line-69","kind":"lyric","text":"forcing you to bend.","columns":20,"beats":4,"changes":[]},{"id":"line-70","kind":"lyric","text":"Bend up A5 chord at end of riff 2(c).","columns":37,"beats":4,"changes":[]},{"id":"line-71","kind":"lyric","text":"riff 6 *4","columns":9,"beats":4,"changes":[]},{"id":"line-72","kind":"lyric","text":"riff 7 *1 (whilst bass plays riff 6)","columns":36,"beats":4,"changes":[]},{"id":"line-73","kind":"lyric","text":"SOLO starts in 12th posn., whilst bass plays variations on verse & pre-chorus","columns":77,"beats":4,"changes":[]},{"id":"line-74","kind":"lyric","text":"riffs, followed by rhythm going from E - F - G - A.","columns":51,"beats":4,"changes":[]},{"id":"line-75","kind":"lyric","text":"riff 8 *4","columns":9,"beats":4,"changes":[]},{"id":"line-76","kind":"lyric","text":"SOLO (tapping) whilst bass  plays riff 8 *4","columns":43,"beats":4,"changes":[]},{"id":"line-77","kind":"lyric","text":"riff 9(a) *1","columns":12,"beats":4,"changes":[]},{"id":"line-78","kind":"lyric","text":"riff 9(b) *1","columns":12,"beats":4,"changes":[]},{"id":"line-79","kind":"lyric","text":"riff 9(a) *1","columns":12,"beats":4,"changes":[]},{"id":"line-80","kind":"lyric","text":"riff 9(b) *1","columns":12,"beats":4,"changes":[]},{"id":"line-81","kind":"lyric","text":"END.","columns":4,"beats":4,"changes":[]},{"id":"line-82","kind":"lyric","text":"Matt Garrad 1995","columns":16,"beats":4,"changes":[]},{"id":"line-83","kind":"lyric","text":"* Is there no standard anymore? * [ 'Walk' ]","columns":44,"beats":4,"changes":[]},{"id":"line-84","kind":"lyric","text":"From pgonzalez@monmouth.com