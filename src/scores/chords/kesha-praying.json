{"version":1,"id":"kesha-praying","title":"Praying","artist":"Kesha","key":"Bb","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/kesha/praying/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Kesha, Ryan Lewis, Andrew Joslyn and Ben Abraham","chords":[{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":17,"beats":6,"changes":[{"symbol":"Gm","column":8,"beat":0},{"symbol":"F","column":12,"beat":2},{"symbol":"Bb","column":15,"beat":4}]},{"id":"line-2","kind":"instrumental","text":"","columns":17,"beats":6,"changes":[{"symbol":"Gm","column":8,"beat":0},{"symbol":"F","column":12,"beat":2},{"symbol":"Bb","column":15,"beat":4}]},{"id":"line-3","kind":"lyric","text":"  Well, you almost had me fooled","columns":32,"beats":12,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":12,"beat":4},{"symbol":"Bb","column":27,"beat":8}]},{"id":"line-4","kind":"lyric","text":"  Told me that I was nothing without you","columns":40,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":12,"beat":2},{"symbol":"Bb","column":21,"beat":5}]},{"id":"line-5","kind":"lyric","text":"Oh, but after everything you've done","columns":36,"beats":6,"changes":[{"symbol":"Gm","column":2,"beat":0},{"symbol":"F","column":14,"beat":2},{"symbol":"Bb","column":31,"beat":4}]},{"id":"line-6","kind":"lyric","text":"  I can thank you for how strong I have become","columns":46,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":10,"beat":2},{"symbol":"Bb","column":28,"beat":5}]},{"id":"line-7","kind":"lyric","text":"'Cause you brought the flames","columns":29,"beats":4,"changes":[{"symbol":"Gm","column":7,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And you put me through hell","columns":27,"beats":4,"changes":[{"symbol":"F","column":9,"beat":0}]},{"id":"line-9","kind":"lyric","text":"  I had to learn how to fight for myself","columns":40,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-10","kind":"lyric","text":"And we both know all the truth I could tell","columns":43,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":27,"beat":2}]},{"id":"line-11","kind":"lyric","text":"I'll just say this is I wish you farewell","columns":41,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-12","kind":"lyric","text":"I hope you're somewhere praying, praying","columns":40,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":26,"beat":2},{"symbol":"Bb","column":31,"beat":4}]},{"id":"line-13","kind":"lyric","text":"I hope your soul is changing, changing","columns":38,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":19,"beat":2},{"symbol":"Bb","column":25,"beat":4},{"symbol":"Eb","column":31,"beat":6}]},{"id":"line-14","kind":"lyric","text":"   I hope you find your peace","columns":29,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":6,"beat":2},{"symbol":"Bb","column":25,"beat":5}]},{"id":"line-15","kind":"lyric","text":"Falling on your knees, praying","columns":36,"beats":8,"changes":[{"symbol":"Gm","column":18,"beat":0},{"symbol":"F","column":25,"beat":2},{"symbol":"Bb","column":30,"beat":4},{"symbol":"Eb","column":34,"beat":6}]},{"id":"line-16","kind":"instrumental","text":"(           )","columns":13,"beats":6,"changes":[{"symbol":"Gm","column":2,"beat":0},{"symbol":"F","column":6,"beat":2},{"symbol":"Bb","column":9,"beat":4}]},{"id":"line-17","kind":"lyric","text":"  I'm proud of who I am","columns":23,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":8,"beat":2},{"symbol":"Bb","column":18,"beat":4}]},{"id":"line-18","kind":"lyric","text":"  No more monsters, I can breathe again","columns":39,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":11,"beat":2},{"symbol":"Bb","column":21,"beat":5}]},{"id":"line-19","kind":"lyric","text":"  And you said that I was done","columns":30,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":11,"beat":2},{"symbol":"Bb","column":28,"beat":4}]},{"id":"line-20","kind":"lyric","text":"  Well, you were wrong and now the best is yet to come","columns":54,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":19,"beat":2},{"symbol":"Bb","column":35,"beat":4}]},{"id":"line-21","kind":"lyric","text":"  'Cause I can make it on my own","columns":32,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":16,"beat":2},{"symbol":"Bb","column":29,"beat":5}]},{"id":"line-22","kind":"lyric","text":"  And I don't need you, I found a strength I've never known","columns":59,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":15,"beat":2},{"symbol":"Bb","column":37,"beat":4}]},{"id":"line-23","kind":"lyric","text":"  I've been thrown out, I've been burned","columns":40,"beats":6,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":15,"beat":2},{"symbol":"Bb","column":35,"beat":4}]},{"id":"line-24","kind":"lyric","text":"   When I'm finished, they won't even know your name","columns":52,"beats":8,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":13,"beat":2},{"symbol":"Bb","column":33,"beat":4},{"symbol":"Eb","column":48,"beat":6}]},{"id":"line-25","kind":"lyric","text":"You brought the flames and you put me through hell","columns":50,"beats":4,"changes":[{"symbol":"Gm","column":1,"beat":0},{"symbol":"F","column":32,"beat":2}]},{"id