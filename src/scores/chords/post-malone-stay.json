{"version":1,"id":"post-malone-stay","title":"Stay","artist":"Post Malone","key":"F","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/post-malone/stay/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Lu Balz, A Rosen, Andrew Watt and Post Malone","chords":[{"symbol":"F7M","canonical":"Fmaj7","keyboardPitchClasses":[5,9,0,4],"interpretation":"Keyboard interpretation: Fmaj7"},{"symbol":"C7M/G","canonical":"Cmaj7/G","keyboardPitchClasses":[7,11,0,4],"interpretation":"Keyboard interpretation: Cmaj7/G"},{"symbol":"Am7","canonical":"Am7","keyboardPitchClasses":[9,0,4,7],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"D7","canonical":"D7","keyboardPitchClasses":[2,6,9,0],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"It's true that all that you know is all that you are","columns":54,"beats":6,"changes":[{"symbol":"F7M","column":6,"beat":0},{"symbol":"C7M/G","column":32,"beat":2},{"symbol":"Am7","column":51,"beat":4}]},{"id":"line-2","kind":"lyric","text":"You said that it's all that you want and more","columns":45,"beats":4,"changes":[{"symbol":"Gm","column":19,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Fuck off and pour another drink","columns":33,"beats":4,"changes":[{"symbol":"F7M","column":0,"beat":0},{"symbol":"C7M/G","column":28,"beat":2}]},{"id":"line-4","kind":"lyric","text":"And tell me what you think","columns":26,"beats":4,"changes":[{"symbol":"Am7","column":23,"beat":0}]},{"id":"line-5","kind":"lyric","text":"You know that I'm too drunk to talk right now","columns":45,"beats":4,"changes":[{"symbol":"Gm","column":18,"beat":0},{"symbol":"F7M","column":42,"beat":2}]},{"id":"line-6","kind":"lyric","text":"You put your cigarette out on my face","columns":39,"beats":4,"changes":[{"symbol":"C7M/G","column":34,"beat":0}]},{"id":"line-7","kind":"lyric","text":"So beautiful, please woman","columns":26,"beats":4,"changes":[{"symbol":"Am7","column":9,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Don't break your back for me","columns":28,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F","column":27,"beat":2}]},{"id":"line-9","kind":"lyric","text":"I'll put you out of your misery","columns":31,"beats":4,"changes":[{"symbol":"Fm","column":11,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Tell me that it's all okay (tell me that it's all okay)","columns":55,"beats":4,"changes":[{"symbol":"C7M/G","column":1,"beat":0}]},{"id":"line-11","kind":"lyric","text":"I've been waitin' on this all damn day (waitin' on this all damn day)","columns":69,"beats":4,"changes":[{"symbol":"Am7","column":11,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Call me in the mornin', tell me how last night went","columns":51,"beats":4,"changes":[{"symbol":"D7","column":1,"beat":0}]},{"id":"line-13","kind":"lyric","text":"I'm here, but don't count on me to","columns":34,"beats":4,"changes":[{"symbol":"F","column":6,"beat":0},{"symbol":"Fm","column":21,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Stay a little longer if you convince me","columns":39,"beats":4,"changes":[{"symbol":"F7M","column":0,"beat":0}]},{"id":"line-15","kind":"lyric","text":"You tell me all the things that you have against me","columns":51,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"Every time we make up, the truth is faded","columns":41,"beats":4,"changes":[{"symbol":"C7M/G","column":0,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Everybody's blind when the view's amazin'","columns":41,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Damn, who are we right now?","columns":27,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Can we have a little conversation?","columns":34,"beats":4,"changes":[{"symbol":"F7M","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Figure it out with no intoxication","columns":34,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"We carry on, what is our motivation?","columns":36,"beats":4,"changes":[{"symbol":"C7M/G","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"We're never wrong, how the hell we gonna make it?","columns":49,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Maybe we're used to this","columns":28,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"F7M","column":25,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Tell me, what are we to do","columns":26,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"It's like we only play to lose","columns":30,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Chasin' pain with an excuse","columns":27,"beats":4,"changes":[{"symbol":"C7M/G","column":0,"beat":0}]},{"id":"line-27","kind":"lyric","text":"I love that shit and so do you","columns":30,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"But don't break your back for me","columns":34,"beats":4,"changes":[{"symbol":"Gm","column":4,"beat":0},{"symbol":"F","column":33,"beat":2}]},{"id":"line-29","kind":"lyric","text":"I'll put you out of your misery","columns":31,"beats":4,"changes":[{"symbol":"Fm","column":13,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Tell me that it's all okay (tell me that it's all okay)","columns":55,"beats":4,"changes":[{"symbol":"C7M/G","column":0,"beat":0}]},{"id":"line-31","kind":"lyric","text":"I've been waitin' on this all damn day (waitin' on this all damn day)","columns":69,"beats":2,"changes":[{"symbol":"Am7","column":11,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Call me in the mornin', tell me how last night went","columns":51,"beats":4,"changes":[{"symbol":"D7","column":1,"beat":0}]},{"id":"line-33","kind":"lyric","text":"I'm here, but don't count on me to stay","columns":39,"beats":4,"changes":[{"symbol":"F","column":6,"beat":0},{"symbol":"Fm","column":20,"beat":2}]},{"id":"line-34","kind":"instrumental","text":"(                     )","columns":23,"beats":8,"changes":[{"symbol":"F7M","column":2,"beat":0},{"symbol":"C7M/G","column":7,"beat":2},{"symbol":"Am7","column":14,"beat":4},{"symbol":"Gm","column":19,"beat":6}]},{"id":"line-35","kind":"instrumental","text":"(                     )","columns":23,"beats":8,"changes":[{"symbol":"F7M","column":2,"beat":0},{"symbol":"C7M/G","column":7,"beat":2},{"symbol":"Am7","column":14,"beat":4},{"symbol":"Gm","column":19,"beat":6}]},{"id":"line-36","kind":"instrumental","text":"(       )","columns":9,"beats":4,"changes":[{"symbol":"F","column":2,"beat":0},{"symbol":"Fm","column":5,"beat":2}]},{"id":"line-37","kind":"lyric","text":"Tell me that it's all okay (tell me that it's all okay)","columns":55,"beats":4,"changes":[{"symbol":"C7M/G","column":0,"beat":0}]},{"id":"line-38","kind":"lyric","text":"I've been waitin' on this all damn day (waitin' on this all damn day)","columns":69,"beats":2,"changes":[{"symbol":"Am7","column":11,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Call me in the mornin', tell me how last night went","columns":51,"beats":4,"changes":[{"symbol":"D7","column":1,"beat":0}]},{"id":"line-40","kind":"lyric","text":"I'm here, but don't count on me to stay","columns":41,"beats":6,"changes":[{"symbol":"F","column":6,"beat":0},{"symbol":"Fm","column":20,"beat":2},{"symbol":"C7M/G","column":36,"beat":4}]}]}