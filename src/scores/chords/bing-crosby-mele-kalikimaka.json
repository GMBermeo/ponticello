nd all the stars by night.","columns":54,"beats":6,"changes":[{"symbol":"D7","column":4,"beat":0},{"symbol":"G7","column":39,"beat":2},{"symbol":"C","column":48,"beat":4}]},{"id":"line-7","kind":"lyric","text":"\"Mele Kalikimaka\" is Hawaii's way","columns":33,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"D7","column":21,"beat":2}]},{"id":"line-8","kind":"lyric","text":"to say \"Merry Christmas\" to you.","columns":32,"beats":6,"changes":[{"symbol":"G7","column":0,"beat":0},{"symbol":"C7","column":15,"beat":2},{"symbol":"F","column":29,"beat":4}]}]}