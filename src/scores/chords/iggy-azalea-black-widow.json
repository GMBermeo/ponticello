-23","kind":"lyric","text":"Now sing","columns":8,"beats":4,"changes":[]},{"id":"line-24","kind":"section","text":"[Pre-Hook — Rita Ora:]","columns":22,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"You used to be thirsty for me","columns":29,"beats":4,"changes":[{"symbol":"D#m","column":0,"beat":0},{"symbol":"B","column":15,"beat":2}]},{"id":"line-26","kind":"lyric","text":"But now you wanna be set free","columns":29,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0},{"symbol":"C#","column":17,"beat":2}]},{"id":"line-27","kind":"lyric","text":"This is the web, web that you weave","columns":35,"beats":4,"changes":[{"symbol":"D#m","column":0,"beat":0},{"symbol":"B","column":17,"beat":2}]},{"id":"line-28","kind":"lyric","text":"So baby now rest in peace (It's all over with now)","columns":50,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0},{"symbol":"C#","column":16,"beat":2}]},{"id":"line-29","kind":"section","text":"[Hook — Rita Ora:]","columns":18,"beats":0,"changes":[]},{"id":"line-30","kind":"lyric","text":"I'm gonna love ya","columns":17,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"Until you hate me (Right)","columns":25,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"And I'm gonna show ya (Show 'em what show 'em what)","columns":51,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"What's really crazy","columns":19,"beats":4,"changes":[]},{"id":"line-34","kind":"lyric","text":"You should've known better","columns":26,"beats":4,"changes":[]},{"id":"line-35","kind":"lyric","text":"Than to mess with me, honey (it's all over with now)","columns":52,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"I'm gonna love ya, I'm gonna love ya","columns":36,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"Gonna love ya, gonna love ya","columns":28,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"Like a black widow, baby","columns":24,"beats":4,"changes":[]}]}