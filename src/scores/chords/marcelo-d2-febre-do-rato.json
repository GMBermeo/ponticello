{"version":1,"id":"marcelo-d2-febre-do-rato","title":"Febre do Rato","artist":"Marcelo D2","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/marcelo-d2/febre-do-rato/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/4jqn3lhC2gZ8yqtRv35Pm6","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: D2","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Não beijo pé do patrão","columns":22,"beats":4,"changes":[{"symbol":"G","column":9,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Não quero o que é dos outros","columns":28,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"Me ame, te estendo a mão","columns":24,"beats":4,"changes":[]},{"id":"line-4","kind":"lyric","text":"E a raiva fica pros outros","columns":26,"beats":4,"changes":[]},{"id":"line-5","kind":"lyric","text":"Se eu tô na febre do rato","columns":25,"beats":4,"changes":[{"symbol":"F","column":12,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Agora vocês vão ver","columns":19,"beats":4,"changes":[]},{"id":"line-7","kind":"lyric","text":"Se é guerra o que nego quer","columns":27,"beats":4,"changes":[{"symbol":"G","column":9,"beat":0}]},{"id":"line-8","kind":"lyric","text":"É guerra que eles vão ter","columns":25,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"Simbóra","columns":7,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"Dizem querer meu melhor, mas torcem pelo pior","columns":45,"beats":4,"changes":[]},{"id":"line-11","kind":"lyric","text":"Na minha frente, dente; por trás, faca","columns":38,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"Seus olhos falam por si só","columns":26,"beats":4,"changes":[]},{"id":"line-13","kind":"lyric","text":"Às vezes, nada dá liga, amigo Zizo dizia","columns":40,"beats":4,"changes":[{"symbol":"F","column":4,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Cachaça e rapariga essas horas é poesia","columns":39,"beats":4,"changes":[{"symbol":"G","column":4,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Se eu tô na febre do rato, é que na vida nada é barato","columns":54,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"Tento ser o civilizado, mas nego não adianta o meu lado","columns":55,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"Você em cima do prédio sabe o cheiro que a cidade tem","columns":53,"beats":4,"changes":[{"symbol":"F","column":3,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Você aí em cima do prédio, se esconde e não atende ninguém","columns":58,"beats":4,"changes":[{"symbol":"G","column":3,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Selva de pedra não tem dó","columns":25,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Às vezes, o tempo fecha e cê se sente só","columns":40,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"Mano Cipó, milionário","columns":21,"beats":4,"changes":[{"symbol":"F","column":3,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Pegou um otário, deu o golpe, conto do vigário","columns":46,"beats":4,"changes":[{"symbol":"G","column":3,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Quero ter o direito de errar, eu sei que eu posso errar","columns":55,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"É que errando, eu posso acertar","columns":31,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"Mas não, não posso se não tentar","columns":32,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Quero as notas baixa de Barry White","columns":35,"beats":4,"changes":[{"symbol":"F","column":4,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Quero passar dos quarenta rimando","columns":33,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"Quero noites ouvindo Pharcyde","columns":29,"beats":4,"changes":[{"symbol":"G","column":4,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Quero a cabeça erguida e vamo que vamo","columns":38,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"Roubaram meu sonho, acabou","columns":26,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"Se eu fui livre, hoje, eu não sou","columns":33,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"Se eles querem guerra, eu não","columns":29,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"Mas é na febre do rato que eu tô","columns":32,"beats":4,"changes":[]},{"id":"line-34","kind":"lyric","text":"Às vezes, nada dá liga, amigo Zizo dizia","columns":40,"beats":4,"changes":[{"symbol":"F","column":6,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Cachaça e rapariga, cachaça e rapariga","columns":38,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0}]},{"id":"line-36","kind":"lyric","text":"Cachaça e rapariga essas horas é poesia","columns":39,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"Sou desse jeito, virtudes e defeitos","columns":36,"beats":4,"changes":[{"symbol":"G","column":5,"beat":0}]},{"id":"line-38","kind":"lyric","text":"Nunca pensei em ser perfeito","columns":28,"beats":4,"changes":[{"symbol":"F","column":24,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Mas vou correr pelo direito","columns":27,"beats":4,"changes":[{"symbol":"G","column":24,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Eu sou o sim, também o não","columns":26,"beats":4,"changes":[]},{"id":"line-41","kind":"lyric","text":"Sou liberdade, eu sou prisão","columns":28,"beats":4,"changes":[]},{"id":"line-42","kind":"lyric","text":"O que bate e o que estende a mão (sou eu, sou eu)","columns":49,"beats":4,"changes":[{"symbol":"F","column":30,"beat":0}]},{"id":"line-43","kind":"lyric","text":"Sou eu: pura contradição","columns":24,"beats":4,"changes":[{"symbol":"G","column":22,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Eles querem que a gente sonhe se vestir igual eles","columns":50,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Falar igual eles, pra trabalhar pra eles","columns":40,"beats":4,"changes":[]},{"id":"line-46","kind":"lyric","text":"Mas comigo não, relíquia","columns":24,"beats":4,"changes":[]},{"id":"line-47","kind":"lyric","text":"Eu tô aqui pra desafinar o coro dos contentes","columns":45,"beats":4,"changes":[]},{"id":"line-48","kind":"lyric","text":"Sou barril de pólvora, pavio acesso","columns":35,"beats":4,"changes":[]},{"id":"line-49","kind":"lyric","text":"Final traçado desdo começo","columns":26,"beats":4,"changes":[]},{"id":"line-50","kind":"lyric","text":"Meus amigos já se foram","columns":23,"beats":4,"changes":[]},{"id":"line-51","kind":"lyric","text":"Eu aqui sozinho engolindo meu choro","columns":35,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"Ouço um tiro e a dor me persegue","columns":32,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-53","kind":"lyric","text":"Eu corro pra longe, antes que o ódio me cegue, y-ah","columns":51,"beats":4,"changes":[{"symbol":"G","column":43,"beat":0}]},{"id":"line-54","kind":"lyric","text":"Antes que o ódio me cegue","columns":25,"beats":4,"changes":[]},{"id":"line-55","kind":"lyric","text":"Eu corro pra longe, antes que a morte me pegue","columns":46,"beats":4,"changes":[]},{"id":"line-56","kind":"lyric","text":"Eles me pedem calma, tô calmo uma porra","columns":39,"beats":4,"changes":[]},{"id":"line-57","kind":"lyric","text":"Cem por cento certo ou guerra, porra","columns":36,"beats":4,"changes":[]},{"id":"line-58","kind":"lyric","text":"Se ele agora quer bagulho, tem","columns":30,"beats":4,"changes":[]},{"id":"line-59","kind":"lyric","text":"Esse negócio que está morto, vem","columns":32,"beats":4,"changes":[]},{"id":"line-60","kind":"lyric","text":"Vem, mas vem que vem, mané",