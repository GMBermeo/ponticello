{"version":1,"id":"shawn-mendes-monster","title":"Monster","artist":"Shawn Mendes","key":"Dm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/shawn-mendes/monster/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Shawn Mendes, Adam King Feeney,  Justin Bieber, Ashton Simmonds and Mustafa Ahmed","chords":[{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Gm","canonical":"Gm","keyboardPitchClasses":[7,10,2],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":21,"beats":8,"changes":[{"symbol":"Dm","column":8,"beat":0},{"symbol":"C","column":12,"beat":2},{"symbol":"Gm","column":15,"beat":4},{"symbol":"Bb","column":19,"beat":6}]},{"id":"line-2","kind":"lyric","text":"You put me on a pedestal and tell me I'm the best","columns":51,"beats":4,"changes":[{"symbol":"C","column":50,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Raise me up into the sky until I'm short of breath (yeah)","columns":57,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Bb","column":50,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Fill me up with confidence, I say what's in my chest","columns":52,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Spill my words and tear me down until there's nothing left","columns":58,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Rearrange the pieces just to fit me with the rest, yeah","columns":55,"beats":4,"changes":[{"symbol":"Gm","column":0,"beat":0},{"symbol":"Bb","column":49,"beat":2}]},{"id":"line-7","kind":"lyric","text":"But what if I, what if I trip?","columns":30,"b