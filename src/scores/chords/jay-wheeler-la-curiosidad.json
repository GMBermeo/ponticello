{"version":1,"id":"jay-wheeler-la-curiosidad","title":"La Curiosidad","artist":"Jay Wheeler","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/jay-wheeler/la-curiosidad/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Myke Towers and Jay Wheeler","chords":[{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Háblame de ti, ¿cómo tú estás? Quisiera verte","columns":45,"beats":6,"changes":[{"symbol":"Bm","column":1,"beat":0},{"symbol":"A","column":16,"beat":2},{"symbol":"Em","column":30,"beat":4}]},{"id":"line-2","kind":"lyric","text":"En una foto te vi y me dieron ganas de comerte","columns":46,"beats":6,"changes":[{"symbol":"Bm","column":11,"beat":0},{"symbol":"A","column":26,"beat":2},{"symbol":"Em","column":40,"beat":4}]},{"id":"line-3","kind":"lyric","text":"Sé que, al igual que yo, en el amor no has tenido suerte","columns":56,"beats":6,"changes":[{"symbol":"Bm","column":20,"beat":0},{"symbol":"A","column":34,"beat":2},{"symbol":"Em","column":49,"beat":4}]},{"id":"line-4","kind":"lyric","text":"Pero me matan las ganas de verte","columns":32,"beats":6,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"A","column":20,"beat":2},{"symbol":"Em","column":30,"beat":4}]},{"id":"line-5","kind":"lyric","text":"La curiosidad me mata y no aguanto","columns":34,"beats":6,"changes":[{"symbol":"Bm","column":7,"beat":0},{"symbol":"A","column":19,"beat":2},{"symbol":"Em","column":31,"beat":4}]},{"id":"line-6","kind":"lyric","text":"Ya te quiero tener, solo dime cuándo","columns":36,"beats":6,"changes":[{"symbol":"Bm","column":13,"beat":0},{"symbol":"A","column":21,"beat":2},{"symbol":"Em","column":32,"beat":4}]},{"id":"line-7","kind":"lyric","text":"Es que tú y yo muy bien sabemos","columns":31,"beats":6,"changes":[{"symbol":"Bm","column":5,"beat":0},{"symbol":"A","column":19,"beat":2},{"symbol":"Em","column":27,"beat":4}]},{"id":"line-8","kind":"lyric","text":"Que es diferente cuando nos comemos (yeah)","columns":42,"beats":6,"changes":[{"symbol":"G","column":11,"beat":0},{"symbol":"A","column":24,"beat":2},{"symbol":"Em","column":31,"beat":4}]},{"id":"line-9","kind":"lyric","text":"Ey, yo', ella es curiosa, una nena estudiosa (yeah)","columns":51,"beats":4,"changes":[{"symbol":"Bm","column":10,"beat":0},{"symbol":"A","column":32,"beat":2}]},{"id":"line-10","kind":"lyric","text":"A la' otra' ella las tiene furiosa'","columns":35,"beats":6,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-11","kind":"lyric","text":"La bañera ella la pone espumosa","columns":31,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":22,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Yo le juego y se la dejo jugosa","columns":31,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Posa, yo la retrato y le pongo las esposa'","columns":42,"beats":6,"changes":[{"symbol":"Bm","column":1,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"Em","column":31,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Marihuana de flore', ella no quiere rosa'","columns":41,"beats":4,"changes":[{"symbol":"G","column":35,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Si no se lo hago en la cabaña, en la carroza","columns":44,"beats":4,"changes":[{"symbol":"A","column":21,"beat":0},{"symbol":"Em","column":39,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Te ves hermosa","columns":14,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"A mí me dio con verte pero de frente","columns":36,"beats":6,"changes":[{"symbol":"A","column":5,"beat":0},{"symbol":"Bm","column":18,"beat":2},{"symbol":"A","column":32,"beat":4}]},{"id":"line-18","kind":"lyric","text":"Yo sé que ere' diferente, ya chequeé su expediente","columns":50,"beats":4,"changes":[{"symbol":"Em","column":20,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Y no tiene antecedente', qué bien te ve'","columns":40,"beats":4,"changes":[{"symbol":"Bm","column":18,"beat":0},{"symbol":"A","column":36,"beat":2}]},{"id":"line-20","kind":"lyric","text":"Tu mirada no miente, llama si estás caliente","columns":44,"beats":4,"changes":[{"symbol":"Em","column":16,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Y yo sigo aquí, tú siempre pasas por mi mente","columns":45,"beats":6,"changes":[{"symbol":"Bm","column":14,"beat":0},{"symbol":"A","column":28,"beat":2},{"symbol":"Em","column":36,"beat":4}]},{"id":"line-22","kind":"lyric","text":"Hablarte no me atreví, sé que conmigo no pueden verte","columns":53,"beats":6,"changes":[{"symbol":"G","column":21,"beat":0},{"symbol":"A","column":34,"beat":2},{"symbol":"Em","column":47,"beat":4}]},{"id":"line-23","kind":"lyric","text":"Se dice por ahí que lo que no mata te hace má' fuerte","columns":53,"beats":6,"changes":[{"symbol":"Bm","column":13,"beat":0},{"symbol":"A","column":32,"beat":2},{"symbol":"Em","column":47,"beat":4}]},{"id":"line-24","kind":"lyric","text":"Si vuelvo a nacer yo volvería a conocerte","columns":41,"beats":6,"changes":[{"symbol":"Bm","column":15,"beat":0},{"symbol":"A","column":26,"beat":2},{"symbol":"Em","column":36,"beat":4}]},{"id":"line-25","kind":"lyric","text":"La curiosidad me mata y no aguanto","columns":34,"beats":6,"changes":[{"symbol":"Bm","column":7,"beat":0},{"symbol":"A","column":19,"beat":2},{"symbol":"Em","column":31,"beat":4}]},{"id":"line-26","kind":"lyric","text":"Ya te quiero tener, solo dime cuándo","columns":36,"beats":6,"changes":[{"symbol":"Bm","column":13,"beat":0},{"symbol":"A","column":21,"beat":2},{"symbol":"Em","column":32,"beat":4}]},{"id"