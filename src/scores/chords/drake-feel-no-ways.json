{"version":1,"id":"drake-feel-no-ways","title":"Feel No Ways","artist":"Drake","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/drake/feel-no-ways/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Anne Dudley, Drake, Mr Shebib, Nayvadius Wilburn, Jordan and Mclaren Malcolm Robert Andrew","chords":[{"symbol":"Cmaj7","canonical":"Cmaj7","keyboardPitchClasses":[0,4,7,11],"interpretation":null},{"symbol":"Gmaj7","canonical":"Gmaj7","keyboardPitchClasses":[7,11,2,6],"interpretation":null},{"symbol":"Am7","canonical":"Am7","keyboardPitchClasses":[9,0,4,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I should be downtown, whipping on the way to you","columns":48,"beats":4,"changes":[{"symbol":"Cmaj7","column":37,"beat":0}]},{"id":"line-2","kind":"lyric","text":"You got something that belongs to me","columns":47,"beats":4,"changes":[{"symbol":"Gmaj7","column":23,"beat":0},{"symbol":"Am7","column":44,"beat":2}]},{"id":"line-3","kind":"lyric","text":"Your body language says it all","columns":30,"beats":4,"changes":[{"symbol":"Cmaj7","column":19,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Despite the things you said to me","columns":46,"beats":4,"changes":[{"symbol":"Gmaj7","column":22,"beat":0},{"symbol":"Am7","column":43,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Who is it that's got you all gassed up?","columns":40,"beats":4,"changes":[{"symbol":"Cmaj7","column":35,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Changing your opinion on me","columns":40,"beats":4,"changes":[{"symbol":"Gmaj7","column":15,"beat":0},{"symbol":"Am7","column":37,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I was only gone for the last few months","columns":43,"beats":4,"changes":[{"symbol":"Cmaj7","column":38,"beat":0}]},{"id":"line-8","kind":"lyric","text":"But you don't have the time to wait on me","columns":53,"beats":4,"chan