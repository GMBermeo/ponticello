{"version":1,"id":"dominic-fike-white-keys","title":"White Keys","artist":"Dominic Fike","key":"G#m","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/dominic-fike/white-keys/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Fabricio, John Cunningham and Dominic Fike","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":21,"beats":8,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"Bm","column":11,"beat":2},{"symbol":"A","column":15,"beat":4},{"symbol":"F#m","column":18,"beat":6}]},{"id":"line-2","kind":"instrumental","text":"","columns":21,"beats":8,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"Bm","column":11,"beat":2},{"symbol":"A","column":15,"beat":4},{"symbol":"F#m","column":18,"beat":6}]},{"id":"line-3","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-4","kind":"lyric","text":"Aight, pitch-black Chevy antique, I was seventeen","columns":49,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":23,"beat":2}]},{"id":"line-5","kind":"lyric","text":"I ain't have nothing but some tees and a pair of jeans","columns":54,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":40,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Pine trees, but it smell like weed in the front seat","columns":52,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":30,"beat":2}]},{"id":"line-7","kind":"lyric","text":"You was en route to being famous and everything","columns":47,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":37,"beat":2}]},{"id":"line-8","kind":"lyric","text":"White keys 'cause she's way too major for everything","columns":52,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":32,"beat":2}]},{"id":"line-9","kind":"lyric","text":"I wanna be a part of it, what you got goin' on","columns":46,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":43,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Isn't as sad as you make it out to be?","columns":38,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":35,"beat":2}]},{"id":"line-11","kind":"lyric","text":"I wanna be mad, but you take it out on me","columns":42,"beats":4,"changes":[{"symbol":"A","column":11,"beat":0},{"symbol":"F#m","column":39,"beat":2}]},{"id":"line-12","kind":"lyric","text":"1995, Teens in the Florida breeze","columns":33,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":6,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Ice cream, she was so sweet before everything","columns":45,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":35,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Tight squeeze, tryna fit me in your everyday, but you never came","columns":64,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":24,"beat":2}]},{"id":"line-15","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-16","kind":"lyric","text":"The world is movin', we were never meant to stay","columns":48,"beats":4,"changes":[{"symbol":"G","column":13,"beat":0},{"symbol":"Bm","column":44,"beat":2}]},{"id":"line-17","kind":"lyric","text":"But I was workin' on the world","columns":30,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0}]},{"id":"line-18","kind":"lyric","text":"I guess I thought that if I gave you what I had","columns":47,"beats":4,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"Bm","column":44,"beat":2}]},{"id":"line-19","kind":"lyric","text":"I guess I thought that it would work","columns":36,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0}]},{"id":"line-20","kind":"lyric","text":"I never knew (oh)","columns":21,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":8,"beat":2},{"symbol":"Bm","column":14,"beat":4},{"symbol":"A","column":20,"beat":6}]},{"id":"line-21","kind":"lyric","text":"It was because of you (oh, oh, oh, oh, ooh)","columns":43,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":19,"beat":2},{"symbol":"Bm","column":28,"beat":4},{"symbol":"A","column":34,"beat":6}]},{"id":"line-22","kind":"lyric","text":"I never knew (oh, oh, oh, ooh)","columns":30,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":9,"beat":1},{"symbol":"Bm","column":18,"beat":2},{"symbol":"A","column":24,"beat":3}]},{"id":"line-23","kind":"lyric","text":"Oh, I guess I never— (woah)","columns":27,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":11,"beat":2},{"symbol":"Bm","column":20,"beat":4},{"symbol":"A","column":26,"beat":6}]},{"id":"line-24","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"Aight, rich ass, tryna fit my Gs in these Prada jeans","columns":53,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"Bm","column":30,"beat":2}]},{"id":"line-26","kind":"lyric","text":"Mismatchin' with my Célines, king of everything","columns":47,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":29,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Fifth stack comin' in this week, I bought everything","columns":52,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":27,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Dispatchin' with all the G's, pulled up, wrecked the scene","columns":58,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":26,"beat":2}]},{"id":"line-29","kind":"lyric","text":"White keys 'cause she's way too major for everything","columns":52,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":28,"beat":2}]},{"id":"line-30","kind":"lyric","text":"The kids want this, the hoes want that","columns":38,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":20,"beat":2}]},{"id":"line-31","kind":"lyric","text":"I feel my heart inside my back","columns":30,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":21,"beat":2}]},{"id":"line-32","kind":"lyric","text":"I made a point to be intact","columns":27,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":18,"beat":2}]},{"id":"line-33","kind":"lyric","text":"And you don't even keep it wholesome with me","columns":44,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":26,"beat":2}]},{"id":"line-34","kind":"lyric","text":"You were singin' old songs with me","columns":34,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"F#m","column":21,"beat":2}]},{"id":"line-35","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-36","kind":"lyric","text":"The world is movin', we were never meant to stay","columns":48,"beats":4,"changes":[{"symbol":"G","column":13,"beat":0},{"symbol":"Bm","column":44,"beat":2}]},{"id":"line-37","kind":"lyric","text":"But I was workin' on the world","columns":30,"beats":6,"changes":[{"symbol":"A","column":10,"beat":0}]},{"id":"line-38","kind":"lyric","text":"I guess I thought that if I gave you what I had","columns":47,"beats":4,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"Bm","column":44,"beat":2}]},{"id":"line-39","kind":"lyric","text":"I guess I thought that it would work","columns":36,"beats":6,"changes":[{"symbol":"A","column":10,"beat":0}]},{"id":"line-40","kind":"lyric","text":"I never knew (oh)","columns":21,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":8,"beat":2},{"symbol":"Bm","column":14,"beat":4},{"symbol":"A","column":20,"beat":6}]},{"id":"line-41","kind":"lyric","text":"It was because of you (oh, oh, oh, oh, ooh)","columns":43,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":19,"beat":2},{"symbol":"Bm","column":28,"beat":4},{"symbol":"A","column":34,"beat":6}]},{"id":"line-42","kind":"lyric","text":"I never knew (oh, oh, oh, ooh)","columns":30,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":9,"beat":2},{"symbol":"Bm","column":18,"beat":4},{"symbol":"A","column":24,"beat":6}]},{"id":"line-43","kind":"lyric","text":"Oh, I guess I never— (woah)","columns":27,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":11,"beat":2},{"symbol":"Bm","column":20,"beat":4},{"symbol":"A","column":26,"beat":6}]}]}