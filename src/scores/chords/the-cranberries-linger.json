ric","text":"It's ruining everyday","columns":21,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"I swore, I swore I would be true","columns":32,"beats":4,"changes":[{"symbol":"D","column":4,"beat":0}]},{"id":"line-11","kind":"lyric","text":"And honey so did you","columns":20,"beats":4,"changes":[{"symbol":"A","column":18,"beat":0}]},{"id":"line-12","kind":"lyric","text":"So why were you holding her hand?","columns":33,"beats":4,"changes":[{"symbol":"C","column":29,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Is that the way we stand?","columns":25,"beats":4,"changes":[]},{"id":"line-14","kind":"lyric","text":"Were you lying all the time?","columns":28,"beats":4,"changes":[{"symbol":"G","column":24,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Was it just a game to you?","columns":26,"beats":4,"changes":[]},{"id":"line-16","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-17","kind":"lyric","text":"But I'm in so deep","columns":18,"beats":4,"changes":[{"symbol":"D","column":15,"beat":0}]},{"id":"line-18","kind":"lyric","text":"You know I'm such a fool for you","columns":32,"beats":4,"changes":[{"symbol":"A","column":21,"beat":0}]},{"id":"line-19","kind":"lyric","text":"You got me wrapped around your finger","columns":37,"beats":4,"changes":[{"symbol":"C","column":32,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Do you have to let it linger?","columns":29,"beats":4,"changes":[{"symbol":"G","column":23,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Do you have to? do you have to?","columns":31,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"Do you have to let it linger?","columns":29,"beats":4,"changes":[{"symbol":"D","column":23,"beat":0}]},{"id":"line-23","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-24","kind":"lyric","text":"Oh, I thought the world of you","columns":30,"beats":4,"changes":[{"symbol":"A","column":8,"beat":0}]},{"id":"line-25","kind"