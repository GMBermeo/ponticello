{"version":1,"id":"the-marias-sienna","title":"Sienna","artist":"The Marias","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/the-marias/sienna/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Josh Conway and Maria Zardoya","chords":[{"symbol":"Am7","canonical":"Am7","keyboardPitchClasses":[9,0,4,7],"interpretation":null},{"symbol":"D7","canonical":"D7","keyboardPitchClasses":[2,6,9,0],"interpretation":null},{"symbol":"G7M","canonical":"Gmaj7","keyboardPitchClasses":[7,11,2,6],"interpretation":"Keyboard interpretation: Gmaj7"},{"symbol":"C7M","canonical":"Cmaj7","keyboardPitchClasses":[0,4,7,11],"interpretation":"Keyboard interpretation: Cmaj7"},{"symbol":"E7","canonical":"E7","keyboardPitchClasses":[4,8,11,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"   Please tell me not to go","columns":29,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":27,"beat":2}]},{"id":"line-2","kind":"lyric","text":"   We’ve been here long before","columns":35,"beats":4,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"C7M","column":32,"beat":2}]},{"id":"line-3","kind":"lyric","text":"   I live under your eyelids","columns":30,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":28,"beat":2}]},{"id":"line-4","kind":"lyric","text":"   I’ll always be yours","columns":27,"beats":4,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"E7","column":25,"beat":2}]},{"id":"line-5","kind":"lyric","text":"   I’ll lay on your rooftop","columns":29,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":27,"beat":1}]},{"id":"line-6","kind":"lyric","text":"In the freezing cold","columns":22,"beats":4,"changes":[{"symbol":"G7M","column":19,"beat":0}]},{"id":"line-7","kind":"lyric","text":"And I’ll watch the sunset","columns":27,"beats":4,"changes":[{"symbol":"C7M","column":24,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Wearing all your clothes","columns":27,"beats":4,"changes":[{"symbol":"Am7","column":24,"beat":0}]},{"id":"line-9","kind":"lyric","text":"I can feel you with me","columns":23,"beats":4,"changes":[{"symbol":"D7","column":21,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Like I did before","columns":20,"beats":4,"changes":[{"symbol":"G7M","column":17,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Like when I sing you a love song","columns":32,"beats":4,"changes":[{"symbol":"E7","column":30,"beat":0}]},{"id":"line-12","kind":"lyric","text":"By Norah Jones","columns":14,"beats":4,"changes":[]},{"id":"line-13","kind":"lyric","text":"Ooh, Sienna","columns":13,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":11,"beat":2}]},{"id":"line-14","kind":"lyric","text":"Would’ve been cute","columns":24,"beats":8,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"C7M","column":21,"beat":4}]},{"id":"line-15","kind":"lyric","text":"Ooh, Sienna","columns":13,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":11,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Would’ve looked just like you","columns":32,"beats":8,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"E7","column":30,"beat":4}]},{"id":"line-17","kind":"lyric","text":"I came clean","columns":12,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":8,"beat":2}]},{"id":"line-18","kind":"lyric","text":"It feels so good","columns":20,"beats":4,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"C7M","column":17,"beat":2}]},{"id":"line-19","kind":"lyric","text":"But I feel seen","columns":15,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":13,"beat":2}]},{"id":"line-20","kind":"lyric","text":" Only through you","columns":21,"beats":8,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"E7","column":19,"beat":4}]},{"id":"line-21","kind":"lyric","text":"   I’ll wait here tomorrow","columns":28,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":26,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Outside your door","columns":19,"beats":4,"changes":[{"symbol":"G7M","column":16,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Like I did in December","columns":22,"beats":4,"changes":[{"symbol":"C7M","column":17,"beat":0}]},{"id":"line-24","kind":"lyric","text":"When you held me close","columns":23,"beats":4,"changes":[{"symbol":"Am7","column":20,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Coming up on your corner","columns":24,"beats":4,"changes":[{"symbol":"D7","column":22,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Pulling out my hair","columns":22,"beats":4,"changes":[{"symbol":"G7M","column":19,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Hear the creak on the floorboards","columns":33,"beats":4,"changes":[{"symbol":"E7","column":31,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Going up the stairs","columns":19,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"Ooh, Sienna","columns":11,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":6,"beat":2}]},{"id":"line-30","kind":"lyric","text":"  Would’ve been cute","columns":24,"beats":4,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"C7M","column":21,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Ooh, Sienna","columns":11,"beats":4,"changes":[{"symbol":"Am7","column":0,"beat":0},{"symbol":"D7","column":7,"beat":2}]},{"id":"line-32","kind":"lyric","text":"  Would’ve looked just like you","columns":34,"beats":4,"changes":[{"symbol":"G7M","column":0,"beat":0},{"symbol":"E7","column":32,"beat":2}]},{"id":"line-33","kind":"lyric","text":"With a temper like you","columns":22,"beats":4,"changes":[{"symbol":"Am7","column":7,"beat":0}]},{"id":"line-34","kind":"lyric","text":"Run around like you","columns":1