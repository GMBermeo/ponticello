{"version":1,"id":"fresno-manifesto","title":"Manifesto","artist":"Fresno","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/fresno/manifesto/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/6wJqQmyHqINC6aRm6iYsku","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Lucas Silveira and Emicida","chords":[{"symbol":"G#m7","canonical":"G#m7","keyboardPitchClasses":[8,11,3,6],"interpretation":null},{"symbol":"G#m7(9)","canonical":"G#m7(9)","keyboardPitchClasses":[8,10,11,3,6],"interpretation":null},{"symbol":"B9","canonical":"Badd9","keyboardPitchClasses":[11,1,3],"interpretation":"Keyboard interpretation: Badd9"},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"C#","canonical":"C#","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"B","canonical":"B","keyboardPitchClasses":[11,3,6],"interpretation":null},{"symbol":"C#11/B","canonical":"C#11/B","keyboardPitchClasses":[],"interpretation":null},{"symbol":"C#4","canonical":"C#sus4","keyboardPitchClasses":[1,6,8],"interpretation":"Keyboard interpretation: C#sus4"},{"symbol":"D#m","canonical":"D#m","keyboardPitchClasses":[3,6,10],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"Intro:                           (2x)","columns":37,"beats":14,"changes":[{"symbol":"G#m7","column":7,"beat":0},{"symbol":"G#m7(9)","column":13,"beat":2},{"symbol":"B9","column":21,"beat":4},{"symbol":"F#","column":25,"beat":6},{"symbol":"C#","column":30,"beat":8}]},{"id":"line-2","kind":"lyric","text":"A gente acorda pra vida e não quer sair da cama","columns":47,"beats":4,"changes":[{"symbol":"G#m7","column":10,"beat":0},{"symbol":"G#m7(9)","column":36,"beat":2}]},{"id":"line-3","kind":"lyric","text":"A gente abre a ferida na pele de quem nos ama","columns":45,"beats":4,"changes":[{"symbol":"B9","column":8,"beat":0}]},{"id":"line-4","kind":"lyric","text":"A gente vive na guerra, a gente luta por paz","columns":44,"beats":4,"changes":[{"symbol":"F#","column":9,"beat":0}]},{"id":"line-5","kind":"lyric","text":"A gente pensa que sabe, mas nunca sabe o que faz","columns":48,"beats":2,"changes":[{"symbol":"C#","column":9,"beat":0}]},{"id":"line-6","kind":"lyric","text":"A gente nega o que nunca teve forças pra dizer","columns":46,"beats":4,"changes":[{"symbol":"G#m7","column":9,"beat":0},{"symbol":"G#m7(9)","column":35,"beat":2}]},{"id":"line-7","kind":"lyric","text":"A gente mostra pro mundo o que se quer esconder","columns":47,"beats":4,"changes":[{"symbol":"B9","column":9,"beat":0}]},{"id":"line-8","kind":"lyric","text":"A gente finge que vive até o dia de morrer","columns":42,"beats":4,"changes":[{"symbol":"F#","column":9,"beat":0}]},{"id":"line-9","kind":"lyric","text":"E espera a hora da morte pra se arrepender de tudo","columns":60,"beats":8,"changes":[{"symbol":"C#","column":12,"beat":0},{"symbol":"B","column":48,"beat":2},{"symbol":"C#11/B","column":51,"beat":4},{"symbol":"B9","column":58,"beat":6}]},{"id":"line-10","kind":"lyric","text":"E todas essas pessoas que passaram por mim","columns":42,"beats":4,"changes":[{"symbol":"G#m7","column":8,"beat":0},{"symbol":"G#m7(9)","column":31,"beat":2}]},{"id":"line-11","kind":"lyric","text":"Alguns querendo dinheiro, outros querendo o meu fim","columns":51,"beats":4,"changes":[{"symbol":"B9","column":11,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Os meus amores de infância e os inimigos mortais","columns":48,"beats":4,"changes":[{"symbol":"F#","column":10,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Todas as micaretas, todos os funerais","columns":37,"beats":4,"changes":[{"symbol":"C#","column":7,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Todos os ditadores e sub-celebridades","columns":37,"beats":4,"changes":[{"symbol":"G#m7","column":6,"beat":0},{"symbol":"G#m7(9)","column":26,"beat":2}]},{"id":"line-15","kind":"lyric","text":"Farsantes reais encobertando verdades","columns":37,"beats":4,"changes":[{"symbol":"B9","column":4,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Pra proteger um vazio, um castelo de papel","columns":42,"beats":4,"changes":[{"symbol":"F#","column":10,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Sempre esquecendo que o mundo é só um ponto azul no céu","columns":57,"beats":6,"changes":[{"symbol":"C#","column":13,"beat":0},{"symbol":"C#4","column":39,"beat":2},{"symbol":"B9","column":55,"beat":4}]},{"id":"line-18","kind":"lyric","text":"Quem é que vai ouvir a minha oração?","columns":36,"beats":4,"changes":[{"symbol":"D#m","column":5,"beat":0},{"symbol":"B9","column":24,"beat":2}]},{"id":"line-19","kind":"lyric","text":"E quantos vão morrer até o final dessa canção?","columns":46,"beats":4,"changes":[{"symbol":"F#","column":4,"beat":0},{"symbol":"C#","column":24,"beat":2}]},{"id":"line-20","kind":"lyric","text":"E quem vai prosseguir com a minha procissão","columns":43,"beats":4,"changes":[{"symbol":"D#m","column":3,"beat":0},{"symbol":"B9","column":30,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Sem nunca desistir, nem sucumbir a toda essa pressão?","columns":76,"beats":7,"changes":[{"symbol":"F#","column":5,"beat":0},{"symbol":"C#","column":26,"beat":1},{"symbol":"G#m7","column":51,"beat":2},{"symbol":"G#m7(9)","column":57,"beat":3},{"symbol":"B9","column":65,"beat":4},{"symbol":"F#","column":69,"beat":5},{"symbol":"C#","column":74,"beat":6}]},{"id":"line-22","kind":"lyric","text":"No escuro, a sós com a minha voz... por nós, quem? Quem? Quem?","columns":62,"beats":4,"changes":[{"symbol":"G#m7","column":3,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Antes, durante e após, desatando os nós, hein? Hein? Hein?","columns":58,"beats":4,"changes":[{"symbol":"B9","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Sente no corpo uma prisão, correntes, vendas na visão","columns":53,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Os caras não avisam, balas não alisam, minas e manos brisam","columns":59,"beats":4,"changes":[{"symbol":"C#","column":5,"beat":0}]},{"id":"line-26","kind":"lyric","text":"E precisam de mais,  mais visão, ter paz","columns":40,"beats":4,"changes":[{"symbol":"G#m7","column":4,"beat":0},{"symbol":"G#m7(9)","column":19,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Mas note que o holofote e o vício nele em si te desfaz","columns":54,"beats":4,"changes":[{"symbol":"B9","column":4,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Menos é mais, e o que segue é a lombra","columns":38,"beats":4,"changes":[{"symbol":"F#","column":1,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Onde se vacilar os verme leva até sua sombra","columns":44,"beats":4,"changes":[{"symbol":"C#","column":3,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Cada qual com seu caos","columns":22,"beats":4,"changes":[{"symbol":"B","column":2,"beat":0}]},{"id":"line-31","kind":"lyric","text":"O inferno particular","columns":20,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"Tempo, individual","columns":17,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"E o amor, impopular","columns":19,"beats":4,"changes":[]},{"id":"line-34","kind":"lyric","text":"Quem é que vai ouvir a minha oração?","columns":36,"beats":4,"changes":[{"symbol":"D#m","column":5,"beat":0},{"symbol":"B9","column":24,"beat":2}]},{"id":"line-35","kind":"lyric","text":"E quantos vão morrer até o final dessa canção?","columns":46,"beats":4,"changes":[{"symbol":"F#","column":4,"beat":0},{"symbol":"C#","column":24,"beat":1}]},{"id":"line-36","kind":"lyric","text":"E quem vai prosseguir com a minha procissão","columns":43,"beats":4,"changes":[{"symbol":"D#m","column":3,"beat":0},{"symbol":"B9","column":30,"beat":2}]},{"id":"line-37","kind":"lyric","text":"Sem nunca desistir, nem sucumbir a toda essa pressão?","columns":76,"beats":13,"changes":[{"symbol":"F#","column":5,"beat":0},{"symbol":"C#","column":26,"beat":1},{"symbol":"G#m7","column":51,"beat":3},{"symbol":"G#m7(9)","column":57,"beat":5},{"symbol":"B9","column":65,"beat":7},{"symbol":"F#","column":69,"beat":9},{"symbol":"C#","column":74,"beat":11}]},{"id":"line-38","kind":"instrumental","text":"(                                                      )","columns":56,"beats":10,"changes":[{"symbol":"G#m7","column":2,"beat":0},{"symbol":"G#m7(9)","column":8,"beat":1},{"symbol":"B9","column":16,"beat":2},{"symbol":"F#","column":20,"beat":3},{"symbol":"C#","column":25,"beat":4},{"symbol":"G#m7","column":29,"beat":5},{"symbol":"G#m7(9)","column":35,"beat":6},{"symbol":"B9","column":43,"beat":7},{"symbol":"F#","column":47,"beat":8},{"symbol":"C#","column":52,"beat":9}]},{"id":"line-39","kind":"lyric","text":"(Só existe uma maneira de se viver pra sempre, irmão","columns":52,"beats":4,"changes":[]},{"id":"line-40","kind":"lyric","text":"Que é compartilhando a sabedoria adquirida","columns":42,"beats":4,"changes":[]},{"id":"line-41","kind":"lyric","text":"E exercitando a gratidão, sempre","columns":32,"beats":4,"changes":[]},{"id":"line-42","kind":"lyric","text":"É o homem entender que ele é parte do todo","columns":42,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"É sobre isso que o Manifesto fala","columns":33,"beats":4,"changes":[]},{"id":"line-44","kind":"lyric","text":"Nem ser menos e nem ser mais, ser parte da natureza, certo?","columns":59,"beats":4,"changes":[]},{"id":"line-45","kind":"lyric","text":"Ao caminhar na contramão disso","columns":30,"beats":4,"changes":[]},{"id":"line-46","kind":"lyric","text":"A gente caminha pra nossa própria destruição)","columns":45,"beats":4,"changes":[]}]}