":"Am","column":27,"beat":2}]},{"id":"line-5","kind":"lyric","text":"   I should've worshipped her sooner","columns":36,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":31,"beat":2}]},{"id":"line-6","kind":"lyric","text":"   If the heavens ever did speak","columns":32,"beats":8,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":24,"beat":4}]},{"id":"line-7","kind":"lyric","text":"   She is the last true mouthpiece","columns":34,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":25,"beat":2}]},{"id":"line-8","kind":"lyric","text":"  Every sunday's getting more bleak","columns":35,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Am","column":26,"beat":2}]},{"id":"line-9","kind":"lyric","text":"   A fresh poison each week","columns":27,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":18,"beat":2}]},{"id":"line-10","kind":"lyric","text":"   We were born sick","columns":20,"beats":4,"changes":[{"symbol":"D9","column":0,"beat":0}]},{"id":"line-11","kind":"lyric","text":"  You heard them say it","columns":23,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-12","kind":"lyric","text":"   My church offers no absolutes","columns":32,"beats":8,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":23,"beat":4}]},{"id":"line-13","kind":"lyric","text":"   She tells me, worship in the bedroom","columns":39,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":33,"beat":2}]},{"id":"line-14","kind":"lyric","text":"  The only heaven I'll be sent to","columns":33,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Am","column":27,"beat":2}]},{"id":"line-15","kind":"lyric","text":"   Is when I'm alone with you","columns":29,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Am","column":22,"beat":2}]},{"id":"line-16","kind":"lyric","text":"   I was born sick,   but I love it","columns":35,"beats":4,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"C","column":20,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Command me to be well","columns":21,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Amen, a_men, a__men, a__men","columns":39,"beats":14,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"C","column":6,"beat":2},{"symbol":"G","column":9,"beat":4},{"symbol":"Cm","column":13,"beat":6},{"symbol":"G","column":17,"beat":8},{"symbol":"Cm","column":21,"beat":10},{"symbol":"G","column":25,"beat":12}]},{"id":"line-19","kind":"section","text":"[Passagem 1]","columns":12,"beats":0,"changes":[]},{"id":"line-20","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-21","kind":"lyric","text":"Take me to church","columns":17,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0}]},{"id":"line-22","kind":"lyric","text":"I'll worship like a dog","columns":23,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"At the shrine of your lies","columns":26,"beats":4,"changes":[{"symbol":"B","column":23,"beat":0}]},{"id":"line-24","kind":"lyric","text":"I'll tell you my sins","columns":21,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"So you can sharpen your knife","columns":29,"beats":4,"changes":[{"symbol":"G","column":26,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Offer me that deathless death","columns":29,"beats":4,"changes":[{"symbol":"Am","column":15,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Good God, let me give you my life","columns":33,"beats":4,"changes":[{"symbol":"Em","column":6,"beat":0}]},{"id":"line-28","kind":"lyric","text":"(Passagem 2)","columns":12,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"Take me to church","columns":17,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0}]},{"id":"line-30","kind":"lyric","text":"I'll worship like a dog","columns":23,"beats":4,"changes":[]},{"id":"line-31","k