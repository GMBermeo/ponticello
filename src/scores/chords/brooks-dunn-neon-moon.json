{"version":1,"id":"brooks-dunn-neon-moon","title":"Neon Moon","artist":"Brooks & Dunn","key":"A","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/brooks-e-dunn-musicas/neon-moon/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ronnie Dunn","chords":[{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"    When the sun goes down on my side of town,","columns":46,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"A","column":15,"beat":2}]},{"id":"line-2","kind":"lyric","text":"    that lonesome feeling comes to my door,","columns":43,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"    and the whole world turns blue.","columns":35,"beats":4,"changes":[{"symbol":"D","column":14,"beat":0},{"symbol":"A","column":32,"beat":2}]},{"id":"line-4","kind":"lyric","text":"    There's a run down bar across the railroad tracks,","columns":54,"beats":4,"changes":[{"symbol":"A","column":15,"beat":0}]},{"id":"line-5","kind":"lyric","text":"    I got a table for two way in the back,","columns":42,"beats":4,"changes":[]},{"id":"line-6","kind":"lyric","text":"    where I sit alone and think of losin' you.","columns":46,"beats":4,"changes":[{"symbol":"D","column":9,"beat":0},{"symbol":"A","column":36,"beat":2}]},{"id":"line-7","kind":"lyric","text":"    I spend most every night beneath the light of a neon moon. Now...","columns":69,"beats":4,"changes":[{"symbol":"E","column":17,"beat":0},{"symbol":"A","column":53,"beat":2}]},{"id":"line-8","kind":"lyric","text":"If you lose your one and only,","columns":30,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"E","column":26,"beat":2}]},{"id":"line-9","kind":"lyric","text":"there's always room here for the lonely,","columns":40,"beats":4,"changes":[{"symbol":"D","column":17,"beat":0},{"symbol":"E","column":33,"beat":2}]},{"id":"line-10","kind":"lyric","text":"go watch your broken dreams,","columns":28,"beats":4,"changes":[{"symbol":"D","column":15,"beat":0}]},{"id":"line-11","kind":"lyric","text":"dance in and out of the beams of a neon moon.","columns":45,"beats":4,"changes":[{"symbol":"E","column":14,"beat":0},{"symbol":"A","column":36,"beat":2}]},{"id":"line-12","kind":"lyric","text":"    I think of two young lovers runnin' wild and free,","columns":54,"beats":4,"changes":[{"symbol":"A","column":16,"beat":0}]},{"id":"line-13","kind":"lyric","text":"    I close my eyes and sometimes see,","columns":38,"beats":4,"changes":[]},{"id":"line-14","kind":"lyric","text":"    you in the shadows of this smoke-filled room.","columns":49,"beats":4,"changes":[{"symbol":"D","column":5,"beat":0},{"symbol":"A","column":33,"beat":2}]},{"id":"line-15","kind":"lyric","text":"    No tellin' how many tears I've sat here and cried,","columns":54,"beats":4,"changes":[{"symbol":"A","column":16,"beat":0}]},{"id":"line-16","kind":"lyric","text":"    or how many lies that I've lied,","columns":36,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"    tellin' my poor heart, she'll come back some day.","columns":53,"beats":4,"changes":[{"symbol":"D","column":13,"beat":0},{"symbol":"A","column":40,"beat":2}]},{"id":"line-18","kind":"lyric","text":"  Oh! But I'll be all right,as long as there's light from a neon moon. Oh…","columns":74,"beats":4,"changes":[{"symbol":"E","column":15,"beat":0},{"symbol":"E","column":61,"beat":2}]},{"id":"line-19","kind":"lyric","text":"If you lose your one and only,","columns":30,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"E","column":26,"beat":2}]},{"id":"line-20","kind":"lyric","text":"there's always room here for the lonely,","columns":40,"beats":4,"changes":[{"symbol":"D","column":17,"beat":0},{"symbol":"E","column":33,"beat":2}]},{"id":"line-21","kind":"lyric","text":"go watch your broken dreams,","columns":28,"beats":4,"changes":[{"symbol":"D","column":15,"beat":0}]},{"id":"line-22","kind":"lyric","text":"dance in and out of the beams of a neon moon.","columns":50,"beats":5,"changes":[{"symbol":"E","column":14,"beat":0},{"symbol":"A","column":36,"beat":1},{"symbol":"A","column":45,"beat":2},{"symbol":"D","column":47,"beat":3},{"symbol":"A","column":49,"beat":4}]},{"id":"line-23","kind":"lyric","text":"    The jukebox plays on, drink by drink,","columns":41,"beats":4,"changes":[{"symbol":"A","column":9,"beat":0}]},{"id":"line-24","kind":"lyric","text":"    and the words of every sad song seem to say what I think,","columns":61,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"    this hurtin' inside of me ain't never gonna end.","columns":52,"beats":4,"changes":[{"symbol":"D","column":10,"beat":0},{"symbol":"A","column":43,"beat":2}]},{"id":"line-26","kind":"lyric","text":"  Oh! But I'll be all right as long as there's light from a neon moon. Oh…","columns":74,"beats":4,"changes":[{"symbol":"E","column":16,"beat":0},{"symbol":"A","column":62,"beat":2}]},{"id":"line-27","kind":"lyric","text":"If you lose your one and only,","columns":30,"beats":4,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"E","column":26,"beat":2}]},{"id":"line-28","kind":"lyric","text":"there's always room here for the lonely,","columns":40,"beats":4,"changes":[{"symbol":"D","column":17,"beat":0},{"symbol":"E","column":33,"beat":2}]},{"id":"line-29","kind":"lyric","text":"go watch your broken dreams,","columns":28,"beats":4,"changes":[{"symbol":"D","column":15,"beat":0}]},{"id":"line-30","kind":"lyric","text":"dance in and out of the beams of a neon moon.","columns":45,"beats":4,"changes":[{"symbol":"E","column":14,"beat":0},{"symbol":"A","column":36,"beat":2}]},{"id":"line-31","kind":"lyric","text":"    Watch your broken dreams,","columns":29,"beats":4,"changes":[{"symbol":"D","column":17,"beat":0}]},{"id":"line-32","kind":"lyric","text":"    dance in and out of the beams of a neon moon.","columns":49,"beats":4,"changes":[{"symbol":"E","column":18,"beat":0},{"symbol":"A","column":40,"beat":2}]},{"id":"line-33","kind":"lyric","text":"    Oh, watch your broken dreams,","columns":33,"beats":4,"changes":[{"symbol":"D","column":21,"beat":0}]},{"id":"line-34","kind":"lyric","text":"    dance in and out of the beams of a neon moon.","columns":50,"beats":6,"changes":[{"symbol":"E","column":18,"beat":0},{"symbol":"A","column":40,"beat":2},{"symbol":"A","column":49,"beat":4}]}]}