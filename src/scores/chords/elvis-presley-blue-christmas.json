{"version":1,"id":"elvis-presley-blue-christmas","title":"Blue Christmas","artist":"Elvis Presley","key":"E","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/elvis-presley/blue-christmas/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Jay W Johnson and Billy Hayes","chords":[{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"B7","canonical":"B7","keyboardPitchClasses":[11,3,6,9],"interpretation":null},{"symbol":"E7","canonical":"E7","keyboardPitchClasses":[4,8,11,2],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"A7","canonical":"A7","keyboardPitchClasses":[9,1,4,7],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"Bb°","canonical":"Bbdim7","keyboardPitchClasses":[10,1,4,7],"interpretation":"Keyboard interpretation: Bbdim7"}],"lines":[{"id":"line-1","kind":"lyric","text":"I'll have a Blue Christmas without you","columns":38,"beats":4,"changes":[{"symbol":"E","column":13,"beat":0},{"symbol":"B7","column":31,"beat":2}]},{"id":"line-2","kind":"lyric","text":"I'll be so blue just thinking about you","columns":39,"beats":4,"changes":[{"symbol":"E","column":32,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Decorations of red on a green Christmas tree","columns":44,"beats":6,"changes":[{"symbol":"E7","column":16,"beat":0},{"symbol":"A","column":26,"beat":2},{"symbol":"A7","column":41,"beat":4}]},{"id":"line-4","kind":"lyric","text":"Won't be the same dear, if you're not here with me","columns":50,"beats":4,"changes":[{"symbol":"F#","column":2,"beat":0},{"symbol":"B7","column":26,"beat":2}]},{"id":"line-5","kind":"lyric","text":"And when those blue snowflakes start falling","columns":44,"beats":4,"changes":[{"symbol":"E","column":16,"beat":0},{"symbol":"B7","column":38,"beat":2}]},{"id":"line-6","kind":"lyric","text":"That's when those blue memories start calling","columns":45,"beats":4,"changes":[{"symbol":"E","column":39,"beat":0}]},{"id":"line-7","kind":"lyric","text":"You'll be doin' all right with your Christmas of withe","columns":54,"beats":6,"changes":[{"symbol":"E7","column":19,"beat":0},{"symbol":"A","column":39,"beat":2},{"symbol":"Bb°","column":51,"beat":4}]},{"id":"line-8","kind":"lyric","text":"But I'll have a blue, blue, blue Christmas","columns":42,"beats":4,"changes":[{"symbol":"B7","column":3,"beat":0},{"symbol":"E","column":34,"beat":1}]}]}