{"version":1,"id":"post-malone-hollywood-s-bleeding","title":"Hollywood's Bleeding","artist":"Post Malone","key":"Em","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/post-malone/hollywoods-bleeding/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Lu Balz, Brian Dong Ho Lee, Billy Walsh and Post Malone","chords":[{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":20,"beats":8,"changes":[{"symbol":"Em","column":8,"beat":0},{"symbol":"D","column":12,"beat":2},{"symbol":"C","column":15,"beat":4},{"symbol":"Am","column":18,"beat":6}]},{"id":"line-2","kind":"lyric","text":"Hollywood's bleeding, vampires feedin'","columns":38,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":23,"beat":2}]},{"id":"line-3","kind":"lyric","text":"Darkness turns to dust","columns":24,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":22,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Everyone's gone but no one's leavin'","columns":36,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":21,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Nobody left but us","columns":20,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":18,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Tryna chase a feelin', but we never feel it","columns":43,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":24,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Ridin' on our last train home","columns":31,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":29,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Dyin' in our sleep, we're living out the dream","columns":46,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":20,"beat":2}]},{"id":"line-9","kind":"lyric","text":"We only make it out alone","columns":26,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":24,"beat":2}]},{"id":"line-10","kind":"lyric","text":"I just keep on hopin' that you call me","columns":38,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"D","column":31,"beat":2}]},{"id":"line-11","kind":"lyric","text":"You say you wanna' see me, but you can't right now","columns":50,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":34,"beat":2}]},{"id":"line-12","kind":"lyric","text":"You never took the time to get to know me","columns":41,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"D","column":34,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Was scared of losin' something that we never found","columns":50,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":45,"beat":2}]},{"id":"line-14","kind":"lyric","text":"We're running out of reasons, but we can't let go","columns":55,"beats":10,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"D","column":30,"beat":2},{"symbol":"Em","column":47,"beat":4},{"symbol":"F#m","column":50,"beat":6},{"symbol":"G","column":54,"beat":8}]},{"id":"line-15","kind":"lyric","text":"Yeah, Hollywood is bleeding, but we call it home","columns":48,"beats":6,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"D","column":29,"beat":2},{"symbol":"Em","column":46,"beat":4}]},{"id":"line-16","kind":"lyric","text":"Outside the winter sky turnin' grey","columns":35,"beats":6,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":20,"beat":2},{"symbol":"C","column":31,"beat":4}]},{"id":"line-17","kind":"lyric","text":"City up in smoke, it's only ash when it rains","columns":45,"beats":4,"changes":[{"symbol":"Am","column":28,"beat":0},{"symbol":"Em","column":32,"beat":2}]},{"id":"line-18","kind":"lyric","text":"Howl at the Moon and go to sleep in the day","columns":43,"beats":4,"changes":[{"symbol":"D","column":12,"beat":0},{"symbol":"C","column":40,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Love for everybody 'til the drugs fade away","columns":43,"beats":4,"changes":[{"symbol":"Am","column":12,"beat":0},{"symbol":"Em","column":37,"beat":2}]},{"id":"line-20","kind":"lyric","text":"In the mornin', blocking out the Sun with the shades","columns":52,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0},{"symbol":"C","column":46,"beat":2}]},{"id":"line-21","kind":"lyric","text":"She gotta' check her pulse and tell herself that she okay","columns":57,"beats":4,"changes":[{"symbol":"Am","column":21,"beat":0},{"symbol":"Em","column":53,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Seem like dying young is an honour","columns":35,"beats":4,"changes":[{"symbol":"D","column":16,"beat":0},{"symbol":"C","column":34,"beat":2}]},{"id":"line-23","kind":"lyric","text":"But who be at my funeral? How I wonder","columns":38,"beats":4,"changes":[{"symbol":"Am","column":22,"beat":0}]},{"id":"line-24","kind":"lyric","text":"I go out, and all the eyes on me","columns":32,"beats":8,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":31,"beat":4}]},{"id":"line-25","kind":"lyric","text":"I show out, do you like what you see?","columns":37,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":23,"beat":2}]},{"id":"line-26","kind":"lyric","text":"Hey now, they closin' in on me","columns":30,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"D","column":22,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Let them sharpen all they teeth","columns":31,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":27,"beat":2}]},{"id":"line-28","kind":"lyric","text":"This is more than I can handle","columns":30,"beats":4,"changes":[{"symbol":"C","column":24,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Blood in my Lambo'","columns":18,"beats":4,"changes":[{"symbol":"D","column":13,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Wish I could go, uh, I'm losin' hope, uh","columns":40,"beats":4,"changes":[{"symbol":"Em","column":13,"beat":0},{"symbol":"G","column":38,"beat":2}]},{"id":"line-31","kind":"lyric","text":"I light a candle, some Palo Santo","columns":33,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"D","column":28,"beat":2}]},{"id":"line-32","kind":"lyric","text":"For all these demons, wish I could just go on","columns":45,"beats":4,"changes":[{"symbol":"Em","column":8,"beat":0},{"symbol":"D","column":37,"beat":2}]},{"id":"line-33","kind":"lyric","text":"I just keep on hopin' that you call me","columns":38,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"D","column":31,"beat":2}]},{"id":"line-34","kind":"lyric","text":"You say you wanna see me, but you can't right now","columns":49,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":34,"beat":2}]},{"id":"line-35","kind":"lyric","text":"You never took the time to get to know me","columns":41,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"D","column":34,"beat":2}]},{"id":"line-36","kind":"lyric","text":"Was scared of losin' something that we never found","columns":50,"beats":4,"changes":[{"symbol":"Em","column":4,"beat":0},{"symbol":"D","column":46,"beat":2}]},{"id":"line-37","kind":"lyric","text":"We're running out of reasons but we can't let go","columns":55,"beats":8,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"D","column":21,"beat":2},{"symbol":"Em","column":46,"beat":4},{"symbol":"F#m","column":50,"beat":6},{"symbol":"G","column":54,"beat":7}]},{"id":"line-38","kind":"lyric","text":"Yeah, Hollywood is bleeding, but we call it home","columns":48,"beats":6,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"D","column":19,"beat":2},{"symbol":"Em","column":44,"beat":4}]}]}