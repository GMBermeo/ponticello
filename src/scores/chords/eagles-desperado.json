{"version":1,"id":"eagles-desperado","title":"Desperado","artist":"Eagles","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/the-eagles/desperado/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Don Henley and Glenn Frey","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"G7","canonical":"G7","keyboardPitchClasses":[7,11,2,5],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"Em7","canonical":"Em7","keyboardPitchClasses":[4,7,11,2],"interpretation":null},{"symbol":"A7","canonical":"A7","keyboardPitchClasses":[9,1,4,7],"interpretation":null},{"symbol":"D7","canonical":"D7","keyboardPitchClasses":[2,6,9,0],"interpretation":null},{"symbol":"B7","canonical":"B7","keyboardPitchClasses":[11,3,6,9],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"Am7","canonical":"Am7","keyboardPitchClasses":[9,0,4,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Desperado, why don't you come to your senses ?","columns":46,"beats":8,"changes":[{"symbol":"G","column":6,"beat":0},{"symbol":"G7","column":9,"beat":2},{"symbol":"C","column":25,"beat":4},{"symbol":"Cm","column":40,"beat":6}]},{"id":"line-2","kind":"lyric","text":"You been out ridin' fences for so long now","columns":43,"beats":8,"changes":[{"symbol":"G","column":9,"beat":0},{"symbol":"Em7","column":22,"beat":2},{"symbol":"A7","column":31,"beat":4},{"symbol":"D7","column":41,"beat":6}]},{"id":"line-3","kind":"lyric","text":"Oh, you're a hard one, I know that you got your reasons,","columns":56,"beats":8,"changes":[{"symbol":"G","column":13,"beat":0},{"symbol":"G7","column":21,"beat":2},{"symbol":"C","column":35,"beat":4},{"symbol":"Cm","column":51,"beat":6}]},{"id":"line-4","kind":"lyric","text":"These things that are pleasin' you can hurt you somehow","columns":56,"beats":12,"changes":[{"symbol":"G","column":6,"beat":0},{"symbol":"B7","column":18,"beat":2},{"symbol":"Em7","column":25,"beat":4},{"symbol":"A7","column":39,"beat":6},{"symbol":"D7","column":48,"beat":8},{"symbol":"G","column":55,"beat":10}]},{"id":"line-5","kind":"lyric","text":"Don't you draw the queen of diamonds boy,","columns":41,"beats":6,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Em","column":10,"beat":2},{"symbol":"Bm","column":28,"beat":4}]},{"id":"line-6","kind":"lyric","text":"She'll beat you if she's able,","columns":30,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-7","kind":"lyric","text":"You know the queen of hearts is always your best bet","columns":54,"beats":8,"changes":[{"symbol":"Em7","column":13,"beat":0},{"symbol":"C","column":32,"beat":2},{"symbol":"G","column":49,"beat":4},{"symbol":"D","column":53,"beat":6}]},{"id":"line-8","kind":"lyric","text":"Now it seems to me some fine things have been laid upon your table","columns":66,"beats":8,"changes":[{"symbol":"Em","column":7,"beat":0},{"symbol":"Bm","column":24,"beat":2},{"symbol":"C","column":46,"beat":4},{"symbol":"G","column":61,"beat":6}]},{"id":"line-9","kind":"lyric","text":"But you only want the ones you can't get","columns":40,"beats":6,"changes":[{"symbol":"Em","column":8,"beat":0},{"symbol":"A7","column":22,"beat":2},{"symbol":"Am7","column":37,"beat":4}]},{"id":"line-10","kind":"lyric","text":"Desperado, oh you ain't gettin' no younger,","columns":43,"beats":12,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"D7","column":2,"beat":2},{"symbol":"G","column":6,"beat":4},{"symbol":"G7","column":9,"beat":6},{"symbol":"C","column":24,"beat":8},{"symbol":"Cm","column":38,"beat":10}]},{"id":"line-11","kind":"lyric","text":"Your pain and your hunger, they're drivin' you home","columns":51,"beats":8,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"Em7","column":21,"beat":2},{"symbol":"A7","column":35,"beat":4},{"symbol":"D7","column":47,"beat":6}]},{"id":"line-12","kind":"lyric","text":"And freedom, oh freedom, well, that's just some people talkin'","columns":62,"beats":8,"changes":[{"symbol":"G","column":4,"beat":0},{"symbol":"G7","column":11,"beat":2},{"symbol":"C","column":31,"beat":4},{"symbol":"Cm","column":45,"beat":6}]},{"id":"line-13","kind":"lyric","text":"Your prison is walkin' through this world all alone","columns":54,"beats":12,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"B7","column":12,"beat":2},{"symbol":"Em7","column":17,"beat":4},{"symbol":"A7","column":36,"beat":6},{"symbol":"D7","column":46,"beat":8},{"symbol":"G","column":53,"beat":10}]},{"id":"line-14","kind":"lyric","text":"Don't your feet get cold in the winter time ?","columns":45,"beats":6,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Em","column":11,"beat":2},{"symbol":"Bm","column":32,"beat":4}]},{"id":"line-15","kind":"lyric","text":"The sky won't snow and the sun won't shine","columns":42,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"G","column":23,"beat":2}]},{"id":"line-16","kind":"lyric","text":"It's hard to tell the night time from the day","columns":48,"beats":8,"changes":[{"symbol":"Em7","column":5,"beat":0},{"symbol":"C","column":22,"beat":2},{"symbol":"G","column":42,"beat":4},{"symbol":"D","column":47,"beat":6}]},{"id":"line-17","kind":"lyric","text":"You're losin' all your highs and lows","columns":37,"beats":4,"changes":[{"symbol":"Em","column":7,"beat":0},{"symbol":"Bm","column":23,"beat":2}]},{"id":"line-18","kind":"lyric","text":"Ain't it funny how the feelin' goes away","columns":40,"beats":6,"changes":[{"symbol":"C","column":9,"beat":0},{"symbol":"G","column":23,"beat":2},{"symbol":"Am7","column":37,"beat":4}]},{"id":"line-19","kind":"lyric","text":"Desperado, why don't you come to your senses","columns":44,"beats":12,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"D7","column":3,"beat":2},{"symbol":"G","column":6,"beat":4},{"symbol":"G7","column":9,"beat":6},{"symbol":"C","column":25,"beat":8},{"symbol":"Cm","column":40,"beat":10}]},{"id":"line-20","kind":"lyric","text":"Come down from your fences, open the gate","columns":41,"beats":14,"changes":[{"symbol":"G","column":5,"beat":0},{"symbol":"D","column":15,"beat":2},{"symbol":"Em","column":22,"beat":4},{"symbol":"A7","column":26,"beat":6},{"symbol":"D7","column":37,"beat":8}]},{"id":"line-21","kind":"lyric","text":"It may be rainin',  but there's a rainbow above you","columns":51,"beats":8,"changes":[{"symbol":"G","column":10,"beat":0},{"symbol":"G7","column":17,"beat":2},{"symbol":"C","column":34,"beat":4},{"symbol":"Cm","column":46,"beat":6}]},{"id":"line-22","kind":"lyric","text":"You better let somebody love you,","columns":44,"beats":12,"changes":[{"symbol":"G","column":11,"beat":0},{"symbol":"B7","column":19,"beat":2},{"symbol":"Em","column":24,"beat":4},{"symbol":"C","column":35,"beat":6},{"symbol":"G","column":38,"beat":8},{"symbol":"Am7","column":41,"beat":10}]},{"id":"line-23","kind":"lyric","text":"You better let somebody love you before it's too late","columns":53,"beats":12,"changes":[{"symbol":"G","column":11,"beat":0},{"symbol":"B7","column":19,"beat":2},{"symbol":"Em","column":24,"beat":4},{"symbol":"Am7","column":35,"beat":6},{"symbol":"D7","column":45,"beat":8},{"symbol":"G","column":49,"beat":10}]}]}