{"version":1,"id":"benson-boone-slow-it-down","title":"Slow It Down","artist":"Benson Boone","key":"Db","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/benson-boone/slow-it-down/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Jason Evigan, Connor McDonough, Riley McDonough, Benson Boone and Jackson Lafrantz Larsen","chords":[{"symbol":"Db","canonical":"Db","keyboardPitchClasses":[1,5,8],"interpretation":null},{"symbol":"Ab","canonical":"Ab","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"Ab7M","canonical":"Abmaj7","keyboardPitchClasses":[8,0,3,7],"interpretation":"Keyboard interpretation: Abmaj7"},{"symbol":"Db6","canonical":"Db6","keyboardPitchClasses":[1,5,8,10],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"Eb","canonical":"Eb","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"Bbm","canonical":"Bbm","keyboardPitchClasses":[10,1,5],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"I'd never met you, but I wanted","columns":31,"beats":4,"changes":[{"symbol":"Db","column":10,"beat":0}]},{"id":"line-2","kind":"lyric","text":"To invite you to the party","columns":26,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"Then you walked in with those green eyes","columns":40,"beats":6,"changes":[{"symbol":"Ab","column":9,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Never stolen by nobody","columns":22,"beats":4,"changes":[{"symbol":"Ab7M","column":10,"beat":0}]},{"id":"line-5","kind":"lyric","text":"And they flicker to the future","columns":30,"beats":6,"changes":[{"symbol":"Db","column":9,"beat":0}]},{"id":"line-6","kind":"lyric","text":"For a moment, I could picture","columns":29,"beats":4,"changes":[]},{"id":"line-7","kind":"lyric","text":"Then you touch me and I come back","columns":33,"beats":2,"changes":[{"symbol":"Ab","column":9,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And we're talkin' on the staircase","columns":34,"beats":4,"changes":[{"symbol":"Ab7M","column":12,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Bout your big dreams on the big screens","columns":39,"beats":6,"changes":[{"symbol":"Db","column":10,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Out of Georgia, now you're lonely in this city","columns":46,"beats":4,"changes":[{"symbol":"Db6","column":8,"beat":0},{"symbol":"Ab","column":42,"beat":2}]},{"id":"line-11","kind":"lyric","text":"Lyin' with me","columns":13,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"And you're scared it's movin' quickly","columns":37,"beats":4,"changes":[{"symbol":"Ab7M","column":12,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Oh, now you're cryin', you're in pieces","columns":39,"beats":4,"changes":[{"symbol":"Db","column":15,"beat":0}]},{"id":"line-14","kind":"lyric","text":"'Cause the only love you've ever known is Jesus","columns":47,"beats":4,"changes":[{"symbol":"Db6","column":13,"beat":0},{"symbol":"Ab","column":43,"beat":2}]},{"id":"line-15","kind":"lyric","text":"I can feel it","columns":13,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"Oh, I hate that I'm the reason that you're","columns":42,"beats":4,"changes":[{"symbol":"Ab7M","column":5,"beat":0}]},{"id":"line-17","kind":"lyric","text":"In your head right now","columns":22,"beats":10,"changes":[{"symbol":"Fm","column":0,"beat":0},{"symbol":"Eb","column":4,"beat":2},{"symbol":"Ab","column":8,"beat":4},{"symbol":"Eb","column":13,"beat":6},{"symbol":"Db","column":19,"beat":8}]},{"id":"line-18","kind":"lyric","text":"While your world is  spinnin' out","columns":33,"beats":10,"changes":[{"symbol":"Fm","column":11,"beat":0},{"symbol":"Eb","column":17,"beat":2},{"symbol":"Ab","column":20,"beat":4},{"symbol":"Eb","column":24,"beat":6},{"symbol":"Db","column":30,"beat":8}]},{"id":"line-19","kind":"lyric","text":"So slow it down, take a moment now","columns":34,"beats":8,"changes":[{"symbol":"Db","column":3,"beat":0},{"symbol":"Db6","column":26,"beat":4}]},{"id":"line-20","kind":"lyric","text":"We're too young to drown","columns":24,"beats":4,"changes":[{"symbol":"Ab","column":10,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Deep in dirty waters","columns":20,"beats":4,"changes":[{"symbol":"Ab7M","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Full of hopeless doubt, let me pull you out","columns":43,"beats":4,"changes":[{"symbol":"Db","column":8,"beat":0},{"symbol":"Db6","column":32,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Let me hold you now","columns":19,"beats":4,"changes":[{"symbol":"Ab","column":7,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Let me slow it down","columns":19,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"Ain't it funny how it changes?","columns":30,"beats":4,"changes":[{"symbol":"Db","column":9,"beat":0}]},{"id":"line-26","kind":"lyric","text":"How the future rearranges","columns":25,"beats":4,"changes":[{"symbol":"Db6","column":9,"beat":0}]},{"id":"line-27","kind":"lyric","text":"I get nervous, oh, I'm anxious","columns":30,"beats":4,"changes":[{"symbol":"Ab","column":6,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Maybe lovin' you is dangerous","columns":29,"beats":4,"changes":[{"symbol":"Ab7M","column":7,"beat":0}]},{"id":"line-29","kind":"lyric","text":"I could lose you like the others","columns":32,"beats":4,"changes":[{"symbol":"Db","column":8,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Only girl that's never left me is my mother","columns":43,"beats":4,"changes":[{"symbol":"Db6","column":6,"beat":0},{"symbol":"Ab","column":37,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Oh, I love her","columns":14,"beats":4,"changes":[]},{"id":"line-32","kind":"lyric","text":"And I know you'll probably hate it, but I'm","columns":43,"beats":4,"changes":[{"symbol":"Ab7M","column":7,"beat":0}]},{"id":"lin