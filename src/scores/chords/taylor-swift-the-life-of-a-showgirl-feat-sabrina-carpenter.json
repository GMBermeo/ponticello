ts":4,"changes":[{"symbol":"Am7","column":16,"beat":0},{"symbol":"F9","column":27,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Then she said to mе","columns":19,"beats":4,"changes":[{"symbol":"D4","column":5,"beat":0}]},{"id":"line-17","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"\"Hey, thank you for the lovely bouquet","columns":38,"beats":4,"changes":[{"symbol":"G/B","column":4,"beat":0},{"symbol":"Am7","column":34,"beat":2}]},{"id":"line-19","kind":"lyric","text":"You're sweeter than a peach","columns":27,"beats":4,"changes":[{"symbol":"F9","column":7,"beat":0}]},{"id":"line-20","kind":"lyric","text":"But you don’t know the life of a showgirl, babe","columns":47,"beats":6,"changes":[{"symbol":"G/B","column":4,"beat":0},{"symbol":"Em7","column":23,"beat":2},{"symbol":"F9","column":41,"beat":4}]},{"id":"line-21","kind":"lyric","text":"And you're never, ever gonna","columns":28,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Wait, the more you play the more that you pay","columns":45,"beats":4,"changes":[{"symbol":"G/B","column":4,"beat":0},{"symbol":"Am7","column":40,"beat":2}]},{"id":"line-23","kind":"lyric","text":"You're softer than a kitten so","columns":30,"beats":4,"changes":[{"symbol":"F9","column":7,"beat":0}]},{"id":"line-24","kind":"lyric","text":"You don’t know the life of a showgirl, babe","columns":43,"beats":6,"changes":[{"symbol":"G/B","column":0,"beat":0},{"symbol":"Em7","column":19,"beat":2},{"symbol":"F9","column":37,"beat":4}]},{"id":"line-25","kind":"lyric","text":"And you're never gonna wanna\"","columns":29,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0}]},{"id":"line-26","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-27","kind":"lyric","text":"She was a menace","columns":16,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0}]},{"id":"line-28","kind":"lyric","text":"T