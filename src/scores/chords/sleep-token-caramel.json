{"version":1,"id":"sleep-token-caramel","title":"Caramel","artist":"Sleep Token","key":"Db","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/sleep-token/caramel/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Leo Faulkner and Adam Pedder","chords":[{"symbol":"C#7M","canonical":"C#maj7","keyboardPitchClasses":[1,5,8,0],"interpretation":"Keyboard interpretation: C#maj7"},{"symbol":"A#m","canonical":"A#m","keyboardPitchClasses":[10,1,5],"interpretation":null},{"symbol":"Fm","canonical":"Fm","keyboardPitchClasses":[5,8,0],"interpretation":null},{"symbol":"Cm/G","canonical":"Cm/G","keyboardPitchClasses":[7,0,3],"interpretation":null},{"symbol":"D#4/A#","canonical":"D#sus4/A#","keyboardPitchClasses":[10,3,8],"interpretation":"Keyboard interpretation: D#sus4/A#"},{"symbol":"C#/G#","canonical":"C#/G#","keyboardPitchClasses":[8,1,5],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"C#9","canonical":"C#add9","keyboardPitchClasses":[1,3,5],"interpretation":"Keyboard interpretation: C#add9"},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Count me out like sovereigns","columns":28,"beats":4,"changes":[{"symbol":"C#7M","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Payback for the good times","columns":26,"beats":4,"changes":[{"symbol":"A#m","column":19,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Right foot in the roses","columns":23,"beats":4,"changes":[{"symbol":"Fm","column":18,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Left foot on a landmine","columns":23,"beats":4,"changes":[{"symbol":"Cm/G","column":17,"beat":0}]},{"id":"line-5","kind":"lyric","text":"I'm not gonna be there","columns":22,"beats":4,"changes":[{"symbol":"C#7M","column":17,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Tripping on the grapevine","columns":25,"beats":4,"changes":[{"symbol":"A#m","column":18,"beat":0}]},{"id":"line-7","kind":"lyric","text":"They can sing the words while I cry into the bassline","columns":53,"beats":4,"changes":[{"symbol":"D#4/A#","column":20,"beat":0},{"symbol":"C#/G#","column":45,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Wear me out like Prada","columns":22,"beats":4,"changes":[{"symbol":"C#7M","column":18,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Devil in my detail","columns":18,"beats":4,"changes":[{"symbol":"A#m","column":14,"beat":0}]},{"id":"line-10","kind":"lyric","text":"I swear it's getting harder","columns":27,"beats":4,"changes":[{"symbol":"Fm","column":21,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Even just to exhale","columns":19,"beats":4,"changes":[{"symbol":"Cm/G","column":14,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Backed up into corners","columns":22,"beats":4,"changes":[{"symbol":"C#7M","column":16,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Bitter in the lens","columns":21,"beats":4,"changes":[{"symbol":"A#m","column":18,"beat":0}]},{"id":"line-14","kind":"lyric","text":"I'm sick of tryna hide it every time they take mine","columns":51,"beats":4,"changes":[{"symbol":"D#4/A#","column":18,"beat":0},{"symbol":"C#/G#","column":44,"beat":2}]},{"id":"line-15","kind":"section","text":"[Refrão - versão 1]","columns":19,"beats":0,"changes":[]},{"id":"line-16","kind":"lyric","text":"So stick to me","columns":14,"beats":4,"changes":[{"symbol":"A#m","column":4,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Stick to me like caramel","columns":31,"beats":4,"changes":[{"symbol":"Fm","column":17,"beat":0},{"symbol":"D#4/A#","column":25,"beat":2}]},{"id":"line-18","kind":"lyric","text":"Walk beside me","columns":14,"beats":4,"changes":[{"symbol":"A#m","column":1,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Till you feel nothing as well","columns":34,"beats":6,"changes":[{"symbol":"C#/G#","column":0,"beat":0},{"symbol":"Fm","column":20,"beat":2},{"symbol":"C#7M","column":30,"beat":4}]},{"id":"line-20","kind":"lyric","text":"They ask me","columns":16,"beats":4,"changes":[{"symbol":"C#7M","column":12,"beat":0}]},{"id":"line-21","kind":"lyric","text":"Is it going good in the garden?","columns":35,"beats":4,"changes":[{"symbol":"A#m","column":32,"beat":0}]},{"id":"line-22","kind":"lyric","text":"Say: I'm lost, but I beg no pardon","columns":37,"beats":4,"changes":[{"symbol":"Fm","column":35,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Up on the dice, but low on the cards","columns":40,"beats":4,"changes":[{"symbol":"Cm/G","column":36,"beat":0}]},{"id":"line-24","kind":"lyric","text":"I try not to talk about how it's harder now","columns":47,"beats":4,"changes":[{"symbol":"C#7M","column":43,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Can I get a mirror side-stage?","columns":30,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Looking sideways at my own visage, getting worse","columns":48,"beats":4,"changes":[{"symbol":"A#m","column":8,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Every time they try to shout my real name just to get a rise from me","columns":68,"beats":4,"changes":[{"symbol":"D#4/A#","column":8,"beat":0},{"symbol":"C#/G#","column":58,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Acting like I'm never stressed out by the hearsay","columns":55,"beats":4,"changes":[{"symbol":"C#7M","column":51,"beat":0}]},{"id":"line-29","kind":"lyric","text":"I guess that's what I get for tryna hide in the limelight","columns":57,"beats":4,"changes":[{"symbol":"A#m","column":22,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Guess that's what I get for having 20/20 hindsight","columns":50,"beats":4,"changes":[{"symbol":"Fm","column":21,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Everybody wants eyes on 'em","columns":27,"beats":4,"changes":[{"symbol":"Cm/G","column":12,"beat":0}]},{"id":"line-32","kind":"lyric","text":"I just wanna hear you sing that top line","columns":40,"beats":4,"changes":[{"symbol":"C#7M","column":34,"beat":0}]},{"id":"line-33","kind":"lyric","text":"And if you don't think I mean it, then I understand","columns":57,"beats":4,"changes":[{"symbol":"A#m","column":26,"beat":0},{"symbol":"D#4/A#","column":51,"beat":2}]},{"id":"line-34","kind":"lyric","text":"But I'm still glad you came, so let me see those hands","columns":54,"beats":4,"changes":[{"symbol":"C#/G#","column":26,"beat":0}]},{"id":"line-35","kind":"section","text":"[Refrão - versão 2]","columns":19,"beats":0,"changes":[]},{"id":"line-36","kind":"lyric","text":"So stick to me","columns":14,"beats":4,"changes":[{"symbol":"Fm","column":6,"beat":0}]},{"id":"line-37","kind":"lyric","text":"Stick to me like caramel","columns":24,"beats":4,"changes":[{"symbol":"C#7M","column":17,"beat":0}]},{"id":"line-38","kind":"lyric","text":"Walk beside me","columns":14,"beats":4,"changes":[{"symbol":"G#","column":0,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Till you feel nothing as well","columns":32,"beats":4,"changes":[{"symbol":"C#7M","column":14,"beat":0},{"symbol":"C#9","column":29,"beat":2}]},{"id":"line-40","kind":"lyric","text":"I'm falling free","columns":16,"beats":4,"changes":[{"symbol":"Fm","column":4,"beat":0}]},{"id":"line-41","kind":"lyric","text":"Of the final parallel","columns":21,"beats":4,"changes":[{"symbol":"C#7M","column":13,"beat":0}]},{"id":"line-42","kind":"lyric","text":"The sweetest dreams are bitter, but there's no one left to tell","columns":67,"beats":3,"changes":[{"symbol":"G#","column":6,"beat":0},{"symbol":"D#4/A#","column":45,"beat":1},{"symbol":"C#/G#","column":62,"beat":2}]},{"id":"line-43","kind":"lyric","text":"Too young to get bitter over it all","columns":43,"beats":6,"changes":[{"symbol":"C#7M","column":1,"beat":0},{"symbol":"G#","column":18,"beat":2},{"symbol":"D#4/A#","column":37,"beat":4}]},{"id":"line-44","kind":"lyric","text":"Too old to retaliate like before","columns":36,"beats":4,"changes":[{"symbol":"Cm/G","column":16,"beat":0},{"symbol":"C#7M","column":32,"beat":2}]},{"id":"line-45","kind":"lyric","text":"Too blessed to be caught ungrateful, I know","columns":49,"beats":4,"changes":[{"symbol":"G#","column":20,"beat":0},{"symbol":"D#4/A#","column":43,"beat":2}]},{"id":"line-46","kind":"lyric","text":"So I'll keep dancing along to the rhythm","columns":40,"beats":4,"changes":[{"symbol":"Fm","column":14,"beat":0},{"symbol":"C#7M","column":35,"beat":2}]},{"id":"line-47","kind":"lyric","text":"This stage is a prison (too young to get bitter)","columns":48,"beats":2,"changes":[{"symbol":"G#","column":19,"beat":0}]},{"id":"line-48","kind":"lyric","text":"A beautiful nightmare (over it all)","columns":35,"beats":4,"changes":[{"symbol":"D#4/A#","column":18,"beat":0}]},{"id":"line-49","kind":"lyric","text":"A war of attrition (too old to retaliate)","columns":41,"beats":2,"changes":[{"symbol":"Fm","column":16,"beat":0}]},{"id":"line-50","kind":"lyric","text":"I'll take what I'm given (like before)","columns":38,"beats":6,"changes":[{"symbol":"C#7M","column":19,"beat":0}]},{"id":"line-51","kind":"lyric","text":"The deepest incisions (too blessed to be called)","columns":48,"beats":2,"changes":[{"symbol":"G#","column":17,"beat":0}]},{"id":"line-52","kind":"lyric","text":"I thought I got better (ungrateful, I know)","columns":43,"beats":4,"changes":[{"symbol":"D#4/A#","column":18,"beat":0}]},{"id":"line-53","kind":"lyric","text":"But maybe I didn't","columns":21,"beats":4,"changes":[{"symbol":"C#7M","column":17,"beat":0}]},{"id":"line-54","kind":"section","text":"[Breakdown]","columns":11,"beats":0,"changes":[]},{"id":"line-55","kind":"instrumental","text":"","columns":7,"beats":4,"changes":[{"symbol":"G#","column":1,"beat":0},{"symbol":"Cm","column":5,"beat":2}]},{"id":"line-56","kind":"instrumental","text":"","columns":13,"beats":6,"changes":[{"symbol":"G#","column":1,"beat":0},{"symbol":"Fm","column":5,"beat":2},{"symbol":"C#7M","column":9,"beat":4}]},{"id":"line-57","kind":"lyric","text":"(In these days of days) Tell me, did I give you what you came for?","columns":66,"beats":4,"changes":[{"symbol":"A#m","column":10,"beat":0},{"symbol":"Fm","column":28,"beat":2}]},{"id":"line-58","kind":"lyric","text":"(I wish it all away) Terrified to answer my own front door","columns":58,"beats":4,"changes":[{"symbol":"D#4/A#","column":8,"beat":0},{"symbol":"Fm","column":25,"beat":2}]},{"id":"line-59","kind":"lyric","text":"(I thought things had changed) Missing my wings in a realm of angels","columns":68,"beats":4,"changes":[{"symbol":"C#7M","column":8,"beat":0},{"symbol":"Fm","column":33,"beat":2}]},{"id":"line-60","kind":"lyric","text":"(But everything's the same)","columns":27,"beats":4,"changes":[{"symbol":"D#4/A#","column":8,"beat":0}]},{"id":"line-61","kind":"lyric","text":"So I'll keep dancing along to the rhythm","columns":40,"beats":4,"changes":[{"symbol":"C#7M","column":36,"beat":0}]},{"id":"line-62","kind":"lyric","text":"This stage is a prison, a beautiful nightmare","columns":45,"beats":4,"changes":[{"symbol":"A#m","column":17,"beat":0},{"symbol":"Fm","column":38,"beat":2}]},{"id":"line-63","kind":"lyric","text":"A war of attrition, I'll take what I'm given","columns":44,"beats":4,"changes":[{"symbol":"Cm/G","column":11,"beat":0},{"symbol":"C#7M","column":39,"beat":2}]},{"id":"line-64","kind":"lyric","text":"The deepest incisions, I thought I got better","columns":46,"beats":4,"changes":[{"symbol":"G#","column":14,"beat":0},{"symbol":"D#4/A#","column":40,"beat":2}]},{"id":"line-65","kind":"lyric","text":"But maybe I didn't","columns":18,"beats":4,"changes":[{"symbol":"C#/G#","column":12,"beat":0}]}]}