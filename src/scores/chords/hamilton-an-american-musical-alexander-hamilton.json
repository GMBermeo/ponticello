{"version":1,"id":"hamilton-an-american-musical-alexander-hamilton","title":"Alexander Hamilton","artist":"Hamilton: An American Musical","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/hamilton/alexander-hamilton/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/0fzO6GT9SS80IuZZCwq3RZ","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Lin-Manuel Miranda","chords":[{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"Bb°","canonical":"Bbdim7","keyboardPitchClasses":[10,1,4,7],"interpretation":"Keyboard interpretation: Bbdim7"},{"symbol":"F#4","canonical":"F#sus4","keyboardPitchClasses":[6,11,1],"interpretation":"Keyboard interpretation: F#sus4"},{"symbol":"G7","canonical":"G7","keyboardPitchClasses":[7,11,2,5],"interpretation":null},{"symbol":"Em9","canonical":"Em9","keyboardPitchClasses":[4,6,7,11],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"Bm/F#","canonical":"Bm/F#","keyboardPitchClasses":[6,11,2],"interpretation":null},{"symbol":"Em/G","canonical":"Em/G","keyboardPitchClasses":[7,11,4],"interpretation":null},{"symbol":"D/A","canonical":"D/A","keyboardPitchClasses":[9,2,6],"interpretation":null},{"symbol":"F#7/A#","canonical":"F#7/A#","keyboardPitchClasses":[10,1,4,6],"interpretation":null},{"symbol":"Bm/C#","canonical":"Bm/C#","keyboardPitchClasses":[],"interpretation":null},{"symbol":"Bm/D","canonical":"Bm/D","keyboardPitchClasses":[2,6,11],"interpretation":null},{"symbol":"Em/C#","canonical":"Em/C#","keyboardPitchClasses":[],"interpretation":null},{"symbol":"Bm9/F#","canonical":"Bm9/F#","keyboardPitchClasses":[6,11,1,2],"interpretation":null},{"symbol":"Em6/F#","canonical":"Em6/F#","keyboardPitchClasses":[],"interpretation":null},{"symbol":"F#7","canonical":"F#7","keyboardPitchClasses":[6,10,1,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"How does a bastard, orphan, son of a whore and a","columns":48,"beats":4,"changes":[{"symbol":"Bm","column":12,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Scotsman, dropped in the middle of a","columns":36,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Forgotten spot in the Caribbean by providence","columns":45,"beats":6,"changes":[{"symbol":"G","column":11,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Impoverished, in squalor","columns":24,"beats":4,"changes":[{"symbol":"D","column":19,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Grow up to be a hero and a scholar?","columns":35,"beats":2,"changes":[{"symbol":"Bb°","column":16,"beat":0}]},{"id":"line-6","kind":"lyric","text":"The ten-dollar founding father without a father","columns":47,"beats":4,"changes":[{"symbol":"Bm","column":5,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Got a lot farther by working a lot harder","columns":41,"beats":2,"changes":[{"symbol":"F#","column":7,"beat":0}]},{"id":"line-8","kind":"lyric","text":"By being a lot smarter","columns":22,"beats":4,"changes":[{"symbol":"G","column":12,"beat":0}]},{"id":"line-9","kind":"lyric","text":"By being a self-starter","columns":23,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"By fourteen, they placed him in charge of a trading charter","columns":59,"beats":4,"changes":[{"symbol":"D","column":6,"beat":0},{"symbol":"Bb°","column":33,"beat":2}]},{"id":"line-11","kind":"lyric","text":"And every day while slaves were being slaughtered and carted","columns":60,"beats":4,"changes":[{"symbol":"Bm","column":5,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Away across the waves, he struggled and kept his guard up","columns":57,"beats":4,"changes":[{"symbol":"F#","column":1,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Inside he was longing for something to be a part of","columns":51,"beats":4,"changes":[{"symbol":"G","column":2,"beat":0}]},{"id":"line-14","kind":"lyric","text":"The brother was ready to beg, steal, borrow, or barter","columns":54,"beats":4,"changes":[{"symbol":"D","column":5,"beat":0},{"symbol":"Bb°","column":31,"beat":2}]},{"id":"line-15","kind":"lyric","text":"Then a hurricane came, and devastation reigned","columns":46,"beats":2,"changes":[{"symbol":"Bm","column":8,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Our man saw his future drip, dripping down the drain","columns":52,"beats":4,"changes":[{"symbol":"F#","column":5,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Put a pencil to his temple, connected it to his brain","columns":53,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0}]},{"id":"line-18","kind":"lyric","text":"And he wrote his first refrain, a testament to his pain","columns":55,"beats":6,"changes":[{"symbol":"D","column":8,"beat":0},{"symbol":"F#4","column":35,"beat":2},{"symbol":"F#","column":51,"beat":4}]},{"id":"line-19","kind":"lyric","text":"Well the word got around, they said, \"This kid is insane, man\"","columns":62,"beats":4,"changes":[{"symbol":"Bm","column":10,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Took up a collection just to send him to the mainland","columns":53,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0}]},{"id":"line-21","kind":"lyric","text":"\"Get your education, don't forget from whence you came","columns":54,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"And the world is gonna know your name.\" What's your name, man?","columns":62,"beats":4,"changes":[{"symbol":"D","column":10,"beat":0},{"symbol":"Bb°","column":33,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Alexander Hamilton","columns":18,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"My name is Alexander Hamilton","columns":29,"beats":4,"changes":[{"symbol":"F#","column":12,"beat":0}]},{"id":"line-25","kind":"lyric","text":"And there's a million things I haven't done","columns":43,"beats":4,"changes":[{"symbol":"G","column":14,"beat":0}]},{"id":"line-26","kind":"lyric","text":"But just you wait, just you wait","columns":32,"beats":4,"changes":[{"symbol":"D","column":14,"beat":0},{"symbol":"F#","column":29,"beat":2}]},{"id":"line-27","kind":"lyric","text":"When he was ten his father split, full of it, debt-ridden","columns":57,"beats":4,"changes":[{"symbol":"Bm","column":12,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Two years later, see Alex and his mother bed-ridden half-dead","columns":61,"beats":4,"changes":[{"symbol":"F#","column":5,"beat":0},{"symbol":"G","column":58,"beat":2}]},{"id":"line-29","kind":"lyric","text":"Sittin' in their own sick, the scent thick","columns":42,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"And Alex got better but his mother went quick","columns":45,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"Moved in with a cousin, the cousin committed suicide","columns":52,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Left him with nothin' but ruined pride, something new inside","columns":60,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0}]},{"id":"line-33","kind":"lyric","text":"A voice saying","columns":14,"beats":4,"changes":[{"symbol":"G","column":2,"beat":0}]},{"id":"line-34","kind":"lyric","text":"\"You gotta fend for yourself\"","columns":29,"beats":4,"changes":[]},{"id":"line-35","kind":"lyric","text":"\"Alex, you gotta fend for yourself\"","columns":35,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"He started retreatin' and readin' every treatise on the shelf","columns":61,"beats":4,"changes":[{"symbol":"D","column":15,"beat":0},{"symbol":"Bb°","column":41,"beat":2}]},{"id":"line-37","kind":"lyric","text":"There would have been nothing left to do","columns":40,"beats":4,"changes":[{"symbol":"Bm","column":5,"beat":0}]},{"id":"line-38","kind":"lyric","text":"For someone less astute, he woulda been","columns":39,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"Dead or destitute without a sense of restitution","columns":48,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Started workin', clerkin' for his late mother's landlord","columns":56,"beats":4,"changes":[{"symbol":"G","column":9,"beat":0}]},{"id":"line-41","kind":"lyric","text":"Tradin' sugarcane and rum and all the things he can't afford","columns":60,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"Bb°","column":30,"beat":2}]},{"id":"line-42","kind":"lyric","text":"Scannin' for every book he can get his hands on","columns":47,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-43","kind":"lyric","text":"Plannin' for the future see him now as he stands on","columns":51,"beats":4,"changes":[{"symbol":"F#","column":0,"beat":0}]},{"id":"line-44","kind":"lyric","text":"The bow of a ship headed for a new land","columns":39,"beats":4,"changes":[{"symbol":"G","column":4,"beat":0}]},{"id":"line-45","kind":"lyric","text":"In New York you can be a new man","columns":32,"beats":4,"changes":[{"symbol":"D","column":3,"beat":0},{"symbol":"Bb°","column":20,"beat":2}]},{"id":"line-46","kind":"lyric","text":"In New York you can","columns":19,"beats":4,"changes":[{"symbol":"Bm","column":2,"beat":0}]},{"id":"line-47","kind":"lyric","text":"Be a new man","columns":12,"beats":4,"changes":[]},{"id":"line-48","kind":"lyric","text":"Just you wait","columns":13,"beats":4,"changes":[]},{"id":"line-49","kind":"lyric","text":"In New York you can","columns":19,"beats":2,"changes":[{"symbol":"G7","column":3,"beat":0}]},{"id":"line-50","kind":"lyric","text":"Be a new man","columns":12,"beats":4,"changes":[]},{"id":"line-51","kind":"lyric","text":"Just you wait","columns":13,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"In New York you can","columns":19,"beats":4,"changes":[{"symbol":"Em9","column":3,"beat":0}]},{"id":"line-53","kind":"lyric","text":"Be a new man","columns":12,"beats":4,"changes":[]},{"id":"line-54","kind":"lyric","text":"In New York--","columns":13,"beats":2,"changes":[{"symbol":"F#","column":3,"beat":0}]},{"id":"line-55","kind":"lyric","text":"New York","columns":8,"beats":4,"changes":[]},{"id":"line-56","kind":"lyric","text":"Just you wait!","columns":14,"beats":4,"changes":[]},{"id":"line-57","kind":"lyric","text":"Alexander Hamilton (Alexander Hamilton)","columns":39,"beats":6,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-58","kind":"lyric","text":"We are waiting in the wings for you","columns":35,"beats":2,"changes":[{"symbol":"G7","column":8,"beat":0}]},{"id":"line-59","kind":"lyric","text":"(waiting in the wings for you)","columns":30,"beats":4,"changes":[]},{"id":"line-60","kind":"lyric","text":"You could never back down","columns":25,"beats":4,"changes":[{"symbol":"Em","column":11,"beat":0}]},{"id":"line-61","kind":"lyric","text":"You never learned to take your time","columns":35,"beats":4,"changes":[{"symbol":"F#","column":32,"beat":0}]},{"id":"line-62","kind":"lyric","text":"Oh, Alexander Hamilton (Alexander Hamilton)","columns":43,"beats":4,"changes":[{"symbol":"Bm","column":5,"beat":0}]},{"id":"line-63","kind":"lyric","text":"When America sings for you","columns":26,"beats":4,"changes":[{"symbol":"G7","column":6,"beat":0}]},{"id":"line-64","kind":"lyric","text":"Will they know what you overcame?","columns":33,"beats":2,"changes":[{"symbol":"Em","column":11,"beat":0}]},{"id":"line-65","kind":"lyric","text":"Will they know you rewrote the game?","columns":36,"beats":4,"changes":[{"symbol":"D","column":11,"beat":0},{"symbol":"Em","column":31,"beat":2}]},{"id":"line-66","kind":"lyric","text":"The world will never be the same, oh","columns":39,"beats":8,"changes":[{"symbol":"Bm/F#","column":5,"beat":0},{"symbol":"Em/G","column":16,"beat":2},{"symbol":"D/A","column":24,"beat":4},{"symbol":"F#7/A#","column":33,"beat":6}]},{"id":"line-67","kind":"lyric","text":"The ship is in the harbor now","columns":29,"beats":4,"changes":[{"symbol":"Bm","column":3,"beat":0}]},{"id":"line-68","kind":"lyric","text":"See if you can spot him","columns":23,"beats":4,"changes":[{"symbol":"Bm/C#","column":0,"beat":0}]},{"id":"line-69","kind":"lyric","text":"Just you wait","columns":13,"beats":4,"changes":[]},{"id":"line-70","kind":"lyric","text":"Another immigrant","columns":17,"beats":4,"changes":[{"symbol":"Bm/D","column":1,"beat":0}]},{"id":"line-71","kind":"lyric","text":"Comin' up from the bottom","columns":25,"beats":4,"changes":[{"symbol":"Em","column":4,"beat":0}]},{"id":"line-72","kind":"lyric","text":"Just you wait","columns":13,"beats":4,"changes":[]},{"id":"line-73","kind":"lyric","text":"His enemies destroyed his rep","columns":29,"beats":4,"changes":[{"symbol":"Em/G","column":5,"beat":0}]},{"id":"line-74","kind":"lyric","text":"America forgot him","columns":18,"beats":4,"changes":[{"symbol":"Em/C#","column":0,"beat":0}]},{"id":"line-75","kind":"lyric","text":"We fought with him","columns":18,"beats":4,"changes":[{"symbol":"F#4","column":0,"beat":0},{"symbol":"F#","column":9,"beat":2}]},{"id":"line-76","kind":"lyric","text":"Me? I died for him","columns":18,"beats":4,"changes":[{"symbol":"F#4","column":0,"beat":0},{"symbol":"F#","column":12,"beat":2}]},{"id":"line-77","kind":"lyric","text":"Me? I trusted him","columns":17,"beats":4,"changes":[{"symbol":"Bm9/F#","column":0,"beat":0},{"symbol":"F#","column":13,"beat":2}]},{"id":"line-78","kind":"lyric","text":"Me? I loved him","columns":15,"beats":4,"changes":[{"symbol":"Em6/F#","column":0,"beat":0},{"symbol":"F#","column":13,"beat":2}]},{"id":"line-79","kind":"lyric","text":"And me? I'm the damn fool that shot him","columns":39,"beats":4,"changes":[{"symbol":"F#","column":6,"beat":0}]},{"id":"line-80","kind":"lyric","text":"There's a million things I haven't done","columns":41,"beats":4,"changes":[{"symbol":"Em/G","column":11,"beat":0},{"symbol":"D","column":40,"beat":2}]},{"id":"line-81","kind":"lyric","text":"But just you wait!","columns":19,"beats":2,"changes":[{"symbol":"Em6/F#","column":13,"beat":0}]},{"id":"line-82","kind":"lyric","text":"What's your name, man?","columns":22,"beats":4,"changes":[{"symbol":"F#7","column":0,"beat":0}]},{"id":"line-83","kind":"lyric","text":"Alexander Hamilton!","columns":19,"beats":6,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-84","kind":"instrumental","text":"(    )","columns":6,"beats":4,"changes":[{"symbol":"Bm","column":2,"beat":0}]}]}