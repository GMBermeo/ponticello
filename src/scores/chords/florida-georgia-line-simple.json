{"version":1,"id":"florida-georgia-line-simple","title":"Simple","artist":"Florida Georgia Line","key":"Eb","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/florida-georgia-line/simple/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Mark L Holman, Florida Georgia Line and Michael Wilson Hardy","chords":[{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"D#","canonical":"D#","keyboardPitchClasses":[3,7,10],"interpretation":null},{"symbol":"G#","canonical":"G#","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null}],"lines":[{"id":"line-1","kind":"section","text":"[Intro]","columns":7,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"The way your fingers fit in mine","columns":32,"beats":4,"changes":[{"symbol":"Cm","column":5,"beat":0},{"symbol":"D#","column":21,"beat":2}]},{"id":"line-3","kind":"lyric","text":"It's five plus five, not rocket science","columns":39,"beats":4,"changes":[{"symbol":"G#","column":5,"beat":0},{"symbol":"D#","column":26,"beat":2}]},{"id":"line-4","kind":"lyric","text":"This day in time, that's hard to find, it's true","columns":48,"beats":3,"changes":[{"symbol":"G#","column":5,"beat":0},{"symbol":"D#","column":26,"beat":1},{"symbol":"A#","column":46,"beat":2}]},{"id":"line-5","kind":"lyric","text":"The road we're on ain't a traffic jam","columns":37,"beats":4,"changes":[{"symbol":"Cm","column":4,"beat":0},{"symbol":"D#","column":26,"beat":2}]},{"id":"line-6","kind":"lyric","text":"It's a Sunday drive on a piece of land","columns":38,"beats":4,"changes":[{"symbol":"G#","column":7,"beat":0},{"symbol":"D#","column":26,"beat":2}]},{"id":"line-7","kind":"lyric","text":"It's paradise as long as I'm with you","columns":40,"beats":6,"changes":[{"symbol":"G#","column":5,"beat":0},{"symbol":"D#",