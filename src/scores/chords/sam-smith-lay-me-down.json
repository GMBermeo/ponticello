{"version":1,"id":"sam-smith-lay-me-down","title":"Lay Me Down","artist":"Sam Smith","key":"A","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/sam-smith/lay-me-down/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: James John Napier, Sam Smith and Elviin","chords":[{"symbol":"E7M","canonical":"Emaj7","keyboardPitchClasses":[4,8,11,3],"interpretation":"Keyboard interpretation: Emaj7"},{"symbol":"A7M","canonical":"Amaj7","keyboardPitchClasses":[9,1,4,8],"interpretation":"Keyboard interpretation: Amaj7"},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"Dbm","canonical":"Dbm","keyboardPitchClasses":[1,4,8],"interpretation":null},{"symbol":"B","canonical":"B","keyboardPitchClasses":[11,3,6],"interpretation":null},{"symbol":"E/B","canonical":"E/B","keyboardPitchClasses":[11,4,8],"interpretation":null},{"symbol":"F#m/B","canonical":"F#m/B","keyboardPitchClasses":[],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null},{"symbol":"C#m","canonical":"C#m","keyboardPitchClasses":[1,4,8],"interpretation":null},{"symbol":"E/Eb","canonical":"E/Eb","keyboardPitchClasses":[],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"A6","canonical":"A6","keyboardPitchClasses":[9,1,4,6],"interpretation":null},{"symbol":"D7M","canonical":"Dmaj7","keyboardPitchClasses":[2,6,9,1],"interpretation":"Keyboard interpretation: Dmaj7"},{"symbol":"Bm7(9)","canonical":"Bm7(9)","keyboardPitchClasses":[11,1,2,6,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Yes I do, I believe","columns":19,"beats":4,"changes":[{"symbol":"E7M","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"That one day I will be, where I was","columns":35,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"Right there, right next to you","columns":31,"beats":4,"changes":[{"symbol":"A7M","column":28,"beat":0}]},{"id":"line-4","kind":"lyric","text":"And it's hard, the days just seem so dark","columns":41,"beats":4,"changes":[]},{"id":"line-5","kind":"lyric","text":"The moon, the stars, are nothing without you","columns":44,"beats":4,"changes":[]},{"id":"line-6","kind":"lyric","text":"Your touch, your skin, where do I begin?","columns":40,"beats":4,"changes":[{"symbol":"E7M","column":7,"beat":0}]},{"id":"line-7","kind":"lyric","text":"No words can explain, the way I'm missing you","columns":46,"beats":4,"changes":[{"symbol":"A7M","column":43,"beat":0}]},{"id":"line-8","kind":"lyric","text":"The night, this emptiness, this hole that I'm inside","columns":52,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"These tears, they tell their own story","columns":38,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"You told me not to cry when you were gone","columns":50,"beats":8,"changes":[{"symbol":"F#m","column":4,"beat":0},{"symbol":"A","column":20,"beat":2},{"symbol":"Dbm","column":37,"beat":4},{"symbol":"B","column":49,"beat":6}]},{"id":"line-11","kind":"lyric","text":"But the feelings overwhelming, it's much too strong","columns":53,"beats":8,"changes":[{"symbol":"F#m","column":10,"beat":0},{"symbol":"A","column":22,"beat":2},{"symbol":"E/B","column":42,"beat":4},{"symbol":"F#m/B","column":48,"beat":6}]},{"id":"line-12","kind":"lyric","text":"Can I lay by your side, next to you, you","columns":40,"beats":8,"changes":[{"symbol":"E","column":4,"beat":0},{"symbol":"C#m","column":18,"beat":2},{"symbol":"F#m","column":32,"beat":4},{"symbol":"A","column":38,"beat":6}]},{"id":"line-13","kind":"lyric","text":"And make sure you're alright","columns":28,"beats":4,"changes":[{"symbol":"E","column":5,"beat":0},{"symbol":"C#m","column":23,"beat":2}]},{"id":"line-14","kind":"lyric","text":"I'll take care of you,","columns":30,"beats":4,"changes":[{"symbol":"F#m","column":18,"beat":0},{"symbol":"A","column":29,"beat":2}]},{"id":"line-15","kind":"lyric","text":"And I don't want to be here if I can't be with you tonight","columns":58,"beats":6,"changes":[{"symbol":"A","column":7,"beat":0},{"symbol":"B","column":31,"beat":2},{"symbol":"E","column":51,"beat":4}]},{"id":"line-16","kind":"lyric","text":"I'm reaching out to you","columns":23,"beats":4,"changes":[{"symbol":"E7M","column":8,"beat":0}]},{"id":"line-17","kind":"lyric","text":"Can you hear my call?","columns":21,"beats":4,"changes":[{"symbol":"A7M","column":17,"beat":0}]},{"id":"line-18","kind":"lyric","text":"This hurt that I've been through","columns":32,"beats":4,"changes":[{"symbol":"E7M","column":6,"beat":0}]},{"id":"line-19","kind":"lyric","text":"I'm missing you, missing you like crazy","columns":39,"beats":4,"changes":[{"symbol":"A7M","column":36,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Can I lay by your side, next to you, you","columns":41,"beats":5,"changes":[{"symbol":"E","column":4,"beat":0},{"symbol":"E/Eb","column":9,"beat":1},{"symbol":"C#m","column":20,"beat":2},{"symbol":"F#m","column":34,"beat":3},{"symbol":"A","column":40,"beat":4}]},{"id":"line-21","kind":"lyric","text":"And make sure you're alright","columns":28,"beats":4,"changes":[{"symbol":"E","column":5,"beat":0},{"symbol":"C#m","column":23,"beat":2}]},{"id":"line-22","kind":"lyric","text":"I'll take care of you,","columns":30,"beats":4,"changes":[{"symbol":"F#m","column":18,"beat":0},{"symbol":"A","column":29,"beat":2}]},{"id":"line-23","kind":"lyric","text":"And I don't want to be here if I can't be with you tonight","columns":58,"beats":4,"changes":[{"symbol":"A","column":8,"beat":0},{"symbol":"B","column":32,"beat":2}]},{"id":"line-24","kind":"instrumental","text":"(              )","columns":16,"beats":8,"changes":[{"symbol":"F#m","column":2,"beat":0},{"symbol":"A","column":7,"beat":2},{"symbol":"