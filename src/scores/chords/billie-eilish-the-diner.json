{"version":1,"id":"billie-eilish-the-diner","title":"THE DINER","artist":"Billie Eilish","key":"Bm","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/billie-eilish/the-diner/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Finneas and Billie Eilish","chords":[{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"F#7(5+)","canonical":"F#7#5","keyboardPitchClasses":[6,10,2,4],"interpretation":"Keyboard interpretation: F#7#5"},{"symbol":"Em7","canonical":"Em7","keyboardPitchClasses":[4,7,11,2],"interpretation":null},{"symbol":"F#7","canonical":"F#7","keyboardPitchClasses":[6,10,1,4],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":32,"beats":8,"changes":[{"symbol":"Bm","column":8,"beat":0},{"symbol":"F#7(5+)","column":12,"beat":2},{"symbol":"Bm","column":21,"beat":4},{"symbol":"F#7(5+)","column":25,"beat":6}]},{"id":"line-2","kind":"instrumental","text":"","columns":32,"beats":8,"changes":[{"symbol":"Bm","column":8,"beat":0},{"symbol":"F#7(5+)","column":12,"beat":2},{"symbol":"Bm","column":21,"beat":4},{"symbol":"F#7(5+)","column":25,"beat":6}]},{"id":"line-3","kind":"lyric","text":"Don't be afraid of me","columns":23,"beats":4,"changes":[{"symbol":"Em7","column":20,"beat":0}]},{"id":"line-4","kind":"lyric","text":"I'm what you need","columns":17,"beats":2,"changes":[{"symbol":"F#7","column":14,"beat":0}]},{"id":"line-5","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-6","kind":"lyric","text":"I saw you on the screens","columns":24,"beats":4,"changes":[{"symbol":"Bm","column":20,"beat":0}]},{"id":"line-7","kind":"lyric","text":"I know we're meant to be","columns":24,"beats":4,"changes":[]},{"id":"line-8","kind":"lyric","text":"You're starring in my dreams","columns":28,"beats":4,"changes":[{"symbol":"Em","column":24,"beat":0}]},{"id":"line-9","kind":"lyric","text":"In magazines","columns":12,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"You're looking right at me","columns":28,"beats":4,"changes":[{"symbol":"F#7","column":25,"beat":0}]},{"id":"line-11","kind":"lyric","text":"I'm here around the clock","columns":25,"beats":4,"changes":[{"symbol":"Bm","column":22,"beat":0}]},{"id":"line-12","kind":"lyric","text":"I'm waiting on your block","columns":25,"beats":4,"changes":[]},{"id":"line-13","kind":"lyric","text":"But please, don't call the cops","columns":31,"beats":4,"changes":[{"symbol":"Em","column":28,"beat":0}]},{"id":"line-14","kind":"lyric","text":"They'll make me stop","columns":20,"beats":4,"changes":[]},{"id":"line-15","kind":"lyric","text":"And I just wanna talk","columns":21,"beats":4,"changes":[{"symbol":"F#7","column":18,"beat":0}]},{"id":"line-16","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-17","kind":"lyric","text":"Bet I could change your life","columns":28,"beats":4,"changes":[{"symbol":"Bm","column":25,"beat":0}]},{"id":"line-18","kind":"lyric","text":"You could be my wife (wife, wife)","columns":33,"beats":4,"changes":[]},{"id":"line-19","kind":"lyric","text":"Could get into a fight","columns":22,"beats":4,"changes":[{"symbol":"Em","column":18,"beat":0}]},{"id":"line-20","kind":"lyric","text":"I'll say you're right and","columns":25,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"You'll kiss me goodnight","columns":24,"beats":4,"changes":[{"symbol":"F#7","column":20,"beat":0}]},{"id":"line-22","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-23","kind":"lyric","text":"I waited on the corner","columns":22,"beats":4,"changes":[{"symbol":"Bm","column":17,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Till I saw the sitter leave","columns":27,"beats":4,"changes":[]},{"id":