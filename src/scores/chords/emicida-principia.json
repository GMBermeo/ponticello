ic","text":"Amor é decisão, atitude","columns":23,"beats":4,"changes":[]},{"id":"line-96","kind":"lyric","text":"Muito mais que sentimento","columns":25,"beats":4,"changes":[]},{"id":"line-97","kind":"lyric","text":"Alento, fogueira, amanhecer","columns":27,"beats":4,"changes":[]},{"id":"line-98","kind":"lyric","text":"O amor perdoa o imperdoável","columns":27,"beats":4,"changes":[]},{"id":"line-99","kind":"lyric","text":"Resgata dignidade do ser","columns":24,"beats":4,"changes":[]},{"id":"line-100","kind":"lyric","text":"É espiritual","columns":12,"beats":4,"changes":[]},{"id":"line-101","kind":"lyric","text":"Tão carnal quanto angelical","columns":27,"beats":4,"changes":[]},{"id":"line-102","kind":"lyric","text":"Não tá no dogma, ou preso numa religião","columns":39,"beats":4,"changes":[]},{"id":"line-103","kind":"lyric","text":"É tão antigo quanto a eternidade","columns":32,"beats":4,"changes":[]},{"id":"line-104","kind":"lyric","text":"Amor é espiritualidade","columns":22,"beats":4,"changes":[]},{"id":"line-105","kind":"lyric","text":"Latente, potente, preto, poesia","columns":31,"beats":4,"changes":[]},{"id":"line-106","kind":"lyric","text":"Um ombro na noite quieta","columns":24,"beats":4,"changes":[]},{"id":"line-107","kind":"lyric","text":"Um colo para começar o dia","columns":26,"beats":4,"changes":[]},{"id":"line-108","kind":"lyric","text":"Filho, abrace sua mãe","columns":21,"beats":4,"changes":[]},{"id":"line-109","kind":"lyric","text":"Pai, perdoe seu filho","columns":21,"beats":4,"changes":[]},{"id":"line-110","kind":"lyric","text":"Pais é reparação, fruto de paz","columns":30,"beats":4,"changes":[]},{"id":"line-111","kind":"lyric","text":"Paz não se constrói com tiro","columns":28,"beats":4,"changes":[]},{"id":"line-112","kind":"lyric","text":"Mas eu o miro, de frente, na minha fragilidade","columns":46,"beats":4,"changes":[]},{"id":"line-113","kind":"lyric","text":"Eu não tenho a bolha da proteção","columns":32,"beats":4,"changes":[]},{"id":"line-114","kind":"lyric","text":"Queria guardar tudo que amo","columns":27,"beats":4,"changes":[]},{"id":"line-115","kind":"lyric","text":"No castelo da minha imaginação","columns":30,"beats":4,"changes":[]},{"id":"line-116","kind":"lyric","text":"Mas eu vejo a vida passar num instante","columns":38,"beats":4,"changes":[]},{"id":"line-117","kind":"lyric","text":"Será tempo o bastante que tenho para viver?","columns":43,"beats":4,"changes":[]},{"id":"line-118","kind":"lyric","text":"Eu não sei, eu não posso saber","columns":30,"beats":4,"changes":[]},{"id":"line-119","kind":"lyric","text":"Mas enquanto houver amor","columns":24,"beats":4,"changes":[]},{"id":"line-120","kind":"lyric","text":"Eu mudarei o curso da vida","columns":26,"beats":4,"changes":[]},{"id":"line-121","kind":"lyric","text":"Farei um altar para comunhão","columns":28,"beats":4,"changes":[]},{"id":"line-122","kind":"lyric","text":"Nele eu serei um com o mundo","columns":28,"beats":4,"changes":[]},{"id":"line-123","kind":"lyric","text":"Até ver o ubuntu da emancipação","columns":31,"beats":4,"changes":[]},{"id":"line-124","kind":"lyric","text":"Porque eu descobri o segredo que me faz humano","columns":46,"beats":4,"changes":[]},{"id":"line-125","kind":"lyric","text":"Já não está mais perdido o elo","columns":30,"beats":4,"changes":[]},{"id":"line-126","kind":"lyric","text":"O amor é o segredo de tudo","columns":26,"beats":4,"changes":[]},{"id":"line-127","kind":"lyric","text":"E eu pinto tudo em amarelo","columns":26,"beats":4,"changes":[]}]}