{"version":1,"id":"olivia-rodrigo-hope-ur-ok","title":"Hope Ur Ok","artist":"Olivia Rodrigo","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/olivia-rodrigo/hope-ur-ok/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Daniel Leonard Nigro and Olivia Isabel Rodrigo","chords":[{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"F7M","canonical":"Fmaj7","keyboardPitchClasses":[5,9,0,4],"interpretation":"Keyboard interpretation: Fmaj7"},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"G6","canonical":"G6","keyboardPitchClasses":[7,11,2,4],"interpretation":null},{"symbol":"G7","canonical":"G7","keyboardPitchClasses":[7,11,2,5],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":13,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"Am","column":11,"beat":2}]},{"id":"line-2","kind":"lyric","text":"I knew a boy once, when I was small","columns":35,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":28,"beat":2}]},{"id":"line-3","kind":"lyric","text":"A tow-head blond, with eyes of salt","columns":35,"beats":4,"changes":[{"symbol":"C","column":30,"beat":0}]},{"id":"line-4","kind":"lyric","text":"He played the drum in the marching band","columns":39,"beats":2,"changes":[{"symbol":"Am","column":35,"beat":0}]},{"id":"line-5","kind":"lyric","text":"His parents cared more about the Bible","columns":38,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":33,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Than being good to their own child","columns":34,"beats":4,"changes":[{"symbol":"C","column":30,"beat":0}]},{"id":"line-7","kind":"lyric","text":"He wore long sleeves 'cause of his dad","columns":38,"beats":2,"changes":[{"symbol":"Am","column":34,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And somehow, we fell out of touch","columns":33,"beats":4,"changes":[{"symbol":"F7M","column":3,"beat":0},{"symbol":"Am","column":30,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Hope he took his bad deal and made a royal flush","columns":48,"beats":4,"changes":[{"symbol":"F7M","column":8,"beat":0},{"symbol":"Am","column":45,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Don't know if I'll see you again someday","columns":40,"beats":4,"changes":[{"symbol":"F7M","column":5,"beat":0},{"symbol":"Am","column":37,"beat":2}]},{"id":"line-11","kind":"lyric","text":"But if you're out there, I hope that you're okay","columns":48,"beats":6,"changes":[{"symbol":"G","column":14,"beat":0},{"symbol":"G6","column":19,"beat":2},{"symbol":"G7","column":23,"beat":4}]},{"id":"line-12","kind":"instrumental","text":"(       )","columns":9,"beats":4,"changes":[{"symbol":"C","column":2,"beat":0},{"symbol":"Am","column":5,"beat":2}]},{"id":"line-13","kind":"lyric","text":"My middle school friend grew up alone","columns":37,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":33,"beat":2}]},{"id":"line-14","kind":"lyric","text":"She raised her brothers on her own","columns":34,"beats":4,"changes":[{"symbol":"C","column":30,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Her parents hated who she loved","columns":31,"beats":4,"changes":[{"symbol":"Am","column":26,"beat":0}]},{"id":"line-16","kind":"lyric","text":"She couldn't wait to go to college","columns":34,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":28,"beat":2}]},{"id":"line-17","kind":"lyric","text":"She was tired 'cause she was brought","columns":36,"beats":4,"changes":[{"symbol":"C","column":30,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Into a world where family was merely blood","columns":42,"beats":4,"changes":[{"symbol":"Am","column":22,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Does she know how proud I am she was created","columns":44,"beats":4,"changes":[{"symbol":"F7M","column":9,"beat":0},{"symbol":"Am","column":41,"beat":2}]},{"id":"line-20","kind":"lyric","text":"With the courage to unlearn all of their hatred","columns":47,"beats":4,"changes":[{"symbol":"F7M","column":9,"beat":0},{"symbol":"Am","column":41,"beat":2}]},{"id":"line-21","kind":"lyric","text":"We don't talk much but I just gotta say","columns":39,"beats":4,"changes":[{"symbol":"F7M","column":8,"beat":0},{"symbol":"Am","column":36,"beat":2}]},{"id":"line-22","kind":"lyric","text":"I miss you, and I hope that you're okay","columns":39,"beats":3,"changes":[{"symbol":"G","column":2,"beat":0},{"symbol":"G6","column":6,"beat":1},{"symbol":"G7","column":9,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Address the letters, to the holes in my butterfly wings","columns":55,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":19,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Nothing's forever, nothing is as good as it seems","columns":49,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"Am","column":18,"beat":2}]},{"id":"line-25","kind":"lyric","text":"And when the clouds won't iron out","columns":34,"beats":4,"changes":[{"symbol":"Dm","column":0,"beat":0},{"symbol":"F7M","column":31,"beat":2}]},{"id":"line-26","kind":"lyric","text":"And the monsters creep into your house","columns":38,"beats":4,"changes":[{"symbol":"C","column":33,"beat":0}]},{"id":"line-27","kind":"lyric","text":"And every door is hard to close","columns":31,"beats":4,"changes":[{"symbol":"G","column":26,"beat":0}]},{"id":"line-28","kind":"lyric","text":"Well, I hope you know how proud I am you were created","columns":53,"beats":4,"changes":[{"symbol":"F7M","column":17,"beat":0},{"symbol":"Am","column":49,"beat":2}]},{"id":"line-29","kind":"lyric","text":"With the courage to unlearn all of their hatred","columns":47,"beats":4,"changes":[{"symbol":"F7M","column":9,"beat":0},{"symbol":"Am","column":41,"beat":2}]},{"id":"line-30","kind":"lyric","text":"God, I hope that you're happier today","columns":37,"beats":4,"changes":[{"symbol":"F7M","column":6,"beat":0},{"symbol":"Am","column":35,"beat":2}]},{"id":"line-31","kind":"lyric","text":"'Cause I love you, and I hope that you're okay","columns":46,"beats":6,"changes":[{"symbol":"G","column":9,"beat":0},{"symbol":"G6","column":13,"beat":2},{"symbol":"G7","column":16,"beat":4}]},{"id":"line-32","kind":"instrumental","text":"[Final]","columns":20,"beats":8,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"Am","column":11,"beat":2},{"symbol":"C","column":15,"beat":4},{"symbol":"Am","column":18,"beat":6}]},{"id":"line-33","kind":"instrumental","text":"","columns":20,"beats":8,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"Am","column":11,"beat":2},{"symbol":"C","column":15,"beat":4},{"symbol":"Am","column":18,"beat":6}]},{"id":"line-34","kind":"instrumental","text":"","columns":20,"beats":8,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"Am","column":11,"beat":2},{"symbol":"C","column":15,"beat":4},{"symbol":"Am","column":18,"beat":6}]}]}