d":"line-5","kind":"lyric","text":"Lovely to be sitting here with you","columns":35,"beats":6,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"F#m7/C#","column":7,"beat":2},{"symbol":"E11/B","column":30,"beat":4}]},{"id":"line-6","kind":"lyric","text":"You're kinda cute but it’s  raining  harder","columns":43,"beats":4,"changes":[{"symbol":"D9","column":26,"beat":0},{"symbol":"F#m7/C#","column":35,"beat":2}]},{"id":"line-7","kind":"lyric","text":"My shoes are now full of water","columns":30,"beats":6,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"A6","column":13,"beat":2},{"symbol":"E/G#","column":24,"beat":4}]},{"id":"line-8","kind":"lyric","text":"Lovely to be rained on with you","columns":32,"beats":6,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"F#m7/C#","column":6,"beat":2},{"symbol":"E11/B","column":27,"beat":4}]},{"id":"line-9","kind":"lyric","text":"It's kinda cute but it's  so short","columns":34,"beats":4,"changes":[{"symbol":"D9","column":24,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Then you're driving me home","columns":27,"beats":4,"changes":[{"symbol":"A6","column":24,"beat":0}]},{"id":"line-11","kind":"lyric","text":"And I don't wanna leave","columns":23,"beats":4,"changes":[{"symbol":"E/G#","column":19,"beat":0}]},{"id":"line-12","kind":"lyric","text":"But I have to go","columns":18,"beats":4,"changes":[{"symbol":"D9","column":16,"beat":0}]},{"id":"line-13","kind":"lyric","text":"You kiss me in your car","columns":23,"beats":4,"changes":[]},{"id":"line-14","kind":"lyric","text":"And it feels like the start of a movie I've seen     before","columns":59,"beats":6,"changes":[{"symbol":"A6","column":8,"beat":0},{"symbol":"E/G#","column":32,"beat":2},{"symbol":"F#m9","column":48,"beat":4}]},{"id":"line-15","kind":"lyric","text":"Before","columns":7,"beats":4,"changes":[{"symbol":"E11/B","column":2,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Bedsheets, no clothes","columns":21,"beats":4,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"F#m7/C#","column":12,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Touch me like nobody else does","columns":30,"beats":6,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"A6","column":15,"beat":2},{"symbol":"E/G#","column":21,"beat":4}]},{"id":"line-18","kind":"lyric","text":"Lovely to just lay here with you","columns":36,"beats":6,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"F#m7/C#","column":14,"beat":2},{"symbol":"E11/B","column":31,"beat":4}]},{"id":"line-19","kind":"lyric","text":"You're kinda cute and I would say  all of this","columns":46,"beats":4,"changes":[{"symbol":"D9","column":22,"beat":0},{"symbol":"F#m7/C#","column":31,"beat":2}]},{"id":"line-20","kind":"lyric","text":"But I don't wanna ruin the moment","columns":33,"beats":6,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"A6","column":19,"beat":2},{"symbol":"E/G#","column":27,"beat":4}]},{"id":"line-21","kind":"lyric","text":"Lovely to sit between comfort     and chaos","columns":48,"beats":8,"changes":[{"symbol":"D9","column":0,"beat":0},{"symbol":"C#7","column":11,"beat":2},{"symbol":"D9","column":30,"beat":4},{"symbol":"E11/B","column":43,"beat":6}]},{"id":"line-22","kind":"lyric","text":"But it's over","columns":13,"beats":4,"changes":[{"symbol":"D9","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Then you're driving me home","columns":27,"beats":4,"changes":[{"symbol":"A6","column":24,"beat":0}]},{"id":"line-24","kind":"lyric","text":"And it kinda comes out as I get up to go","columns":42,"beats":4,"changes":[{"symbol":"E/G#","column":19,"beat":0},{"symbol":"D9","column":40,"beat":2}]},{"id":"line-25","kind":"lyric","text":"You kiss me in your car","columns":23,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"And it feels like the start of a movie I've seen before","columns":55,"beats":4,"changes":[{"symbol":"A6","column":8,"beat":0},{"symbol":"E/G#","column":33,"beat":2}]},{"id":"line-27","kind":"lyric","text":"But it's not real","columns":17,"beats":4,"changes":[{"symbol":"D9","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"And you don't exist","columns":19,"beats":4,"changes":[{"symbol":"A6","column":16,"beat":0}]},{"id":"line-29","kind":"lyric","text":"And I can't recall the last time I was kissed","columns":45,"beats":4,"changes":[{"symbol":"E/G#","column":13,"beat":0},{"symbol":"D9","column":40,"beat":2}]},{"id":"line-30","kind":"lyric","text":"It hits me in the car","columns":21,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"And it feels like the end of a movie I've seen    before","columns":56,"beats":6,"changes":[{"symbol":"A6","column":8,"beat":0},{"symbol":"E/G#","column":31,"beat":2},{"symbol":"F#m9","column":45,"beat":4}]},{"id":"line-32","kind":"lyric","text":"Before","columns":6,"beats":4,"changes":[{"symbol":"E11/B","column":0,"beat":0}]}]}