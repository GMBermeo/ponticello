{"version":1,"id":"ruth-b-lost-boy","title":"Lost Boy","artist":"Ruth B.","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/ruth-b/lost-boy/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ruth B","chords":[{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":19,"beats":4,"changes":[{"symbol":"Em","column":8,"beat":0},{"symbol":"G","column":12,"beat":1},{"symbol":"C","column":15,"beat":2},{"symbol":"G","column":18,"beat":3}]},{"id":"line-2","kind":"lyric","text":"There was a time when I was alone","columns":33,"beats":8,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":20,"beat":4}]},{"id":"line-3","kind":"lyric","text":"No where to go and no place to call home","columns":40,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":20,"beat":2}]},{"id":"line-4","kind":"lyric","text":"My only friend was the Man on the Moon","columns":38,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":21,"beat":2}]},{"id":"line-5","kind":"lyric","text":"And even sometimes he would go away too","columns":39,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Then one night as I closed my eyes","columns":34,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":19,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I saw a shadow flying high","columns":26,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":14,"beat":2}]},{"id":"line-8","kind":"lyric","text":"He came to me with the sweetest smile","columns":37,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":22,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Told me he wanted to talk for awhile","columns":36,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":20,"beat":2}]},{"id":"line-10","kind":"lyric","text":"He said,  \"Peter Pan, that's what they call me","columns":46,"beats":4,"changes":[{"symbol":"Em","column":6,"beat":0},{"symbol":"G","column":20,"beat":2}]},{"id":"line-11","kind":"lyric","text":"   I promise that you'll never be lonely\"","columns":41,"beats":8,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":25,"beat":4}]},{"id":"line-12","kind":"lyric","text":"And ever since that day","columns":23,"beats":4,"changes":[{"symbol":"Am","column":4,"beat":0},{"symbol":"D","column":19,"beat":2}]},{"id":"line-13","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-14","kind":"lyric","text":"   I am a lost boy","columns":18,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Em","column":9,"beat":2}]},{"id":"line-15","kind":"lyric","text":"   From Never Land","columns":18,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"G","column":13,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Usually hanging out with","columns":24,"beats":8,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"C","column":15,"beat":4}]},{"id":"line-17","kind":"lyric","text":"   Peter Pan","columns":12,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"G","column":9,"beat":4}]},{"id":"line-18","kind":"lyric","text":"And when we are bored we play in the woods","columns":42,"beats":8,"changes":[{"symbol":"Em","column":4,"beat":0},{"symbol":"Em","column":14,"beat":2},{"symbol":"G","column":23,"beat":4},{"symbol":"G","column":34,"beat":6}]},{"id":"line-19","kind":"lyric","text":"Always on the run from   Captain Hook","columns":37,"beats":8,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"C","column":13,"beat":2},{"symbol":"G","column":21,"beat":4},{"symbol":"G","column":30,"beat":6}]},{"id":"line-20","kind":"lyric","text":"\"Run, run, Lost Boy,\"","columns":21,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Em","column":6,"beat":1},{"symbol":"G","column":11,"beat":2},{"symbol":"G","column":16,"beat":3}]},{"id":"line-21","kind":"lyric","text":"    They say to me","columns":19,"beats":8,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"C","column":10,"beat":2},{"symbol":"G","column":16,"beat":4},{"symbol":"G","column":18,"beat":6}]},{"id":"line-22","kind":"lyric","text":"\"Away from all of     reality\"","columns":31,"beats":18,"changes":[{"symbol":"Em","column":1,"beat":0},{"symbol":"Em","column":5,"beat":2},{"symbol":"G","column":11,"beat":4},{"symbol":"G","column":15,"beat":6},{"symbol":"C","column":19,"beat":8},{"symbol":"C","column":23,"beat":10},{"symbol":"G","column":27,"beat":12},{"symbol":"G","column":30,"beat":13}]},{"id":"line-23","kind":"lyric","text":"Never Land is home to Lost Boys like me","columns":39,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":19,"beat":2}]},{"id":"line-24","kind":"lyric","text":"And Lost boys like me are free","columns":30,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-25","kind":"lyric","text":"He sprinkled me with pixie dust","columns":31,"beats":4,"changes":[{"symbol":"Em","column":3,"beat":0}]},{"id":"line-26","kind":"lyric","text":"And told me to believe","columns":22,"beats":4,"changes":[{"symbol":"G","column":3,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Believe in him and believe in me","columns":32,"beats":4,"changes":[{"symbol":"C","column":1,"beat":0},{"symbol":"G","column":17,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Together we will fly away in a cloud of green","columns":45,"beats":4,"changes":[{"symbol":"Em","column":1,"beat":0},{"symbol":"G","column":23,"beat":2}]},{"id":"line-29","kind":"lyric","text":"To our beautiful destiny","columns":24,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":15,"beat":2}]},{"id":"line-30","kind":"lyric","text":"As we soared above the town that never loved me","columns":47,"beats":4,"changes":[{"symbol":"Em","column":5,"beat":0},{"symbol":"G","column":26,"beat":2}]},{"id":"line-31","kind":"lyric","text":"I realized I finally had a family","columns":33,"beats":4,"changes":[{"symbol":"C","column":2,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Soon enough we reached Never Land","columns":33,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"G","column":21,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Peacefully my feet hit the sand","columns":31,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"G","column":17,"beat":2}]},{"id":"line-34","kind":"lyric","text":"And ever since that day","columns":23,"beats":4,"changes":[{"symbol":"Am","column":4,"beat":0},{"symbol":"D","column":18,"beat":2}]},{"id":"line-35","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-36","kind":"lyric","text":"   I am a lost boy","columns":18,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"Em","column":9,"beat":2}]},{"id":"line-37","kind":"lyric","text":"   From Never Land","columns":18,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"G","column":13,"beat":2}]},{"id":"line-38","kind":"lyric","text":"Usually hanging out with","columns":24,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"C","column":15,"beat":2}]},{"id":"line-39","kind":"lyric","text":"   Peter Pan","columns":12,"beats":8,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol"