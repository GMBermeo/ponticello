{"version":1,"id":"bad-bunny-bokete","title":"BOKeTE","artist":"Bad Bunny","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/bad-bunny/bokete/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Chris Berry","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"C7M","canonical":"Cmaj7","keyboardPitchClasses":[0,4,7,11],"interpretation":"Keyboard interpretation: Cmaj7"}],"lines":[{"id":"line-1","kind":"section","text":"[Intro]","columns":7,"beats":0,"changes":[]},{"id":"line-2","kind":"lyric","text":"           Las 6","columns":16,"beats":12,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"Bm","column":2,"beat":2},{"symbol":"Em","column":5,"beat":4},{"symbol":"Bm","column":8,"beat":6},{"symbol":"D","column":11,"beat":8},{"symbol":"C","column":13,"beat":10}]},{"id":"line-3","kind":"lyric","text":"6 P.m. frente al río","columns":20,"beats":4,"changes":[{"symbol":"G","column":17,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Viéndono' los corazone'","columns":23,"beats":4,"changes":[{"symbol":"Bm","column":6,"beat":0},{"symbol":"Em","column":18,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Las hoja' cayendo, preguntas sin contestacione'","columns":47,"beats":8,"changes":[{"symbol":"Bm","column":12,"beat":0},{"symbol":"D","column":29,"beat":2},{"symbol":"C","column":41,"beat":5}]},{"id":"line-6","kind":"lyric","text":"Mis sentimiento' cambian como estacione'","columns":40,"beats":4,"changes":[{"symbol":"G","column":34,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Y aunque en PR todo el tiempo es verano","columns":39,"beats":4,"changes":[{"symbol":"Bm","column":27,"beat":0},{"symbol":"Em","column":35,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Estoy pasando frío escuchando estas cancione'","columns":45,"beats":4,"changes":[{"symbol":"Bm","column":39,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Pensando en ti, pero no te emocione'","columns":36,"beats":4,"changes":[{"symbol":"D","column":21,"beat":0},{"symbol":"C7M","column":30,"beat":2}]},{"id":"line-10","kind":"lyric","text":"Porque no te vo'a escribir","columns":26,"beats":4,"changes":[{"symbol":"G","column":20,"beat":0}]},{"id":"line-11","kind":"lyric","text":"¿Cuál de los dos es quien más va a sufrir?","columns":42,"beats":4,"changes":[{"symbol":"Bm","column":20,"beat":0},{"symbol":"Em","column":35,"beat":2}]},{"id":"line-12","kind":"lyric","text":"No sé, pero ojalá que seas tú, ojalá que seas tú","columns":48,"beats":4,"changes":[{"symbol":"Bm","column":15,"beat":0},{"symbol":"D","column":46,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Pa' mí, que vas a ser tú","columns":24,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Ya ni quiero competir","columns":21,"beats":4,"changes":[{"symbol":"G","column":18,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Tú erе' linda, pero te gusta mentir","columns":35,"beats":4,"changes":[{"symbol":"Bm","column":20,"beat":0},{"symbol":"Em","column":32,"beat":2}]},{"id":"line-16","kind":"lyric","text":"Quédatе en tu viaje, que cuando aterrice, nadie va a aplaudir, ey","columns":65,"beats":8,"changes":[{"symbol":"Bm","column":14,"beat":0},{"symbol":"D","column":42,"beat":2},{"symbol":"C7M","column":58,"beat":5}]},{"id":"line-17","kind":"lyric","text":"Un día va' a ponerte vieja, va' a","columns":33,"beats":4,"changes":[{"symbol":"G","column":21,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Mirar pa'trá' y te va' a arrepentir","columns":35,"beats":4,"changes":[{"symbol":"Bm","column":19,"beat":0},{"symbol":"Em","column":29,"beat":2}]},{"id":"line-19","kind":"lyric","text":"De que lo más real que has tenido en tu vida lo dejaste ir","columns":58,"beats":6,"changes":[{"symbol":"Bm","column":16,"beat":0},{"symbol":"D","column":45,"beat":2},{"symbol":"C","column":53,"beat":4}]},{"id":"line-20","kind":"instrumental","text":"(                     )","columns":23,"beats":16,"changes":[{"symbol":"G","column":2,"beat":0},{"symbol":"Bm","column":5,"beat":2},{"symbol":"Em","column":9,"beat":4},{"symbol":"Bm","column":13,"beat":6},{"symbol":"D","column":17,"beat":8},{"symbol":"C","column":20,"beat":10}]},{"id":"line-21","kind":"lyric","text":"Ey, ey","columns":6,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"Tú ere' un boquete en PR, por eso es que te esquivo","columns":51,"beats":4,"changes":[{"symbol":"G","column":13,"beat":0},{"symbol":"Bm","column":46,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Ya no hay más poema' pa' ti, este es el último que escribo","columns":58,"beats":4,"changes":[{"symbol":"Em","column":16,"beat":0}]},{"id":"line-24","kind":"lyric","text":"A-A vece' vienen los flashback', tú y yo chingando agresivo","columns":59,"beats":4,"changes":[{"symbol":"Bm","column":4,"beat":0},{"symbol":"D","column":55,"beat":2}]},{"id":"line-25","kind":"lyric","text":"Te-te-te iba a llevar pa' Maya, y no llegaste ni a Arecibo","columns":58,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0}]},{"id":"line-26","kind":"lyric","text":"La invitación de la playita se venció","columns":37,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-27","kind":"lyric","text":"Lo mejor de nosotro' nadie lo vio","columns":33,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"O quizá fue que la vida nos mintió","columns":34,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Y tocó decir adió'","columns":18,"beats":4,"changes":[{"symbol":"C7M","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Y vivir como vivía ante' de conocerte","columns":37,"beats":6,"changes":[{"symbol":"G","column":15,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Viendo fotito' tuya', probando si soy fuerte","columns":44,"beats":4,"changes":[{"symbol":"Bm","column":4,"beat":0},{"symbol":"Em","column":14,"beat":2}]},{"id":"line-32","kind":"lyric","text":"Las ola' con el viento, los perro' y la suerte","columns":46,"beats":4,"changes":[{"symbol":"Bm","column":16,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Tenía miedo 'e perderte, pero no má' que a la muerte","columns":52,"beats":4,"changes":[{"symbol":"D","column":2,"beat":0},{"symbol":"C7M","column":18,"beat":2}]},{"id":"line-34","kind":"lyric","text":"Y estoy vivo","columns":12,"beats":4,"changes":[]},{"id":"line-35","kind":"lyric","text":"Gracia' a Dio', estoy vivo, eso es lo que importa","columns":49,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"Yo me he enamora'o 515 vece', y contigo son 516","columns":47,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"So eso no es na' nuevo","columns":22,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"Toca seguir, pichar y olvidar","columns":29,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"Y má' alante si hay que enamorarno'","columns":35,"beats":4,"changes":[]},{"id":"line-40","kind":"lyric","text":"De nuevo, nos volvemo' a enamorar","columns":33,"beats":4,"changes":[]},{"id":"line-41","kind":"lyric","text":"Tú sabe' que a mí me gusta estar así, enamora'o","columns":47,"beats":4,"changes":[]},{"id":"line-42","kind":"lyric","text":"Pero","columns":4,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"Ya ni quiero competir","columns":21,"beats":4,"changes":[{"symbol":"G","column":18,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Tú ere' linda, pero te gusta mentir","columns":35,"beats":4,"changes":[{"symbol":"