{"version":1,"id":"nightwish-the-phantom-of-the-opera","title":"The Phantom Of The Opera","artist":"Nightwish","key":"C","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/nightwish/the-phantom-of-the-opera/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/6VOxRb9IAJQDDyHBlyEdPF","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Andrew Lloyd Webber","chords":[{"symbol":"F#","canonical":"F#","keyboardPitchClasses":[6,10,1],"interpretation":null},{"symbol":"Ab","canonical":"Ab","keyboardPitchClasses":[8,0,3],"interpretation":null},{"symbol":"A#","canonical":"A#","keyboardPitchClasses":[10,2,5],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Afinação 1 tom abaixo: D, G, C, F, A, D","columns":39,"beats":4,"changes":[]},{"id":"line-2","kind":"lyric","text":"In sleep he sang to me, in dreams he came,","columns":42,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"That voice which calls to me,","columns":29,"beats":4,"changes":[]},{"id":"line-4","kind":"lyric","text":"And speaks my name.","columns":19,"beats":4,"changes":[]},{"id":"line-5","kind":"lyric","text":"And do I dream again? For now I find","columns":36,"beats":6,"changes":[{"symbol":"F#","column":12,"beat":0},{"symbol":"Ab","column":19,"beat":2},{"symbol":"A#","column":33,"beat":4}]},{"id":"line-6","kind":"lyric","text":"The phantom of the opera is here","columns":32,"beats":4,"changes":[{"symbol":"A#","column":25,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Inside my mind.","columns":15,"beats":4,"changes":[]},{"id":"line-8","kind":"lyric","text":"Sing once again with me our strange duet;","columns":41,"beats":4,"changes":[]},{"id":"line-9","kind":"lyric","text":"My power over you grows stronger yet.","columns":37,"beats":4,"changes":[]},{"id":"line-10","kind":"lyric","text":"I know you turn from me to glance behind,","columns":41,"beats":6,"changes":[{"symbol":"F#","column":14,"beat":0},{"symbol":"Ab","column":22,"beat":2},{"symbol":"A#","column":39,"beat":4}]},{"id":"line-11","kind":"lyric","text":"REPETE A PARTE DA TARJA","columns":23,"beats":4,"changes":[]},{"id":"line-12","kind":"lyric","text":"The phantom of the opera is there","columns":33,"beats":4,"changes":[]},{"id":"line-13","kind":"lyric","text":"Inside your mind.","columns":17,"beats":4,"changes":[]},{"id":"line-14","kind":"lyric","text":"Those who have seen your face","columns":29,"beats":4,"changes":[]},{"id":"line-15","kind":"lyric","text":"Draw back in fear.","columns":18,"beats":4,"changes":[]},{"id":"line-16","kind":"lyric","text":"I am the mask you wear,","columns":23,"beats":4,"changes":[]},{"id":"line-17","kind":"lyric","text":"It's me they hear.","columns":18,"beats":4,"changes":[]},{"id":"line-18","kind":"lyric","text":"Your spirit and my voice in one combined;","columns":41,"beats":4,"changes":[{"symbol":"Ab","column":20,"beat":0}]},{"id":"line-19","kind":"lyric","text":"The phantom of the opera is here","columns":32,"beats":4,"changes":[]},{"id":"line-20","kind":"lyric","text":"Inside my your mind.","columns":20,"beats":4,"changes":[]},{"id":"line-21","kind":"lyric","text":"He's there the phantom of the opera.","columns":36,"beats":4,"changes":[]},{"id":"line-22","kind":"lyric","text":"Beware the phantom of the opera.","columns":32,"beats":4,"changes":[]},{"id":"line-23","kind":"lyric","text":"In all your fantasies, you always knew","columns":38,"beats":4,"changes":[]},{"id":"line-24","kind":"lyric","text":"That man and mystery","columns":20,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"Were both in you.","columns":17,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"And in this labyrinth where night is blind,","columns":43,"beats":4,"changes":[]},{"id":"line-27","kind":"lyric","text":"The Phantom of the opera is here","columns":32,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"Inside my your mind.","columns":20,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"Sing, my angel of music!","columns":24,"beats":4,"changes":[]},{"id":"line-30","kind":"lyric","text":"He's there,the phantom of the opera!","columns":36,"beats":4,"changes":[]},{"id":"line-31","kind":"lyric","text":"Danilo Assunção dos Santos","columns":26,"beats":4,"changes":[]}]}