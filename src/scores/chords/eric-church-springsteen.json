{"version":1,"id":"eric-church-springsteen","title":"Springsteen","artist":"Eric Church","key":"D","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/eric-church/springsteen/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Jeff Hyde, Eric Church and Ryan Tyndell","chords":[{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"To this day when I hear that song","columns":33,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-2","kind":"lyric","text":"I see you standin' there on that lawn","columns":37,"beats":4,"changes":[]},{"id":"line-3","kind":"lyric","text":"Discount shades, store bought tan","columns":33,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Flip flops and cut-off jeans","columns":28,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":15,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Somewhere between that setting sun","columns":34,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"I'm on fire and born to run","columns":27,"beats":4,"changes":[]},{"id":"line-7","kind":"lyric","text":"You looked at me and I was done","columns":31,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"And we're, we're just getting started","columns":37,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":22,"beat":2}]},{"id":"line-9","kind":"lyric","text":"I was singin' to you, you were singin' to me","columns":44,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-10","kind":"lyric","text":"I was so alive, never been more free","columns":36,"beats":4,"changes":[]},{"id":"line-11","kind":"lyric","text":"Fired up my daddy's lighter and we sang","columns":39,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-12","kind":"lyric","text":"OOhh","columns":4,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":3,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Stayed there 'til they forced us out","columns":36,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-14","kind":"lyric","text":"And took the long way to your house","columns":35,"beats":4,"changes":[]},{"id":"line-15","kind":"lyric","text":"I can still hear the sound of","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-16","kind":"lyric","text":"you sayin' don't go","columns":19,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":17,"beat":2}]},{"id":"line-17","kind":"lyric","text":"When I think about you, I think about 17","columns":40,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"A","column":24,"beat":2}]},{"id":"line-18","kind":"lyric","text":"I think about my old jeep","columns":25,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"I think about the stars in the sky","columns":34,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Funny how a melody sounds like a memory","columns":39,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":19,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Like the soundtrack to a july saturday night","columns":44,"beats":6,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":25,"beat":2},{"symbol":"Em","column":39,"beat":4}]},{"id":"line-22","kind":"lyric","text":"Springsteen","columns":18,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":13,"beat":1},{"symbol":"D","column":15,"beat":2},{"symbol":"G","column":17,"beat":3}]},{"id":"line-23","kind":"lyric","text":"I bumped into you by happenstance","columns":33,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"You probably wouldn't even know who I am","columns":40,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"But if I whispered your name","columns":28,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"I bet there'd still be a spark","columns":30,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":24,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Back when I was gasoline","columns":24,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"And this old tattoo had brand new ink","columns":37,"beats":4,"changes":[]},{"id":"line-29","kind":"lyric","text":"And we didn't care what your mom would think","columns":44,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-30","kind":"lyric","text":"About your name on my arm","columns":25,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":19,"beat":2}]},{"id":"line-31","kind":"lyric","text":"Baby is it spring or is it summer","columns":33,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"The guitar sound or the beat of that drummer","columns":44,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"You hear sometimes late at night","columns":32,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-34","kind":"lyric","text":"On your radio","columns":13,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":9,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Even though you're a million miles away","columns":39,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0}]},{"id":"line-36","kind":"lyric","text":"When you hear born in the usa","columns":29,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"You relive those glory days","columns":27,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-38","kind":"lyric","text":"So long ago","columns":11,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":9,"beat":2}]},{"id":"line-39","kind":"lyric","text":"When you think about me, do you think about 17","columns":46,"beats":4,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"A","column":25,"beat":2}]},{"id":"line-40","kind":"lyric","text":"Do you think about my old jeep","columns":30,"beats":6,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-41","kind":"lyric","text":"Think about the stars in the sky","columns":32,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-42","kind":"lyric","text":"Funny how a melody sounds like a memory","columns":39,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":19,"beat":2}]},{"id":"line-43","kind":"lyric","text":"Like a soundtrack to a july saturday night","columns":43,"beats":6,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":23,"beat":2},{"symbol":"Em","column":41,"beat":4}]},{"id":"line-44","kind":"lyric","text":"Springsteen","columns":12,"beats":8,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":11,"beat":4}]},{"id":"line-45","kind":"lyric","text":"Springsteen","columns":12,"beats":8,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":11,"beat":4}]},{"id":"line-46","kind":"lyric","text":"Woah-oh-oh-oh","columns":19,"beats":8,"changes":[{"symbol":"D","column":0,"beat":0},{"symbol":"G","column":11,"beat":2},{"symbol":"Bm","column":15,"beat":4},{"symbol":"A","column":18,"beat":6}]},{"id":"line-47","kind"