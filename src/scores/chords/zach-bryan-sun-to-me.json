{"version":1,"id":"zach-bryan-sun-to-me","title":"Sun To Me","artist":"Zach Bryan","key":"Am","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/zach-bryan/sun-to-me/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Zach Bryan","chords":[{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"","columns":8,"beats":8,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"G","column":3,"beat":2},{"symbol":"C","column":5,"beat":4},{"symbol":"F","column":7,"beat":6}]},{"id":"line-2","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"5:34 AM, was about to start my day","columns":34,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"G","column":13,"beat":2}]},{"id":"line-4","kind":"lyric","text":"She laid there across me, so I stayed anyway","columns":44,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"F","column":31,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Arms are tired, legs numb, wrapped around my knee","columns":49,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"G","column":27,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Sweetest of the sunflowers, how you're the sun to me","columns":52,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"F","column":32,"beat":2}]},{"id":"line-7","kind":"section","text":"[Instrumental]","columns":14,"beats":0,"changes":[]},{"id":"line-8","kind":"instrumental","text":"","columns":8,"beats":6,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"G","column":3,"beat":1},{"symbol":"C","column":5,"beat":3},{"symbol":"F","column":7,"beat":5}]},{"id":"line-9","kind":"section","text":"[Verse]","columns":7,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"Don't recall what you were wearing on the first night we met","columns":60,"beats":4,"changes":[{"symbol":"Am","column":7,"beat":0},{"symbol":"G","column":42,"beat":2}]},{"id":"line-11","kind":"lyric","text":"Besides a subtle cloud around you from my last cigarette","columns":56,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0},{"symbol":"F","column":43,"beat":2}]},{"id":"line-12","kind":"lyric","text":"And you come from a good place with a happy family","columns":50,"beats":4,"changes":[{"symbol":"Am","column":8,"beat":0},{"symbol":"G","column":38,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Only bad you've ever done was to see the good in me","columns":51,"beats":4,"changes":[{"symbol":"C","column":5,"beat":0},{"symbol":"F","column":34,"beat":2}]},{"id":"line-14","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"Well I've been livin, waitin on the day","columns":39,"beats":8,"changes":[{"symbol":"F","column":6,"beat":0},{"symbol":"C","column":15,"beat":2},{"symbol":"G","column":23,"beat":4},{"symbol":"Am","column":35,"beat":6}]},{"id":"line-16","kind":"lyric","text":"That the good lord willing sends you out my way","columns":47,"beats":4,"changes":[{"symbol":"F","column":10,"beat":0},{"symbol":"C","column":19,"beat":1},{"symbol":"G","column":27,"beat":2},{"symbol":"Am","column":43,"beat":3}]},{"id":"line-17","kind":"lyric","text":"I've seen hard times, bad luck, all that in between","columns":51,"beats":8,"changes":[{"symbol":"F","column":10,"beat":0},{"symbol":"C","column":22,"beat":2},{"symbol":"G","column":32,"beat":4},{"symbol":"Am","column":44,"beat":6}]},{"id":"line-18","kind":"lyric","text":"Sweetest of the sunflowers, how you're the sun to me","columns":52,"beats":8,"changes":[{"symbol":"F","column":1,"beat":0},{"symbol":"C","column":16,"beat":2},{"symbol":"G","column":27,"beat":4},{"symbol":"Am","column":48,"beat":6}]},{"id":"line-19","kind":"section","text":"[Instrumental]","columns":14,"beats":0,"changes":[]},{"id":"line-20","kind":"instrumental","text":"","columns":8,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"G","column":3,"beat":1},{"symbol":"C","column":5,"beat":2},{"symbol":"F","column":7,"beat":3}]},{"id":"line-21","kind":"section","text":"[Verse 3]","columns":9,"beats":0,"changes":[]},{"id":"line-22","kind":"lyric","text":"I remember being younger and my mother told me true","columns":51,"beats":4,"changes":[{"symbol":"Am","column":7,"beat":0},{"symbol":"G","column":37,"beat":2}]},{"id":"line-23","kind":"lyric","text":"Find someone who grows flowers in the darkest parts of you","columns":58,"beats":4,"changes":[{"symbol":"C","column":6,"beat":0},{"symbol":"F","column":38,"beat":2}]},{"id":"line-24","kind":"lyric","text":"Take heed when things get hard, and don't you ever turn around","columns":62,"beats":4,"changes":[{"symbol":"Am","column":6,"beat":0},{"symbol":"G","column":46,"beat":2}]},{"id":"line-25","kind":"lyric","text":"You'll find someone, someday, somewhere that grows you to the clouds","columns":68,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"F","column":44,"beat":2}]},{"id":"line-26","kind":"section","text":"[Verse 4]","columns":9,"beats":0,"changes":[]},{"id":"line-27","kind":"lyric","text":"And you walked me home that evening when I could barely walk","columns":60,"beats":4,"changes":[{"symbol":"Am","column":8,"beat":0},{"symbol":"G","column":41,"beat":2}]},{"id":"line-28","kind":"lyric","text":"And you spoke to me so sweetly on the days I couldn't talk","columns":58,"beats":4,"changes":[{"symbol":"C","column":11,"beat":0},{"symbol":"F","column":39,"beat":2}]},{"id":"line-29","kind":"lyric","text":"Now I'm seeing clearly and I'm growing up so free","columns":49,"beats":4,"changes":[{"symbol":"Am","column":7,"beat":0},{"symbol":"G","column":34,"beat":2}]},{"id":"line-30","kind":"lyric","text":"Sweetest of the sunflowers, yeah you're the sun to me","columns":53,"beats":4,"changes":[{"symbol":"C","column":10,"beat":0},{"symbol":"F","column":42,"beat":2}]},{"id":"line-31","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-32","kind":"lyric","text":"Well I've been livin, waitin on the day","columns":39,"beats":8,"changes":[{"symbol":"F","column":6,"beat":0},{"symbol":"C","column":15,"beat":2},{"symbol":"G","column":23,"beat":4},{"symbol":"Am","column":36,"beat":6}]},{"id":"line-33","kind":"lyric","text":"That the good lord willing sends you out my way","columns":47,"beats":8,"changes":[{"symbol":"F","column":10,"beat":0},{"symbol":"C","column":19,"beat":2},{"symbol":"G","column":27,"beat":4},{"symbol":"Am","column":43,"beat":6}]},{"id":"line-34","kind":"lyric","text":"I've seen hard times, bad luck, all that in between","columns":51,"beats":8,"changes":[{"symbol":"F","column":11,"beat":0},{"symbol":"C","column":23,"beat":2},{"symbol":"G","column":34,"beat":4},{"symbol":"Am","column":46,"beat":6}]},{"id":"line-35","kind":"lyric","text":"Sweetest of the sunflowers, how you're the sun to me","columns":52,"beats":8,"changes":[{"symbol":"F","column":1,"beat":0},{"symbol":"C","column":16,"beat":2},{"symbol":"G","column":27,"beat":4},{"symbol":"Am","column":48,"beat":6}]},{"id":"line-36","kind":"lyric","text":"Sweetest of the sunflowers, how you're the sun to me","columns":52,"beats":8,"changes":[{"symbol":"F","column":0,"beat":0},{"symbol":"C","column":16,"beat":2},{"symbol":"G","column":27,"beat":4},{"symbol":"Am","column":48,"beat":6}]}]}