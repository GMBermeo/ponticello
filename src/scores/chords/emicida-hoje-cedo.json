":4,"changes":[{"symbol":"Bbm","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Coisas que afetam sintonia","columns":26,"beats":4,"changes":[{"symbol":"Ab","column":13,"beat":0}]},{"id":"line-25","kind":"lyric","text":"Como sonhei em tá aqui um dia","columns":29,"beats":4,"changes":[]},{"id":"line-26","kind":"lyric","text":"Crise, trampo, ideologia, pause","columns":31,"beats":4,"changes":[{"symbol":"Eb7/G","column":2,"beat":0}]},{"id":"line-27","kind":"lyric","text":"E é aqui, onde \"nóis\" entende a Amy Winehouse","columns":45,"beats":4,"changes":[]},{"id":"line-28","kind":"lyric","text":"Hoje cedo","columns":9,"beats":4,"changes":[{"symbol":"Bbm","column":6,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Quando eu acordei e não te vi","columns":33,"beats":4,"changes":[{"symbol":"Ab","column":15,"beat":0},{"symbol":"Eb7/G","column":28,"beat":2}]},{"id":"line-30","kind":"lyric","text":"Eu pensei em tanta coisa","columns":24,"beats":4,"changes":[{"symbol":"F#","column":20,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Tive medo","columns":9,"beats":2,"changes":[{"symbol":"Bbm","column":6,"beat":0}]},{"id":"line-32","kind":"lyric","text":"Ah, como eu chorei, eu sofri","columns":28,"beats":4,"changes":[{"symbol":"Ab","column":16,"beat":0}]},{"id":"line-33","kind":"lyric","text":"Em segredo","columns":12,"beats":4,"changes":[{"symbol":"Eb7/G","column":7,"beat":0}]},{"id":"line-34","kind":"lyric","text":"Tudo isso, hoje cedo","columns":20,"beats":4,"changes":[{"symbol":"F#","column":17,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Vagabundo, a trilha é um precipício, tenso, o melhor","columns":52,"beats":4,"changes":[{"symbol":"Bbm","column":0,"beat":0},{"symbol":"Ab","column":34,"beat":2}]},{"id":"line-36","kind":"lyric","text":"Quero salvar o mundo","columns":21,"beats":4,"changes":[{"symbol":"Eb7/G","column":16,"beat":0}]},{"id":"line-37","kind":"lyric","text":"pois desisti da minha família e numa luta mais difícil","columns":54,"beats":2,"changes":[{"symbol":"F#","column":38,"beat":0}]},{"id":"line-38","kind":"lyric","text":"A frustração vai ser menor","columns":27,"beats":4,"changes":[{"symbol":"Bbm","column":24,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Digno de dó, só o pó, vazio comum","columns":33,"beats":4,"changes":[]},{"id":"line-40","kind":"lyric","text":"   que já é moda no século 21","columns":29,"beats":4,"changes":[{"symbol":"Ab","column":0,"beat":0}]},{"id":"line-41","kind":"lyric","text":"      Blacks com voz sagaz gravada","columns":34,"beats":4,"changes":[{"symbol":"Eb7/G","column":0,"beat":0}]},{"id":"line-42","kind":"lyric","text":"Contra vilões que sangram a quebrada","columns":36,"beats":4,"changes":[{"symbol":"F#","column":1,"beat":0}]},{"id":"line-43","kind":"lyric","text":"Só que raps por nóiz, por paz, mais nada","columns":40,"beats":4,"changes":[{"symbol":"Bbm","column":8,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Me pôs nas gerais, numa cela trancada","columns":37,"beats":2,"changes":[{"symbol":"Ab","column":4,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Eu lembrei do Racionais, reflexão","columns":33,"beats":2,"changes":[{"symbol":"Eb7/G","column":8,"beat":0}]},{"id":"line-46","kind":"lyric","text":"Aí, os próprio preto num tá nem aí com isso, não","columns":48,"beats":2,"changes":[{"symbol":"F#","column":9,"beat":0}]},{"id":"line-47","kind":"lyric","text":"É um clichê romântico, triste","columns":29,"beats":4,"changes":[{"symbol":"Bb","column":10,"beat":0}]},{"id":"line-48","kind":"lyric","text":"Vai perceber, vai ver, se matou e o paraíso não existe","columns":54,"beats":4,"changes":[{"symbol":"Ab","column":21,"beat":0}]},{"id":"line-49","kind":"lyric","text":"Eu ainda sou o Emicida da Rinha","columns":31,"beats":4,"changes":[{"symbol":"Eb7/G","column":10,"beat":0}]},{"id":"line-50","kind":"lyric","text":"Lotei casas do sul ao norte","columns":27,"beats":4,"changes":[{"symbol":"F#","column":16,"beat":0}]},{"id":"line-51","kind":"lyric","text":"Mas esvaziei a minha","columns":20,"beats":4,"changes":[]},{"id":"line-52","kind":"lyric","text":"E vou por aí, Taleban","columns":21,"beats":4,"changes":[{"symbol":"Bbm","column":5,"beat":0}]},{"id":"line-53","kind":"lyric","text":"vendo os boy beber dois mês de salário da minha irmã","columns":52,"beats":4,"changes":[{"symbol":"Ab","column":18,"beat":0}]},{"id":"line-54","kind":"lyric","text":"Hennessys, avelãs, camarins, fãs, globais","columns":41,"beats":2,"changes":[{"symbol":"Eb7/G","column":7,"beat":0}]},{"id":"line-55","kind":"lyric","text":"Mano, onde eles tavam há dez anos atrás","columns":39,"beats":2,"changes":[{"symbol":"F#","column":4,"beat":0}]},{"id":"line-56","kind":"lyric","text":"Showbiz como a regra diz, lek","columns":29,"beats":4,"changes":[{"symbol":"Bbm","column":5,"beat":0}]},{"id":"line-57","kind":"lyric","text":"A sociedade vende Jesus, por que não ia vender rap","columns":50,"beats":6,"changes":[{"symbol":"Ab","column":11,"beat":0}]},{"id":"line-58","kind":"lyric","text":"      O mundo vai se ocupar com seu cifrão","columns":42,"beats":4,"changes":[{"symbol":"Eb7/G","column":0,"beat":0}]},{"id":"line-59","kind":"lyric","text":"dizendo que a miséria é quem carecia de atenção","columns":47,"beats":4,"changes":[{"symbol":"F#","column":12,"beat":0}]},{"id":"line-60","kind":"lyric","text":"Hoje cedo","columns":9,"beats":4,"changes":[{"symbol":"Bbm","column":6,"beat":0}]},{"id":"line-61","kind":"lyric","text":"Quando eu acordei e não te vi","columns":33,"beats":4,"changes":[{"symbol":"Ab","column":15,"beat":0},{"symbol":"Eb7/G","column":28,"beat":2}]},{"id":"line-62","kind":"lyric","text":"Eu pensei em tanta coisa","columns":24,"beats":4,"changes":[{"symbol":"F#","column":20,"beat":0}]},{"id":"line-63","kind":"lyric","text":"Tive medo","columns":9,"beats":4,"changes":[{"symbol":"Bbm","column":6,"beat":0}]},{"id":"line-64","kind":"lyric","text":"Ah, como eu chorei, eu sofri","columns":28,"beats":4,"changes":[{"symbol":"Ab","column":16,"beat":0}]},{"id