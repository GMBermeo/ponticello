{"version":1,"id":"dwayne-johnson-youre-welcome","title":"Youre Welcome","artist":"Dwayne Johnson","key":"F","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/dwayne-johnson/youre-welcome/?instrument=keyboard","spotifyUrl":"https://open.spotify.com/track/6U4VqEHy4n5VeiH4pQPL24","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":null,"chords":[{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Okay, okay, I see what's happening here","columns":39,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0},{"symbol":"C","column":14,"beat":2},{"symbol":"F","column":36,"beat":4}]},{"id":"line-2","kind":"lyric","text":"You're face-to-face with greatness and it's strange","columns":51,"beats":4,"changes":[{"symbol":"Bb","column":7,"beat":0},{"symbol":"C","column":49,"beat":2}]},{"id":"line-3","kind":"lyric","text":"You don't even know how you feel, it's adorable","columns":47,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0},{"symbol":"F","column":40,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Well, it's nice to see that humans never change","columns":47,"beats":4,"changes":[{"symbol":"Bb","column":10,"beat":0},{"symbol":"C","column":44,"beat":2}]},{"id":"line-5","kind":"lyric","text":"Open your eyes, let's begin","columns":27,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"F","column":24,"beat":2}]},{"id":"line-6","kind":"lyric","text":"Yes, it's really me, it's Maui, breathe it in","columns":48,"beats":4,"changes":[{"symbol":"Bb","column":14,"beat":0},{"symbol":"C","column":47,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I know it's a lot: the hair, the bod","columns":36,"beats":4,"changes":[{"symbol":"C","column":12,"beat":0},{"symbol":"F","column":34,"beat":2}]},{"id":"line-8","kind":"lyric","text":"When you're staring at a demigod","columns":32,"beats":4,"changes":[{"symbol":"Bb","column":12,"beat":0},{"symbol":"C","column":31,"beat":2}]},{"id":"line-9","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"What can I say except \"you're welcome\"?","columns":39,"beats":6,"changes":[{"symbol":"Am","column":4,"beat":0},{"symbol":"F","column":16,"beat":2},{"symbol":"C","column":34,"beat":4}]},{"id":"line-11","kind":"lyric","text":"For the tides, the sun, the sky","columns":31,"beats":4,"changes":[{"symbol":"E","column":9,"beat":0},{"symbol":"Am","column":27,"beat":2}]},{"id":"line-12","kind":"lyric","text":"Hey, it's okay, it's okay, you're welcome","columns":41,"beats":4,"changes":[{"symbol":"F","column":9,"beat":0},{"symbol":"C","column":32,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I'm just an ordinary demi-guy!","columns":30,"beats":4,"changes":[{"symbol":"E","column":6,"beat":0},{"symbol":"C","column":23,"beat":2}]},{"id":"line-14","kind":"section","text":"[Verse 2]","columns":9,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"Hey, what has two thumbs and pulled up the sky","columns":46,"beats":4,"changes":[{"symbol":"C","column":14,"beat":0},{"symbol":"F","column":43,"beat":2}]},{"id":"line-16","kind":"lyric","text":"When you were waddling yay high? This guy","columns":41,"beats":4,"changes":[{"symbol":"Bb","column":13,"beat":0}]},{"id":"line-17","kind":"lyric","text":"When the nights got cold, who stole you fire from down below?","columns":64,"beats":8,"changes":[{"symbol":"C","column":14,"beat":0},{"symbol":"F","column":40,"beat":2},{"symbol":"Bb","column":62,"beat":5}]},{"id":"line-18","kind":"lyric","text":"You're looking at him, yo!","columns":26,"beats":4,"changes":[{"symbol":"Bb","column":0,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Oh, also I lassoed the sun, you're welcome","columns":42,"beats":4,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"F","column":24,"beat":2}]},{"id":"line-20","kind":"lyric","text":"To stretch your days and bring you fun","columns":38,"beats":4,"changes":[{"symbol":"Bb","column":7,"beat":0},{"symbol":"C","column":35,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Also, I harnessed the breeze, you're welcome","columns":44,"beats":4,"changes":[{"symbol":"C","column":8,"beat":0},{"symbol":"F","column":25,"beat":2}]},{"id":"line-22","kind":"lyric","text":"To fill your sails and shake your trees","columns":44,"beats":6,"changes":[{"symbol":"Bb","column":11,"beat":0},{"symbol":"C","column":27,"beat":2},{"symbol":"Am","column":42,"beat":4}]},{"id":"line-23","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-24","kind":"lyric","text":"So, what can I say except \"you're welcome\"?","columns":43,"beats":6,"changes":[{"symbol":"Am","column":7,"beat":0},{"symbol":"F","column":16,"beat":2},{"symbol":"C","column":37,"beat":4}]},{"id":"line-25","kind":"lyric","text":"For the islands I pulled from the sea","columns":37,"beats":4,"changes":[{"symbol":"E","column":9,"beat":0},{"symbol":"Am","column":32,"beat":2}]},{"id":"line-26","kind":"lyric","text":"There's no need to pray, it's okay, you're welcome","columns":50,"beats":4,"changes":[{"symbol":"F","column":19,"beat":0},{"symbol":"C","column":45,"beat":2}]},{"id":"line-27","kind":"lyric","text":"I guess it's just my way of being me","columns":36,"beats":4,"changes":[{"symbol":"E","column":5,"beat":0},{"symbol":"Am","column":33,"beat":2}]},{"id":"line-28","kind":"lyric","text":"You're welcome, you're welcome","columns":30,"beats":4,"changes":[{"symbol":"F","column":7,"beat":0},{"symbol":"C","column":23,"beat":2}]},{"id":"line-29","kind":"section","text":"[Verse 3]","columns":9,"beats":0,"changes":[]},{"id":"line-30","kind":"lyric","text":"Well, come to think of it","columns":25,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Kid, honestly, I can go on and on","columns":33,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-32","kind":"lyric","text":"N.C.","columns":4,"beats":4,"changes":[]},{"id":"line-33","kind":"lyric","text":"I can explain every natural phenomenon","columns":38,"beats":4,"changes":[]},{"id":"line-34","kind":"lyric","text":"The tide, the grass, the ground","columns":31,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-35","kind":"lyric","text":"N.C.","columns":4,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"Oh, that was Maui just messing around","columns":37,"beats":4,"changes":[]},{"id":"line-37","kind":"lyric","text":"I killed an eel, I buried its guts","columns":34,"beats":6,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-38","kind":"lyric","text":"N.C.","columns":4,"beats":4,"changes":[]},{"id":"line-39","kind":"lyric","text":"Sprouted a tree, now you've got coconuts","columns":40,"beats":4,"changes":[]},{"id":"line-40","kind":"lyric","text":"What's the lesson? What is the takeaway?","columns":40,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-41","kind":"lyric","text":"N.C.","columns":4,"beats":4,"changes":[]},{"id":"line-42","kind":"lyric","text":"Don't mess with Maui when he's on the breakaway","columns":47,"beats":4,"changes":[]},{"id":"line-43","kind":"lyric","text":"And the tapestry here in my skin","columns":32,"beats":4,"changes":[{"symbol":"Am","column":0,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Is a map of the victories I win","columns":31,"beats":4,"changes":[{"symbol":"F","column":0,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Look where I've been, I make everything happen","columns":46,"beats":4,"changes":[{"symbol":"C","column":0,"beat":0}]},{"id":"line-46","kind":"lyric","text":"Look at that mean mini Maui just tippity tapping","columns":48,"beats":4,"changes":[{"symbol":"E","column":3,"beat":0},{"symbol":"E","column":33,"beat":2}]},{"id":"line-47","kind":"lyric","text":"Ha, ha, ha, ha, ha, ha, hey","columns":27,"beats":4,"changes":[{"symbol":"E","column":3,"beat":0}]},{"id":"line-48","kind":"section","text":"[Chorus]","columns":8,"beats":0,"changes":[]},{"id":"line-49","kind":"lyric","text":"Well anyway, let me say \"you're welcome\"","columns":40,"beats":6,"changes":[{"symbol":"Am","column":0,"beat":0},{"symbol":"F","column":9,"beat":2},{"symbol":"C","column":30,"beat":4}]},{"id":"line-50","kind":"lyric","text":"For the wonderful world you know","columns":32,"beats":4,"changes":[{"symbol":"E","column":8,"beat":0},{"symbol":"Am","column":27,"beat":2}]},{"id":"line-51","kind":"lyric","text":"Hey, it's okay, it's okay, you're welcome","columns":41,"beats":4,"changes":[{"symbol":"F","column":11,"beat":0},{"symbol":"C","column":35,"beat":2}]},{"id":"line-52","kind":"lyric","text":"Well, come to think of it, I gotta go","columns":37,"beats":4,"changes":[{"symbol":"E","column":7,"beat":0},{"symbol":"Am","column":34,"beat":2}]},{"id":"line-53","kind":"lyric","text":"Hey, it's your day to say \"you're welcome\"","columns":42,"beats":4,"changes":[{"symbol":"F","column":16,"beat":0},{"symbol":"C","column":37,"beat":2}]},{"id":"line-54","kind":"lyric","text":"'Cause I'm gonna need that boat","columns":31,"beats":4,"changes":[{"symbol":"E","column":8,"beat":0},{"symbol":"Am","column":27,"beat":2}]},{"id":"line-55","kind":"lyric","text":"I'm sailing away, away, you're welcome","columns":38,"beats":4,"changes":[{"symbol":"F","column":13,"beat":0},{"symbol":"C","column":32,"beat":2}]},{"id":"line-56","kind":"lyric","text":"'Cause Maui can do everything but float","columns":39,"beats":4,"changes":[{"symbol":"E","column":8,"beat":0},{"symbol":"Am","column":34,"beat":2}]},{"id":"line-57","kind":"lyric","text":"You're welcome, you're welcome","columns":30,"beats":4,"changes":[{"symbol":"F","column":7,"beat":0},{"symbol":"C","column":24,"beat":2}]},{"id":"line-58","kind":"section","text":"[Outro]","columns":7,"beats":0,"changes":[]},{"id":"line-59","kind":"lyric","text":"And thank you!","columns":14,"beats":4,"changes":[{"symbol":"C","column":4,"beat":0}]}]}