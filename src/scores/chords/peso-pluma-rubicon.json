{"version":1,"id":"peso-pluma-rubicon","title":"Rubicon","artist":"Peso Pluma","key":"F","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/peso-pluma/rubicon/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Peso Pluma and Luis Ernesto Vega Carvajal","chords":[{"symbol":"Dm7","canonical":"Dm7","keyboardPitchClasses":[2,5,9,0],"interpretation":null},{"symbol":"C7","canonical":"C7","keyboardPitchClasses":[0,4,7,10],"interpretation":null},{"symbol":"F","canonical":"F","keyboardPitchClasses":[5,9,0],"interpretation":null},{"symbol":"Bb","canonical":"Bb","keyboardPitchClasses":[10,2,5],"interpretation":null},{"symbol":"C#7","canonical":"C#7","keyboardPitchClasses":[1,5,8,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Dicen que soy mamón, también que soy culero","columns":43,"beats":4,"changes":[{"symbol":"Dm7","column":0,"beat":0},{"symbol":"C7","column":39,"beat":2}]},{"id":"line-2","kind":"lyric","text":"No les pongo atención y muy poco les creo","columns":41,"beats":4,"changes":[{"symbol":"Dm7","column":38,"beat":0}]},{"id":"line-3","kind":"lyric","text":"No sufro de conciencia, yo cuido mi cuero","columns":41,"beats":4,"changes":[{"symbol":"C7","column":37,"beat":0}]},{"id":"line-4","kind":"lyric","text":"Se me activa el instinto con un buen veneno","columns":43,"beats":4,"changes":[{"symbol":"Dm7","column":39,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Pendiente al celular y también de los medio'","columns":44,"beats":4,"changes":[{"symbol":"C7","column":39,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Pa' que no haya problemas por estos terrenos","columns":44,"beats":4,"changes":[{"symbol":"Dm7","column":39,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Ando bien protegido desde allá del cielo","columns":40,"beats":4,"changes":[{"symbol":"C7","column":37,"beat":0}]},{"id":"line-8","kind":"lyric","text":"Te adelantaste, hermano, luego nos veremos","columns":42,"beats":4,"changes":[{"symbol":"Dm7","column":37,"beat":0}]},{"id":"line-9","kind":"lyric","text":"Nomás me quedan los que aquí traigo colgando","columns":44,"beats":4,"changes":[{"symbol":"C7","column":39,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Son pocas amistades a mi lado","columns":29,"beats":4,"changes":[{"symbol":"Dm7","column":26,"beat":0}]},{"id":"line-11","kind":"lyric","text":"Me cuidan los collares que traigo en el pecho","columns":45,"beats":4,"changes":[{"symbol":"C7","column":42,"beat":0}]},{"id":"line-12","kind":"lyric","text":"Alejan las envidias y a los traicioneros","columns":40,"beats":4,"changes":[{"symbol":"Dm7","column":33,"beat":0}]},{"id":"line-13","kind":"lyric","text":"Y aquí sigo por el camino","columns":25,"beats":4,"changes":[{"symbol":"F","column":22,"beat":0}]},{"id":"line-14","kind":"lyric","text":"Casi siempre me ven tranquilo","columns":29,"beats":4,"changes":[{"symbol":"C7","column":16,"beat":0}]},{"id":"line-15","kind":"lyric","text":"Cumpliendo mi objetivo, pienso positivo","columns":39,"beats":4,"changes":[{"symbol":"Bb","column":19,"beat":0}]},{"id":"line-16","kind":"lyric","text":"Siempre con un gallo me verán activo","columns":36,"beats":4,"changes":[{"symbol":"C#7","column":17,"beat":0},{"symbol":"C7","column":33,"beat":2}]},{"id":"line-17","kind":"lyric","text":"Para trabajar, me pinto","columns":23,"beats":4,"changes":[{"symbol":"F","column":9,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Los billetes no caen solitos","columns":28,"beats":4,"changes":[{"symbol":"C7","column":18,"beat":0}]},{"id":"line-19","kind":"lyric","text":"Moviendo esos paquetes llenos de cuadritos","columns":42,"beats":4,"changes":[{"symbol":"Bb","column":17,"beat":0}]},{"id":"line-20","kind":"lyric","text":"Verdes dolaritos, puros benjamines me hacen generar","columns":51,"beats":6,"changes":[{"symbol":"C#7","column":10,"beat":0},{"symbol":"C7","column":30,"beat":2},{"symbol":"F","column":48,"beat":4}]},{"id":"line-21","kind":"lyric","text":"Ahí me vieron pasar en un Rubicon","columns":33,"beats":4,"changes":[{"symbol":"C7","column":0,"beat":0},{"symbol":"Dm7","column":29,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Suman los Cryptos y bajo control","columns":32,"beats":4,"changes":[{"symbol":"C7","column":28,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Nos mantenemos a la orden del señor","columns":35,"beats":4,"changes":[{"symbol":"Dm7","column":31,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Con un gallo, me relajo yo","columns":28,"beats":4,"changes":[{"symbol":"C7","column":1,"beat":0},{"symbol":"Dm7","column":25,"beat":2}]},{"id":"line-25","kind":"lyric","text":"Allá en las dunas, siempre tranquilón","columns":37,"beats":4,"changes":[{"symbol":"C7","column":33,"beat":0}]},{"id":"line-26","kind":"lyric","text":"Compa, ando torcido, ya me pegó el blunt","columns":40,"beats":4,"changes":[{"symbol":"Dm7","column":36,"beat":0}]},{"id":"line-27","kind":"lyric","text":"En la orilla del mar, me verán","columns":31,"beats":4,"changes":[{"symbol":"C7","column":0,"beat":0},{"symbol":"Dm7","column":28,"beat":2}]},{"id":"line-28","kind":"lyric","text":"Con hierbita pa' desestresar","columns":28,"beats":4,"changes":[{"symbol":"C7","column":25,"beat":0}]},{"id":"line-29","kind":"lyric","text":"Siempre a la orden y aquí voy a estar","columns":37,"beats":4,"changes":[{"symbol":"Dm7","column":34,"beat":0}]},{"id":"line-30","kind":"lyric","text":"Y para qué voy a hablar de más","columns":30,"beats":4,"changes":[{"symbol":"C7","column":28,"beat":0}]},{"id":"line-31","kind":"lyric","text":"Por El Chapillo me han de apodar","columns":32,"beats":4,"changes":[{"symbol":"Dm7","column":28,"beat":0}]},{"id":"line-32","kind":"lyric","text":"La bandera es internacional","columns":27,"beats":4,"changes":[{"symbol":"C7","column":0,"beat":0},{"symbol":"Dm7","column":24,"beat":2}]},{"id":"line-33","kind":"lyric","text":"Efectivo para trabajar","columns":22,"beats":4,"changes":[{"symbol":"C7","column":18,"beat":0}]},{"id":"line-34","kind":"lyric","text":"En el equipo piñas y también SCAR","columns":33,"beats":6,"changes":[{"symbol":"Dm7","column":30,"beat":0}]},{"id":"line-35","kind":"lyric","text":"Y pa' los que quieran afectar","columns":29,"beats":4,"changes":[{"symbol":"C7","column":24,"beat":0}]},{"id":"line-36","kind":"lyric","text":"Creo en mis santos y en el Eleguá","columns":33,"beats":4,"changes":[{"symbol":"Dm7","column":29,"beat":0}]},{"id":"line-37","kind":"lyric","text":"Y hablando de antes, no voy a volver atrás","columns":42,"beats":4,"changes":[{"symbol":"C7","column":38,"beat":0}]},{"id":"line-38","kind":"lyric","text":"Hacer billetes es la prioridad","columns":30,"beats":4,"changes":[{"symbol":"Dm7","column":27,"beat":0}]},{"id":"line-39","kind":"lyric","text":"Y aquí sigo por el camino","columns":25,"beats":4,"changes":[{"symbol":"F","column":15,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Casi siempre me ven tranquilo","columns":29,"beats":4,"changes":[{"symbol":"C7","column":17,"beat":0}]},{"id":"line-41","kind":"lyric","text":"Cumpliendo mi objetivo, pienso positivo","columns":39,"beats":2,"changes":[{"symbol":"Bb","column":18,"beat":0}]},{"id":"line-42","kind":"lyric","text":"Siempre con un gallo me verán activo","columns":36,"beats":4,"changes":[{"symbol":"C#7","column":16,"beat":0},{"symbol":"C7","column":31,"beat":2}]},{"id":"line-43","kind":"lyric","text":"Para trabajar, me pinto","columns":23,"beats":4,"changes":[{"symbol":"F","column":9,"beat":0}]},{"id":"line-44","kind":"lyric","text":"Los billetes no caen solitos","columns":28,"beats":4,"changes":[{"symbol":"C7","column":17,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Moviendo esos paquetes llenos de cuadritos","columns":42,"beats":4,"changes":[{"symbol":"Bb","column":17,"beat":0}]},{"id":"line-46","kind":"lyric","text":"Verdes dolaritos, puros benjamines me hacen generar","columns":51,"beats":6,"changes":[{"symbol":"C#7","co