{"version":1,"id":"olivia-dean-i-ve-seen-it","title":"I've Seen It","artist":"Olivia Dean","key":"D","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/olivia-dean/i-ve-seen-it/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Gang Wolf, Bastian Langebaek and Olivia Dean","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"Em","canonical":"Em","keyboardPitchClasses":[4,7,11],"interpretation":null},{"symbol":"B","canonical":"B","keyboardPitchClasses":[11,3,6],"interpretation":null},{"symbol":"C","canonical":"C","keyboardPitchClasses":[0,4,7],"interpretation":null},{"symbol":"Cm","canonical":"Cm","keyboardPitchClasses":[0,3,7],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":29,"beats":14,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"D","column":11,"beat":2},{"symbol":"Em","column":14,"beat":4},{"symbol":"B","column":18,"beat":6},{"symbol":"C","column":21,"beat":8},{"symbol":"Cm","column":24,"beat":10},{"symbol":"G","column":28,"beat":12}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"  I've seen it last for thirty years","columns":36,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":14,"beat":2},{"symbol":"Em","column":32,"beat":4}]},{"id":"line-4","kind":"lyric","text":"Seen it bloom, then end in tears","columns":32,"beats":4,"changes":[{"symbol":"B","column":9,"beat":0},{"symbol":"C","column":27,"beat":1}]},{"id":"line-5","kind":"lyric","text":"I've seen it after school and in the park","columns":41,"beats":4,"changes":[{"symbol":"Cm","column":13,"beat":0},{"symbol":"G","column":30,"beat":2}]},{"id":"line-6","kind":"lyric","text":"  Sat right across me on the tube","columns":33,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":14,"beat":2},{"symbol":"Em","column":29,"beat":4}]},{"id":"line-7","kind":"lyric","text":"Seen it miss a stop or two","columns":26,"beats":4,"changes":[{"symbol":"B","column":10,"beat":0},{"symbol":"C","column":23,"beat":2}]},{"id":"line-8","kind":"lyric","text":"Seen it trying not to fall apart","columns":32,"beats":4,"changes":[{"symbol":"Cm","column":8,"beat":0},{"symbol":"G","column":23,"beat":2}]},{"id":"line-9","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-10","kind":"lyric","text":"   I've heard it laced in every song","columns":36,"beats":6,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"B","column":18,"beat":2},{"symbol":"Em","column":32,"beat":4}]},{"id":"line-11","kind":"lyric","text":"And still the words all come out wrong","columns":38,"beats":4,"changes":[{"symbol":"A","column":14,"beat":0},{"symbol":"C","column":33,"beat":2}]},{"id":"line-12","kind":"lyric","text":"It doesn't always answer when you call","columns":38,"beats":4,"changes":[{"symbol":"Cm","column":11,"beat":0},{"symbol":"G","column":25,"beat":2}]},{"id":"line-13","kind":"lyric","text":"  Brings out the worst, brings out the","columns":41,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":17,"beat":2},{"symbol":"Em","column":39,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Best","columns":4,"beats":4,"changes":[]},{"id":"line-15","kind":"lyric","text":"I understand it less and less","columns":29,"beats":4,"changes":[{"symbol":"B","column":8,"beat":0},{"symbol":"C","column":24,"beat":2}]},{"id":"line-16","kind":"lyric","text":"I guess I'm not supposed to know it all","columns":39,"beats":4,"changes":[{"symbol":"Cm","column":12,"beat":0},{"symbol":"G","column":28,"beat":2}]},{"id":"line-17","kind":"section","text":"[Ponte]","columns":7,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"I've seen it dance with friends around the","columns":42,"beats":4,"changes":[{"symbol":"C","column":13,"beat":0},{"symbol":"D","column":24,"beat":2}]},{"id":"line-19","kind":"lyric","text":" Table","columns":6,"beats":4,"changes":[{"symbol":"G","column":1,"beat":0}]},{"id":"line-20","kind":"lyric","text":"In Eleanor, Rosie and Louise","columns":28,"beats":6,"changes":[{"symbol":"C","column":7,"beat":0},{"symbol":"D","column":12,"beat":2},{"symbol":"G","column":24,"beat":4}]},{"id":"line-21","kind":"lyric","text":"And it makes me cry to think that I am","columns":38,"beats":4,"changes":[{"symbol":"C","column":16,"beat":0},{"symbol":"D","column":23,"beat":2}]},{"id":"line-22","kind":"lyric","text":"Able","columns":4,"beats":4,"changes":[{"symbol":"Em","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"   To give it back the way it gives to me","columns":41,"beats":6,"changes":[{"symbol":"A","column":0,"beat":0},{"symbol":"Am","column":13,"beat":2},{"symbol":"D","column":36,"beat":4}]},{"id":"line-24","kind":"section","text":"[Terceira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-25","kind":"lyric","text":"  I've seen it grow old and forget","columns":34,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":15,"beat":2},{"symbol":"Em","column":32,"beat":4}]},{"id":"line-26","kind":"lyric","text":"Until it's just a silhouеtte","columns":28,"beats":4,"changes":[{"symbol":"B","column":14,"beat":0},{"symbol":"C","column":25,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Till someone picks it up and sends it on","columns":40,"beats":4,"changes":[{"symbol":"Cm","column":13,"beat":0},{"symbol":"G","column":29,"beat":2}]},{"id":"line-28","kind":"lyric","text":"  I've seen the films, I've read the books","columns":42,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":16,"beat":2},{"symbol":"Em","column":37,"beat":4}]},{"id":"line-29","kind":"lyric","text":"My mum and dad, they got me hooked","columns":34,"beats":4,"changes":[{"symbol":"B","column":12,"beat":0},{"symbol":"C","column":27,"beat":2}]},{"id":"line-30","kind":"lyric","text":"The fairy tale, the search goes on and on","columns":41,"beats":4,"changes":[{"symbol":"Cm","column":10,"beat":0},{"symbol":"G","column":32,"beat":2}]},{"id":"line-31","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-32","kind":"lyric","text":"    The more you look, the more you find","columns":40,"beats":6,"changes":[{"symbol":"Em","column":0,"beat":0},{"symbol":"B","column":17,"beat":2},{"symbol":"Em","column":36,"beat":4}]},{"id":"line-33","kind":"lyric","text":"It's all around you all the time","columns":32,"beats":4,"changes":[{"symbol":"A","column":11,"beat":0},{"symbol":"C","column":28,"beat":2}]},{"id":"line-34","kind":"lyric","text":"Catches your eye, you blink and then it's","columns":41,"beats":4,"changes":[{"symbol":"Cm","column":13,"beat":0},{"symbol":"G","column":32,"beat":2}]},{"id":"line-35","kind":"lyric","text":"Gone","columns":4,"beats":4,"changes":[]},{"id":"line-36","kind":"lyric","text":"  Brings out the worst, brings out the","columns":41,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"D","column":17,"beat":2},{"symbol":"Em","column":39,"beat":4}]},{"id":"line-37","kind":"lyric","text":"Best","columns":4,"beats":4,"changes":[]},{"id":"line-38","kind":"lyric","text":"I know it's somewhere in my chest","columns":33,"beats":4,"changes":[{"symbol":"B","column":13,"beat":0},{"symbol":"C","column":27,"beat":2}]},{"id":"line-39","kind":"lyric","text":"I guess it's been inside me all along","columns":37,"beats":4,"changes":[{"symbol":"Cm","column":13,"beat":0},{"symbol":"G","column":28,"beat":2}]}]}