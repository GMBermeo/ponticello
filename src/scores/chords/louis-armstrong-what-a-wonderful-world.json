":8,"changes":[{"symbol":"Bb7M","column":0,"beat":0},{"symbol":"Am","column":16,"beat":4}]},{"id":"line-12","kind":"lyric","text":"    The bright blessed day","columns":29,"beats":6,"changes":[{"symbol":"Gm7","column":0,"beat":0},{"symbol":"F7M","column":17,"beat":2},{"symbol":"A7","column":27,"beat":4}]},{"id":"line-13","kind":"lyric","text":"The dark sacred night","columns":21,"beats":4,"changes":[{"symbol":"Dm","column":17,"beat":0}]},{"id":"line-14","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-15","kind":"lyric","text":"And I think to myself","columns":21,"beats":4,"changes":[{"symbol":"Db7M","column":8,"beat":0}]},{"id":"line-16","kind":"lyric","text":"      What a wonderful world","columns":41,"beats":12,"changes":[{"symbol":"Gm7/C","column":0,"beat":0},{"symbol":"C7","column":14,"beat":2},{"symbol":"F7M","column":24,"beat":4},{"symbol":"Gm7","column":29,"beat":6},{"symbol":"Bb","column":34,"beat":8},{"symbol":"F7M","column":38,"beat":10}]},{"id":"line-17","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"The colors of the rainbow","columns":25,"beats":4,"changes":[{"symbol":"C7","column":5,"beat":0}]},{"id":"line-19","kind":"lyric","text":"So pretty in the sky","columns":20,"beats":4,"changes":[{"symbol":"F7M","column":5,"beat":0}]},{"id":"line-20","kind":"lyric","text":"    Are also on the faces of people goin' by","columns":44,"beats":4,"changes":[{"symbol":"Gm7","column":0,"beat":0},{"symbol":"F7M","column":30,"beat":2}]},{"id":"line-21","kind":"lyric","text":"I see friends shaking hands, saying","columns":35,"beats":4,"changes":[{"symbol":"Dm","column":9,"beat":0},{"symbol":"C/E","column":23,"beat":2}]},{"id":"line-22","kind":"lyric","text":"How do you do?","columns":14,"beats":4,"changes":[{"symbol":"Dm","column":1,"beat":0},{"symbol":"C","column":12,"beat":2}]},{"id":"line-23","kind":"lyric","text":"  They're really saying","columns":23,"beats":4,"c