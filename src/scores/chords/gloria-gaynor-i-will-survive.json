{"version":1,"id":"gloria-gaynor-i-will-survive","title":"I Will Survive","artist":"Gloria Gaynor","key":"Am","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/gloria-gaynor/i-will-survive/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Freddie Perren and Dino Fekaris","chords":[{"symbol":"B°","canonical":"Bdim7","keyboardPitchClasses":[11,2,5,8],"interpretation":"Keyboard interpretation: Bdim7"},{"symbol":"Am","canonical":"Am","keyboardPitchClasses":[9,0,4],"interpretation":null},{"symbol":"Dm","canonical":"Dm","keyboardPitchClasses":[2,5,9],"interpretation":null},{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"C7M","canonical":"Cmaj7","keyboardPitchClasses":[0,4,7,11],"interpretation":"Keyboard interpretation: Cmaj7"},{"symbol":"F7M","canonical":"Fmaj7","keyboardPitchClasses":[5,9,0,4],"interpretation":"Keyboard interpretation: Fmaj7"},{"symbol":"Bm7(5-)","canonical":"Bm7b5","keyboardPitchClasses":[11,2,5,9],"interpretation":"Keyboard interpretation: Bm7b5"},{"symbol":"E7(4)","canonical":"E7sus4","keyboardPitchClasses":[4,9,11,2],"interpretation":"Keyboard interpretation: E7sus4"},{"symbol":"E7","canonical":"E7","keyboardPitchClasses":[4,8,11,2],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":10,"beats":4,"changes":[{"symbol":"B°","column":8,"beat":0}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"At first I was afraid, I was petrified","columns":38,"beats":4,"changes":[{"symbol":"Am","column":4,"beat":0},{"symbol":"Dm","column":30,"beat":2}]},{"id":"line-4","kind":"lyric","text":"Kept thinkin' I could never live","columns":32,"beats":4,"changes":[{"symbol":"G","column":14,"beat":0}]},{"id":"line-5","kind":"lyric","text":"Without you by my side","columns":22,"beats":4,"changes":[{"symbol":"C7M","column":13,"beat":0}]},{"id":"line-6","kind":"lyric","text":"But then I spent so many nights","columns":31,"beats":4,"changes":[{"symbol":"F7M","column":13,"beat":0}]},{"id":"line-7","kind":"lyric","text":"Thinking how you did me wrong","columns":29,"beats":4,"changes":[{"symbol":"Bm7(5-)","column":10,"beat":0}]},{"id":"line-8","kind":"lyric","text":"I grew strong","columns":15,"beats":4,"changes":[{"symbol":"E7(4)","column":10,"beat":0}]},{"id":"line-9","kind":"lyric","text":"And I learned how to get along","columns":30,"beats":6,"changes":[{"symbol":"E7","column":15,"beat":0}]},{"id":"line-10","kind":"lyric","text":"And so you're back, from outer space","columns":36,"beats":4,"changes":[{"symbol":"Am","column":15,"beat":0},{"symbol":"Dm","column":33,"beat":2}]},{"id":"line-11","kind":"lyric","text":"I just walked in to find you here","columns":33,"beats":4,"changes":[{"symbol":"G","column":14,"beat":0}]},{"id":"line-12","kind":"lyric","text":"With that sad look upon your face","columns":33,"beats":4,"changes":[{"symbol":"C7M","column":15,"beat":0}]},{"id":"line-13","kind":"lyric","text":"I should have change that stupid lock","columns":37,"beats":4,"changes":[{"symbol":"F7M","column":16,"beat":0}]},{"id":"line-14","kind":"lyric","text":"I should have made you leave your key","columns":37,"beats":4,"changes":[{"symbol":"Bm7(5-)","column":15,"beat":0}]},{"id":"line-15","kind":"lyric","text":"If I'd known for just one second","columns":32,"beats":4,"changes":[{"symbol":"E7(4)","column":9,"beat":0}]},{"id":"line-16","kind":"lyric","text":"You'd be back to bother me","columns":26,"beats":4,"changes":[{"symbol":"E7","column":10,"beat":0}]},{"id":"line-17","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"Go on now, go, walk out the door","columns":32,"beats":4,"changes":[{"symbol":"Am","column":12,"beat":0},{"symbol":"Dm","column":29,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Just turn around now","columns":20,"beats":4,"changes":[{"symbol":"G","column":12,"beat":0}]},{"id":"line-20","kind":"lyric","text":"'Cause you're not welcome anymore","columns":33,"beats":4,"changes":[{"symbol":"C7M","column":19,"beat":0}]},{"id":"line-21","kind":"lyric","text":"    Weren't you the one who tried","columns":33,"beats":4,"changes":[{"symbol":"F7M","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"To hurt me with goodbye?","columns":24,"beats":4,"changes":[{"symbol":"Bm7(5-)","column":4,"beat":0}]},{"id":"line-23","kind":"lyric","text":"Did you think I'd crumble?","columns":26,"beats":4,"changes":[{"symbol":"E7(4)","column":20,"beat":0}]},{"id":"line-24","kind":"lyric","text":"Did you think I'd lay down and die?","columns":35,"beats":4,"changes":[{"symbol":"E7","column":19,"beat":0}]},{"id":"line-25","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-26","kind":"lyric","text":"Oh no, not I, I will survive","columns":28,"beats":4,"changes":[{"symbol":"Am","column":11,"beat":0},{"symbol":"Dm","column":25,"beat":2}]},{"id":"line-27","kind":"lyric","text":"Oh, as long as I know how to love","columns":33,"beats":4,"changes":[{"symbol":"G","column":8,"beat":0}]},{"id":"line-28","kind":"lyric","text":"I know I'll stay alive","columns":22,"beats":4,"changes":[{"symbol":"C7M","column":4,"beat":0}]},{"id":"line-29","kind":"lyric","text":"I've got all my life to live","columns":28,"beats":4,"changes":[{"symbol":"F7M","column":9,"beat":0}]},{"id":"line-30","kind":"lyric","text":"And I've got all my love to give","columns":32,"beats":4,"changes":[{"symbol":"Bm7(5-)","column":13,"beat":0}]},{"id":"line-31","kind":"lyric","text":"And I will survive, I will survive","columns":34,"beats":4,"changes":[{"symbol":"E7(4)","column":15,"beat":0},{"symbol":"E7","column":31,"beat":2}]},{"id":"line-32","kind":"instrumental","text":"[Solo]","columns":21,"beats":8,"changes":[{"symbol":"Am","column":7,"beat":0},{"symbol":"Dm","column":11,"beat":2},{"symbol":"G","column":15,"beat":4},{"symbol":"C7M","column":18,"beat":6}]},{"id":"line-33","kind":"instrumental","text":"","columns":30,"beats":8,"changes":[{"symbol":"F7M","column":7,"beat":0},{"symbol":"Bm7(5-)","column":12,"beat":2},{"symbol":"E7(4)","column":21,"beat":4},{"symbol":"E7","column":28,"beat":6}]},{"id":"line-34","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-35","kind":"lyric","text":"Only the Lord could give me strength","columns":36,"beats":6,"changes":[{"symbol":"Am","column":10,"beat":0}]},{"id":"line-36","kind":"lyric","text":"Not to fall apart","columns":17,"beats":4,"changes":[{"symbol":"Dm","column":8,"beat":0}]},{"id":"line-37","kind":"lyric","text":"Though I tried hard to mend","columns":27,"beats":4,"changes":[{"symbol":"G","column":16,"beat":0}]},{"id":"line-38","kind":"lyric","text":"The pieces of my broken heart","columns":29,"beats":4,"changes":[{"symbol":"C7M","column":19,"beat":0}]},{"id":"line-39","kind":"lyric","text":"And I spent oh, so many nights","columns":30,"beats":4,"changes":[{"symbol":"F7M","column":12,"beat":0}]},{"id":"line-40","kind":"lyric","text":"Just felling sorry for myself","columns":29,"beats":4,"changes":[{"symbol":"Bm7(5-)","column":14,"beat":0}]},{"id":"line-41","kind":"lyric","text":"I used to cry","columns":17,"beats":4,"changes":[{"symbol":"E7(4)","column":12,"beat":0}]},{"id":"line-42","kind":"lyric","text":"But now I hold my head up high","columns":30,"beats":4,"changes":[{"symbol":"E7","column":11,"beat":0}]},{"id":"line-43","kind":"lyric","text":"And you see me, somebody new","columns":28,"beats":4,"changes":[{"symbol":"Am","column":13,"beat":0},{"symbol":"Dm","column":26,"beat":2}]},{"id":"line-44","kind":"lyric","text":"I'm not that chained-up little person","columns":37,"beats":4,"changes":[{"symbol":"G","column":15,"beat":0}]},{"id":"line-45","kind":"lyric","text":"Still in love with you","columns":22,"beats":4,"changes":[{"symbol":"C7M"