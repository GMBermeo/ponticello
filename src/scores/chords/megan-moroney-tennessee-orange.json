{"version":1,"id":"megan-moroney-tennessee-orange","title":"Tennessee Orange","artist":"Megan Moroney","key":"G","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/megan-moroney/tennessee-orange/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Megan Moroney, Ben Williams, David Fanning and Paul Jenkins","chords":[{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"lyric","text":"Mama, I'm callin', I've got some news","columns":37,"beats":4,"changes":[{"symbol":"A","column":1,"beat":0}]},{"id":"line-2","kind":"lyric","text":"Don't you tell daddy, he'll blow a fuse","columns":39,"beats":4,"changes":[{"symbol":"F#m","column":1,"beat":0}]},{"id":"line-3","kind":"lyric","text":"Don't worry, I'm doin' okay","columns":27,"beats":4,"changes":[{"symbol":"Bm","column":6,"beat":0},{"symbol":"D","column":23,"beat":2}]},{"id":"line-4","kind":"lyric","text":"I know you raised me to know right from wrong","columns":45,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"It ain't what you think, and I'm still writin' songs","columns":52,"beats":4,"changes":[{"symbol":"F#m","column":3,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Just never thought I'd see the day","columns":34,"beats":4,"changes":[{"symbol":"Bm","column":6,"beat":0},{"symbol":"D","column":31,"beat":2}]},{"id":"line-7","kind":"lyric","text":"I've never felt this way","columns":24,"beats":6,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"A","column":11,"beat":2},{"symbol":"D","column":22,"beat":4}]},{"id":"line-8","kind":"lyric","text":"I met somebody and he's got blue eyes","columns":37,"beats":4,"changes":[{"symbol":"A","column":10,"beat":0},{"symbol":"E","column":33,"beat":2}]},{"id":"line-9","kind":"lyric","text":"He opens the door and he don't make me cry","columns":42,"beats":4,"changes":[{"symbol":"F#m","column":13,"beat":0},{"symbol":"D","column":40,"beat":2}]},{"id":"line-10","kind":"lyric","text":"He ain't from where we're from, but he feels like home, yeah","columns":60,"beats":4,"changes":[{"symbol":"A","column":27,"beat":0},{"symbol":"E","column":50,"beat":2}]},{"id":"line-11","kind":"lyric","text":"He's got me doin' things I've never done","columns":40,"beats":4,"changes":[{"symbol":"F#m","column":12,"beat":0},{"symbol":"D","column":37,"beat":2}]},{"id":"line-12","kind":"lyric","text":"In Georgia, they'd call it a sin","columns":32,"beats":4,"changes":[{"symbol":"Bm","column":3,"beat":0},{"symbol":"D","column":29,"beat":2}]},{"id":"line-13","kind":"lyric","text":"I'm wearin' Tennessee orange for him","columns":36,"beats":6,"changes":[{"symbol":"Bm","column":12,"beat":0},{"symbol":"E","column":22,"beat":2},{"symbol":"A","column":33,"beat":4}]},{"id":"line-14","kind":"lyric","text":"Took me to Knoxville last Saturday","columns":34,"beats":4,"changes":[{"symbol":"A","column":0,"beat":0}]},{"id":"line-15","kind":"lyric","text":"And I wore the hat on his dash to the game","columns":42,"beats":4,"changes":[{"symbol":"F#m","column":4,"beat":0}]},{"id":"line-16","kind":"lyric","text":"It sure wasn't Athens, but I","columns":28,"beats":8,"changes":[{"symbol":"Bm","column":0,"beat":0},{"symbol":"D","column":27,"beat":4}]},{"id":"line-17","kind":"lyric","text":"Fell for him under those Neyland lights","columns":39,"beats":6,"changes":[{"symbol":"Bm","column":13,"beat":0},{"symbol":"A","column":25,"beat":2},{"symbol":"D","column":33,"beat":4}]},{"id":"line-18","kind":"lyric","text":"I met somebody and he's g