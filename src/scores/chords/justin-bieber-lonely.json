{"version":1,"id":"justin-bieber-lonely","title":"Lonely","artist":"Justin Bieber","key":"Am","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/justin-bieber/lonely/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Ezekiel Lewis, Bale Wa M Muhammad, Sean Hamilton and Hyuk Shin","chords":[{"symbol":"G","canonical":"G","keyboardPitchClasses":[7,11,2],"interpretation":null},{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"Bm","canonical":"Bm","keyboardPitchClasses":[11,2,6],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":18,"beats":6,"changes":[{"symbol":"G","column":8,"beat":0},{"symbol":"F#m","column":11,"beat":2},{"symbol":"Bm","column":16,"beat":4}]},{"id":"line-2","kind":"section","text":"[Primeira Parte]","columns":16,"beats":0,"changes":[]},{"id":"line-3","kind":"lyric","text":"  Everybody knows my name now","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-4","kind":"lyric","text":"  But something 'bout it still feels strange","columns":44,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-5","kind":"lyric","text":"  Like looking in the mirror","columns":28,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-6","kind":"lyric","text":"Tryna steady yourself and seeing somebody else","columns":46,"beats":4,"changes":[]},{"id":"line-7","kind":"lyric","text":"  And everything is not the same now","columns":36,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-8","kind":"lyric","text":"  It feels like all our lives have changed","columns":42,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-9","kind":"lyric","text":"  Maybe when I'm older, it'll all calm down","columns":43,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-10","kind":"lyric","text":"But it's killing me now","columns":23,"beats":4,"changes":[]},{"id":"line-11","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-12","kind":"lyric","text":"  What if you had it all but nobody to call?","columns":44,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"A","column":21,"beat":2},{"symbol":"F#m","column":39,"beat":4}]},{"id":"line-13","kind":"lyric","text":"Maybe then you'd know me","columns":24,"beats":4,"changes":[{"symbol":"G","column":17,"beat":0}]},{"id":"line-14","kind":"lyric","text":"  'Cause I've had everything","columns":28,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"A","column":23,"beat":2}]},{"id":"line-15","kind":"lyric","text":"But no one's listening","columns":22,"beats":4,"changes":[{"symbol":"F#m","column":19,"beat":0}]},{"id":"line-16","kind":"lyric","text":"And that's just fucking lonely","columns":30,"beats":4,"changes":[{"symbol":"G","column":24,"beat":0}]},{"id":"line-17","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-18","kind":"lyric","text":"I'm so lo-o-o-onely","columns":19,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"A","column":17,"beat":2}]},{"id":"line-19","kind":"lyric","text":"Lo-o-o-onely","columns":12,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column":11,"beat":4}]},{"id":"line-20","kind":"section","text":"[Segunda Parte]","columns":15,"beats":0,"changes":[]},{"id":"line-21","kind":"lyric","text":"  Everybody knows my past now","columns":29,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-22","kind":"lyric","text":"  Like my house was always made of glass","columns":40,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-23","kind":"lyric","text":"  And maybe that's the price you pay","columns":36,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-24","kind":"lyric","text":"For the money and fame at an early age","columns":38,"beats":4,"changes":[]},{"id":"line-25","kind":"lyric","text":"  And everybody saw me sick","columns":27,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0}]},{"id":"line-26","kind":"lyric","text":"  And it felt like no one gave a shit","columns":37,"beats":4,"changes":[{"symbol":"F#m","column":0,"beat":0}]},{"id":"line-27","kind":"lyric","text":"  They criticized the things I did","columns":34,"beats":4,"changes":[{"symbol":"Bm","column":0,"beat":0}]},{"id":"line-28","kind":"lyric","text":"As an idiot kid","columns":15,"beats":4,"changes":[]},{"id":"line-29","kind":"section","text":"[Pré-Refrão]","columns":12,"beats":0,"changes":[]},{"id":"line-30","kind":"lyric","text":"  What if you had it all but nobody to call?","columns":44,"beats":6,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"A","column":21,"beat":2},{"symbol":"F#m","column":39,"beat":4}]},{"id":"line-31","kind":"lyric","text":"Maybe then you'd know me","columns":24,"beats":4,"changes":[{"symbol":"G","column":17,"beat":0}]},{"id":"line-32","kind":"lyric","text":"  'Cause I've had everything","columns":28,"beats":4,"changes":[{"symbol":"G","column":0,"beat":0},{"symbol":"A","column":23,"beat":2}]},{"id":"line-33","kind":"lyric","text":"But no one's listening","columns":22,"beats":4,"changes":[{"symbol":"F#m","column":19,"beat":0}]},{"id":"line-34","kind":"lyric","text":"And that's just fucking lonely","columns":30,"beats":4,"changes":[{"symbol":"G","column":24,"beat":0}]},{"id":"line-35","kind":"section","text":"[Refrão]","columns":8,"beats":0,"changes":[]},{"id":"line-36","kind":"lyric","text":"I'm so lo-o-o-onely","columns":19,"beats":4,"changes":[{"symbol":"G","column":7,"beat":0},{"symbol":"A","column":17,"beat":2}]},{"id":"line-37","kind":"lyric","text":"Lo-o-o-onely","columns":12,"beats":8,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"G","column"