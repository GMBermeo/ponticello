{"version":1,"id":"shaboozey-a-bar-song-tipsy","title":"A Bar Song (Tipsy)","artist":"Shaboozey","key":"A","bpm":null,"bpmSource":"unknown","sourceUrl":"https://www.cifraclub.com.br/shaboozey/a-bar-song-tipsy/?instrument=keyboard","instrument":"keyboard","lyrics":"included","timing":"estimated","timingModel":"qwen3.5:4b","credits":"Composed by: Joe Anthony Kent, Tarboy, J Kwon, Henry Chibueze and Nevin","chords":[{"symbol":"F#m","canonical":"F#m","keyboardPitchClasses":[6,9,1],"interpretation":null},{"symbol":"A","canonical":"A","keyboardPitchClasses":[9,1,4],"interpretation":null},{"symbol":"D","canonical":"D","keyboardPitchClasses":[2,6,9],"interpretation":null},{"symbol":"E","canonical":"E","keyboardPitchClasses":[4,8,11],"interpretation":null}],"lines":[{"id":"line-1","kind":"instrumental","text":"[Intro]","columns":23,"beats":10,"changes":[{"symbol":"F#m","column":8,"beat":0},{"symbol":"A","column":13,"beat":2},{"symbol":"D","column":16,"beat":4},{"symbol":"A","column":19,"beat":6},{"symbol":"E","column":22,"beat":8}]},{"id":"line-2","kind":"lyric","text":"My baby want a birkin, she's been telling me all night long","columns":60,"beats":13,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"D","column":30,"beat":4},{"symbol":"A","column":56,"beat":6},{"symbol":"E","column":59,"beat":8}]},{"id":"line-3","kind":"lyric","text":"Gasoline and groceries, the list goes on and on","columns":51,"beats":10,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"D","column":30,"beat":4},{"symbol":"A","column":45,"beat":6},{"symbol":"E","column":50,"beat":8}]},{"id":"line-4","kind":"lyric","text":"This 9 to 5 ain't working, why the hell do I work so hard?","columns":64,"beats":10,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":17,"beat":2},{"symbol":"D","column":30,"beat":4},{"symbol":"A","column":55,"beat":6},{"symbol":"E","column":63,"beat":8}]},{"id":"line-5","kind":"lyric","text":"I can't worry about my problems, I can't take them when I'm gone","columns":65,"beats":5,"changes":[{"symbol":"F#m","column":1,"beat":0},{"symbol":"A","column":24,"beat":1},{"symbol":"D","column":37,"beat":2},{"symbol":"A","column":58,"beat":3},{"symbol":"E","column":64,"beat":4}]},{"id":"line-6","kind":"lyric","text":"One, here comes the two to the three to the four","columns":48,"beats":7,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":20,"beat":1},{"symbol":"D","column":44,"beat":2}]},{"id":"line-7","kind":"lyric","text":"Tell 'em bring another out, we need plenty more","columns":47,"beats":6,"changes":[{"symbol":"A","column":9,"beat":0},{"symbol":"E","column":24,"beat":2},{"symbol":"F#m","column":41,"beat":4}]},{"id":"line-8","kind":"lyric","text":"Two stepping on the table, she don't need a dance floor","columns":55,"beats":4,"changes":[{"symbol":"A","column":20,"beat":0},{"symbol":"D","column":53,"beat":2}]},{"id":"line-9","kind":"lyric","text":"Oh my, good lord","columns":16,"beats":2,"changes":[{"symbol":"A","column":6,"beat":0}]},{"id":"line-10","kind":"lyric","text":"Someone pour me up a double shot of whiskey","columns":46,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":20,"beat":2},{"symbol":"D","column":45,"beat":4}]},{"id":"line-11","kind":"lyric","text":"They know me and Jack daniels got a history","columns":43,"beats":6,"changes":[{"symbol":"A","column":26,"beat":0},{"symbol":"E","column":32,"beat":2},{"symbol":"F#m","column":37,"beat":4}]},{"id":"line-12","kind":"lyric","text":"There's a party downtown near fifth street","columns":42,"beats":4,"changes":[{"symbol":"A","column":26,"beat":0},{"symbol":"D","column":39,"beat":2}]},{"id":"line-13","kind":"lyric","text":"Everybody at the bar getting tipsy","columns":43,"beats":8,"changes":[{"symbol":"A","column":27,"beat":0},{"symbol":"E","column":34,"beat":2},{"symbol":"F#m","column":37,"beat":4},{"symbol":"A","column":42,"beat":6}]},{"id":"line-14","kind":"lyric","text":"Everybody at the bar getting tipsy","columns":42,"beats":10,"changes":[{"symbol":"D","column":9,"beat":0},{"symbol":"A","column":24,"beat":2},{"symbol":"E","column":31,"beat":4},{"symbol":"F#m","column":36,"beat":6},{"symbol":"A","column":41,"beat":8}]},{"id":"line-15","kind":"lyric","text":"Everybody at the bar getting tipsy","columns":34,"beats":3,"changes":[{"symbol":"D","column":9,"beat":0},{"symbol":"A","column":24,"beat":1},{"symbol":"E","column":31,"beat":2}]},{"id":"line-16","kind":"lyric","text":"I've been boozey since I've left, I ain't changing for a check","columns":62,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":27,"beat":2},{"symbol":"D","column":60,"beat":4}]},{"id":"line-17","kind":"lyric","text":"Tell my ma I ain't forget (oh lord)","columns":35,"beats":4,"changes":[{"symbol":"A","column":20,"beat":0}]},{"id":"line-18","kind":"lyric","text":"Woke up drunk at 10am, we gone do this shit again","columns":52,"beats":6,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":27,"beat":2},{"symbol":"D","column":51,"beat":4}]},{"id":"line-19","kind":"lyric","text":"Tell your girl to bring a friend (oh lord)","columns":42,"beats":4,"changes":[{"symbol":"A","column":20,"beat":0}]},{"id":"line-20","kind":"lyric","text":"One, here comes the two to the three to the four","columns":48,"beats":3,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":20,"beat":1},{"symbol":"D","column":44,"beat":2}]},{"id":"line-21","kind":"lyric","text":"Tell 'em bring another out, we need plenty more","columns":47,"beats":6,"changes":[{"symbol":"A","column":9,"beat":0},{"symbol":"E","column":24,"beat":2},{"symbol":"F#m","column":41,"beat":4}]},{"id":"line-22","kind":"lyric","text":"Two stepping on the table, she don't need a dance floor","columns":55,"beats":5,"changes":[{"symbol":"F#m","column":0,"beat":0},{"symbol":"A","column":20,"beat":1},{"symbol":"D","column":44,"beat"