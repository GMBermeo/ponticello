{
  "expo": {
    "name": "Ponticello",
    "slug": "ponticello",
    "version": "1.4.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ponticello",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bermeo.ponticello",
      "buildNumber": "6"
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#f3f2f2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.bermeo.ponticello"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f2f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 148
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ponticello listens to your cello to show whether each note is in tune. Nothing is recorded and nothing leaves the device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Offline intonation practice for acoustic cello, laid out for the Galaxy Z Fold 5 inner display.",
    "backgroundColor": "#f3f2f2"
  }
}
