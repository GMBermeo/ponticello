{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@audio": [
        "./src/audio/index.ts"
      ],
      "@components": [
        "./src/components/index.ts"
      ],
      "@domain": [
        "./src/domain/index.ts"
      ],
      "@scores": [
        "./src/scores/index.ts"
      ],
      "@state": [
        "./src/state/index.ts"
      ],
      "@theme": [
        "./src/theme/index.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
