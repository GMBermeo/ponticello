{
  "name": "ponticello",
  "main": "expo-router/entry",
  "version": "1.8.0",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo/ui": "~57.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tonaljs/chord-type": "5.1.1",
    "@tonaljs/interval": "5.1.0",
    "@tonaljs/note": "4.12.1",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.2",
    "cheerio": "1.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build:chords": "vite-node --config vitest.config.ts tools/build-cello-chords.ts",
    "study:chords": "vite --config tools/chord-study/vite.config.ts",
    "import:chords": "vite-node --config vitest.config.ts tools/import-chord-sheets.ts --",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "build:library": "vite-node --config vitest.config.ts tools/build-library.ts -- --edition=full",
    "audit:arrangements": "vite-node --config vitest.config.ts tools/audit-arrangements.ts",
    "arrange:ollama": "vite-node --config vitest.config.ts tools/ollama-arranger.ts --",
    "ollama:benchmark": "vite-node --config vitest.config.ts tools/ollama-benchmark.ts --",
    "convert": "vite-node --config vitest.config.ts tools/convert-score.ts --",
    "apk": "bash tools/build-apk.sh",
    "proxy": "node tools/dev-proxy.mjs",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "ipa": "eas build --platform ios --profile device",
    "ipa:simulator": "eas build --platform ios --profile preview",
    "build:library:free": "vite-node --config vitest.config.ts tools/build-library.ts -- --edition=free",
    "release:full": "bash tools/build-release.sh full",
    "release:free": "bash tools/build-release.sh free"
  },
  "private": true
}
